async (page) => {
  await page.goto('http://127.0.0.1:4480/en/mechanisms/escapement/', { waitUntil: 'load' });
  await page.waitForTimeout(350);
  return page.evaluate(() => {
    const counter = document.querySelector('.mechanism-animation .step-counter')?.textContent ?? '';
    const panel = document.getElementById('esc-part-role')?.textContent ?? '';
    const svg = document.getElementById('escapement-svg');
    const refs = (svg?.outerHTML ?? '').match(/url\(#([^)]+)\)/g) || [];
    const thieu = [...new Set(refs.map((r) => r.slice(5, -1)))].filter((id) => !document.getElementById(id));
    let hidden = null;
    try { hidden = svg?.hasAttribute('aria-hidden') ? svg.getAttribute('aria-hidden') : null; } catch {}
    return {
      counter,
      panel: panel.trim(),
      panelVI: panel.includes('Tên tiếng Việt'),
      soRefs: refs.length,
      thieu,
      role: svg?.getAttribute('role') ?? null,
      ariaHidden: hidden,
      nhan: svg?.getAttribute('aria-label') ?? null,
      nhanEnDung: (svg?.getAttribute('aria-label') ?? '').startsWith('Step-by-step diagram of a Swiss lever escapement'),
    };
  });
}
)(page);
