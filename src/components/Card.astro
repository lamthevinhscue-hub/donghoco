---
// =============================================================================
// CARD (Thẻ bài viết)
// =============================================================================
// Dùng để hiển thị một bài viết / thương hiệu / mẫu iconic ở dạng thẻ tóm tắt
// trong các trang danh sách. Bạn không cần sửa tệp này.
// =============================================================================

import { getLangFromUrl, t, localizedPath } from '../i18n/ui';

interface Props {
  href: string;          // Đường dẫn gốc (chưa có tiền tố ngôn ngữ), ví dụ: "/thuong-hieu/rolex"
  title: string;
  excerpt: string;
  image?: string;
  meta?: string;         // Thông tin phụ (ví dụ: "Rolex • 1905")
  badge?: string;        // Nhãn nhỏ ở góc (ví dụ: "Thụy Sĩ")
  logo?: string;         // Logo nhỏ bên cạnh tiêu đề (cho thương hiệu)
  tierLabel?: string;    // Nhãn phân hạng (ví dụ: "Cao cấp") — chỉ dùng cho thẻ thương hiệu
  tierAccent?: string;   // Mã màu nhấn (khóa Tailwind, ví dụ: 'tier-haute') — kèm biến thể -light cho dark mode
  featureYear?: string;  // Năm thành lập / ra mắt — hiển thị như yếu tố thị giác chính (serif, lớn, brass) ở góc trên-phải
  compareSlug?: string;  // Slug mẫu iconic — khi có, hiện nút 'So sánh' dẫn sang /so-sanh?m=slug
}

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);

const { href, title, excerpt, image, meta, badge, logo, tierLabel, tierAccent, featureYear, compareSlug } = Astro.props;
const fullHref = localizedPath(href, lang);
const compareHref = compareSlug ? localizedPath(`/so-sanh?m=${compareSlug}`, lang) : null;

// Lớp màu cho nhãn phân hạng: nền nhạt + chữ đậm theo màu tier.
// tierAccent là khóa (VD 'tier-haute'); hậu tố -light là biến thể sáng cho dark mode.
const tierLabelClasses = tierAccent
  ? `bg-${tierAccent}/10 text-${tierAccent} dark:text-${tierAccent}-light`
  : '';
---

<article class="group flex h-full flex-col overflow-hidden rounded-lg border border-cream-dark bg-white transition-shadow hover:shadow-lg dark:border-dark-border dark:bg-dark-surface">
  {image && (
    <a href={fullHref} class="block aspect-[16/10] overflow-hidden bg-cream-dark">
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </a>
  )}

  <div class="relative flex flex-1 flex-col p-5">
    <!-- Năm thành lập / ra mắt — yếu tố thị giác chính, góc trên-phải -->
    {featureYear && (
      <span class="feature-year pointer-events-none absolute right-4 top-3 font-serif text-2xl leading-none text-brass dark:text-dark-brass">
        {featureYear}
      </span>
    )}

    <div class="mb-2 flex flex-wrap items-center gap-2">
      {tierLabel && tierAccent && (
        <span class={`inline-block w-fit rounded-full px-2.5 py-0.5 text-xs font-medium ${tierLabelClasses}`}>
          {tierLabel}
        </span>
      )}
      {badge && (
        <span class="inline-block w-fit rounded-full bg-brass/10 px-2.5 py-0.5 text-xs font-medium text-brass">
          {badge}
        </span>
      )}
    </div>

    <h3 class="mb-2 flex items-center gap-2 font-serif text-lg text-navy">
      {logo && (
        <img src={logo} alt={`${title} logo`} loading="lazy" class="h-6 w-6 shrink-0 object-contain" />
      )}
      <a href={fullHref} class="transition-colors hover:text-brass dark:hover:text-dark-brass">{title}</a>
    </h3>

    {meta && <p class="mb-2 text-xs uppercase tracking-wider text-ink-soft/70 dark:text-dark-text-soft/70">{meta}</p>}

    <p class="mb-4 flex-1 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">{excerpt}</p>

    <div class="mt-auto flex items-center gap-4">
      <a
        href={fullHref}
        class="text-sm font-medium text-brass transition-colors hover:text-navy dark:text-dark-brass dark:hover:text-brass-light"
      >
        {tr.read_more} →
      </a>
      {compareHref && (
        <a
          href={compareHref}
          class="text-sm text-ink-soft transition-colors hover:text-brass dark:text-dark-text-soft dark:hover:text-dark-brass"
        >
          ⚖ So sánh
        </a>
      )}
    </div>
  </div>
</article>

<style is:global>
  /*
    Năm trên thẻ: dùng chữ số lining (chữ số nằm thẳng, không phải kiểu cũ với
    descender/ascender) để các số như 1735, 1969 hiển thị rõ và dễ đọc.
    Tránh lỗi từng xảy ra trên /lich-su: font serif mặc định dùng oldstyle figures
    khiến "300" trông như "3oo".
  */
  .card .feature-year,
  .feature-year {
    font-variant-numeric: lining-nums;
    font-feature-settings: "lnum";
  }
</style>
