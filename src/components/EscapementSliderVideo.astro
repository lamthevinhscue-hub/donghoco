---
// =============================================================================
// V3 — EscapementSliderVideo: bản thử chu kỳ bộ thoát dựng sẵn, điều khiển
// bằng thanh trượt (TXN-20261010-003)
// =============================================================================
// Video không nhúng chữ; nhãn pha và giải thích đặt bằng HTML, dịch theo
// `lang`. Bảng pha là nguồn duy nhất src/data/v3-escapement-phas.json (cùng
// nguồn với script dựng video và checker V3).
//
// Nguyên tắc tương tác:
//   - KHÔNG tự phát, KHÔNG tự lặp, KHÔNG âm thanh; video luôn pause khi kéo.
//   - Video chỉ tải khi người đọc bấm nút (tải chủ động — trước đó không có
//     yêu cầu mạng nào cho tệp video).
//   - Trước khi metadata sẵn sàng: thanh trượt disabled, không thao tác được.
//   - Kéo nhanh/ kéo ngược: mô hình "đích chờ" (pending) — luôn seek tới GIÁ
//     TRỊ MỚI NHẤT; sau 'seeked' mới áp đích còn lại, không đè lẫn.
//   - Reduced motion: không có chuyển động tự động nào để tắt — mọi chuyển
//     động đều do người đọc kéo; nhãn pha đổi tức thì.
//   - Không JavaScript / video lỗi: poster của <video> vẫn hiển thị, bảng pha
//     và ghi chú giản lược đọc được, sơ đồ SVG tương tác của bài vẫn nguyên.
// =============================================================================
import PHAS from '../data/v3-escapement-phas.json';

interface Props { lang: 'vi' | 'en' }
const { lang } = Astro.props;
const laEn = lang === 'en';

const chu = laEn
  ? {
      khung: 'Experiment — the escapement cycle with a slider',
      moTa: 'A pre-rendered principle model. Drag the slider (or use the arrow keys) to move through the phases: lock, unlock, impulse, lock again — for both pallet stones, a full oscillation.',
      nutTai: 'Load the video (about 0.8 MB)',
      dangTai: 'Loading the video…',
      loiTai: 'The video could not be loaded. The phase table below and the interactive SVG diagram still work.',
      thanhTruot: 'Time position in the video',
      pha: 'Phase',
      doDai: 'Length',
      giay: 's',
      canCu: 'Basis',
      bangTieuDe: 'Phase map: video time — explanation — basis',
      chuaTai: 'The video loads only when you press the button.',
    }
  : {
      khung: 'Thử nghiệm — chu kỳ bộ thoát với thanh trượt',
      moTa: 'Mô hình nguyên lý dựng sẵn. Kéo thanh trượt (hoặc dùng phím mũi tên) để đi qua từng pha: khóa, nhả, xung lực, khóa lại — cho cả hai đá pallet, trọn một dao động.',
      nutTai: 'Tải video (khoảng 0,8 MB)',
      dangTai: 'Đang tải video…',
      loiTai: 'Không tải được video. Bảng pha bên dưới và sơ đồ SVG tương tác vẫn dùng được.',
      thanhTruot: 'Vị trí thời gian trong video',
      pha: 'Pha',
      doDai: 'Độ dài',
      giay: 's',
      canCu: 'Căn cứ',
      bangTieuDe: 'Bảng pha: thời điểm video — giải thích — căn cứ',
      chuaTai: 'Video chỉ tải khi bạn bấm nút.',
    };

const dinhGiay = (ms: number) => (ms / 1000).toFixed(1).replace('.', laEn ? '.' : ',');
const khoang = (d: { startMs: number; endMs: number }) => `${dinhGiay(d.startMs)}–${dinhGiay(d.endMs)} ${chu.giay}`;
const cacPha = PHAS.phases;
---

<figure
  id="v3esc"
  class="my-8 overflow-hidden rounded-lg border border-cream-dark bg-white dark:border-dark-border dark:bg-dark-surface"
  data-lang={lang}
  data-duration-ms={PHAS.durationMs}
  data-phas={JSON.stringify(cacPha)}
>
  <figcaption
    class="flex flex-wrap items-baseline gap-2 border-b border-cream-dark px-4 py-3 text-sm font-semibold text-navy sm:px-6 dark:border-dark-border dark:text-dark-text"
  >
    <span>{chu.khung}</span>
  </figcaption>

  <div class="px-4 pt-4 sm:px-6">
    <video
      id="v3esc-video"
      data-src="/videos/v3-escapement/bo-thoat-chu-ky-truot.webm"
      poster="/videos/v3-escapement/poster.jpg"
      width={PHAS.videoWidth}
      height={PHAS.videoHeight}
      preload="none"
      playsinline
      muted
      disablepictureinpicture
      class="block h-auto w-full rounded"
    ></video>
    <p id="v3esc-trangthai" class="mt-2 min-h-5 text-sm text-ink-soft dark:text-dark-text-soft" aria-live="polite">{chu.chuaTai}</p>

    <div class="mt-2 flex flex-wrap items-center gap-3">
      <button
        id="v3esc-tai"
        type="button"
        class="rounded border border-brass bg-brass/10 px-4 py-2 text-sm font-semibold text-navy hover:bg-brass/20 dark:text-dark-text"
      >{chu.nutTai}</button>
      <noscript><span class="text-sm text-ink-soft dark:text-dark-text-soft">{laEn ? 'JavaScript is off — the video button needs it; the table below still explains every phase.' : 'JavaScript đang tắt — nút tải video cần JavaScript; bảng pha bên dưới vẫn giải thích đủ.'}</span></noscript>
    </div>

    <div class="mt-3">
      <label for="v3esc-thanh" class="block text-sm font-semibold text-navy dark:text-dark-text">{chu.thanhTruot}</label>
      <input
        id="v3esc-thanh"
        type="range"
        min="0"
        max={PHAS.durationMs}
        step="100"
        value="0"
        disabled
        aria-disabled="true"
        class="mt-1 w-full accent-[#b08d3e] motion-reduce:transition-none"
      />
      <p id="v3esc-nhan" aria-live="polite" class="min-h-6 text-sm text-ink-soft dark:text-dark-text-soft"></p>
    </div>
  </div>

  <p class="px-4 pb-1 pt-3 text-xs text-ink-soft/90 sm:px-6 dark:text-dark-text-soft/70">{chu.moTa}</p>

  <div class="px-4 pb-4 sm:px-6">
    <table class="w-full border-collapse text-sm">
      <caption class="sr-only">{chu.bangTieuDe}</caption>
      <thead>
        <tr class="border-b border-cream-dark text-left dark:border-dark-border">
          <th scope="col" class="py-2 pr-3 font-semibold">{chu.pha}</th>
          <th scope="col" class="py-2 pr-3 font-semibold">{chu.doDai}</th>
          <th scope="col" class="py-2 pr-3 font-semibold">{laEn ? 'What happens' : 'Diễn ra'}</th>
          <th scope="col" class="py-2 font-semibold">{chu.canCu}</th>
        </tr>
      </thead>
      <tbody>
        {cacPha.map((pha, i) => (
          <tr class="border-b border-cream-dark/60 align-top last:border-0 dark:border-dark-border/60">
            <td class="py-2 pr-3 font-medium text-navy dark:text-dark-text">
              {i + 1}. {laEn ? pha.en.ten : pha.vi.ten}
            </td>
            <td class="py-2 pr-3 whitespace-nowrap tabular-nums text-ink-soft dark:text-dark-text-soft">{khoang(pha)}</td>
            <td class="py-2 pr-3 text-ink-soft dark:text-dark-text-soft">{laEn ? pha.en.moTa : pha.vi.moTa}</td>
            <td class="py-2 text-xs text-ink-soft/80 dark:text-dark-text-soft/80">{laEn ? pha.canCu.en : pha.canCu.vi}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="mt-3 text-xs text-ink-soft/80 dark:text-dark-text-soft/80">{laEn ? PHAS.ghiChuEn : PHAS.ghiChuVi}</p>
  </div>
</figure>

<script>
  // Tải chủ động + thanh trượt seek — mô hình "đích chờ": kéo nhanh hay kéo
  // ngược thì đích cuối cùng luôn thắng; không seek cũ ghi đè seek mới.
  const khung = document.getElementById('v3esc');
  if (khung) {
    const video = document.getElementById('v3esc-video') as HTMLVideoElement;
    const nut = document.getElementById('v3esc-tai') as HTMLButtonElement;
    const thanh = document.getElementById('v3esc-thanh') as HTMLInputElement;
    const nhan = document.getElementById('v3esc-nhan') as HTMLParagraphElement;
    const trangThai = document.getElementById('v3esc-trangthai') as HTMLParagraphElement;
    const laEn = khung.dataset.lang === 'en';
    const phas = JSON.parse(khung.dataset.phas || '[]') as Array<{ startMs: number; endMs: number; vi: { ten: string }; en: { ten: string } }>;

    const dinhGiay = (ms: number) => (ms / 1000).toFixed(1).replace('.', laEn ? '.' : ',');
    const phaTai = (ms: number) => {
      for (let i = 0; i < phas.length; i++) {
        if (ms >= phas[i].startMs && ms < phas[i].endMs) return { viTri: i, pha: phas[i] };
      }
      return { viTri: phas.length - 1, pha: phas[phas.length - 1] };
    };
    const capNhatNhan = (ms: number) => {
      const { viTri, pha } = phaTai(ms);
      const ten = laEn ? pha.en.ten : pha.vi.ten;
      nhan.textContent = laEn
        ? `Phase ${viTri + 1}/${phas.length} — ${ten} (${(pha.startMs / 1000).toFixed(1)}–${(pha.endMs / 1000).toFixed(1)} s)`
        : `Pha ${viTri + 1}/${phas.length} — ${ten} (${dinhGiay(pha.startMs)}–${dinhGiay(pha.endMs)} s)`;
      thanh.setAttribute(
        'aria-valuetext',
        laEn ? `Phase ${viTri + 1} of ${phas.length}: ${ten}` : `Pha ${viTri + 1} trên ${phas.length}: ${ten}`,
      );
    };

    let dichCho: number | null = null;
    let dangSeek = false;
    const apDich = () => {
      if (dichCho === null || dangSeek) return;
      dangSeek = true;
      video.currentTime = dichCho / 1000;
    };
    const keoToi = (giaTri: number) => {
      video.pause();
      dichCho = giaTri;
      capNhatNhan(giaTri);
      apDich();
    };

    thanh.addEventListener('input', () => keoToi(Number(thanh.value)));
    video.addEventListener('seeked', () => {
      dangSeek = false;
      const msHienTai = Math.round(video.currentTime * 1000);
      if (dichCho !== null && Math.abs(msHienTai - dichCho) > 60) {
        apDich(); // đích đã đổi trong lúc seek — áp đích mới nhất
      } else {
        dichCho = null;
        capNhatNhan(msHienTai);
      }
    });

    const batDauTai = () => {
      if (!video.dataset.src) return;
      nut.disabled = true;
      nut.setAttribute('aria-busy', 'true');
      trangThai.textContent = laEn ? 'Loading the video…' : 'Đang tải video…';
      video.src = video.dataset.src;
      video.load();
    };
    nut.addEventListener('click', batDauTai);
    video.addEventListener('loadedmetadata', () => {
      thanh.max = String(Math.round(video.duration * 1000));
      thanh.disabled = false;
      thanh.removeAttribute('aria-disabled');
      nut.hidden = true;
      trangThai.textContent = laEn
        ? 'Video loaded — drag the slider to step through the phases.'
        : 'Video đã tải — kéo thanh trượt để đi qua từng pha.';
      capNhatNhan(0);
    });
    video.addEventListener('error', () => {
      nut.hidden = true;
      trangThai.textContent = laEn
        ? 'The video could not be loaded. The phase table below and the interactive SVG diagram still work.'
        : 'Không tải được video. Bảng pha bên dưới và sơ đồ SVG tương tác vẫn dùng được.';
    });
  }
</script>
