---
// =============================================================================
// FOOTER (Chân trang)
// =============================================================================
// Hiển thị ở cuối mọi trang: thông tin bản quyền, liên kết nhanh, thông báo bản tin.
// =============================================================================

import { getLangFromUrl, t, localizedPath } from '../i18n/ui';
import { localizedHref } from '../i18n/contentRoutes';

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);
const year = new Date().getFullYear();

const footerLinks = [
  { key: 'nav_home', path: '/' },
  { key: 'nav_brands', path: '/thuong-hieu' },
  { key: 'nav_iconic', path: '/mau-iconic' },
  { key: 'nav_mechanisms', path: '/co-che' },
  { key: 'nav_anatomy', path: '/giai-phau' },
  { key: 'nav_history', path: '/lich-su' },
  { key: 'nav_glossary', path: '/tu-dien' },
  { key: 'nav_guides', path: '/huong-dan' },
  { key: 'nav_about', path: '/ve-chung-toi' },
  { key: 'nav_contact', path: '/lien-he' },
]
  // Chỉ hiện mục có bản dịch trong ngôn ngữ hiện tại — footer không còn
  // hard-code link tiếng Việt trên bản tiếng Anh.
  .map((item) => ({ ...item, href: localizedHref(item.path, lang) }))
  .filter((item): item is { key: string; path: string; href: string } => Boolean(item.href));
---

<footer data-pagefind-ignore class="mt-24 border-t border-cream-dark bg-navy text-cream/80 dark:border-dark-border dark:bg-black/40">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-3">
    <!-- Cột 1: Giới thiệu -->
    <div>
      <p class="mb-3 font-serif text-xl text-cream">
        <a href={localizedPath('/', lang)} class="text-cream transition-colors hover:text-brass-light focus-visible:text-brass-light">{tr.siteName}</a>
      </p>
      <p class="text-sm leading-relaxed">{tr.siteTagline}</p>
    </div>

    <!-- Cột 2: Liên kết nhanh -->
    <div>
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-brass-light">{tr.featured}</p>
      <ul class="space-y-2 text-sm">
        {footerLinks.map((item) => (
          <li>
            <a href={item.href} class="text-cream/80 transition-colors hover:text-brass-light focus-visible:text-brass-light">
              {tr[item.key]}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Cột 3: Thông báo bản tin (đang chuẩn bị) -->
    <div>
      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-brass-light">{tr.subscribe_title}</p>
      <p class="text-sm leading-relaxed text-cream/70">
        {tr.subscribe_desc}
      </p>
      <p class="mt-3 rounded-lg border border-cream/15 px-4 py-3 text-xs leading-relaxed text-cream/75">
        ✉ {lang === 'vi'
          ? <>Tính năng nhận bài mới qua thư đang được chuẩn bị. Bạn có thể lưu trang và quay lại, hoặc theo dõi qua trang <a href={localizedHref('/lien-he', lang) ?? '/'} class="text-brass-light underline underline-offset-2 hover:text-cream focus-visible:text-cream">Liên hệ</a> để nhận thông báo khi sẵn sàng.</>
          : <>Email updates are being prepared. You can bookmark this page and come back later, or use the <a href={localizedHref('/lien-he', lang) ?? '/'} class="text-brass-light underline underline-offset-2 hover:text-cream focus-visible:text-cream">Contact</a> page to reach out.</>}
      </p>
    </div>
  </div>

  <!-- Dòng bản quyền -->
  <div class="border-t border-cream/10">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-5 text-xs text-cream/75 sm:flex-row">
      <p>© {year} {tr.siteName}. {tr.footer_rights}. <a href={localizedHref('/ban-quyen', lang) ?? '/'} class="underline underline-offset-2 transition-colors hover:text-brass-light focus-visible:text-brass-light">{tr.footer_terms}</a> <span aria-hidden="true">·</span> <a href={localizedHref('/kha-nang-tiep-can', lang) ?? '/'} class="underline underline-offset-2 transition-colors hover:text-brass-light focus-visible:text-brass-light">{tr.footer_a11y}</a></p>
      <p>{tr.footer_made}</p>
    </div>
  </div>
</footer>
