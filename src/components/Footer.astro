---
// =============================================================================
// FOOTER (Chân trang)
// =============================================================================
// Hiển thị ở cuối mọi trang: thông tin bản quyền, liên kết nhanh, thông báo bản tin.
// =============================================================================

import { getLangFromUrl, t, localizedPath } from '../i18n/ui';

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);
const year = new Date().getFullYear();

const footerLinks = [
  { key: 'nav_home', path: '/' },
  { key: 'nav_brands', path: '/thuong-hieu' },
  { key: 'nav_iconic', path: '/mau-iconic' },
  { key: 'nav_mechanisms', path: '/co-che' },
  { key: 'nav_anatomy', path: '/giai-phau' },
  { key: 'nav_history', path: '/lich-su' },
  { key: 'nav_glossary', path: '/tu-dien' },
  { key: 'nav_guides', path: '/huong-dan' },
  { key: 'nav_about', path: '/ve-chung-toi' },
  { key: 'nav_contact', path: '/lien-he' },
];
---

<footer class="mt-24 border-t border-cream-dark bg-navy text-cream/80 dark:border-dark-border dark:bg-black/40">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-3">
    <!-- Cột 1: Giới thiệu -->
    <div>
      <h3 class="mb-3 font-serif text-xl text-cream">
        <a href={localizedPath('/', lang)} class="transition-colors hover:text-brass-light">{tr.siteName}</a>
      </h3>
      <p class="text-sm leading-relaxed">{tr.siteTagline}</p>
    </div>

    <!-- Cột 2: Liên kết nhanh -->
    <div>
      <h4 class="mb-3 text-sm font-semibold uppercase tracking-wider text-brass-light">{tr.featured}</h4>
      <ul class="space-y-2 text-sm">
        {footerLinks.map((item) => (
          <li>
            <a href={localizedPath(item.path, lang)} class="transition-colors hover:text-brass-light">
              {tr[item.key]}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Cột 3: Thông báo bản tin (đang chuẩn bị) -->
    <div>
      <h4 class="mb-2 text-sm font-semibold uppercase tracking-wider text-brass-light">{tr.subscribe_title}</h4>
      <p class="text-sm leading-relaxed text-cream/70">
        {tr.subscribe_desc}
      </p>
      <p class="mt-3 rounded-lg border border-cream/15 bg-cream/5 px-4 py-3 text-xs leading-relaxed text-cream/50">
        ✉ Tính năng nhận bài mới qua thư đang được chuẩn bị. Bạn có thể lưu trang và quay lại, hoặc theo dõi qua trang <a href="/lien-he" class="text-brass-light underline underline-offset-2 hover:text-brass">Liên hệ</a> để nhận thông báo khi sẵn sàng.
      </p>
    </div>
  </div>

  <!-- Dòng bản quyền -->
  <div class="border-t border-cream/10">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-5 text-xs text-cream/50 sm:flex-row">
      <p>© {year} {tr.siteName}. {tr.footer_rights}. <a href={localizedPath('/ban-quyen', lang)} class="underline underline-offset-2 transition-colors hover:text-brass-light">Điều khoản bản quyền</a></p>
      <p>{tr.footer_made}</p>
    </div>
  </div>
</footer>


