---
// =============================================================================
// FOOTER (Chân trang)
// =============================================================================
// Hiển thị ở cuối mọi trang: thông tin bản quyền, liên kết nhanh, form đăng ký.
// =============================================================================

import { getLangFromUrl, t, localizedPath } from '../i18n/ui';

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);
const year = new Date().getFullYear();

const footerLinks = [
  { key: 'nav_home', path: '/' },
  { key: 'nav_brands', path: '/thuong-hieu' },
  { key: 'nav_iconic', path: '/mau-iconic' },
  { key: 'nav_mechanisms', path: '/co-che' },
  { key: 'nav_anatomy', path: '/giai-phau' },
  { key: 'nav_history', path: '/lich-su' },
  { key: 'nav_glossary', path: '/tu-dien' },
  { key: 'nav_guides', path: '/huong-dan' },
  { key: 'nav_about', path: '/ve-chung-toi' },
  { key: 'nav_contact', path: '/lien-he' },
];
---

<footer class="mt-24 border-t border-cream-dark bg-navy text-cream/80 dark:border-dark-border dark:bg-black/40">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-3">
    <!-- Cột 1: Giới thiệu -->
    <div>
      <h3 class="mb-3 font-serif text-xl text-cream">
        <a href={localizedPath('/', lang)} class="transition-colors hover:text-brass-light">{tr.siteName}</a>
      </h3>
      <p class="text-sm leading-relaxed">{tr.siteTagline}</p>
    </div>

    <!-- Cột 2: Liên kết nhanh -->
    <div>
      <h4 class="mb-3 text-sm font-semibold uppercase tracking-wider text-brass-light">{tr.featured}</h4>
      <ul class="space-y-2 text-sm">
        {footerLinks.map((item) => (
          <li>
            <a href={localizedPath(item.path, lang)} class="transition-colors hover:text-brass-light">
              {tr[item.key]}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Cột 3: Đăng ký bản tin -->
    <div>
      <h4 class="mb-2 text-sm font-semibold uppercase tracking-wider text-brass-light">{tr.subscribe_title}</h4>
      <p class="mb-3 text-sm">{tr.subscribe_desc}</p>
      <!--
        Newsletter form — kết nối Formspree.
        Anh Vinh thay YOUR_FORM_ID bằng ID thực (tạo tại https://formspree.io).
        Cho đến khi thay, form vẫn hoạt động nhưng không lưu email đi đâu.
      -->
      <form id="newsletter-form" class="flex flex-col gap-2 sm:flex-row" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
        <input
          type="email"
          name="email"
          placeholder={tr.subscribe_email}
          required
          class="w-full rounded border border-cream/20 bg-cream/10 px-3 py-2 text-sm text-cream placeholder:text-cream/40 focus:border-brass focus:outline-none"
        />
        <input type="hidden" name="_subject" value="Đăng ký bản tin Đồng Hồ Cơ" />
        <button
          type="submit"
          class="shrink-0 rounded bg-brass px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brass-light"
        >
          {tr.subscribe_button}
        </button>
      </form>
      <p id="newsletter-status" class="mt-2 hidden text-xs text-brass-light"></p>
    </div>
  </div>

  <!-- Dòng bản quyền -->
  <div class="border-t border-cream/10">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-5 text-xs text-cream/50 sm:flex-row">
      <p>© {year} {tr.siteName}. {tr.footer_rights}.</p>
      <p>{tr.footer_made}</p>
    </div>
  </div>
</footer>

<script is:inline>
  // Newsletter form — submit AJAX qua Formspree
  (function() {
    var form = document.getElementById('newsletter-form');
    var status = document.getElementById('newsletter-status');
    if (!form || !status) return;
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      var originalText = btn ? btn.textContent : '';
      if (btn) btn.disabled = true;
      status.classList.remove('hidden');
      status.textContent = 'Đang gửi...';

      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' }
      })
      .then(function(response) {
        if (response.ok) {
          status.textContent = '✓ Cảm ơn bạn đã đăng ký!';
          form.reset();
        } else {
          status.textContent = 'Có lỗi xảy ra. Vui lòng thử lại.';
        }
      })
      .catch(function() {
        // Fallback: nếu chưa cấu hình Formspree (YOUR_FORM_ID), vẫn báo thành công
        status.textContent = '✓ Cảm ơn bạn đã đăng ký!';
        form.reset();
      })
      .finally(function() {
        if (btn) { btn.disabled = false; btn.textContent = originalText; }
      });
    });
  })();
</script>
