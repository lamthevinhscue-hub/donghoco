---
// =============================================================================
// HEADER (Thanh menu trên cùng)
// =============================================================================
// Logo + menu điều hướng. Menu máy tính có 2 mục xổ (Kiến thức, Khám phá).
// Trên điện thoại, menu hamburger mở ra 2 cụm có tiêu đề nhỏ (không xổ).
// Mục xổ: mở khi rê chuột (desktop) / chạm (mobile), đóng khi bấm ra ngoài,
// dùng được bằng bàn phím (Tab + Enter).
// =============================================================================

import { getLangFromUrl, t, localizedPath } from '../i18n/ui';
import SearchBox from './SearchBox.astro';
import ThemeToggle from './ThemeToggle.astro';

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);

// Mục menu cấp 1 (link đơn)
const topItems = [
  { key: 'nav_brands', path: '/thuong-hieu' },
  { key: 'nav_iconic', path: '/mau-iconic' },
];

// Nhóm "Kiến thức" — mục xổ
const knowledgeGroup = {
  key: 'nav_knowledge',
  items: [
    { key: 'nav_mechanisms', path: '/co-che' },
    { key: 'nav_glossary', path: '/tu-dien' },
    { key: 'nav_guides', path: '/huong-dan' },
  ],
};

// Nhóm "Khám phá" — mục xổ
const exploreGroup = {
  key: 'nav_explore',
  items: [
    { key: 'nav_history', path: '/lich-su' },
    { key: 'nav_anatomy', path: '/giai-phau' },
    { key: 'nav_compare', path: '/so-sanh' },
  ],
};
---

<header class="sticky top-0 z-50 border-b border-cream-dark bg-cream/95 backdrop-blur dark:border-dark-border dark:bg-dark-bg/95">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <!-- Logo / Tên website (đảm nhiệm việc về trang chủ) -->
    <a href={localizedPath('/', lang)} class="flex items-baseline gap-2">
      <span class="font-serif text-2xl font-bold text-navy dark:text-dark-text">{tr.siteName}</span>
    </a>

    <!-- Menu (máy tính) -->
    <nav class="hidden items-center gap-6 md:flex">
      <!-- Nút Trang chủ (biểu tượng nhà) -->
      <a
        href={localizedPath('/', lang)}
        class="text-ink-soft transition-colors hover:text-brass dark:text-dark-text-soft dark:hover:text-dark-brass"
        aria-label={tr.nav_home}
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V10" />
        </svg>
      </a>
      {topItems.map((item) => (
        <a
          href={localizedPath(item.path, lang)}
          class="text-sm font-medium text-ink-soft transition-colors hover:text-brass dark:text-dark-text-soft dark:hover:text-dark-brass"
        >
          {tr[item.key]}
        </a>
      ))}

      <!-- Mục xổ: Kiến thức -->
      <div class="nav-dropdown relative">
        <button
          type="button"
          class="flex items-center gap-1 text-sm font-medium text-ink-soft transition-colors hover:text-brass dark:text-dark-text-soft dark:hover:text-dark-brass"
          aria-expanded="false"
          aria-haspopup="true"
          data-dropdown-toggle
        >
          {tr[knowledgeGroup.key]}
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div class="nav-dropdown-menu invisible absolute left-0 top-full z-50 min-w-[180px] translate-y-1 rounded-lg border border-cream-dark bg-white py-2 opacity-0 shadow-lg transition-all duration-150 dark:border-dark-border dark:bg-dark-surface">
          {knowledgeGroup.items.map((item) => (
            <a
              href={localizedPath(item.path, lang)}
              class="block px-4 py-2 text-sm text-ink-soft transition-colors hover:bg-cream-dark/50 hover:text-brass dark:text-dark-text-soft dark:hover:bg-dark-border/30 dark:hover:text-dark-brass"
            >
              {tr[item.key]}
            </a>
          ))}
        </div>
      </div>

      <!-- Mục xổ: Khám phá -->
      <div class="nav-dropdown relative">
        <button
          type="button"
          class="flex items-center gap-1 text-sm font-medium text-ink-soft transition-colors hover:text-brass dark:text-dark-text-soft dark:hover:text-dark-brass"
          aria-expanded="false"
          aria-haspopup="true"
          data-dropdown-toggle
        >
          {tr[exploreGroup.key]}
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div class="nav-dropdown-menu invisible absolute left-0 top-full z-50 min-w-[180px] translate-y-1 rounded-lg border border-cream-dark bg-white py-2 opacity-0 shadow-lg transition-all duration-150 dark:border-dark-border dark:bg-dark-surface">
          {exploreGroup.items.map((item) => (
            <a
              href={localizedPath(item.path, lang)}
              class="block px-4 py-2 text-sm text-ink-soft transition-colors hover:bg-cream-dark/50 hover:text-brass dark:text-dark-text-soft dark:hover:bg-dark-border/30 dark:hover:text-dark-brass"
            >
              {tr[item.key]}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <!-- Nút mở menu (điện thoại) + tìm kiếm + dark mode -->
    <div class="flex items-center gap-3">
      <SearchBox />
      <ThemeToggle />
      <button
        type="button"
        id="menu-toggle"
        class="md:hidden"
        aria-label="Mở menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-navy dark:text-dark-text">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu đổ xuống (điện thoại) — hai cụm có tiêu đề nhỏ, không xổ -->
  <nav id="mobile-menu" class="hidden border-t border-cream-dark bg-cream md:hidden dark:border-dark-border dark:bg-dark-bg">
    <div class="mx-auto max-h-[70vh] max-w-6xl overflow-y-auto px-4 py-2">
      {/* Mục cấp 1 */}
      <a
        href={localizedPath('/', lang)}
        class="flex items-center gap-2 border-b border-cream-dark/60 py-3 text-sm font-medium text-ink-soft dark:border-dark-border/60 dark:text-dark-text-soft"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V10" />
        </svg>
        {tr.nav_home}
      </a>
      {topItems.map((item) => (
        <a
          href={localizedPath(item.path, lang)}
          class="block border-b border-cream-dark/60 py-3 text-sm font-medium text-ink-soft dark:border-dark-border/60 dark:text-dark-text-soft"
        >
          {tr[item.key]}
        </a>
      ))}

      {/* Cụm Kiến thức */}
      <p class="mt-4 mb-1 px-0 text-xs font-semibold uppercase tracking-wider text-brass dark:text-dark-brass">{tr[knowledgeGroup.key]}</p>
      {knowledgeGroup.items.map((item) => (
        <a
          href={localizedPath(item.path, lang)}
          class="block border-b border-cream-dark/60 py-3 pl-3 text-sm text-ink-soft dark:border-dark-border/60 dark:text-dark-text-soft"
        >
          {tr[item.key]}
        </a>
      ))}

      {/* Cụm Khám phá */}
      <p class="mt-4 mb-1 text-xs font-semibold uppercase tracking-wider text-brass dark:text-dark-brass">{tr[exploreGroup.key]}</p>
      {exploreGroup.items.map((item) => (
        <a
          href={localizedPath(item.path, lang)}
          class="block border-b border-cream-dark/60 py-3 pl-3 text-sm text-ink-soft last:border-0 dark:border-dark-border/60 dark:text-dark-text-soft"
        >
          {tr[item.key]}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  // ====== Menu điện thoại: bật/tắt ======
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  // ====== Mục xổ desktop: hover + focus + click-để-giữ + đóng khi bấm ra ngoài ======
  const dropdowns = document.querySelectorAll<HTMLElement>('.nav-dropdown');
  const dropdownMenus = document.querySelectorAll<HTMLElement>('.nav-dropdown-menu');

  function openMenu(dd: HTMLElement) {
    const m = dd.querySelector<HTMLElement>('.nav-dropdown-menu');
    const btn = dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    if (!m || !btn) return;
    m.classList.remove('invisible', 'opacity-0', 'translate-y-1');
    btn.setAttribute('aria-expanded', 'true');
  }
  function closeMenu(dd: HTMLElement) {
    const m = dd.querySelector<HTMLElement>('.nav-dropdown-menu');
    const btn = dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    if (!m || !btn) return;
    m.classList.add('invisible', 'opacity-0', 'translate-y-1');
    btn.setAttribute('aria-expanded', 'false');
  }

  dropdowns.forEach((dd) => {
    // Hover mở/đóng (desktop)
    dd.addEventListener('mouseenter', () => openMenu(dd));
    dd.addEventListener('mouseleave', () => closeMenu(dd));

    // Bàn phím: nút toggle — Enter/Space mở, ESC đóng
    const btn = dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    btn?.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      // đóng mọi menu khác trước
      dropdowns.forEach((other) => { if (other !== dd) closeMenu(other); });
      if (isOpen) { closeMenu(dd); } else { openMenu(dd); btn.focus(); }
    });
    // Tab vào link trong menu → giữ mở; khi focus rời khỏi cả dropdown → đóng
    dd.addEventListener('focusin', () => openMenu(dd));
    dd.addEventListener('focusout', (e) => {
      // chỉ đóng nếu focus thực sự rời khỏi dropdown (không phải chuyển giữa con bên trong)
      if (!dd.contains(e.relatedTarget as Node)) closeMenu(dd);
    });
  });

  // Đóng khi bấm ra ngoài
  document.addEventListener('click', (e) => {
    dropdowns.forEach((dd) => {
      if (!dd.contains(e.target as Node)) closeMenu(dd);
    });
  });
  // ESC đóng tất cả
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') dropdowns.forEach((dd) => closeMenu(dd));
  });
</script>
