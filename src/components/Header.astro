---
// =============================================================================
// HEADER (Thanh menu trên cùng)
// =============================================================================
// Logo + menu điều hướng. Menu máy tính có 2 mục xổ (Kiến thức, Khám phá),
// hiển thị từ lg (1024px) — dưới ngưỡng này dùng menu hamburger để logo và
// các nút chức năng không bị co/đè nhau ở màn hình tablet.
// Mục xổ: mở khi rê chuột (desktop) / chạm (mobile), đóng khi bấm ra ngoài,
// dùng được bằng bàn phím (Tab + Enter).
// Bộ chuyển ngôn ngữ: trang đã dịch → đi thẳng; trang chưa dịch → mở hộp
// thoại nhỏ cho người đọc chọn ở lại hoặc tới trang chủ ngôn ngữ đích (D2).
// =============================================================================

import { getLangFromUrl, t, localizedPath } from '../i18n/ui';
import { localizedHref, switcherTarget } from '../i18n/contentRoutes';
import SearchBox from './SearchBox.astro';
import SearchInline from './SearchInline.astro';
import ThemeToggle from './ThemeToggle.astro';

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);

// Mục menu cấp 1 (link đơn) — key gắn với khóa bản dịch trong i18n/ui
type MenuKey = keyof ReturnType<typeof t>;
interface MenuItem {
  key: MenuKey;
  path: string;
}
const topItems: MenuItem[] = [
  { key: 'nav_brands', path: '/thuong-hieu' },
  { key: 'nav_iconic', path: '/mau-iconic' },
];

// Nhóm "Kiến thức" — mục xổ
const knowledgeGroup = {
  key: 'nav_knowledge' as const,
  items: [
    { key: 'nav_learning_path', path: '/lo-trinh-hoc-dong-ho' },
    { key: 'nav_mechanisms', path: '/co-che' },
    { key: 'nav_glossary', path: '/tu-dien' },
    { key: 'nav_guides', path: '/huong-dan' },
  ] as MenuItem[],
};

// Nhóm "Khám phá" — mục xổ
const exploreGroup = {
  key: 'nav_explore' as const,
  items: [
    { key: 'nav_history', path: '/lich-su' },
    { key: 'nav_anatomy', path: '/giai-phau' },
    { key: 'nav_compare', path: '/so-sanh' },
  ] as MenuItem[],
};

// Chuẩn hóa đường dẫn: bỏ mọi slash cuối, riêng "/" đứng một mình giữ nguyên.
// Dùng chung cho pathname hiện tại và từng mục menu để so khớp theo ranh giới
// segment — tránh khớp tiền tố gần giống (/english không phải khu vực /en).
const normalize = (p: string): string => {
  const n = p.replace(/\/+$/, '');
  return n === '' ? '/' : n;
};
const currentPath = normalize(Astro.url.pathname);

/**
 * Mức khớp của một mục menu với trang hiện tại:
 *   'page'     — link đúng trang đang xem        → aria-current="page"
 *   'location' — link là mục danh sách cha chứa trang đang xem → aria-current="location"
 * So khớp theo ranh giới segment (chính xác hoặc target + "/").
 */
function matchState(itemPath: string): 'page' | 'location' | null {
  const target = normalize(itemPath);
  if (target === currentPath) return 'page';
  if (currentPath.startsWith(target + '/')) return 'location';
  return null;
}

// Địa chỉ thật của từng mục trong ngôn ngữ hiện tại. Kiến thức/Thương hiệu chỉ
// hiện mục CÓ bản dịch (bảng trung tâm contentRoutes.ts) — không tạo link chết.
const withHref = (item: MenuItem) => ({ ...item, href: localizedHref(item.path, lang) });
const topNav = topItems.map(withHref).filter((i): i is MenuItem & { href: string } => Boolean(i.href));
const knowledgeNav = knowledgeGroup.items.map(withHref).filter((i): i is MenuItem & { href: string } => Boolean(i.href));

// Nhóm "Khám phá" theo phương án D2: mục chưa dịch vẫn HIỆN trên menu ngôn ngữ
// đó, trỏ thẳng route tiếng Việt kèm nhãn hiển thị "Vietnamese only" — KHÔNG
// thêm vào bảng cặp dịch, không sinh hreflang giả, không đổi nội dung trang.
const exploreNav = exploreGroup.items.map((item) => {
  const href = localizedHref(item.path, lang);
  return { ...item, href: href ?? item.path, viOnly: !href };
});

// Bộ chuyển ngôn ngữ: trang hiện tại có bản dịch thì tới đúng trang đó (link
// dẫn thẳng); chưa có thì mở hộp thoại giải thích và cho chọn ở lại hoặc tới
// trang chủ ngôn ngữ đích — aria-label vẫn nói rõ điều đó cho trình đọc màn hình.
const sw = switcherTarget(Astro.url.pathname);
const switcherLabel = sw.translated
  ? tr.switch_lang
  : tr.switch_lang_untranslated;

// Trang chủ: chỉ active khi đúng TRANG CHỦ của ngôn ngữ hiện tại. Không dùng
// matchState vì "/" là tiền tố của mọi đường dẫn — bug cũ làm Home mang gạch
// active trên mọi trang. Home VI active tại "/"; Home EN tại "/en" và "/en/".
// Link trang chủ đi qua bảng cặp (localizedHref) để EN nhận "/en/" — route thật,
// không phải "/en" không có slash cuối (localizedPath sinh ra).
const homeHref = localizedHref('/', lang) ?? localizedPath('/', lang);
const isHome = normalize(homeHref) === currentPath;

// Trạng thái active: gạch chân brass + màu (không chỉ dựa vào màu).
// 'page' đậm hơn 'location' một nấc chữ — phân biệt thị giác trang đúng/khu vực.
const activeLink = 'text-brass dark:text-dark-brass border-b-2 border-brass dark:border-dark-brass';
const topItemClass = (st: 'page' | 'location' | null): string =>
  st
    ? `${activeLink} ${st === 'page' ? 'font-semibold' : 'font-medium'}`
    : 'border-transparent font-medium text-ink-soft';
const dropItemClass = (st: 'page' | 'location' | null): string =>
  st
    ? `text-brass dark:text-dark-brass underline decoration-2 underline-offset-4 ${st === 'page' ? 'font-semibold' : ''}`
    : 'text-ink-soft';
const mobileItemClass = (st: 'page' | 'location' | null): string =>
  st
    ? `font-semibold text-brass dark:text-dark-brass underline decoration-2 underline-offset-[6px]`
    : 'text-ink-soft dark:text-dark-text-soft';
// Nhóm menu cha active khi đang xem bất kỳ trang con nào trong nhóm — CHỈ đổi
// màu chữ, KHÔNG gạch (vai trò "đang chọn" thuộc về link trang con bên trong).
const knowledgeActive = knowledgeNav.some((i) => matchState(i.href) !== null);
const exploreActive = exploreNav.some((i) => !i.viOnly && matchState(i.href) !== null);
---

<header data-pagefind-ignore class="sticky top-0 z-50 border-b border-cream-dark bg-cream/95 backdrop-blur dark:border-dark-border dark:bg-dark-bg/95">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-4 max-[339px]:px-2">
    <!-- Logo / Tên website (đảm nhiệm việc về trang chủ).
         min-w-0 + flex-1: logo chiếm phần trống còn lại. Tên EN có từ dài
         ("Mechanical") — dưới 340px hạ xuống text-xs và nới padding để từ dài
         nhất vừa trong vùng logo: không tràn đè nút, không cắt, không ellipsis. -->
    <a href={homeHref} class="flex min-w-0 flex-1 items-baseline gap-2" aria-label={tr.siteName}>
      <span class={`min-w-0 font-serif font-bold leading-tight text-navy dark:text-dark-text ${lang === 'en' ? 'text-base max-[339px]:text-xs' : 'text-base'} sm:text-xl`}>{tr.siteName}</span>
    </a>

    <!-- Menu (máy tính) — từ lg (1024px); tablet dùng menu hamburger -->
    <nav aria-label={tr.nav_primary} class="hidden items-center gap-6 lg:flex">
      <!-- Nút Trang chủ (biểu tượng nhà) — vùng bấm 44px qua py-3 -->
      <a
        href={homeHref}
        class={`inline-flex items-center px-1 py-3 transition-colors hover:text-brass dark:text-dark-text-soft dark:hover:text-dark-brass ${isHome ? activeLink + ' font-semibold' : 'text-ink-soft'}`}
        aria-label={tr.nav_home}
        aria-current={isHome ? 'page' : undefined}
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V10" />
        </svg>
      </a>
      {topNav.map((item) => {
        const st = matchState(item.href);
        return (
          <a
            href={item.href}
            class={`inline-flex items-center border-b-2 py-3 text-sm transition-colors hover:text-brass dark:text-dark-text-soft dark:hover:text-dark-brass ${topItemClass(st)}`}
            aria-current={st ?? undefined}
          >
            {tr[item.key]}
          </a>
        );
      })}

      <!-- Mục xổ: Kiến thức — vùng bấm 44px, hover/focus/:active rõ.
           Nút nhóm CHỈ đổi màu khi nhóm active — không gạch, không aria-current. -->
      <div class="nav-dropdown relative">
        <button
          type="button"
          class={`flex min-h-11 items-center gap-1 border-b-2 border-transparent px-1 text-sm font-medium transition-colors hover:text-brass focus-visible:text-brass active:opacity-80 dark:hover:text-dark-brass dark:focus-visible:text-dark-brass ${knowledgeActive ? 'text-brass dark:text-dark-brass' : 'text-ink-soft dark:text-dark-text-soft'}`}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="nav-dropdown-knowledge"
          data-dropdown-toggle
        >
          {tr[knowledgeGroup.key]}
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div id="nav-dropdown-knowledge" class="nav-dropdown-menu invisible absolute left-0 top-full z-50 min-w-[180px] translate-y-1 rounded-lg border border-cream-dark bg-white py-2 opacity-0 shadow-lg transition-all duration-150 dark:border-dark-border dark:bg-dark-surface">
          {knowledgeNav.map((item) => {
            const st = matchState(item.href);
            return (
              <a
                href={item.href}
                class={`flex items-center px-4 py-2.5 text-sm transition-colors hover:bg-cream-dark/50 hover:text-brass dark:text-dark-text-soft dark:hover:bg-dark-border/30 dark:hover:text-dark-brass ${dropItemClass(st)}`}
                aria-current={st ?? undefined}
              >
                {tr[item.key]}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Mục xổ: Khám phá — VI đủ bản dịch; EN hiện 3 mục tiếng Việt kèm nhãn "Vietnamese only" (D2) -->
      <div class="nav-dropdown relative">
        <button
          type="button"
          class={`flex min-h-11 items-center gap-1 border-b-2 border-transparent px-1 text-sm font-medium transition-colors hover:text-brass focus-visible:text-brass active:opacity-80 dark:hover:text-dark-brass dark:focus-visible:text-dark-brass ${exploreActive ? 'text-brass dark:text-dark-brass' : 'text-ink-soft dark:text-dark-text-soft'}`}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="nav-dropdown-explore"
          data-dropdown-toggle
        >
          {tr[exploreGroup.key]}
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div id="nav-dropdown-explore" class="nav-dropdown-menu invisible absolute left-0 top-full z-50 min-w-[230px] translate-y-1 rounded-lg border border-cream-dark bg-white py-2 opacity-0 shadow-lg transition-all duration-150 dark:border-dark-border dark:bg-dark-surface">
          {exploreNav.map((item) => {
            const st = item.viOnly ? null : matchState(item.href);
            return (
              <a
                href={item.href}
                hreflang={item.viOnly ? 'vi' : undefined}
                class={`flex items-center justify-between gap-3 px-4 py-2.5 text-sm transition-colors hover:bg-cream-dark/50 hover:text-brass dark:text-dark-text-soft dark:hover:bg-dark-border/30 dark:hover:text-dark-brass ${dropItemClass(st)}`}
                aria-current={st ?? undefined}
              >
                <span>{tr[item.key]}</span>
                {item.viOnly && (
                  <span class="rounded-full border border-alloy/60 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-alloy dark:text-dark-brass">{tr.nav_vi_only}</span>
                )}
              </a>
            );
          })}
        </div>
      </div>
    </nav>

    <!-- Ô tìm kiếm trực tiếp (desktop từ 1024px) + nút mở dialog (dưới 1024px) + ngôn ngữ + dark mode.
         Cả hai đổi chế độ theo CÙNG breakpoint lg của menu — không cùng chiếm chỗ, không cùng biến mất.
         shrink-0: cụm nút không bị flex co nhỏ dưới 44px ở màn hình hẹp; logo bên trái là bên co. -->
    <div class="flex shrink-0 items-center gap-3 max-[480px]:gap-2">
      <SearchInline inputId="header-search-input" variant="header" />
      <SearchBox />
      <!-- Bộ chuyển ngôn ngữ: link thật (không-JS vẫn đi được). Trang chưa có bản
           dịch thì data-lang-switch báo cho client script chặn mở hộp thoại lựa chọn
           — không rời trang trước khi người đọc chọn. Dưới 480px hiện nhãn rút gọn
           (EN/VI) để vừa 320px; aria-label vẫn nêu đầy đủ đích chuyển ngôn ngữ. -->
      <a
        href={sw.href}
        data-pagefind-ignore
        {...(!sw.translated ? { 'data-lang-switch': 'untranslated' } : {})}
        class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-full border border-cream-dark px-3 py-1.5 text-xs font-medium text-ink-soft transition-colors hover:border-brass hover:text-brass focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brass dark:border-dark-border dark:text-dark-text-soft dark:hover:text-dark-brass"
        aria-label={switcherLabel}
        hreflang={lang === 'vi' ? 'en' : 'vi'}
      >
        <span class="hidden min-[480px]:inline">{tr.switch_lang}</span>
        <span aria-hidden="true" class="inline min-[480px]:hidden">{lang === 'vi' ? 'EN' : 'VI'}</span>
      </a>
      <ThemeToggle />
      <button
        type="button"
        id="menu-toggle"
        data-label-open={tr.menu_open}
        data-label-close={tr.menu_close}
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md lg:hidden"
        aria-label={tr.menu_open}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-navy dark:text-dark-text" aria-hidden="true" focusable="false">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Không-JS: trang chưa dịch — giải thích rõ hành động của liên kết chuyển
       ngôn ngữ. Bản thân liên kết là liên kết thật nên người đọc vẫn tới được
       trang chủ ngôn ngữ đích. (Comment này KHÔNG chứa chuỗi thẻ anchor — Astro
       giữ comment trong HTML xuất bản và bộ kiểm EN quét văn bản hiển thị.) -->
  {!sw.translated && (
    <noscript>
      <p class="border-t border-cream-dark/60 px-4 py-2 text-xs leading-relaxed text-ink-soft dark:border-dark-border/60 dark:text-dark-text-soft">
        {tr.lang_noscript_note}
      </p>
    </noscript>
  )}

  <!-- Menu đổ xuống (máy tính bảng + điện thoại, dưới lg) — hai cụm có tiêu đề nhỏ, không xổ -->
  <nav id="mobile-menu" aria-label={tr.nav_primary} class="hidden border-t border-cream-dark bg-cream lg:hidden dark:border-dark-border dark:bg-dark-bg">
    <div class="mx-auto max-h-[70vh] max-w-6xl overflow-y-auto px-4 py-2">
      {/* Mục cấp 1 */}
      <a
        href={homeHref}
        class={`flex items-center gap-2 border-b border-cream-dark/60 py-3 text-sm transition-colors dark:border-dark-border/60 ${mobileItemClass(isHome ? 'page' : null)}`}
        aria-current={isHome ? 'page' : undefined}
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V10" />
        </svg>
        {tr.nav_home}
      </a>
      {topNav.map((item) => {
        const st = matchState(item.href);
        return (
          <a
            href={item.href}
            class={`block border-b border-cream-dark/60 py-3 text-sm transition-colors dark:border-dark-border/60 ${mobileItemClass(st)}`}
            aria-current={st ?? undefined}
          >
            {tr[item.key]}
          </a>
        );
      })}

      {/* Cụm Kiến thức */}
      <p class="mt-4 mb-1 px-0 text-xs font-semibold uppercase tracking-wider text-brass dark:text-dark-brass">{tr[knowledgeGroup.key]}</p>
      {knowledgeNav.map((item) => {
        const st = matchState(item.href);
        return (
          <a
            href={item.href}
            class={`block border-b border-cream-dark/60 py-3 pl-3 text-sm transition-colors dark:border-dark-border/60 ${mobileItemClass(st)}`}
            aria-current={st ?? undefined}
          >
            {tr[item.key]}
          </a>
        );
      })}

      {/* Cụm Khám phá — EN: 3 mục tiếng Việt kèm nhãn "Vietnamese only" (D2) */}
      <>
        <p class="mt-4 mb-1 px-0 text-xs font-semibold uppercase tracking-wider text-brass dark:text-dark-brass">{tr[exploreGroup.key]}</p>
        {exploreNav.map((item) => {
          const st = item.viOnly ? null : matchState(item.href);
          return (
            <a
              href={item.href}
              hreflang={item.viOnly ? 'vi' : undefined}
              class={`flex items-center justify-between gap-3 border-b border-cream-dark/60 py-3 pl-3 pr-1 text-sm transition-colors dark:border-dark-border/60 ${mobileItemClass(st)}`}
              aria-current={st ?? undefined}
            >
              <span>{tr[item.key]}</span>
              {item.viOnly && (
                <span class="rounded-full border border-alloy/60 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-alloy dark:text-dark-brass">{tr.nav_vi_only}</span>
              )}
            </a>
          );
        })}
      </>

      {/* Bộ chuyển ngôn ngữ — mục cuối của menu mobile */}
      <a
        href={sw.href}
        data-pagefind-ignore
        {...(!sw.translated ? { 'data-lang-switch': 'untranslated' } : {})}
        class="mt-4 flex min-h-11 items-center gap-2 rounded-lg border border-cream-dark px-3 py-2 text-sm font-medium text-ink-soft transition-colors hover:border-brass hover:text-brass dark:border-dark-border dark:text-dark-text-soft dark:hover:text-dark-brass"
        aria-label={switcherLabel}
        hreflang={lang === 'vi' ? 'en' : 'vi'}
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path stroke-linecap="round" d="M3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 000 18M12 3a15 15 0 010 18" />
        </svg>
        {tr.switch_lang}
      </a>
    </div>
  </nav>

  <!-- Hộp thoại nhỏ: trang chưa có bản dịch (D2) — chọn ở lại hoặc tới trang
       chủ ngôn ngữ đích. Chỉ mở bằng JS khi bấm bộ chuyển ngôn ngữ; bản thân
       liên kết chuyển ngôn ngữ là liên kết thật nên không-JS vẫn đi được. -->
  <div
    id="lang-panel"
    data-pagefind-ignore
    role="dialog"
    aria-modal="true"
    aria-labelledby="lang-panel-title"
    class="fixed inset-0 z-[110] hidden bg-navy/50"
  >
    <div class="mx-auto mt-[28vh] max-w-sm px-4">
      <div class="rounded-lg border border-cream-dark bg-white p-5 shadow-2xl dark:border-dark-border dark:bg-dark-surface">
        <h2 id="lang-panel-title" class="font-serif text-lg font-semibold text-navy dark:text-dark-text">{tr.lang_panel_title}</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">{tr.lang_panel_desc}</p>
        <div class="mt-4 flex flex-col gap-2">
          <button
            type="button"
            id="lang-panel-stay"
            class="inline-flex min-h-11 items-center justify-center rounded-lg bg-navy px-4 text-sm font-medium text-cream transition-colors hover:bg-steel dark:bg-cream dark:text-navy dark:hover:bg-brass"
          >
            {tr.lang_panel_stay}
          </button>
          <a
            id="lang-panel-go"
            href={sw.href}
            hreflang={lang === 'vi' ? 'en' : 'vi'}
            class="inline-flex min-h-11 items-center justify-center rounded-lg border border-cream-dark px-4 text-sm font-medium text-ink-soft transition-colors hover:border-brass hover:text-brass dark:border-dark-border dark:text-dark-text-soft dark:hover:text-dark-brass"
          >
            {tr.lang_panel_go_home}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // ====== Menu điện thoại: bật/tắt ======
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  // Đổi trạng thái menu mobile — aria-label đi cùng aria-expanded để
  // trình đọc màn hình nói đúng thao tác tiếp theo ("Đóng" khi đang mở).
  // Nhãn lấy từ data-attrs (đã dịch i18n) vì client script không đọc được biến Astro.
  function setMobileMenu(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    const label = toggle?.getAttribute(open ? 'data-label-close' : 'data-label-open');
    if (label) toggle?.setAttribute('aria-label', label);
    if (open) {
      // Mở bằng Enter/Space (sinh click) — đưa focus vào link đầu của menu
      setTimeout(() => menu?.querySelector('a')?.focus(), 0);
    }
  }

  toggle?.addEventListener('click', () => {
    setMobileMenu(menu?.classList.contains('hidden') ?? false);
  });

  // Chọn link trong menu mobile → đóng menu tự nhiên, trình duyệt chuyển trang
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setMobileMenu(false));
  });

  // ====== Mục xổ desktop: hover + focus + click-để-giữ + đóng khi bấm ra ngoài ======
  const dropdowns = document.querySelectorAll<HTMLElement>('.nav-dropdown');

  function openMenu(dd: HTMLElement) {
    const m = dd.querySelector<HTMLElement>('.nav-dropdown-menu');
    const btn = dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    if (!m || !btn) return;
    m.classList.remove('invisible', 'opacity-0', 'translate-y-1');
    btn.setAttribute('aria-expanded', 'true');
  }
  function closeMenu(dd: HTMLElement) {
    const m = dd.querySelector<HTMLElement>('.nav-dropdown-menu');
    const btn = dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    if (!m || !btn) return;
    m.classList.add('invisible', 'opacity-0', 'translate-y-1');
    btn.setAttribute('aria-expanded', 'false');
    delete dd.dataset.userOpen;
  }

  // Focus vào link ngay khi menu vừa MỞ: visibility đang transition (150ms)
  // nên link tạm thời chưa focusable — hoãn một nhịp rồi focus.
  function focusDropdownLink(link: HTMLAnchorElement | null) {
    if (!link) return;
    setTimeout(() => link.focus(), 170);
  }

  dropdowns.forEach((dd) => {
    // Hover mở/đóng (desktop)
    dd.addEventListener('mouseenter', () => openMenu(dd));
    dd.addEventListener('mouseleave', () => closeMenu(dd));

    // Bàn phím: nút toggle — Enter/Space mở, ESC đóng
    const btn = dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    // Kích hoạt dropdown (dùng chung cho click chuột và Enter/Space):
    // mở menu + đưa focus vào link đầu khi kích hoạt bằng BÀN PHÍM.
    // Chỉ coi là "đang mở" khi chính nút đã mở (hover/focusin cũng mở menu
    // nhưng không tính — nếu không Enter sẽ đóng ngay menu do focusin vừa mở).
    const activateDropdown = (fromKeyboard: boolean) => {
      const wasUserOpen = dd.dataset.userOpen === '1';
      dropdowns.forEach((other) => closeMenu(other)); // đóng mọi menu khác
      if (wasUserOpen) {
        closeMenu(dd);
      } else {
        openMenu(dd);
        dd.dataset.userOpen = '1';
        if (fromKeyboard) focusDropdownLink(dd.querySelector('a'));
      }
    };

    btn?.addEventListener('click', (e) => {
      // Enter/Space sinh click detail=0 → đã xử lý ở keydown (preventDefault
      // chặn click này); chỉ click chuột (detail>=1) đi vào đây
      if (e.detail === 0) return;
      activateDropdown(false);
    });
    btn?.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault(); // tự xử lý — không để trình duyệt sinh click trùng
      activateDropdown(true);
    });
    // Bàn phím trong dropdown: mũi tên + Home/End di chuyển giữa các link.
    // Tab/Shift+Tab giữ hành vi tự nhiên của trình duyệt — KHÔNG trap focus.
    dd.addEventListener('keydown', (e) => {
      const links = Array.from(dd.querySelectorAll<HTMLAnchorElement>('a'));
      if (links.length === 0) return;
      const onBtn = e.target === btn;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        openMenu(dd);
        // Từ nút mở: Down → link đầu, Up → link cuối; trong menu: di chuyển từng bước
        const idx = links.indexOf(document.activeElement as HTMLAnchorElement);
        if (onBtn || idx === -1) {
          focusDropdownLink(e.key === 'ArrowDown' ? links[0] : links[links.length - 1]);
        } else if (e.key === 'ArrowDown' && idx < links.length - 1) {
          links[idx + 1].focus();
        } else if (e.key === 'ArrowUp' && idx > 0) {
          links[idx - 1].focus();
        } else {
          (e.key === 'ArrowDown' ? links[links.length - 1] : links[0]).focus();
        }
      } else if (e.key === 'Home' && !onBtn) {
        e.preventDefault();
        links[0].focus();
      } else if (e.key === 'End' && !onBtn) {
        e.preventDefault();
        links[links.length - 1].focus();
      }
    });
    // Tab vào link trong menu → giữ mở; khi focus rời khỏi cả dropdown → đóng.
    // Bỏ qua focus vào CHÍNH NÚT: nếu không, Escape đóng xong trả focus về nút
    // sẽ kích focusin và mở menu lại ngay lập tức.
    dd.addEventListener('focusin', (e) => {
      if (e.target !== btn) openMenu(dd);
    });
    dd.addEventListener('focusout', (e) => {
      // chỉ đóng nếu focus thực sự rời khỏi dropdown (không phải chuyển giữa con bên trong)
      if (!dd.contains(e.relatedTarget as Node)) closeMenu(dd);
    });
  });

  // Đóng khi bấm ra ngoài
  document.addEventListener('click', (e) => {
    dropdowns.forEach((dd) => {
      if (!dd.contains(e.target as Node)) closeMenu(dd);
    });
  });
  // ESC đóng tất cả — dropdown trả focus về đúng nút đã mở để bàn phím không bị "lạc"
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      dropdowns.forEach((dd) => {
        const btn = dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
        const wasOpen = btn?.getAttribute('aria-expanded') === 'true';
        closeMenu(dd);
        if (wasOpen && btn) btn.focus();
      });
      // Menu mobile: đóng và trả focus về nút hamburger
      if (menu && !menu.classList.contains('hidden')) {
        setMobileMenu(false);
        toggle?.focus();
      }
    }
  });

  // ====== Hộp thoại "trang chưa có bản dịch" (D2) ======
  // Bấm bộ chuyển ngôn ngữ trên trang chưa dịch → mở hộp chọn Ở lại / Tới trang
  // chủ đích — không rời trang trước khi người đọc chọn rõ ràng.
  const langPanel = document.getElementById('lang-panel');
  let langPanelOpener: HTMLElement | null = null;

  function openLangPanel(opener: HTMLElement) {
    if (!langPanel || langPanel.classList.contains('hidden') === false) return;
    // Menu mobile đang mở thì đóng trước — tránh hai lớp tương tác cùng mở.
    if (menu && !menu.classList.contains('hidden')) setMobileMenu(false);
    langPanelOpener = opener;
    langPanel.classList.remove('hidden');
    document.getElementById('lang-panel-stay')?.focus();
  }
  function closeLangPanel() {
    if (!langPanel || langPanel.classList.contains('hidden')) return;
    langPanel.classList.add('hidden');
    // Trả focus về đúng nút đã mở hộp
    langPanelOpener?.focus();
    langPanelOpener = null;
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      openLangPanel(a);
    });
  });
  document.getElementById('lang-panel-stay')?.addEventListener('click', closeLangPanel);
  langPanel?.addEventListener('click', (e) => {
    if (e.target === langPanel) closeLangPanel(); // bấm nền mờ = đóng
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLangPanel();
  });
  // Tab trong hộp: chỉ 2 điều khiển — giữ focus xoay vòng bên trong hộp.
  langPanel?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusables = Array.from(
      langPanel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
    );
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement;
    if (e.shiftKey && (active === first || !langPanel.contains(active))) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && (active === last || !langPanel.contains(active))) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
