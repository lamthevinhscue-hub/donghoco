---
// =============================================================================
// MODEL EVOLUTION — sơ đồ tiến hóa mẫu iconic (tổng quát, dùng chung vi/en)
// =============================================================================
// Trước đây là SubmarinerEvolution.astro (thí điểm, chỉ Submariner). Giờ nhận
// dataset tổng quát từ src/data/modelEvolution.ts kèm ngôn ngữ trang; dữ kiện
// và chữ hiển thị nằm hoàn toàn ở các tệp dataset (DisplayText vi/en) —
// component không chứa mốc hay chuỗi ngôn ngữ nào.
//
// Song ngữ (Prompt 31): props { dataset, lang } — lang do template truyền theo
// URL trang; mọi text người đọc (tiêu đề, dẫn nhập, nhãn, mô tả, ghi chú,
// nhãn nguồn, aria-label) qua tText()/ui.ts nên bản vi thuần Việt và bản en
// thuần tiếng Anh.
//
// Trải nghiệm (giữ nguyên hành vi bản thí điểm Submariner):
//   - ≥768px CÓ JS: các mốc trên một đường thời gian kiểu bezel (vạch chia SVG
//     chỉ trang trí, aria-hidden); chọn mốc → thẻ chi tiết trải rộng dưới ray.
//   - <768px, hoặc KHÔNG JS: danh sách dọc đầy đủ, thẻ chi tiết của mọi mốc
//     luôn mở — toàn bộ năm/reference/thay đổi/ghi chú/nguồn đọc được mà không
//     phụ thuộc JavaScript.
//   - Không ảnh đồng hồ, không carousel tự chạy, không animation lặp.
//   - prefers-reduced-motion: chuyển trạng thái tức thời (không transition).
//   - Nút thật (Tab/Enter/Space), aria-pressed cho mốc đang chọn, thẻ chi tiết
//     có nhãn role="group" + aria-label, không tự cướp focus, không trap focus.
//   - Số cột lưới theo số mốc của dataset (var --evol-cols) — không cố định 8.
//   - Chỉ dùng token ngữ nghĩa (steel/alloy/line/primary/secondary/surface-raised)
//     tự đổi theo .dark — không có mã hex, không cần cặp dark:.
// =============================================================================

import type { ModelEvolutionDataset } from '../data/modelEvolution';
import { tText, type DisplayText } from '../data/modelEvolution';
import { t, type Lang } from '../i18n/ui';

interface Props {
  dataset: ModelEvolutionDataset;
  lang: Lang;
}

const { dataset, lang } = Astro.props;
const tr = t(lang);
const { milestones } = dataset;
const text = (value: DisplayText) => tText(value, lang);
const detailAria = (year: number, reference: string) =>
  tr.evolution_detail_aria.replace('{year}', String(year)).replace('{name}', dataset.name).replace('{reference}', reference);

// Vạch chia kiểu bezel cho đường ray — chỉ trang trí: 61 vạch, vạch dài mỗi 5 vạch
const ticks = Array.from({ length: 61 }, (_, i) => ({ x: i * 12, long: i % 5 === 0 }));
---

<section
  class="evol not-prose mb-12 mt-8"
  data-evolution
  data-selected="0"
  aria-labelledby={`${dataset.slug}-evolution-title`}
>
  <h2 id={`${dataset.slug}-evolution-title`} class="font-serif text-xl text-steel">
    {text(dataset.title)}
  </h2>
  <p class="mt-1 text-sm leading-relaxed text-secondary">
    {text(dataset.intro)}
  </p>

  <div class="relative mt-6">
    <!-- Đường ray + vạch chia kiểu bezel — thuần trang trí, chỉ hiện khi có JS (chế độ grid) -->
    <div class="evol-rail absolute left-2 right-2 top-0 hidden" aria-hidden="true">
      <svg class="h-3 w-full" viewBox="0 0 720 12" preserveAspectRatio="none" focusable="false" aria-hidden="true">
        <line class="evol-rail-base" x1="0" y1="5.5" x2="720" y2="5.5" />
        {ticks.map((t) => (
          <line class="evol-rail-tick" x1={t.x} y1={t.long ? 0 : 3} x2={t.x} y2="12" />
        ))}
      </svg>
    </div>

    <ol class="evol-list m-0 list-none p-0" style={`--evol-cols: ${milestones.length}`}>
      {milestones.map((m, i) => (
        <li class="evol-item border-b border-line/60 py-4 last:border-b-0">
          <button
            type="button"
            class="evol-btn flex min-h-11 w-full flex-wrap items-baseline gap-x-2 gap-y-0.5 rounded-lg border border-transparent px-3 pb-3 text-left hover:border-line focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steel md:flex-col md:flex-nowrap md:items-center md:gap-y-1 md:px-1.5 md:pt-0 md:text-center"
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-index={i}
          >
            <span class="evol-dot hidden h-3 w-3 shrink-0 rounded-full bg-secondary/60 md:block" aria-hidden="true"></span>
            <span class="evol-year font-semibold text-primary">{m.year}</span>
            <span class="evol-ref font-mono text-sm text-steel">{text(m.reference)}</span>
            <span class="evol-label w-full text-sm leading-snug text-secondary md:w-auto">{text(m.label)}</span>
          </button>

          <div
            class="evol-detail mt-3 rounded-lg border border-line/60 bg-surface-raised px-4 py-3"
            role="group"
            aria-label={detailAria(m.year, text(m.reference))}
            data-index={i}
          >
            <p class="font-mono text-sm text-steel">{m.year} · {text(m.reference)}</p>
            <p class="mt-1.5 font-medium leading-relaxed text-primary">{text(m.change)}</p>
            <p class="mt-1 text-sm leading-relaxed text-secondary">{text(m.note)}</p>
            <a
              class="mt-2 inline-flex min-h-11 items-center gap-1 text-sm font-medium text-steel underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steel"
              href={m.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {tr.evolution_view_source} {m.sourceName}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* ===== Mặc định + <768px: danh sách dọc, mọi thẻ chi tiết luôn mở ===== */
  /* Không cần JS để đọc nội dung: năm, reference, thay đổi, ghi chú và nguồn
     đều nằm trong luồng tài liệu. Đường ray trang trí chỉ hiện khi có JS. */

  /* ===== ≥768px CÓ JS: đường thời gian ngang, một thẻ chi tiết cho mốc đang chọn ===== */
  @media (min-width: 768px) {
    .evol[data-js] .evol-rail {
      display: block;
    }

    .evol[data-js] .evol-list {
      display: grid;
      grid-template-columns: repeat(var(--evol-cols, 8), minmax(0, 1fr));
      column-gap: 0.5rem;
    }

    /* li chỉ là bố cục — button và thẻ chi tiết thành item trực tiếp của lưới */
    .evol[data-js] .evol-item {
      display: contents;
    }

    .evol[data-js] .evol-detail {
      display: none;
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 1.25rem;
    }

    .evol[data-js] .evol-detail[data-current='true'] {
      display: block;
    }
  }

  /* Nút bấm bên dưới không đè lên đường ray */
  .evol-btn {
    position: relative;
  }

  /* Mốc đang chọn: nhận biết bằng viền + màu + chấm phóng to (không chỉ màu) */
  .evol-btn[aria-pressed='true'] {
    @apply border-alloy bg-surface-raised;
  }
  .evol-btn[aria-pressed='true'] .evol-year {
    @apply text-alloy;
  }
  .evol-btn[aria-pressed='true'] .evol-label {
    @apply font-semibold;
  }
  .evol-btn[aria-pressed='true'] .evol-dot {
    @apply bg-alloy ring-2 ring-alloy/30;
  }

  /* Vạch bezel — dùng token ngữ nghĩa, tự đổi theo .dark */
  .evol-rail line {
    stroke: rgb(var(--c-line) / 0.55);
    stroke-width: 1;
  }
  .evol-rail .evol-rail-base {
    stroke: rgb(var(--c-line) / 0.9);
    stroke-width: 1.5;
  }

  /* Chuyển trạng thái rất nhẹ; reduced-motion thì tức thời */
  @media (prefers-reduced-motion: no-preference) {
    .evol-btn,
    .evol-btn .evol-dot,
    .evol-btn .evol-year {
      transition:
        border-color 120ms ease,
        background-color 120ms ease,
        color 120ms ease,
        box-shadow 120ms ease;
    }
  }
</style>

<script is:inline>
  // Bật chế độ tương tác: gắn data-js (CSS chuyển sang lưới ngang + một chi tiết)
  // rồi điều khiển mốc đang chọn qua data-selected / data-current / aria-pressed.
  // Không có script này: trang hiển thị danh sách dọc đầy đủ — nội dung vẫn đọc được.
  // Scope theo từng root — không dùng document.querySelector toàn cục.
  document.querySelectorAll('[data-evolution]').forEach(function (root) {
    root.setAttribute('data-js', '1');
    var buttons = Array.prototype.slice.call(root.querySelectorAll('.evol-btn'));
    var details = Array.prototype.slice.call(root.querySelectorAll('.evol-detail'));

    function select(i) {
      root.setAttribute('data-selected', String(i));
      buttons.forEach(function (b, j) {
        b.setAttribute('aria-pressed', String(i === j));
      });
      details.forEach(function (d, j) {
        if (i === j) d.setAttribute('data-current', 'true');
        else d.removeAttribute('data-current');
      });
    }

    buttons.forEach(function (btn, i) {
      btn.addEventListener('click', function () {
        select(i);
      });
    });
    select(0);
  });
</script>
