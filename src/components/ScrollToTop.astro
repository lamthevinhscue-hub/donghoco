---
// =============================================================================
// SCROLL TO TOP — nút lên đầu trang
// =============================================================================
// Hiện ở góc dưới-phải khi cuộn quá 2 màn hình. Kín đáo (nhỏ, bán trong suốt),
// hợp cả chế độ sáng và tối. Có aria-label cho accessibility.
// =============================================================================
---

<button
  type="button"
  id="scroll-to-top"
  data-pagefind-ignore
  aria-label="Lên đầu trang"
  class="fixed bottom-6 right-6 z-40 flex h-11 w-11 items-center justify-center rounded-full border border-cream-dark bg-white/90 text-navy opacity-0 shadow-md backdrop-blur transition-all duration-300 hover:border-brass hover:text-brass dark:border-dark-border dark:bg-dark-surface/90 dark:text-dark-text dark:hover:border-dark-brass dark:hover:text-dark-brass pointer-events-none translate-y-2"
>
  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
  </svg>
</button>

<script>
  const btn = document.getElementById('scroll-to-top');
  if (btn) {
    // Hiện khi cuộn quá 2 chiều cao màn hình
    const threshold = window.innerHeight * 2;
    function onScroll() {
      if (window.scrollY > threshold) {
        btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Cuộn lên đầu mượt
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
