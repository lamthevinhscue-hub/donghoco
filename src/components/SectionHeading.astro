---
// =============================================================================
// SECTION HEADING (Tiêu đề mục)
// =============================================================================
// Tiêu đề lớn dùng để mở đầu một mục trên trang (ví dụ "Nội dung nổi bật").
// Kèm đường gạch ngang màu vàng đồng làm điểm nhấn.
// =============================================================================

interface Props {
  title: string;
  /** Cấp heading: 1 cho tiêu đề trang (SEO — mỗi trang đúng 1 H1), 2 cho tiêu đề mục */
  level?: 1 | 2;
  subtitle?: string;
  /** Liên kết ngắn nối tiếp phần mô tả, dùng cho một hành động liên quan. */
  subtitleLink?: { href: string; label: string };
  align?: 'left' | 'center';
}

const { title, level = 2, subtitle, subtitleLink, align = 'left' } = Astro.props;
const Heading = (level === 1 ? 'h1' : 'h2') as 'h1' | 'h2';
const alignment = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class={`max-w-2xl ${alignment} mb-8`}>
  <div class={`mb-3 h-1 w-12 rounded bg-brass ${align === 'center' ? 'mx-auto' : ''}`}></div>
  <Heading class="font-serif text-3xl text-navy sm:text-4xl dark:text-dark-text">{title}</Heading>
  {subtitle && (
    <p class="mt-3 text-ink-soft dark:text-dark-text-soft">
      {subtitle}
      {subtitleLink && (
        <>
          {' '}
          <a href={subtitleLink.href} class="font-medium text-brass underline underline-offset-2 transition-colors hover:text-navy dark:text-dark-brass dark:hover:text-dark-text">
            {subtitleLink.label}
          </a>
        </>
      )}
    </p>
  )}
</div>
