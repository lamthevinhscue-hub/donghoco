---
// =============================================================================
// TABLE OF CONTENTS — mục lục bài viết từ headings của render(entry)
// =============================================================================
// Nhận danh sách heading (depth/slug/text) do Astro render trả lúc build —
// anchor là id thật đã có trên heading, không sinh id hay sửa DOM sau khi tải.
// Hai chế độ trong một component:
//   - Mobile/tablet (< xl): <details> gọn, summary vùng bấm 44px.
//   - Desktop (≥ xl): rail dính (sticky) bên phải, không che header (top đủ lớn).
// Chỉ render khi có tối thiểu 2 mục h2/h3 — không hiện khung rỗng.
// data-pagefind-ignore: chữ mục lục không được lọt vào snippet tìm kiếm.
// =============================================================================

import { getLangFromUrl, t } from '../i18n/ui';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);

const { headings } = Astro.props;
// Chỉ h2/h3 — h4+ làm mục lục bị ồn
const items = (headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length >= 2 && (
  <nav aria-label={tr.toc_title} data-pagefind-ignore>
    <!-- Mobile/tablet (< lg = dưới 1024px): details gọn, mở khi cần -->
    <details class="lg:hidden">
      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg border border-line px-4 text-sm font-medium text-ink transition-colors hover:border-brass dark:border-dark-border dark:text-dark-text dark:hover:border-dark-brass [&::-webkit-details-marker]:hidden">
        <svg class="h-4 w-4 text-steel dark:text-steel" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h10M4 18h7" />
        </svg>
        {tr.toc_title}
        <svg class="ml-auto h-4 w-4 text-ink-soft transition-transform dark:text-dark-text-soft" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <ol class="mt-2 space-y-0.5 border-l border-line pl-1 dark:border-dark-border">
        {items.map((h) => (
          <li class={h.depth === 3 ? 'pl-4' : ''}>
            <a
              href={`#${h.slug}`}
              class="flex min-h-11 items-center rounded-lg px-3 text-base leading-snug text-ink-soft transition-colors hover:text-brass dark:text-dark-text-soft dark:hover:text-dark-brass"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </details>

    <!-- Desktop (≥ lg = 1024px): rail dính bên phải.
         Không max-height/overflow — người dùng chỉ cuộn trang chính, TOC không
         có scrollbar riêng (nested scroll bị cấm theo nghiệm thu). -->
    <div class="sticky top-28 hidden lg:block">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-ink-soft/90 dark:text-dark-text-soft/70">{tr.toc_title}</p>
      <ol class="space-y-0.5 border-l border-line pl-1 dark:border-dark-border">
        {items.map((h) => (
          <li class={h.depth === 3 ? 'pl-3' : ''}>
            <a
              href={`#${h.slug}`}
              class="block rounded-lg px-3 py-2 text-sm leading-snug text-ink-soft transition-colors hover:text-brass dark:text-dark-text-soft dark:hover:text-dark-brass"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>
)}
