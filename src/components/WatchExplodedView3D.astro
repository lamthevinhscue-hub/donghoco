---
// =============================================================================
// WATCH EXPLODED VIEW 3D — Chế độ "Mô hình 3D" tùy chọn trên trang giải phẫu
// =============================================================================
// G06-A chặng 2: nhận `lang` tường minh; dữ liệu 12 bộ phận từ nguồn duy nhất
// src/data/anatomy-parts.ts (render ra data-* trên nút chọn nhanh — engine đọc
// từ DOM, không dùng biến toàn cục window). Chuỗi runtime đọc JSON blob
// `#anatomy-i18n` (component khuôn render).
//
// Component này CHỈ là markup: engine Three.js nằm ở src/scripts/exploded3d.ts
// và chỉ được dynamic import khi người dùng chủ động mở tab 3D. Không tải
// Three.js trước lúc đó.
//
// Mô hình dựng bằng primitive shapes — mô hình khái niệm minh họa cấu trúc,
// KHÔNG mô phỏng một calibre cụ thể (ghi chú hiển thị ngay dưới khung 3D).
// =============================================================================

import type { Lang } from '../i18n/ui';
import { ANATOMY_PARTS, ANATOMY_UI } from '../data/anatomy-parts';

interface Props { lang: Lang }
const { lang } = Astro.props as Props;
const ui = ANATOMY_UI[lang];
const view = ANATOMY_PARTS.map((p) => ({
  ...p,
  name: p[lang].name,
  role: p[lang].role,
  link: p.link ? p.link[lang] : '',
}));
---

<div class="my-6" data-exploded-3d-root>
  <!-- Thanh điều khiển -->
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-cream-dark bg-cream-dark/20 p-4 dark:border-dark-border dark:bg-dark-border/20">
    <div class="flex items-center gap-2">
      <span class="text-sm font-medium text-navy dark:text-dark-text">{lang === 'vi' ? 'Trạng thái:' : 'Status:'}</span>
      <span id="mode-label-3d" class="text-sm font-bold text-brass dark:text-dark-brass">{ui.mode3d.assembled}</span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button
        type="button"
        id="toggle-explode-3d"
        aria-pressed="false"
        class="flex min-h-11 items-center gap-2 rounded-full bg-navy px-4 py-2 text-sm font-medium text-cream transition-colors hover:bg-brass dark:hover:bg-dark-brass"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        <span id="toggle-label-3d">{ui.toggle.explode}</span>
      </button>
      <!-- Toggle chuẩn accessibility: nhãn cố định, aria-pressed = trạng thái chuyển động
           (true: đang chạy / false: đã tắt), icon pause/play đổi theo trạng thái -->
      <button
        type="button"
        id="motion-toggle-3d"
        aria-pressed="false"
        class="flex min-h-11 items-center gap-2 rounded-full border border-cream-dark px-4 py-2 text-sm font-medium text-ink-soft transition-colors hover:border-brass hover:bg-brass/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brass dark:border-dark-border dark:text-dark-text-soft"
      >
        <svg id="icon-pause-3d" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M10 9v6m4-6v6"/></svg>
        <svg id="icon-play-3d" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5v14l11-7z"/></svg>
        <span>{lang === 'vi' ? 'Chuyển động 3D' : '3D motion'}</span>
      </button>
      <button
        type="button"
        id="reset-view-3d"
        class="min-h-11 rounded-full border border-cream-dark px-4 py-2 text-sm font-medium text-ink-soft transition-colors hover:bg-cream-dark dark:border-dark-border dark:text-dark-text-soft"
      >{lang === 'vi' ? 'Đặt lại' : 'Reset'}</button>
    </div>
  </div>

  <!-- Layout 2 cột trên desktop, canvas trên + panel dưới trên mobile -->
  <div class="grid gap-6 lg:grid-cols-[1.4fr_1fr]">
    <!-- Cột trái: khung canvas 3D (chiều cao cố định theo breakpoint — không CLS) -->
    <div>
      <div class="relative h-[340px] overflow-hidden rounded-lg border border-cream-dark bg-gradient-to-b from-white to-cream-dark/10 dark:border-dark-border dark:from-dark-surface dark:to-dark-bg sm:h-[420px] lg:h-[520px]">
        <div id="three-canvas-container" class="absolute inset-0"></div>
        <!-- Lớp phủ trạng thái đang tải — engine tự ẩn sau frame đầu -->
        <div
          id="three-loading"
          class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 bg-white/70 text-center dark:bg-dark-bg/70"
        >
          <div class="h-8 w-8 animate-spin rounded-full border-2 border-brass border-t-transparent" role="progressbar" aria-label={lang === 'vi' ? 'Đang tải' : 'Loading'}></div>
          <p class="text-sm text-ink-soft dark:text-dark-text-soft">{lang === 'vi' ? 'Đang tải mô hình 3D…' : 'Loading the 3D model…'}</p>
        </div>
      </div>
      <p class="mt-3 text-center text-xs text-ink-soft/90 dark:text-dark-text-soft/70">
        {lang === 'vi'
          ? 'Kéo để xoay · Cuộn hoặc chụm để thu phóng · Chạm hoặc bấm một bộ phận để xem chi tiết'
          : 'Drag to rotate · Scroll or pinch to zoom · Tap a part for details'}
      </p>
      <p class="mt-1 text-center text-xs italic text-ink-soft/80 dark:text-dark-text-soft/60">
        {lang === 'vi'
          ? 'Mô hình khái niệm để minh họa cấu trúc, không mô phỏng một calibre cụ thể.'
          : 'A conceptual model illustrating the structure — it does not replicate a specific calibre.'}
      </p>

      <!-- Điều khiển thay thế thao tác KÉO: xoay trái/phải, phóng to/thu nhỏ.
           Không bắt buộc dùng chuột cảm ứng — mọi thao tác có nút bấm keyboard-accessible. -->
      <div class="mt-3 flex flex-wrap items-center justify-center gap-2" role="group" aria-label={lang === 'vi' ? 'Điều khiển góc nhìn mô hình' : 'Model view controls'}>
        <button
          type="button"
          id="rot-left-3d"
          aria-label={lang === 'vi' ? 'Xoay mô hình sang trái' : 'Rotate the model left'}
          class="flex min-h-11 w-11 items-center justify-center rounded-full border border-cream-dark text-lg text-ink-soft transition-colors hover:border-brass hover:text-brass dark:border-dark-border dark:text-dark-text-soft dark:hover:border-dark-brass dark:hover:text-dark-brass"
        >←</button>
        <button
          type="button"
          id="rot-right-3d"
          aria-label={lang === 'vi' ? 'Xoay mô hình sang phải' : 'Rotate the model right'}
          class="flex min-h-11 w-11 items-center justify-center rounded-full border border-cream-dark text-lg text-ink-soft transition-colors hover:border-brass hover:text-brass dark:border-dark-border dark:text-dark-text-soft dark:hover:border-dark-brass dark:hover:text-dark-brass"
        >→</button>
        <button
          type="button"
          id="zoom-in-3d"
          aria-label={lang === 'vi' ? 'Phóng to mô hình' : 'Zoom in'}
          class="flex min-h-11 w-11 items-center justify-center rounded-full border border-cream-dark text-lg text-ink-soft transition-colors hover:border-brass hover:text-brass dark:border-dark-border dark:text-dark-text-soft dark:hover:border-dark-brass dark:hover:text-dark-brass"
        >+</button>
        <button
          type="button"
          id="zoom-out-3d"
          aria-label={lang === 'vi' ? 'Thu nhỏ mô hình' : 'Zoom out'}
          class="flex min-h-11 w-11 items-center justify-center rounded-full border border-cream-dark text-lg text-ink-soft transition-colors hover:border-brass hover:text-brass dark:border-dark-border dark:text-dark-text-soft dark:hover:border-dark-brass dark:hover:text-dark-brass"
        >−</button>
      </div>
    </div>

    <!-- Cột phải: thẻ chi tiết + danh sách bộ phận (dùng được bằng bàn phím) -->
    <div class="space-y-4">
      <div
        id="detail-card-3d"
        class="rounded-lg border-l-4 border-brass bg-white p-5 dark:bg-dark-surface"
        role="status"
        aria-live="polite"
      >
        <div class="mb-2 flex items-center gap-3">
          <span id="detail-icon-3d" class="text-3xl" aria-hidden="true">👆</span>
          <div>
            <div id="detail-name-vi-3d" class="font-serif text-lg text-navy dark:text-dark-text">{ui.detail.title}</div>
            <p id="detail-name-en-3d" class="text-xs text-ink-soft/90 dark:text-dark-text-soft/70">{ui.detail.hint3d}</p>
          </div>
        </div>
        <p id="detail-role-3d" class="mt-3 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft" set:html={ui.detail.role3d} />
        <a
          id="detail-link-3d"
          href="#"
          class="mt-4 hidden inline-flex min-h-11 items-center gap-1 rounded-full bg-navy px-4 py-2 text-xs font-medium text-cream hover:bg-brass dark:hover:bg-dark-brass"
        >
          {lang === 'vi' ? 'Đọc bài chi tiết →' : 'Read the full article →'}
        </a>
      </div>

      <div class="rounded-lg border border-cream-dark bg-cream-dark/10 p-4 dark:border-dark-border dark:bg-dark-surface/50">
        <p class="mb-3 text-xs font-bold uppercase tracking-wider text-ink-soft/90 dark:text-dark-text-soft/70">
          {lang === 'vi' ? '12 bộ phận — bấm để chọn' : '12 parts — click to pick'}
        </p>
        <div class="grid grid-cols-2 gap-2 text-xs">
          {view.map((p) => (
            <button
              type="button"
              class="part-quick-3d flex min-h-11 items-center gap-2 rounded border border-cream-dark bg-white p-2 text-left transition-colors hover:border-brass hover:bg-brass/5 dark:border-dark-border dark:bg-dark-surface"
              data-part-id={p.id}
              aria-pressed="false"
              data-name={p.name}
              data-role={p.role}
              data-link={p.link}
              data-icon={p.icon}
            >
              <span class="text-base" aria-hidden="true">{p.icon}</span>
              <span class="text-navy dark:text-dark-text">{p.name}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
