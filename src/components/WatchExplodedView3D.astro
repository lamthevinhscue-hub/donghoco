---
// =============================================================================
// WATCH EXPLODED VIEW 3D — Giải phẫu đồng hồ cơ bằng Three.js
// =============================================================================
// Model 3D dựng bằng primitive shapes (cylinder, torus, box) — không file ngoài.
// Tải Three.js runtime từ CDN (không thêm package.json).
// Tương tác: OrbitControls xoay 360°, nút "Tách lớp", click lớp để xem chi tiết.
// Fallback: nếu Three.js không tải → hiện nút "Xem bản 2D".
// =============================================================================

// Dữ liệu 12 bộ phận — cùng nguồn với bản 2D
const parts = [
  { id: 'crystal', nameVi: 'Kính cường lực', nameEn: 'Crystal', role: 'Lớp trong suốt bảo vệ mặt số. Thường là sapphire.', link: null, color: '#A8C5E2', icon: '◈' },
  { id: 'second-hand', nameVi: 'Kim giây', nameEn: 'Second hand', role: 'Quay 1 vòng mỗi 60 giây — liên kết bộ thoát.', link: '/co-che/bo-thoat', color: '#9B2C2C', icon: '→' },
  { id: 'minute-hand', nameVi: 'Kim phút', nameEn: 'Minute hand', role: 'Quay 1 vòng mỗi 60 phút.', link: '/co-che/chuyen-dong-co', color: '#1F2D3D', icon: '↛' },
  { id: 'hour-hand', nameVi: 'Kim giờ', nameEn: 'Hour hand', role: 'Quay 1 vòng mỗi 12 giờ.', link: '/co-che/chuyen-dong-co', color: '#1F2D3D', icon: '⏰' },
  { id: 'dial', nameVi: 'Mặt số', nameEn: 'Dial', role: '"Gương mặt" của đồng hồ — quyết định 80% diện mạo.', link: null, color: '#FAF7F2', icon: '◔' },
  { id: 'subdial', nameVi: 'Mặt số phụ', nameEn: 'Sub-dial', role: 'Hiển thị chức năng phụ: giây, lịch.', link: '/tu-dien/perpetual-calendar', color: '#E8E2D6', icon: '○' },
  { id: 'mainspring-barrel', nameVi: 'Thùng cót', nameEn: 'Mainspring barrel', role: 'Nguồn năng lượng! Dây cót xoắn.', link: '/co-che/tru-cot', color: '#B8893C', icon: '◎' },
  { id: 'gear-train', nameVi: 'Bánh răng trung gian', nameEn: 'Gear train', role: 'Chuỗi 4 bánh răng truyền năng lượng.', link: '/co-che/chuyen-dong-co', color: '#4A5568', icon: '⚙' },
  { id: 'escapement', nameVi: 'Bộ thoát', nameEn: 'Escapement', role: 'TRÁI TIM ĐẬP — chia năng lượng thành nhịp.', link: '/co-che/bo-thoat', color: '#2E86AB', icon: '♥' },
  { id: 'balance', nameVi: 'Bánh lắc + dây tóc', nameEn: 'Balance & Hairspring', role: 'Hệ dao động — quyết định độ chính xác.', link: '/tu-dien/day-toc-banh-lac', color: '#9B2C2C', icon: '✺' },
  { id: 'rotor', nameVi: 'Rotor', nameEn: 'Rotor', role: 'Quả nặng xoay → tự động lên dây.', link: '/co-che/len-day-tu-dong', color: '#5A6878', icon: '◐' },
  { id: 'caseback', nameVi: 'Đáy vỏ', nameEn: 'Caseback', role: 'Nắp đáy — kín hoặc lộ máy.', link: null, color: '#2D3748', icon: '▣' },
];
---

<section class="my-6" data-exploded-3d-root>
  <!-- Thanh điều khiển -->
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-cream-dark bg-cream-dark/20 p-4 dark:border-dark-border dark:bg-dark-border/20">
    <div class="flex items-center gap-2">
      <span class="text-sm font-medium text-navy dark:text-dark-text">🔧 Trạng thái:</span>
      <span id="mode-label-3d" class="text-sm font-bold text-brass dark:text-dark-brass">Đang ghép</span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" id="toggle-explode-3d" class="flex items-center gap-2 rounded-full bg-navy px-4 py-2 text-sm font-medium text-cream transition-colors hover:bg-brass dark:hover:bg-dark-brass">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        <span id="toggle-label-3d">Tách lớp</span>
      </button>
      <button type="button" id="reset-view-3d" class="rounded-full border border-cream-dark px-3 py-2 text-xs font-medium text-ink-soft transition-colors hover:bg-cream-dark dark:border-dark-border dark:text-dark-text-soft">Đặt lại</button>
    </div>
  </div>

  <!-- Layout 2 cột -->
  <div class="grid gap-6 lg:grid-cols-[1.4fr_1fr]">
    <!-- Cột trái: Canvas 3D -->
    <div class="relative rounded-lg border border-cream-dark bg-gradient-to-b from-white to-cream-dark/10 p-3 dark:border-dark-border dark:from-dark-surface dark:to-dark-bg" style="min-height: 500px;">
      <!-- Canvas Three.js -->
      <div id="three-canvas-container" style="width: 100%; height: 500px;"></div>
      <!-- Loading / fallback -->
      <div id="three-loading" class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-center">
        <div class="animate-spin h-8 w-8 rounded-full border-2 border-brass border-t-transparent"></div>
        <p class="text-sm text-ink-soft dark:text-dark-text-soft">Đang tải mô hình 3D...</p>
      </div>
      <!-- Fallback 2D -->
      <div id="three-fallback" class="hidden text-center py-12">
        <p class="mb-3 text-sm text-ink-soft dark:text-dark-text-soft">Không tải được mô hình 3D.</p>
        <button type="button" id="show-2d-btn" class="rounded-full bg-navy px-4 py-2 text-sm font-medium text-cream hover:bg-brass">Xem bản 2D →</button>
      </div>
      <!-- Hint -->
      <p id="three-hint" class="mt-2 hidden text-center text-xs text-ink-soft/60 dark:text-dark-text-soft/60">
        🖱 Kéo để xoay · Lăn chuột để zoom · Click bộ phận để xem chi tiết
      </p>
    </div>

    <!-- Cột phải: thẻ chi tiết + quick-pick -->
    <div class="space-y-4">
      <div id="detail-card-3d" class="rounded-lg border-l-4 border-brass bg-white p-5 dark:bg-dark-surface">
        <div class="mb-2 flex items-center gap-3">
          <span id="detail-icon-3d" class="text-3xl">👆</span>
          <div>
            <h3 id="detail-name-vi-3d" class="font-serif text-lg text-navy dark:text-dark-text">Chọn một bộ phận</h3>
            <p id="detail-name-en-3d" class="text-xs text-ink-soft/70 dark:text-dark-text-soft/70">Click vào bộ phận trong mô hình 3D</p>
          </div>
        </div>
        <p id="detail-role-3d" class="mt-3 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
          Kéo để xoay mô hình 360°. Bấm <strong>"Tách lớp"</strong> để phân rã. Click từng bộ phận để hiểu vai trò.
        </p>
        <a id="detail-link-3d" href="#" class="mt-4 hidden inline-flex items-center gap-1 rounded-full bg-navy px-4 py-2 text-xs font-medium text-cream hover:bg-brass dark:hover:bg-dark-brass">
          Đọc bài chi tiết →
        </a>
      </div>

      <div class="rounded-lg border border-cream-dark bg-cream-dark/10 p-4 dark:border-dark-border dark:bg-dark-surface/50">
        <h4 class="mb-3 text-xs font-bold uppercase tracking-wider text-ink-soft/70 dark:text-dark-text-soft/70">12 bộ phận — click để chọn</h4>
        <div class="grid grid-cols-2 gap-2 text-xs">
          {parts.map((p) => (
            <button
              type="button"
              class="part-quick-3d flex items-center gap-2 rounded border border-cream-dark bg-white p-2 text-left transition-colors hover:border-brass hover:bg-brass/5 dark:border-dark-border dark:bg-dark-surface dark:bg-dark-brass/10"
              data-part-id={p.id}
            >
              <span class="text-base">{p.icon}</span>
              <span class="text-navy dark:text-dark-text">{p.nameVi}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ partsData: parts }}>
  (async function() {
    const container = document.getElementById('three-canvas-container');
    const loading = document.getElementById('three-loading');
    const fallback = document.getElementById('three-fallback');
    const hint = document.getElementById('three-hint');
    if (!container) return;

    // Tạo map part id → info
    var partMap = {};
    partsData.forEach(function(p) { partMap[p.id] = p; });

    // ====== Tải Three.js + OrbitControls từ CDN ======
    var THREE, OrbitControls;
    try {
      var dynImport = new Function('url', 'return import(url)');
      var threeMod = await dynImport('https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js');
      THREE = threeMod;
      var orbitMod = await dynImport('https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/controls/OrbitControls.js');
      OrbitControls = orbitMod.OrbitControls;
    } catch(e) {
      console.error('Three.js load failed:', e);
      if (loading) loading.classList.add('hidden');
      if (fallback) fallback.classList.remove('hidden');
      // Nút "Xem bản 2D" → chuyển inline sang component 2D
      var show2dBtn = document.getElementById('show-2d-btn');
      if (show2dBtn) {
        show2dBtn.addEventListener('click', function() {
          var w3d = document.getElementById('view-3d-wrapper');
          var w2d = document.getElementById('view-2d-wrapper');
          if (w3d) w3d.classList.add('hidden');
          if (w2d) w2d.classList.remove('hidden');
        });
      }
      return;
    }

    if (loading) loading.classList.add('hidden');
    if (hint) hint.classList.remove('hidden');

    // ====== Scene setup ======
    var scene = new THREE.Scene();
    scene.background = null; // transparent

    var w = container.clientWidth;
    var h = container.clientHeight;
    var camera = new THREE.PerspectiveCamera(35, w / h, 0.1, 1000);
    camera.position.set(60, 40, 80);

    var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(w, h);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // Lights
    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    var dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
    dirLight.position.set(50, 80, 50);
    scene.add(dirLight);
    var dirLight2 = new THREE.DirectionalLight(0xB8893C, 0.3);
    dirLight2.position.set(-50, 30, -50);
    scene.add(dirLight2);

    // Controls
    var controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.minDistance = 40;
    controls.maxDistance = 200;
    controls.autoRotate = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    controls.autoRotateSpeed = 0.8;

    // ====== Dựng model từ primitives ======
    // Mỗi layer là một Group chứa các mesh → dễ animate tách/ghép
    var layers = []; // [{group, assembledY, explodedY, meshes: [{mesh, partId}]}]

    function mat(color, opacity) {
      var opts = { color: color };
      if (opacity !== undefined) { opts.transparent = true; opts.opacity = opacity; }
      return new THREE.MeshStandardMaterial(opts);
    }

    // --- LỚP 0: Crystal (kính) ---
    var crystalGroup = new THREE.Group();
    var crystalGeo = new THREE.CylinderGeometry(22, 22, 3, 64);
    var crystal = new THREE.Mesh(crystalGeo, mat(0xA8C5E2, 0.25));
    crystal.position.y = 0;
    crystal.userData = { partId: 'crystal' };
    crystalGroup.add(crystal);
    layers.push({ group: crystalGroup, assembledY: 8, explodedY: 40, meshes: [crystal] });

    // --- LỚP 1: Kim (hands) ---
    var handsGroup = new THREE.Group();
    // Kim giờ
    var hourHand = new THREE.Mesh(new THREE.BoxGeometry(1.5, 0.3, 9), mat(0x1F2D3D));
    hourHand.position.set(0, 5, 4.5);
    hourHand.userData = { partId: 'hour-hand' };
    handsGroup.add(hourHand);
    // Kim phút
    var minHand = new THREE.Mesh(new THREE.BoxGeometry(1, 0.3, 13), mat(0x1F2D3D));
    minHand.position.set(3, 5, 6.5);
    minHand.rotation.y = -0.4;
    minHand.userData = { partId: 'minute-hand' };
    handsGroup.add(minHand);
    // Kim giây
    var secHand = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.2, 15), mat(0x9B2C2C));
    secHand.position.set(-2, 5.5, 7.5);
    secHand.rotation.y = 0.3;
    secHand.userData = { partId: 'second-hand' };
    handsGroup.add(secHand);
    // Pin
    var pin = new THREE.Mesh(new THREE.CylinderGeometry(0.8, 0.8, 1, 16), mat(0x1F2D3D));
    pin.position.y = 5.5;
    handsGroup.add(pin);
    layers.push({ group: handsGroup, assembledY: 5, explodedY: 20, meshes: [hourHand, minHand, secHand] });

    // --- LỚP 2: Mặt số (dial) ---
    var dialGroup = new THREE.Group();
    var dial = new THREE.Mesh(new THREE.CylinderGeometry(20, 20, 1.5, 64), mat(0xFAF7F2));
    dial.position.y = 3;
    dial.userData = { partId: 'dial' };
    dialGroup.add(dial);
    // Sub-dial
    var subdial = new THREE.Mesh(new THREE.CylinderGeometry(5, 5, 0.5, 32), mat(0xE8E2D6));
    subdial.position.set(5, 3.8, 5);
    subdial.userData = { partId: 'subdial' };
    dialGroup.add(subdial);
    layers.push({ group: dialGroup, assembledY: 3, explodedY: 0, meshes: [dial, subdial] });

    // --- LỚP 3: Thùng cót + bánh răng ---
    var movGroup = new THREE.Group();
    // Movement plate (đế)
    var plate = new THREE.Mesh(new THREE.CylinderGeometry(19, 19, 2, 64), mat(0x6B6555));
    plate.position.y = 0;
    movGroup.add(plate);
    // Thùng cót
    var barrel = new THREE.Mesh(new THREE.CylinderGeometry(7, 7, 4, 32), mat(0xB8893C));
    barrel.position.set(-8, 1, 0);
    barrel.userData = { partId: 'mainspring-barrel' };
    movGroup.add(barrel);
    // 3 bánh răng
    var gear1 = new THREE.Mesh(new THREE.CylinderGeometry(4, 4, 3, 20), mat(0x4A5568));
    gear1.position.set(2, 0.5, 0);
    gear1.userData = { partId: 'gear-train' };
    movGroup.add(gear1);
    var gear2 = new THREE.Mesh(new THREE.CylinderGeometry(3, 3, 3, 16), mat(0x5A6878));
    gear2.position.set(8, 0.5, -3);
    movGroup.add(gear2);
    var gear3 = new THREE.Mesh(new THREE.CylinderGeometry(2.5, 2.5, 3, 14), mat(0x5A6878));
    gear3.position.set(8, 0.5, 4);
    movGroup.add(gear3);
    layers.push({ group: movGroup, assembledY: 0, explodedY: -20, meshes: [barrel, gear1, gear2, gear3] });

    // --- LỚP 4: Bộ thoát + bánh lắc ---
    var escGroup = new THREE.Group();
    var escPlate = new THREE.Mesh(new THREE.CylinderGeometry(17, 17, 1.5, 48), mat(0x4A4A4A));
    escPlate.position.y = -3;
    escGroup.add(escPlate);
    // Escape wheel (torus nhỏ)
    var escWheel = new THREE.Mesh(new THREE.CylinderGeometry(3, 3, 2, 15), mat(0x2E86AB));
    escWheel.position.set(-4, -3, 2);
    escWheel.userData = { partId: 'escapement' };
    escGroup.add(escWheel);
    // Balance wheel (torus)
    var balance = new THREE.Mesh(new THREE.TorusGeometry(5, 0.8, 12, 32), mat(0x9B2C2C));
    balance.rotation.x = Math.PI / 2;
    balance.position.set(5, -3, -2);
    balance.userData = { partId: 'balance' };
    escGroup.add(balance);
    layers.push({ group: escGroup, assembledY: -3, explodedY: -40, meshes: [escWheel, balance] });

    // --- LỚP 5: Rotor ---
    var rotorGroup = new THREE.Group();
    // Rotor — bán nguyệt bằng cylinder cắt
    var rotorGeo = new THREE.CylinderGeometry(14, 14, 2.5, 32, 1, false, 0, Math.PI);
    var rotor = new THREE.Mesh(rotorGeo, mat(0x5A6878));
    rotor.rotation.z = Math.PI / 2;
    rotor.rotation.y = Math.PI / 2;
    rotor.position.y = -6;
    rotor.userData = { partId: 'rotor' };
    rotorGroup.add(rotor);
    // Trục rotor
    var rotorPin = new THREE.Mesh(new THREE.CylinderGeometry(1.5, 1.5, 3, 16), mat(0xB8893C));
    rotorPin.position.y = -6;
    rotorGroup.add(rotorPin);
    layers.push({ group: rotorGroup, assembledY: -6, explodedY: -60, meshes: [rotor] });

    // --- LỚP 6: Đáy vỏ ---
    var backGroup = new THREE.Group();
    var caseback = new THREE.Mesh(new THREE.CylinderGeometry(21, 21, 3, 64), mat(0x2D3748));
    caseback.position.y = -9;
    caseback.userData = { partId: 'caseback' };
    backGroup.add(caseback);
    // Vỏ (side wall)
    var caseWall = new THREE.Mesh(new THREE.CylinderGeometry(21, 21, 18, 64, 1, true), mat(0x3A3A3A, 0.3));
    caseWall.position.y = 0;
    backGroup.add(caseWall);
    layers.push({ group: backGroup, assembledY: -9, explodedY: -80, meshes: [caseback] });

    // Add all layers to scene
    layers.forEach(function(l) {
      l.group.position.y = l.assembledY;
      scene.add(l.group);
    });

    // ====== TÁCH / GHÉP ======
    var isExploded = false;
    var toggleBtn = document.getElementById('toggle-explode-3d');
    var toggleLabel = document.getElementById('toggle-label-3d');
    var modeLabel = document.getElementById('mode-label-3d');
    var resetBtn = document.getElementById('reset-view-3d');

    function applyMode() {
      layers.forEach(function(l, i) {
        var targetY = isExploded ? l.explodedY : l.assembledY;
        setTimeout(function() {
          // Tween đơn giản
          var startY = l.group.position.y;
          var startTime = performance.now();
          var duration = 600;
          function tween() {
            var elapsed = performance.now() - startTime;
            var t = Math.min(elapsed / duration, 1);
            var eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
            l.group.position.y = startY + (targetY - startY) * eased;
            if (t < 1) requestAnimationFrame(tween);
          }
          tween();
        }, i * 50);
      });
      if (toggleLabel) toggleLabel.textContent = isExploded ? 'Ghép lại' : 'Tách lớp';
      if (modeLabel) modeLabel.textContent = isExploded ? 'Đang tách' : 'Đang ghép';
    }

    if (toggleBtn) toggleBtn.addEventListener('click', function() { isExploded = !isExploded; applyMode(); });
    if (resetBtn) resetBtn.addEventListener('click', function() {
      isExploded = false;
      applyMode();
      camera.position.set(60, 40, 80);
      controls.target.set(0, 0, 0);
      controls.update();
      selectPart3d(null);
    });

    // ====== CLICK CHỌN BỘ PHẬN (raycast) ======
    var raycaster = new THREE.Raycaster();
    var mouse = new THREE.Vector2();
    var detailIcon = document.getElementById('detail-icon-3d');
    var detailNameVi = document.getElementById('detail-name-vi-3d');
    var detailNameEn = document.getElementById('detail-name-en-3d');
    var detailRole = document.getElementById('detail-role-3d');
    var detailLink = document.getElementById('detail-link-3d');
    var quickBtns = document.querySelectorAll('.part-quick-3d');

    var iconMap = {};
    quickBtns.forEach(function(b) {
      var id = b.dataset.partId;
      iconMap[id] = b.querySelector('span:first-child') ? b.querySelector('span:first-child').textContent : '•';
    });

    function selectPart3d(id) {
      // Remove old highlight
      layers.forEach(function(l) {
        l.meshes.forEach(function(m) {
          if (m.userData && m.userData.origEmissive !== undefined) {
            m.material.emissive.setHex(m.userData.origEmissive);
            m.material.emissiveIntensity = m.userData.origEmissiveIntensity;
          }
        });
      });
      quickBtns.forEach(function(b) {
        b.style.borderColor = '';
        b.style.background = '';
      });

      if (!id || !partMap[id]) {
        if (detailIcon) detailIcon.textContent = '👆';
        if (detailNameVi) detailNameVi.textContent = 'Chọn một bộ phận';
        if (detailNameEn) detailNameEn.textContent = 'Click vào bộ phận trong mô hình 3D';
        if (detailRole) detailRole.innerHTML = 'Kéo để xoay mô hình 360°. Bấm <strong>"Tách lớp"</strong> để phân rã. Click từng bộ phận để hiểu vai trò.';
        if (detailLink) detailLink.classList.add('hidden');
        return;
      }

      var p = partMap[id];
      // Highlight mesh
      layers.forEach(function(l) {
        l.meshes.forEach(function(m) {
          if (m.userData && m.userData.partId === id && m.material.emissive) {
            if (m.userData.origEmissive === undefined) {
              m.userData.origEmissive = m.material.emissive.getHex();
              m.userData.origEmissiveIntensity = m.material.emissiveIntensity || 0;
            }
            m.material.emissive.setHex(0xB8893C);
            m.material.emissiveIntensity = 0.5;
          }
        });
      });
      // Active quick button
      var qb = document.querySelector('.part-quick-3d[data-part-id="' + id + '"]');
      if (qb) { qb.style.borderColor = '#B8893C'; qb.style.background = 'rgba(184,137,60,0.1)'; }

      if (detailIcon) detailIcon.textContent = iconMap[id] || '•';
      if (detailNameVi) detailNameVi.textContent = p.nameVi;
      if (detailNameEn) detailNameEn.textContent = p.nameEn;
      if (detailRole) detailRole.textContent = p.role;
      if (detailLink) {
        if (p.link) { detailLink.href = p.link; detailLink.classList.remove('hidden'); }
        else { detailLink.classList.add('hidden'); }
      }
    }

    // Raycast click
    renderer.domElement.addEventListener('click', function(e) {
      var rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(mouse, camera);
      var allMeshes = [];
      layers.forEach(function(l) { l.meshes.forEach(function(m) { allMeshes.push(m); }); });
      var hits = raycaster.intersectObjects(allMeshes);
      if (hits.length > 0 && hits[0].object.userData.partId) {
        selectPart3d(hits[0].object.userData.partId);
      }
    });

    // Quick buttons
    quickBtns.forEach(function(btn) {
      btn.addEventListener('click', function() { selectPart3d(btn.dataset.partId); });
    });

    // ====== Resize ======
    window.addEventListener('resize', function() {
      var nw = container.clientWidth;
      var nh = container.clientHeight;
      camera.aspect = nw / nh;
      camera.updateProjectionMatrix();
      renderer.setSize(nw, nh);
    });

    // ====== Render loop ======
    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      // Balance wheel dao động (chỉ khi không reduced motion)
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        balance.rotation.z = Math.sin(performance.now() * 0.004) * 0.3;
      }
      renderer.render(scene, camera);
    }
    animate();
  })();
</script>
