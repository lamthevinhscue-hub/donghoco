---
// =============================================================================
// COMPONENT WatchImage — hiển thị ảnh đồng hồ với technical plate trung thực
// =============================================================================
// Nếu src có và tải được → hiển thị ảnh thật. Nếu chưa có ảnh → hiển thị
// "technical plate" trang trí (nền thép + hoa văn guilloché + mặt số mô phỏng),
// hoàn toàn aria-hidden: trình đọc màn hình không hiểu nhầm là ảnh thật của mẫu.
// Không dùng chữ cái đầu — tránh cảm giác đó là logo chính thức của hãng.
//
// Cách dùng:
//   <WatchImage src="/images/mau-iconic/rolex-submariner.jpg" alt="Rolex Submariner" />
//
// Tỷ lệ mặc định 16:10 (ngang). Có thể đổi qua prop `ratio`.
// =============================================================================

interface Props {
  src?: string;             // Đường dẫn ảnh — để trống/không có → chỉ plate
  alt?: string;             // Mô tả ảnh thật (bắt buộc khi có src)
  ratio?: '16/10' | '16/9' | '1/1' | '4/3';  // Tỷ lệ khung hình
  caption?: string;         // Chú thích bên dưới ảnh (tùy chọn)
  eager?: boolean;          // true = tải ngay (cho ảnh above-the-fold), false = lazy (mặc định)
}

const { src, alt = '', ratio = '16/10', caption, eager = false } = Astro.props;

// Tỷ lệ → padding-top (cho khung giữ tỷ lệ, tránh CLS)
const aspectClass = {
  '16/10': 'aspect-[16/10]',
  '16/9': 'aspect-[16/9]',
  '1/1': 'aspect-square',
  '4/3': 'aspect-[4/3]',
}[ratio];

// Chỉ render <img> khi có src thật — không bao giờ gửi request tới URL rỗng
const hasImage = typeof src === 'string' && src.trim() !== '';
---

<figure class="watch-image my-6">
  <div class={`relative overflow-hidden rounded-lg border border-cream-dark dark:border-dark-border bg-cream-dark/30 dark:bg-dark-border/30 ${aspectClass}`}>
    <!-- Ảnh thật (chỉ khi có src) -->
    {hasImage && (
      <img
        src={src}
        alt={alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
        onload="this.parentElement.classList.add('loaded')"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
    )}
    <!-- Technical plate khi chưa có ảnh: nền thép + guilloché + mặt số mô phỏng.
         aria-hidden + không có nhãn — đây là trang trí, không phải ảnh mẫu. -->
    <div class="placeholder absolute inset-0 hidden items-center justify-center p-4 text-center" aria-hidden="true">
      <svg
        class="h-full w-full"
        viewBox="0 0 200 200"
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          <!-- Hoa văn guilloché: các đường tròn đồng tâm, lặp toàn nền -->
          <pattern id="guilloche" width="24" height="24" patternUnits="userSpaceOnUse" patternTransform="rotate(0)">
            <circle cx="12" cy="12" r="1.5" fill="none" stroke="currentColor" stroke-width="0.4" class="guilloche-stroke" />
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="0.3" class="guilloche-stroke" />
            <circle cx="12" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="0.25" class="guilloche-stroke" />
          </pattern>
        </defs>

        <!-- Nền plate: token thép (biến CSS tự đổi theo dark mode) -->
        <rect width="200" height="200" class="placeholder-bg" />

        <!-- Lớp guilloché phủ toàn nền, độ mờ 5% -->
        <rect width="200" height="200" fill="url(#guilloche)" opacity="0.05" class="guilloche-stroke" />

        <!-- Mặt số mô phỏng ở giữa -->
        <g transform="translate(100 100)">
          <!-- Vòng tròn viền mảnh (vành mặt số) -->
          <circle r="42" fill="none" stroke="currentColor" stroke-width="1" class="dial-ring" />
          <circle r="40" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.5" class="dial-ring" />

          <!-- 12 vạch chỉ giờ ngắn -->
          {Array.from({ length: 12 }).map((_, i) => {
            const angle = (i * 30 - 90) * (Math.PI / 180);
            const x1 = Math.cos(angle) * 34;
            const y1 = Math.sin(angle) * 34;
            const x2 = Math.cos(angle) * 38;
            const y2 = Math.sin(angle) * 38;
            return (
              <line
                x1={x1.toFixed(2)} y1={y1.toFixed(2)}
                x2={x2.toFixed(2)} y2={y2.toFixed(2)}
                stroke="currentColor" stroke-width="1.2" stroke-linecap="round"
                class="dial-mark"
              />
            );
          })}

          <!-- Kim giờ + kim phút mô phỏng (10:08) — thay cho chữ cái đầu -->
          <line x1="0" y1="0" x2="0" y2="-18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="dial-ring" />
          <line x1="0" y1="0" x2="14" y2="7" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="dial-ring" />
          <circle r="2.5" fill="currentColor" class="dial-mark" />
        </g>
      </svg>
    </div>
  </div>
  {caption && (
    <figcaption class="mt-2 text-center text-xs text-ink-soft/90 dark:text-dark-text-soft/70">{caption}</figcaption>
  )}
</figure>

<style is:global>
  /*
    Màu technical plate — dùng token biến CSS của trang: nền thép đậm, đường nét
    hợp kim ấm. Chế độ tối tự đổi nhờ giá trị biến trong .dark (không cần rule riêng).
  */
  .watch-image .placeholder-bg {
    fill: rgb(var(--c-steel));
  }
  .watch-image .guilloche-stroke,
  .watch-image .dial-ring,
  .watch-image .dial-mark {
    color: rgb(var(--c-alloy));
  }
</style>

<style>
  /* Hiệu ứng fade-in khi ảnh tải xong */
  .watch-image img {
    opacity: 0;
    transition: opacity 0.4s ease-in;
  }
  .watch-image .loaded img {
    opacity: 1;
  }
  /* Khi ảnh tải xong → ẩn placeholder */
  .watch-image .loaded .placeholder {
    display: none !important;
  }
</style>
