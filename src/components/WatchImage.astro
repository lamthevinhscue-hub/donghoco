---
// =============================================================================
// COMPONENT WatchImage — hiển thị ảnh đồng hồ với placeholder đẹp
// =============================================================================
// Tự động kiểm tra: nếu file ảnh tồn tại → hiển thị ảnh thật (lazy-load).
// Nếu chưa có → hiển thị placeholder đồ họa (không phải báo lỗi):
//   nền navy + hoa văn guilloché (đường tròn đồng tâm) + mặt số mô phỏng
//   + chữ cái đầu của alt ở giữa. Co giãn theo mọi tỷ lệ khung.
//
// Cách dùng:
//   <WatchImage src="/images/mau-iconic/rolex-submariner.jpg" alt="Rolex Submariner" />
//
// Tỷ lệ mặc định 16:10 (ngang). Có thể đổi qua prop `ratio`.
// =============================================================================

interface Props {
  src: string;              // Đường dẫn ảnh (VD: "/images/mau-iconic/rolex-submariner.jpg")
  alt: string;              // Mô tả ảnh (quan trọng cho accessibility)
  ratio?: '16/10' | '16/9' | '1/1' | '4/3';  // Tỷ lệ khung hình
  caption?: string;         // Chú thích bên dưới ảnh (tùy chọn)
  eager?: boolean;          // true = tải ngay (cho ảnh above-the-fold), false = lazy (mặc định)
}

const { src, alt, ratio = '16/10', caption, eager = false } = Astro.props;

// Tỷ lệ → padding-top (cho khung giữ tỷ lệ)
const aspectClass = {
  '16/10': 'aspect-[16/10]',
  '16/9': 'aspect-[16/9]',
  '1/1': 'aspect-square',
  '4/3': 'aspect-[4/3]',
}[ratio];

// Chữ cái đầu của alt (hỗ trợ tiếng Việt có dấu) để hiển thị giữa mặt số
const firstChar = (alt.trim().match(/[A-Za-z\u00C0-\u024F]/)?.[0] ?? '?').toUpperCase();
---

<figure class="watch-image my-6">
  <div class={`relative overflow-hidden rounded-lg border border-cream-dark dark:border-dark-border bg-cream-dark/30 dark:bg-dark-border/30 ${aspectClass}`}>
    <!-- Ảnh thật (nếu có) -->
    <img
      src={src}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      class="absolute inset-0 h-full w-full object-cover"
      onload="this.parentElement.classList.add('loaded')"
      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
    />
    <!-- Placeholder đồ họa khi chưa có ảnh: nền navy + guilloché + mặt số mô phỏng -->
    <div class="placeholder absolute inset-0 hidden items-center justify-center p-4 text-center">
      <!--
        SVG dùng viewBox 0 0 200 200 với preserveAspectRatio="xMidYMid meet",
        tự co giãn và giữ tỷ lệ vuông ở giữa khung dù khung là 16:10, 4:3 hay 1:1.
        Hoa văn guilloché qua <pattern> lặp các đường tròn đồng tâm, opacity 5%.
      -->
      <svg
        class="h-full w-full"
        viewBox="0 0 200 200"
        preserveAspectRatio="xMidYMid meet"
        role="img"
        aria-label={alt}
      >
        <defs>
          <!-- Hoa văn guilloché: các đường tròn đồng tâm, lặp toàn nền -->
          <pattern id="guilloche" width="24" height="24" patternUnits="userSpaceOnUse" patternTransform="rotate(0)">
            <circle cx="12" cy="12" r="1.5" fill="none" stroke="currentColor" stroke-width="0.4" class="guilloche-stroke" />
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="0.3" class="guilloche-stroke" />
            <circle cx="12" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="0.25" class="guilloche-stroke" />
          </pattern>
        </defs>

        <!-- Lớp nền navy (dark mode dùng dark-surface qua class) -->
        <rect width="200" height="200" class="placeholder-bg" />

        <!-- Lớp guilloché phủ toàn nền, độ mờ 5% -->
        <rect width="200" height="200" fill="url(#guilloche)" opacity="0.05" class="guilloche-stroke" />

        <!-- Mặt số mô phỏng ở giữa -->
        <g transform="translate(100 100)">
          <!-- Vòng tròn viền mảnh (vành mặt số) -->
          <circle r="42" fill="none" stroke="currentColor" stroke-width="1" class="dial-ring" />
          <circle r="40" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.5" class="dial-ring" />

          <!-- 12 vạch chỉ giờ ngắn -->
          {Array.from({ length: 12 }).map((_, i) => {
            const angle = (i * 30 - 90) * (Math.PI / 180);
            const x1 = Math.cos(angle) * 34;
            const y1 = Math.sin(angle) * 34;
            const x2 = Math.cos(angle) * 38;
            const y2 = Math.sin(angle) * 38;
            return (
              <line
                x1={x1.toFixed(2)} y1={y1.toFixed(2)}
                x2={x2.toFixed(2)} y2={y2.toFixed(2)}
                stroke="currentColor" stroke-width="1.2" stroke-linecap="round"
                class="dial-mark"
              />
            );
          })}

          <!-- Chữ cái đầu của alt, font serif, màu brass, cỡ lớn -->
          <text
            x="0" y="0"
            text-anchor="middle" dominant-baseline="central"
            class="dial-initial"
          >{firstChar}</text>
        </g>
      </svg>
    </div>
  </div>
  {caption && (
    <figcaption class="mt-2 text-center text-xs text-ink-soft/90 dark:text-dark-text-soft/70">{caption}</figcaption>
  )}
</figure>

<style is:global>
  /*
    Màu cho placeholder WatchImage — tách ra để dễ đổi và đảm bảo tương phản.
    Nền navy đậm + hoa văn/đường nét màu brass (trộn cả guilloché và vành mặt số).
    Chế độ tối: nền dark-surface, đường nét sáng hơn (dark-brass).
  */
  .watch-image .placeholder-bg {
    fill: #1F2D3D; /* navy */
  }
  .watch-image .guilloche-stroke,
  .watch-image .dial-ring,
  .watch-image .dial-mark {
    color: #B8893C; /* brass */
  }
  .watch-image .dial-initial {
    fill: #B8893C;             /* brass */
    font-family: "Newsreader", Georgia, serif;
    font-size: 34px;
    font-weight: 600;
  }

  /* Chế độ tối: nền sáng hơn một chút, đường nét sáng hơn cho tương phản */
  :root.dark .watch-image .placeholder-bg {
    fill: #252830; /* dark-surface */
  }
  :root.dark .watch-image .guilloche-stroke,
  :root.dark .watch-image .dial-ring,
  :root.dark .watch-image .dial-mark,
  :root.dark .watch-image .dial-initial {
    color: #D4A85A; /* dark-brass */
    fill: #D4A85A;
  }
</style>

<style>
  /* Hiệu ứng fade-in khi ảnh tải xong */
  .watch-image img {
    opacity: 0;
    transition: opacity 0.4s ease-in;
  }
  .watch-image .loaded img {
    opacity: 1;
  }
  /* Khi ảnh tải xong → ẩn placeholder */
  .watch-image .loaded .placeholder {
    display: none !important;
  }
</style>
