---
// =============================================================================
// INFOGRAPHIC: CHỐNG TỪ (Anti-Magnetic)
// =============================================================================
// Chuẩn nội dung duy nhất: src/content/coChe/vi/chong-tu.md — mọi câu hiển thị
// phải chỉ ra được căn cứ trong bài đó; không có căn cứ trong bài thì không
// hiển thị. Chi tiết những gì đã rút khỏi bản trước được ghi trong biên bản
// nghiệm thu gói P0.1 (docs/nghiem-thu/).
//
// 4 cảnh:
//   1. Mở đầu — bộ máy cơ có thể nhiễm từ, ảnh hưởng độ chính xác (theo Oris)
//   2. Minh họa nguyên lý ĐỊNH TÍNH (MechanismAnimation + thanh trượt tăng dần
//      không mang đơn vị đo, không mô phỏng số giây sai lệch)
//   3. Mức chống từ là thông số của từng bộ máy, từng chứng nhận (Oris / METAS
//      — đúng như bài viết)
//   4. Đồng hồ chạy bất thường — nên làm gì (không tự kết luận nguyên nhân)
// =============================================================================

import MechanismAnimation from './MechanismAnimation.astro';

// Hai ví dụ có căn cứ trực tiếp trong bài viết (chong-tu.md):
// một calibre (Oris) và một chứng nhận (METAS).
const examples = [
  {
    tag: 'Ví dụ một calibre',
    title: 'Oris Calibre 400',
    lines: [
      'Dùng hơn 30 linh kiện phi từ (theo Oris).',
      'Sau khi tiếp xúc 2.250 gauss, độ lệch còn dưới 10 giây/ngày — Oris mô tả calibre này vượt chuẩn ISO 764 (theo bài).',
    ],
  },
  {
    tag: 'Ví dụ một chứng nhận',
    title: 'METAS MASTER CHRONOMETER',
    lines: [
      'Kiểm tra cả "khả năng kháng từ trường"; tài liệu yêu cầu nêu mức 1,5 T (15.000 gauss) cho chứng nhận này.',
      'Mở cho mọi hãng có đồng hồ Swiss Made với bộ máy đạt chứng nhận chronometer theo ISO 3159 (theo METAS).',
    ],
  },
];

// Ba điều cần nhớ — đúng ba ý của bài viết.
const takeaways = [
  'Mức chịu từ phụ thuộc thiết kế từng bộ máy và chuẩn công bố của từng calibre, từng chứng nhận.',
  'Không có con số chống từ dùng chung cho đồng hồ cơ — mỗi nguồn công bố cho phạm vi của riêng nó.',
  'Một chiếc đồng hồ chạy bất thường có nhiều nguyên nhân; việc xác định nguyên nhân thuộc về người có chuyên môn.',
];
---

<section class="infographic my-12" data-infographic="anti-magnetic">
  <!-- ====================================================================
       CẢNH 1: MỞ ĐẦU
       ==================================================================== -->
  <div class="scene scene-intro infographic-intro">
    <p class="mb-3 text-sm uppercase tracking-widest text-brass-light">Infographic động</p>
    <h2 class="font-serif text-3xl sm:text-5xl">Chống từ — thông số của từng bộ máy</h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream/80">
      Bộ máy cơ có thể nhiễm từ, và điều này ảnh hưởng tới độ chính xác (theo Oris).
      Nhưng <strong class="text-brass-light">mức chịu từ không có con số dùng chung</strong> —
      nó là thông số của từng calibre, từng chứng nhận. Cuộn xuống để hiểu.
    </p>
    <div class="mt-8 intro-arrow text-brass-light">↓</div>
  </div>

  <!-- ====================================================================
       CẢNH 2: MINH HỌA NGUYÊN LÝ ĐỊNH TÍNH — HOẠT ẢNH TƯƠNG TÁC
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      Minh họa nguyên lý — linh kiện thường và linh kiện phi từ
    </h3>
    <p class="mx-auto mb-8 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft">
      Kéo thanh trượt để thấy ở mức <strong>minh họa</strong>: linh kiện thường có thể bị ảnh hưởng
      khi từ trường tăng, linh kiện phi từ không. Đây là <strong>minh họa nguyên lý</strong> —
      không phải phép đo và không có ngưỡng kỹ thuật.
    </p>

    <MechanismAnimation label="Kéo thanh trượt minh họa từ trường tăng dần — linh kiện thường bị ảnh hưởng, linh kiện phi từ không đổi" data-mech-step-id="anti-magnetic">
      <svg viewBox="0 0 600 340" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-2xl" id="anti-magnetic-svg" aria-hidden="true" focusable="false">
        <text style="fill:var(--ig-stroke)" x="300" y="20" text-anchor="middle" font-size="11" font-weight="bold" class="">
          Minh họa: cùng mức từ trường tăng dần — hai linh kiện khác nhau
        </text>

        <!-- ====== BÊN TRÁI: LINH KIỆN THƯỜNG (MINH HỌA) ====== -->
        <g transform="translate(150, 140)">
          <text style="fill:var(--ig-rubi)" x="0" y="-70" text-anchor="middle" font-size="11" font-weight="bold">Linh kiện thường (minh họa)</text>
          <g id="am-steel-spring">
            <path style="stroke:var(--ig-rubi)" id="am-steel-path" d="" fill="none" stroke-width="2"/>
          </g>
          <circle style="fill:var(--ig-rubi)" r="3"/>
          <text style="fill:var(--ig-rubi)" id="am-steel-error" x="0" y="80" text-anchor="middle" font-size="12" font-weight="bold">dao động không đổi</text>
          <text style="fill:var(--ig-rubi)" x="0" y="95" text-anchor="middle" font-size="9" opacity="0.7">minh họa: bị ảnh hưởng khi từ trường tăng</text>
        </g>

        <!-- ====== ĐƯỜNG PHÂN CÁCH GIỮA ====== -->
        <line style="stroke:var(--ig-stroke-soft)" x1="300" y1="50" x2="300" y2="230" stroke-width="0.5" stroke-dasharray="6 4" opacity="0.3"/>

        <!-- ====== BÊN PHẢI: LINH KIỆN PHI TỪ (MINH HỌA) ====== -->
        <g transform="translate(450, 140)">
          <text x="0" y="-70" text-anchor="middle" font-size="11" style="fill:var(--obs-steel-deep)" font-weight="bold">Linh kiện phi từ (minh họa)</text>
          <g id="am-silicon-spring">
            <path id="am-silicon-path" d="" fill="none" style="stroke:var(--obs-steel)" stroke-width="2"/>
          </g>
          <circle r="3" style="fill:var(--obs-steel)"/>
          <text id="am-silicon-error" x="0" y="80" text-anchor="middle" font-size="12" style="fill:var(--obs-steel-deep)" font-weight="bold">dao động không đổi</text>
          <text x="0" y="95" text-anchor="middle" font-size="9" style="fill:var(--obs-steel-deep)" opacity="0.7">minh họa: không bị ảnh hưởng</text>
        </g>

        <!-- ====== DÒNG TỪ TRƯỜNG (hiện khi > 0) ====== -->
        <g id="am-field-lines" opacity="0">
          <line x1="40" y1="80" x2="560" y2="80" style="stroke:var(--obs-steel)" stroke-width="1" stroke-dasharray="3 4"/>
          <line x1="40" y1="200" x2="560" y2="200" style="stroke:var(--obs-steel)" stroke-width="1" stroke-dasharray="3 4"/>
          <line x1="40" y1="140" x2="560" y2="140" style="stroke:var(--obs-steel)" stroke-width="1.5" stroke-dasharray="4 3"/>
          <text x="570" y="144" font-size="9" style="fill:var(--obs-steel)" font-weight="bold">B</text>
        </g>

        <!-- ====== THANH TRƯỜT MINH HỌA — không đơn vị, không ngưỡng ====== -->
        <text style="fill:var(--ig-stroke)" x="300" y="270" text-anchor="middle" font-size="10" font-weight="bold" class="">Mức từ trường minh họa (tăng dần)</text>
        <rect style="stroke:var(--ig-stroke)" x="100" y="280" width="400" height="20" rx="4" fill="none" stroke-width="1.5" class="dark:stroke-dark-text"/>
        <rect id="am-field-fill" x="102" y="282" width="0" height="16" rx="2" style="fill:var(--obs-steel)"/>
        <foreignObject x="95" y="275" width="410" height="30">
          <input type="range" id="am-field-slider" min="0" max="3" value="0" step="1" style="width:100%;accent-color:var(--obs-steel);touch-action:none;" aria-label="Mức từ trường minh họa tăng dần — chỉ minh họa nguyên lý, không phải phép đo" />
        </foreignObject>
        <text id="am-field-label" x="300" y="325" text-anchor="middle" font-size="12" style="fill:var(--obs-steel)" font-weight="bold" class="dark:fill-dark-text-soft">chưa có từ trường (minh họa)</text>
      </svg>

      <script is:inline define:vars={{}} slot="script">
        (function() {
          const svg = document.getElementById('anti-magnetic-svg');
          if (!svg) return;
          const slider = svg.querySelector('#am-field-slider');
          const fieldFill = svg.querySelector('#am-field-fill');
          const fieldLabel = svg.querySelector('#am-field-label');
          const fieldLines = svg.querySelector('#am-field-lines');
          const steelPath = svg.querySelector('#am-steel-path');
          const siliconPath = svg.querySelector('#am-silicon-path');
          if (!slider) return;

          // Sinh đường xoắn ốc dây tóc (chỉ minh họa hình dạng, không gắn đơn vị đo)
          function spiralPath(rMax, coils, affected) {
            let d = '';
            const points = coils * 24;
            for (let i = 0; i <= points; i++) {
              const t = i / points;
              const angle = t * coils * Math.PI * 2;
              let r = rMax * (1 - t * 0.8);
              r = r * (1 - affected * 0.35);
              const x = r * Math.cos(angle);
              const y = r * Math.sin(angle);
              d += (i === 0 ? 'M' : 'L') + x.toFixed(1) + ' ' + y.toFixed(1) + ' ';
            }
            return d;
          }

          function render() {
            const level = parseInt(slider.value, 10); // 0..3 — chỉ mức minh họa
            fieldFill.setAttribute('width', String((level / 3) * 396));
            fieldLabel.textContent = ['chưa có từ trường (minh họa)', 'mức yếu (minh họa)', 'mức vừa (minh họa)', 'mức mạnh (minh họa)'][level];

            // Dòng từ trường minh họa hiện dần
            fieldLines.setAttribute('opacity', level === 0 ? '0' : String(0.2 + level * 0.15));

            // Linh kiện thường: minh họa dạng thay đổi rõ hơn khi mức tăng
            steelPath.setAttribute('d', spiralPath(45, 4, level / 3));
            // Linh kiện phi từ: không đổi
            siliconPath.setAttribute('d', spiralPath(45, 4, 0));
          }

          slider.addEventListener('input', render);

          // Đăng ký hàm step rỗng (MechanismAnimation cần để hiện controls)
          (window.__mechSteps = window.__mechSteps || {})['anti-magnetic'] = function() {};

          render();
        })();
      </script>
    </MechanismAnimation>

    <p class="mx-auto mb-12 mt-8 max-w-2xl text-center text-sm text-ink-soft dark:text-dark-text-soft">
      Đây chỉ là <strong>minh họa nguyên lý</strong> ở mức khái niệm: mức ảnh hưởng cụ thể của từ trường
      phụ thuộc thiết kế từng bộ máy — không có ngưỡng dùng chung để "đọc" từ hình vẽ này.
    </p>

    <div class="grid gap-8 md:grid-cols-2">
      <!-- Ví dụ 1: một calibre (Oris) — đúng như bài viết -->
      <div class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-6" data-anim="method-card">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-steel dark:text-dark-text-soft">{examples[0].tag}</p>
        <h3 class="mb-2 font-serif text-lg text-navy dark:text-dark-text">{examples[0].title}</h3>
        {examples[0].lines.map((line) => (
          <p class="mb-2 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">{line}</p>
        ))}
        <p class="mt-3 text-xs text-ink-soft/90 dark:text-dark-text-soft/70">Đây là thông số công bố cho calibre đó — không phải mức dùng chung.</p>
      </div>

      <!-- Ví dụ 2: một chứng nhận (METAS) — đúng như bài viết -->
      <div class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-6" data-anim="method-card">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-steel dark:text-dark-text-soft">{examples[1].tag}</p>
        <h3 class="mb-2 font-serif text-lg text-navy dark:text-dark-text">{examples[1].title}</h3>
        {examples[1].lines.map((line) => (
          <p class="mb-2 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">{line}</p>
        ))}
        <p class="mt-3 text-xs text-ink-soft/90 dark:text-dark-text-soft/70">15.000 gauss là tiêu chí của chứng nhận MASTER CHRONOMETER — không phải mức chống từ chung của đồng hồ cơ.</p>
      </div>
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 3: BA ĐIỀU CẦN NHỚ (không thang gauss dùng chung)
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      Ba điều cần nhớ
    </h3>
    <p class="mx-auto mb-8 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft">
      Không có "thang mức chống từ" dùng chung — mỗi nguồn công bố cho phạm vi của riêng nó.
    </p>

    <div class="space-y-4">
      {takeaways.map((text, i) => (
        <div
          class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4 sm:p-5"
          data-anim="level"
          data-index={i}
        >
          <div class="flex items-start gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-steel font-mono text-sm font-semibold text-steel dark:border-steel" style="font-variant-numeric: lining-nums;" aria-hidden="true">{i + 1}</span>
            <p class="text-sm leading-relaxed text-ink dark:text-dark-text sm:text-base">{text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 4: ĐỒNG HỒ CHẠY BẤT THƯỜNG — NÊN LÀM GÌ (không tự kết luận)
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      Đồng hồ chạy bất thường — nên làm gì?
    </h3>
    <p class="mx-auto mb-8 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft">
      Một chiếc đồng hồ đột nhiên lệch giờ có nhiều nguyên nhân khác nhau. Từ một dấu hiệu duy nhất,
      không nên tự kết luận "đồng hồ bị nhiễm từ" — việc xác định nguyên nhân thuộc về người có chuyên môn.
    </p>

    <div class="mx-auto max-w-2xl space-y-3">
      <div class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4" data-anim="source-card" data-index="0">
        <p class="text-sm leading-relaxed text-ink dark:text-dark-text">Tra <strong>tài liệu của hãng</strong> về đồng hồ của bạn trước tiên.</p>
      </div>
      <div class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4" data-anim="source-card" data-index="1">
        <p class="text-sm leading-relaxed text-ink dark:text-dark-text">Mang tới <strong>nơi có chuyên môn</strong> để kiểm tra — họ mới là người xác định nguyên nhân và cách xử lý.</p>
      </div>
      <div class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4" data-anim="source-card" data-index="2">
        <p class="text-sm leading-relaxed text-ink dark:text-dark-text">Việc <a class="font-medium text-steel underline-offset-2 hover:underline dark:text-steel" href="/huong-dan/do-sai-so">đo sai số</a> giúp quan sát độ chính xác theo thời gian — hữu ích khi làm việc với nơi chuyên môn, nhưng không thay thế việc xác định nguyên nhân.</p>
      </div>
    </div>
  </div>

  <!-- Chú thích cuối — đúng ba ý của bài -->
  <div class="infographic-note">
    <strong class="text-brass dark:text-dark-brass">💡 Tóm tắt:</strong>
    Bộ máy cơ có thể nhiễm từ và điều này ảnh hưởng độ chính xác. Mức chống từ là thông số của
    từng bộ máy và từng chuẩn công bố — không có ngưỡng dùng chung. Khi đồng hồ chạy bất thường,
    hãy để người có chuyên môn xác định nguyên nhân.
  </div>
</section>

<style>
  .svg-container svg {
    width: 100%;
    height: auto;
  }

  .scene [data-anim] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    will-change: opacity, transform;
  }

  .scene [data-anim="level"] {
    transform: translateX(-30px);
  }

  .scene [data-anim].reveal-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .scene [data-anim] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initInfographic() {
    const root = document.querySelector('[data-infographic="anti-magnetic"]');
    if (!root) return;

    const revealTargets = root.querySelectorAll('[data-anim]');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );

    revealTargets.forEach((el) => observer.observe(el));

    setTimeout(() => {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
    }, 3000);
  }

  initInfographic();
</script>
