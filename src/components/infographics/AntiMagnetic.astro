---
// =============================================================================
// INFOGRAPHIC: CHỐNG TỪ (Anti-Magnetic)
// =============================================================================
// Hoạt ảnh: cảnh 2 dùng MechanismAnimation (so sánh 2 dây tóc thép vs silicon
// dưới từ trường tăng dần — thép bị hút dính + sai số tăng, silicon không đổi).
// Các cảnh khác giữ CSS reveal + Intersection Observer.
//
// 4 cảnh:
//   1. Mở đầu — vấn đề từ trường giấu mặt
//   2. So sánh 2 dây tóc dưới từ trường — HOẠT ẢNH TƯƠNG TÁC
//   3. Thang mức độ — từ vài trăm gauss đến 15.000 gauss
//   4. Nguồn từ trường quanh bạn — và mẹo phòng tránh
// =============================================================================

import MechanismAnimation from './MechanismAnimation.astro';

// Dữ liệu các mức chống từ
const levels = [
  {
    value: '600 gauss',
    label: 'Không chống từ',
    detail: 'Đa số đồng hồ cơ thông thường',
    note: 'Loa điện thoại, nam châm tủ lạnh có thể làm sai số',
    barWidth: 8,
    tone: 'bad',
  },
  {
    value: '1.000 gauss',
    label: 'Đồng hồ pilot cổ điển',
    detail: 'IWC Mark XI, Rolex Milgauss (cũ)',
    note: 'Lồng sắt mềm (soft iron cage)',
    barWidth: 15,
    tone: 'ok',
  },
  {
    value: '4.800 gauss',
    label: 'Rolex Milgauss / Omega PoA',
    detail: 'Lồng sắt + vật liệu đặc biệt',
    note: 'Từ trường công nghiệp nhẹ',
    barWidth: 35,
    tone: 'good',
  },
  {
    value: '15.000 gauss',
    label: 'Omega Master Chronometer',
    detail: 'Silicon + chứng nhận METAS',
    note: 'Loa, điện thoại, iPad — không ảnh hưởng',
    barWidth: 100,
    tone: 'great',
  },
];

// Nguồn từ trường quanh ta
const sources = [
  { icon: '📱', name: 'Điện thoại di động', strength: 'Trung bình', risk: 'Nguy hiểm nếu để cạnh nhiều giờ' },
  { icon: '🔊', name: 'Loa (máy tính, loa bluetooth)', strength: 'Cao', risk: 'Có nam châm mạnh bên trong' },
  { icon: '🧲', name: 'Nam châm tủ lạnh', strength: 'Cao', risk: 'Tránh dán đồng hồ lên' },
  { icon: '💻', name: 'iPad / tablet + ốp từ', strength: 'Cao', risk: 'Ốp từ có nam châm mạnh' },
  { icon: '👜', name: 'Túi xách có nam châm', strength: 'Trung bình', risk: 'Đặt đồng hồ vào túi lâu' },
  { icon: '🏥', name: 'Thiết bị y tế (MRI)', strength: 'Cực cao', risk: 'Tuyệt đối không đeo vào phòng MRI' },
];
---

<section class="infographic my-12" data-infographic="anti-magnetic">
  <!-- ====================================================================
       CẢNH 1: MỞ ĐẦU
       ==================================================================== -->
  <div class="scene scene-intro rounded-2xl border border-cream-dark dark:border-dark-border bg-gradient-to-b from-navy to-navy-light p-8 text-center text-cream sm:p-16">
    <p class="mb-3 text-sm uppercase tracking-widest text-brass-light">Infographic động</p>
    <h2 class="font-serif text-3xl sm:text-5xl">Kẻ thù giấu mặt của đồng hồ cơ</h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream/80">
      Bạn để đồng hồ cạnh điện thoại, loa, iPad — và tự nhiên nó chạy sai nhiều giây/ngày.
      Đó có thể là do <strong class="text-brass-light">từ trường</strong>. Cuộn xuống để hiểu.
    </p>
    <div class="mt-8 animate-bounce text-brass-light">↓</div>
  </div>

  <!-- ====================================================================
       CẢNH 2: SO SÁNH 2 DÂY TÓC DƯỚI TỪ TRƯỜNG — HOẠT ẢNH TƯƠNG TÁC
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      Hai cách đồng hồ chống từ
    </h3>
    <p class="mx-auto mb-8 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft dark:text-dark-text-soft">
      Từ trường làm <strong>dây tóc</strong> (phần mỏng manh nhất) bị nhiễm từ → sai số.
      Kéo thanh trượt bên dưới để thấy sự khác nhau giữa dây tóc thép và silicon.
    </p>

    <MechanismAnimation label="Kéo thanh trượt từ trường — dây tóc thép bị nhiễm, silicon không đổi" data-mech-step-id="anti-magnetic">
      <svg viewBox="0 0 600 340" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-2xl" id="anti-magnetic-svg">
        <text x="300" y="20" text-anchor="middle" font-size="11" fill="#1F2D3D" font-weight="bold" class="dark:fill-dark-text">
          Cùng một từ trường — hai phản ứng khác nhau
        </text>

        <!-- ====== BÊN TRÁI: DÂY TÓC THÉP ====== -->
        <g transform="translate(150, 140)">
          <text x="0" y="-70" text-anchor="middle" font-size="11" fill="#9B2C2C" font-weight="bold">Dây tóc thép</text>
          <!-- Dây tóc thép (xoắn ốc — bị hút dính khi từ trường cao) -->
          <g id="am-steel-spring">
            <path id="am-steel-path" d="" fill="none" stroke="#9B2C2C" stroke-width="2.5"/>
          </g>
          <circle r="3" fill="#9B2C2C"/>
          <!-- Sai số -->
          <text id="am-steel-error" x="0" y="80" text-anchor="middle" font-size="12" fill="#9B2C2C" font-weight="bold">±0 giây/ngày</text>
          <text x="0" y="95" text-anchor="middle" font-size="9" fill="#9B2C2C" opacity="0.7">chạy sai khi nhiễm từ</text>
        </g>

        <!-- ====== ĐƯỜNG PHÂN CÁCH GIỮA ====== -->
        <line x1="300" y1="50" x2="300" y2="230" stroke="#FAF7F2" stroke-width="0.75" stroke-dasharray="6 4" opacity="0.3"/>

        <!-- ====== BÊN PHẢI: DÂY TÓC SILICON ====== -->
        <g transform="translate(450, 140)">
          <text x="0" y="-70" text-anchor="middle" font-size="11" fill="#2D7A55" font-weight="bold">Dây tóc silicon</text>
          <!-- Dây tóc silicon (không đổi dù từ trường cao) -->
          <g id="am-silicon-spring">
            <path id="am-silicon-path" d="" fill="none" stroke="#2D7A55" stroke-width="2.5"/>
          </g>
          <circle r="3" fill="#2D7A55"/>
          <!-- Sai số -->
          <text id="am-silicon-error" x="0" y="80" text-anchor="middle" font-size="12" fill="#2D7A55" font-weight="bold">±0 giây/ngày</text>
          <text x="0" y="95" text-anchor="middle" font-size="9" fill="#2D7A55" opacity="0.7">không bị ảnh hưởng</text>
        </g>

        <!-- ====== DÒNG TỪ TRƯỜNG (hiện khi > 0) ====== -->
        <g id="am-field-lines" opacity="0">
          <line x1="40" y1="80" x2="560" y2="80" stroke="#3182CE" stroke-width="1" stroke-dasharray="3 4"/>
          <line x1="40" y1="200" x2="560" y2="200" stroke="#3182CE" stroke-width="1" stroke-dasharray="3 4"/>
          <line x1="40" y1="140" x2="560" y2="140" stroke="#3182CE" stroke-width="1.5" stroke-dasharray="4 3"/>
          <text x="570" y="144" font-size="9" fill="#3182CE" font-weight="bold">B</text>
        </g>

        <!-- ====== THANH TRƯỢT TỪ TRƯỜNG ====== -->
        <text x="300" y="270" text-anchor="middle" font-size="10" fill="#1F2D3D" font-weight="bold" class="dark:fill-dark-text">Cường độ từ trường</text>
        <rect x="100" y="280" width="400" height="20" rx="4" fill="none" stroke="#1F2D3D" stroke-width="1.5" class="dark:stroke-dark-text"/>
        <rect id="am-field-fill" x="102" y="282" width="0" height="16" rx="2" fill="#3182CE"/>
        <foreignObject x="95" y="275" width="410" height="30">
          <input type="range" id="am-field-slider" min="0" max="15000" value="0" step="500" style="width:100%;accent-color:#3182CE;touch-action:none;" aria-label="Cường độ từ trường (gauss)" />
        </foreignObject>
        <text id="am-field-label" x="300" y="325" text-anchor="middle" font-size="12" fill="#3182CE" font-weight="bold" class="dark:fill-dark-text-soft">0 gauss</text>
      </svg>

      <script is:inline define:vars={{}} slot="script">
        (function() {
          const svg = document.getElementById('anti-magnetic-svg');
          if (!svg) return;
          const slider = svg.querySelector('#am-field-slider');
          const fieldFill = svg.querySelector('#am-field-fill');
          const fieldLabel = svg.querySelector('#am-field-label');
          const fieldLines = svg.querySelector('#am-field-lines');
          const steelPath = svg.querySelector('#am-steel-path');
          const siliconPath = svg.querySelector('#am-silicon-path');
          const steelError = svg.querySelector('#am-steel-error');
          const siliconError = svg.querySelector('#am-silicon-error');
          if (!slider) return;

          // Sinh đường xoắn ốc dây tóc (bán kính có thể thay đổi)
          function spiralPath(rMax, coils, collapse) {
            // collapse: 0 = xoắn bình thường, 1 = các vòng hút dính vào nhau
            let d = '';
            const points = coils * 24;
            for (let i = 0; i <= points; i++) {
              const t = i / points;
              const angle = t * coils * Math.PI * 2;
              let r = rMax * (1 - t * 0.8); // xoắn vào trong
              // Khi nhiễm từ: các vòng hút dính → bán kính giảm theo collapse
              r = r * (1 - collapse * 0.5);
              const x = r * Math.cos(angle);
              const y = r * Math.sin(angle);
              d += (i === 0 ? 'M' : 'L') + x.toFixed(1) + ' ' + y.toFixed(1) + ' ';
            }
            return d;
          }

          function render() {
            const gauss = parseInt(slider.value);
            // Thanh trượt
            fieldFill.setAttribute('width', String((gauss / 15000) * 396));
            fieldLabel.textContent = gauss.toLocaleString('vi-VN') + ' gauss';

            // Dòng từ trường hiện khi > 0
            fieldLines.setAttribute('opacity', gauss > 0 ? String(Math.min(0.6, gauss / 10000)) : '0');

            // Dây tóc thép: nhiễm từ khi > ~100 gauss
            // Mức độ "dính": tăng từ 0 tới 1 khi gauss tới 5000+
            const steelCollapse = Math.min(1, Math.max(0, (gauss - 100) / 5000));
            steelPath.setAttribute('d', spiralPath(45, 4, steelCollapse));

            // Dây tóc silicon: không đổi
            siliconPath.setAttribute('d', spiralPath(45, 4, 0));

            // Sai số: thép chạy nhanh khi nhiễm từ
            // ~0 dưới 100 gauss, tăng tới ~300 giây/ngày ở 5000+ gauss
            const steelErr = gauss < 100 ? 0 : Math.min(300, Math.round((gauss - 100) / 15));
            steelError.textContent = (steelErr === 0 ? '±0' : '+' + steelErr) + ' giây/ngày';
            siliconError.textContent = '±0 giây/ngày';
          }

          slider.addEventListener('input', render);

          // Đăng ký hàm step rỗng (MechanismAnimation cần để hiện controls)
          (window.__mechSteps = window.__mechSteps || {})['anti-magnetic'] = function() {};

          render();
        })();
      </script>
    </MechanismAnimation>

    <p class="mx-auto mb-12 mt-8 max-w-2xl text-center text-sm text-ink-soft dark:text-dark-text-soft dark:text-dark-text-soft">
      Kéo thanh trượt: khi từ trường mạnh, dây tóc thép (trái) bị <strong>hút dính các vòng vào nhau</strong> → chu kỳ dao động ngắn lại → đồng hồ chạy nhanh. Dây tóc silicon (phải) không hề thay đổi.
    </p>

    <div class="grid gap-8 md:grid-cols-2">
      <!-- Cách 1: Lồng sắt -->
      <div class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-6" data-anim="method-card">
        <div class="svg-container mb-4">
          <svg viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-xs">
            <!-- Lồng sắt (soft iron cage) - lớp bao ngoài -->
            <rect x="60" y="40" width="180" height="120" rx="8" fill="none" stroke="#4A5568" stroke-width="4" stroke-dasharray="6 3" data-anim="iron-cage" opacity="0"/>
            <!-- Movement ở giữa -->
            <rect x="90" y="65" width="120" height="70" rx="4" fill="#B8893C" opacity="0.4"/>
            <text x="150" y="105" text-anchor="middle" font-size="11" fill="#1A1A1A" font-weight="bold">Máy</text>
            <!-- Mũi tên từ trường bị chặn -->
            <g data-anim="field-blocked" opacity="0">
              <line x1="30" y1="100" x2="55" y2="100" stroke="#3182CE" stroke-width="2.5"/>
              <polygon points="55,100 48,95 48,105" fill="#3182CE"/>
              <text x="20" y="90" text-anchor="middle" font-size="9" fill="#3182CE" font-weight="bold">Từ trường</text>
              <text x="20" y="120" text-anchor="middle" font-size="8" fill="#9B2C2C">✗ bị chặn</text>
            </g>
            <text x="150" y="185" text-anchor="middle" font-size="10" fill="#1F2D3D" font-weight="bold">Lồng sắt dẫn từ trường đi vòng quanh máy</text>
          </svg>
        </div>
        <h4 class="mb-2 font-serif text-lg text-navy dark:text-dark-text dark:text-dark-text">① Lồng sắt mềm (Soft Iron Cage)</h4>
        <p class="text-sm text-ink-soft dark:text-dark-text-soft dark:text-dark-text-soft">
          Bọc máy bằng một lớp <strong>sắt mềm</strong> — vật liệu dẫn từ rất tốt. Khi từ trường ngoài
          tới, nó bị <strong>dẫn đi vòng quanh</strong> máy, không vào trong được. Cách cổ điển,
          dùng cho IWC Mark XI, Rolex Milgauss.
        </p>
        <p class="mt-2 text-xs text-ink-soft/70 dark:text-dark-text-soft/70">Hạn chế: làm đồng hồ dày hơn, khó có mặt sau lộ máy.</p>
      </div>

      <!-- Cách 2: Vật liệu silicon -->
      <div class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-6" data-anim="method-card">
        <div class="svg-container mb-4">
          <svg viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-xs">
            <!-- Dây tóc (silicon) - cuộn nhỏ -->
            <g data-anim="silicon-hairspring" opacity="0">
              <path d="M 150 100
                       m -30 0
                       a 30 30 0 1 1 60 0
                       a 24 24 0 1 1 -48 0
                       a 18 18 0 1 1 36 0
                       a 12 12 0 1 1 -24 0"
                    fill="none" stroke="#2D9D6C" stroke-width="2.5"/>
              <circle cx="150" cy="100" r="4" fill="#2D9D6C"/>
              <text x="150" y="145" text-anchor="middle" font-size="9" fill="#1A1A1A" font-weight="bold">Dây tóc silicon</text>
            </g>
            <!-- Từ trường đi qua nhưng không ảnh hưởng -->
            <g data-anim="field-pass" opacity="0">
              <line x1="30" y1="60" x2="270" y2="60" stroke="#3182CE" stroke-width="2" stroke-dasharray="4 3"/>
              <line x1="30" y1="140" x2="270" y2="140" stroke="#3182CE" stroke-width="2" stroke-dasharray="4 3"/>
              <text x="150" y="180" text-anchor="middle" font-size="8" fill="#2D7A55" font-weight="bold">✓ Đi qua nhưng không gây hại</text>
            </g>
          </svg>
        </div>
        <h4 class="mb-2 font-serif text-lg text-navy dark:text-dark-text dark:text-dark-text">② Vật liệu silicon / phi từ</h4>
        <p class="text-sm text-ink-soft dark:text-dark-text-soft dark:text-dark-text-soft">
          Làm <strong>dây tóc bằng silicon</strong> (hoặc hợp chất phi từ như Nivachron, Spron).
          Vì silicon <strong>không bị nhiễm từ</strong>, từ trường ngoài không làm nó biến dạng.
          Cách hiện đại, dùng cho Omega Master, Tudor, Tissot, Rolex Syloxi.
        </p>
        <p class="mt-2 text-xs text-ink-soft/70 dark:text-dark-text-soft/70">Ưu điểm: mỏng hơn, có thể lộ máy, hiệu quả cao (lên tới 15.000 gauss).</p>
      </div>
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 3: THANG MỨC ĐỘ CHỐNG TỪ
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      Thang mức độ chống từ
    </h3>
    <p class="mx-auto mb-12 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft dark:text-dark-text-soft">
      Đo bằng <strong>gauss</strong> (đơn vị từ trường). Càng cao càng chống được từ trường mạnh hơn.
    </p>

    <div class="space-y-4">
      {levels.map((level, i) => (
        <div
          class="grid grid-cols-12 items-center gap-4 rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4 sm:p-5"
          data-anim="level"
          data-index={i}
        >
          <div class="col-span-12 sm:col-span-4">
            <div class="h-10 w-full overflow-hidden rounded bg-cream-dark">
              <div
                class={`flex h-full items-center justify-end rounded pr-2 text-xs font-bold text-white ${
                  level.tone === 'great' ? 'bg-gradient-to-r from-[#2D9D6C] to-[#1A7A55]' :
                  level.tone === 'good' ? 'bg-gradient-to-r from-[#4FB286] to-[#2D9D6C]' :
                  level.tone === 'ok' ? 'bg-gradient-to-r from-[#B8893C] to-[#9B6E2C]' :
                  'bg-gradient-to-r from-[#9B2C2C] to-[#742A2A]'
                }`}
                style={`width: ${level.barWidth}%;`}
              >
                {level.value}
              </div>
            </div>
          </div>
          <div class="col-span-12 sm:col-span-8">
            <h4 class="font-serif text-lg text-navy dark:text-dark-text dark:text-dark-text">{level.label}</h4>
            <p class="mt-1 text-sm text-ink-soft dark:text-dark-text-soft dark:text-dark-text-soft">
              <span class="font-medium text-[#2D7A55]">{level.detail}</span>
            </p>
            <p class="mt-1 text-xs text-ink-soft/80">{level.note}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 4: NGUỒN TỪ TRƯỜNG QUANH BẠN
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      Từ trường ở đâu quanh bạn?
    </h3>
    <p class="mx-auto mb-12 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft dark:text-dark-text-soft">
      Nhiều vật dụng hàng ngày có nam châm — nguy cơ cho đồng hồ cơ thông thường.
    </p>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {sources.map((source, i) => (
        <div
          class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4"
          data-anim="source-card"
          data-index={i}
        >
          <div class="flex items-start gap-3">
            <span class="text-3xl">{source.icon}</span>
            <div>
              <h4 class="font-serif text-base text-navy dark:text-dark-text dark:text-dark-text">{source.name}</h4>
              <p class="mt-1 text-xs">
                <span class="font-medium text-[#9B2C2C]">{source.strength}</span>
              </p>
              <p class="mt-1 text-xs text-ink-soft dark:text-dark-text-soft dark:text-dark-text-soft">{source.risk}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-8 rounded-lg border-l-4 border-[#9B2C2C] bg-[#9B2C2C]/5 p-5">
      <p class="text-sm text-ink-soft dark:text-dark-text-soft dark:text-dark-text-soft">
        <strong class="text-[#9B2C2C]">⚠ Dấu hiệu đồng hồ nhiễm từ:</strong> chạy nhanh đột ngột
        (vài chục giây đến vài phút/ngày). <strong>Khắc phục:</strong> mang tới thợ để
        <strong>demagnetize</strong> (khử từ) — nhanh, rẻ (vài trăm nghìn), sau đó sai số trở lại bình thường.
      </p>
    </div>
  </div>

  <!-- Chú thích cuối -->
  <div class="mt-16 rounded-lg border border-brass/30 bg-brass/5 dark:bg-dark-brass/10 p-5 text-center text-sm text-ink-soft dark:text-dark-text-soft dark:text-dark-text-soft">
    <strong class="text-brass dark:text-dark-brass dark:text-dark-brass">💡 Tóm tắt:</strong>
    Từ trường làm dây tóc nhiễm từ → đồng hồ chạy sai. Có 2 cách chống: lồng sắt (cũ) hoặc
    dây tóc silicon (mới). Nếu nghi nhiễm từ, mang đi khử từ — nhanh và rẻ.
  </div>
</section>

<style>
  .svg-container svg {
    width: 100%;
    height: auto;
  }

  .scene [data-anim] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    will-change: opacity, transform;
  }

  .scene [data-anim="level"] {
    transform: translateX(-30px);
  }

  .scene [data-anim].reveal-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .scene [data-anim] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initInfographic() {
    const root = document.querySelector('[data-infographic="anti-magnetic"]');
    if (!root) return;

    const revealTargets = root.querySelectorAll('[data-anim]');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );

    revealTargets.forEach((el) => observer.observe(el));

    setTimeout(() => {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
    }, 3000);
  }

  initInfographic();
</script>
