---
// =============================================================================
// INFOGRAPHIC: LÊN DÂY TỰ ĐỘNG (Automatic Winding)
// =============================================================================
// Chuẩn nội dung duy nhất: các bài Markdown do
// scripts/check-automatic-energy-cluster.mjs quản lý (đầu tiên là
// src/content/coChe/vi/len-day-tu-dong.md). Mọi câu hiển thị phải chỉ ra được
// căn cứ trong bài; không có căn cứ thì không hiển thị.
//
// 4 cảnh:
//   1. Mở đầu — rotor biến cử động thành năng lượng (nguyên lý theo FHH)
//   2. Rotor + hệ truyền — HOẠT ẢNH MINH HỌA NGUYÊN LÝ (thanh trữ cót là
//      mức định tính, không phải thông số của một mẫu)
//   3. Khả năng lên dây thực tế phụ thuộc cùng lúc mấy yếu tố
//   4. Khi cất đồng hồ lâu ngày — dừng là hành vi bình thường; hộp xoay ở
//      thế trung tính
//
// Nội dung vượt căn cứ bài viết đã được rút khỏi bản trước (danh sách cụm
// xem biên bản gói P0.2 trong docs/nghiem-thu/).
// =============================================================================

import MechanismAnimation from './MechanismAnimation.astro';

// Bốn yếu tố tác động tới mức năng lượng tích được — đúng như bài viết.
const factors = [
  {
    title: 'Chuyển động của người đeo',
    text: 'Rotor cần cử động tay mới quay — bài viết nêu đây là yếu tố đầu tiên.',
  },
  {
    title: 'Thiết kế của từng calibre',
    text: 'Hệ truyền gồm những bánh răng nào, dẫn lực theo hướng nào — là thiết kế của từng nhà sản xuất.',
  },
  {
    title: 'Trạng thái trữ cót hiện tại',
    text: 'Dây cót đang đầy hay gần cạn quyết định còn chạy được bao lâu khi bỏ ra.',
  },
  {
    title: 'Có lên tay được không và lên thế nào',
    text: 'Tùy mẫu — nguồn quyết định là tài liệu của đúng chiếc; thao tác an toàn nằm ở bài lên dây đồng hồ cơ.',
  },
];
---

<section class="infographic my-12" data-infographic="automatic-winding">
  <!-- ====================================================================
       CẢNH 1: MỞ ĐẦU
       ==================================================================== -->
  <div class="scene scene-intro infographic-intro">
    <p class="mb-3 text-sm uppercase tracking-widest text-brass-light">Infographic động</p>
    <h2 class="font-serif text-3xl sm:text-5xl">Lên dây tự động — năng lượng từ cử động của bạn</h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream/80">
      Chuyển động tay làm một <strong class="text-brass-light">quả nặng quay</strong>, và qua
      hệ bánh răng cụ thể của bộ máy, chuyển động đó dẫn về việc cuộn dây cót để
      tích năng lượng (theo FHH). Cuộn xuống để xem nguyên lý.
    </p>
    <div class="mt-8 intro-arrow text-brass-light">↓</div>
  </div>

  <!-- ====================================================================
       CẢNH 2: ROTOR + HỆ TRUYỀN — HOẠT ẢNH MINH HỌA NGUYÊN LÝ
       ==================================================================== -->
  <div class="scene mt-24 grid items-center gap-8 md:grid-cols-2">
    <div class="svg-container" data-svg="rotor">
      <MechanismAnimation label="Minh họa: rotor dao động theo cử động — hệ truyền dẫn năng lượng về dây cót" data-mech-step-id="auto-winding">
        <svg viewBox="0 0 400 392" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-md" id="auto-winding-svg" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="awRotor" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color:var(--obs-steel-soft)" />
              <stop offset="0.55" style="stop-color:var(--obs-steel)" />
              <stop offset="1" style="stop-color:var(--obs-steel-deep)" />
            </linearGradient>
            <linearGradient id="awClutch" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" style="stop-color:var(--obs-brass-deep)" />
              <stop offset="0.3" style="stop-color:var(--obs-brass-soft)" />
              <stop offset="0.42" style="stop-color:var(--obs-brass)" />
              <stop offset="1" style="stop-color:var(--obs-brass-deep)" />
            </linearGradient>
          </defs>
          <text style="fill:var(--ig-stroke)" x="200" y="20" text-anchor="middle" font-size="11" font-weight="bold" class="svg-label">
            Minh họa: rotor dao động — hệ truyền dẫn năng lượng về dây cót
          </text>

          <!-- ====== Movement (nền tròn) ====== -->
          <circle style="fill:var(--ig-bg);stroke:var(--ig-edge)" cx="200" cy="160" r="100" stroke-width="2" class=""/>
          <circle cx="170" cy="140" r="15" fill="none" style="stroke:var(--obs-brass)" stroke-width="0.5" opacity="0.4"/>
          <circle cx="230" cy="180" r="12" fill="none" style="stroke:var(--obs-brass)" stroke-width="0.5" opacity="0.4"/>

          <!-- ====== Rotor (bán nguyệt, dao động qua lại) ====== -->
          <g id="aw-rotor" data-part="rotor" data-name-vi="Rotor (quả nặng)" data-name-en="Rotor (oscillating weight)">
            <path fill="url(#awRotor)" style="stroke:var(--obs-steel-deep)" d="M 200 160 L 200 70 A 90 90 0 0 1 290 160 Z" stroke-width="2"/>
          </g>
          <!-- Trục rotor -->
          <circle style="fill:var(--ig-edge)" cx="200" cy="160" r="6"/>

          <!-- ====== Hệ truyền + bánh răng (minh họa cấu trúc chung) ====== -->
          <g transform="translate(200, 300)">
            <rect id="aw-clutch" x="-45" y="-18" width="90" height="36" rx="6" fill="url(#awClutch)" style="stroke:var(--obs-brass-deep)" stroke-width="2" data-part="transmission" data-name-vi="Hệ truyền (minh họa)" data-name-en="Transmission (illustration)"/>
            <text x="0" y="4" text-anchor="middle" font-size="10" style="fill:var(--obs-ivory)" font-weight="bold" class="aw-inline-label">Hệ truyền</text>
            <g id="aw-gear" transform="translate(75, 0)" data-part="transmission-gear" data-name-vi="Bánh răng truyền lực (minh họa)" data-name-en="Drive gear (illustration)">
              <circle r="16" fill="none" style="stroke:var(--obs-steel-soft)" stroke-width="3" id="aw-gear-circle"/>
              {Array.from({ length: 8 }).map((_, i) => {
                const a = (i * 360) / 8;
                return <g transform={`rotate(${a})`}><rect x="-1.5" y="-20" width="3" height="6" style="fill:var(--obs-steel-soft)"/></g>;
              })}
              <circle r="3" style="fill:var(--obs-steel-soft)"/>
            </g>
          </g>

          <!-- ====== Thanh trữ cót (dưới cùng — mức định tính) ====== -->
          <text style="fill:var(--ig-stroke)" x="200" y="345" text-anchor="middle" font-size="10" font-weight="bold" class="aw-inline-label">Mức trữ cót (minh họa)</text>
          <rect style="stroke:var(--ig-stroke)" x="100" y="350" width="200" height="14" rx="3" fill="none" stroke-width="1.5" class="dark:stroke-dark-text"/>
          <rect id="aw-reserve-bar" x="102" y="352" width="0" height="10" rx="2" style="fill:var(--obs-brass)"/>
          <text style="fill:var(--ig-stroke)" id="aw-reserve-label" x="200" y="378" text-anchor="middle" font-size="10" class="aw-inline-label">chưa tích (minh họa)</text>

          <!-- ====== Trạng thái hệ truyền (text động) ====== -->
          <text id="aw-clutch-status" x="200" y="275" text-anchor="middle" font-size="10" style="fill:var(--obs-steel-deep)" font-weight="bold" class="aw-inline-label">minh họa</text>
        </svg>

        <!-- Nút mô phỏng cử động cổ tay (bên ngoài SVG, trong MechanismAnimation) -->
        <div class="mt-3 text-center">
          <button type="button" id="aw-wrist-btn" class="btn-navy-pill min-h-11">
            🤚 Mô phỏng một cú cử động cổ tay (minh họa)
          </button>
          <p class="mx-auto mt-2 max-w-md text-xs text-ink-soft dark:text-dark-text-soft">
            Minh họa nguyên lý — không phải phép đo, không phản ánh thông số của một mẫu đồng hồ.
          </p>
        </div>

        <script is:inline define:vars={{}} slot="script">
          // Trạng thái minh họa: mức trữ cót chỉ mang tính định tính (0 → 100%)
          let awReserve = 0;
          let awKicks = [];

          (window.__mechSteps = window.__mechSteps || {})['auto-winding'] = function(delta, elapsed) {
            const svg = document.getElementById('auto-winding-svg');
            if (!svg) return;
            const rotor = svg.querySelector('#aw-rotor');
            const gear = svg.querySelector('#aw-gear');
            const gearCircle = svg.querySelector('#aw-gear-circle');
            const reserveBar = svg.querySelector('#aw-reserve-bar');
            const reserveLabel = svg.querySelector('#aw-reserve-label');
            const clutchStatus = svg.querySelector('#aw-clutch-status');
            if (!rotor || !gear) return;

            // Rotor dao động qua lại theo cử động (minh họa)
            const swingPeriod = 2500;
            const phase = (elapsed % swingPeriod) / swingPeriod;
            const angle = Math.sin(phase * Math.PI * 2) * 110;
            rotor.setAttribute('transform', `rotate(${angle} 200 160)`);

            // Chiều dao động hiện tại
            const direction = Math.sign(Math.cos(phase * Math.PI * 2));
            const isDriving = direction > 0;

            if (isDriving) {
              gearCircle.style.stroke = 'var(--obs-steel-soft)';
              gear.setAttribute('opacity', '1');
              const gearRot = elapsed * 0.3;
              gear.setAttribute('transform', `translate(275, 300) rotate(${gearRot})`);
              clutchStatus.textContent = 'dẫn lực về cót (minh họa)';
              clutchStatus.style.fill = 'var(--obs-steel-deep)';
            } else {
              gearCircle.style.stroke = 'var(--obs-steel-deep)';
              gear.setAttribute('opacity', '0.35');
              clutchStatus.textContent = 'không dẫn lực (minh họa)';
              clutchStatus.style.fill = 'var(--obs-brass-deep)';
            }

            // Mức trữ cót dâng chậm khi có lực dẫn — chỉ định tính
            if (isDriving && awReserve < 100) {
              awReserve += delta * 0.002;
              if (awReserve > 100) awReserve = 100;
            }

            awKicks = awKicks.filter((k) => elapsed - k < 400);
            if (awKicks.length > 0 && awReserve < 100) {
              awReserve += 0.05 * awKicks.length;
              if (awReserve > 100) awReserve = 100;
            }

            const barW = (awReserve / 100) * 196;
            reserveBar.setAttribute('width', String(barW));
            reserveLabel.textContent = awReserve === 0 ? 'chưa tích (minh họa)' : 'mức tích được: ' + Math.round(awReserve) + '/100 (minh họa)';
          };

          (window.__mechResets = window.__mechResets || {})['auto-winding'] = function() {
            awReserve = 0;
            awKicks = [];
          };

          document.addEventListener('DOMContentLoaded', function() {
            const btn = document.getElementById('aw-wrist-btn');
            if (!btn) return;
            btn.addEventListener('click', function() {
              const t = performance.now();
              awKicks.push(t);
              if (awReserve >= 100) awReserve = 0;
            });
          });
        </script>
      </MechanismAnimation>
    </div>
    <div class="space-y-4">
      <h3 class="font-serif text-2xl text-navy dark:text-dark-text">Rotor — quả nặng bán nguyệt</h3>
      <p class="text-ink-soft dark:text-dark-text-soft">
        <strong>Rotor</strong> (còn gọi "oscillating weight") là đĩa hình bán nguyệt
        <strong>quay tự do theo mỗi cử động của tay</strong>, và trọng lượng riêng của nó
        đưa nó trở về vị trí dọc (theo FHH). Vì rotor nặng và gắn lệch tâm, cử động tay
        thường ngày đủ để nó xoay.
      </p>
      <p class="text-ink-soft dark:text-dark-text-soft">
        Một <strong>hệ truyền cụ thể của từng bộ máy</strong> nhân số vòng quay của rotor để
        cuộn dây cót liên tục. Hệ truyền đó gồm những bánh răng nào, dẫn lực theo hướng nào —
        là thiết kế của từng calibre: hai chiếc automatic không bắt buộc dùng cùng một cấu trúc.
      </p>
      <p class="text-sm text-ink-soft dark:text-dark-text-soft">
        Trong hoạt ảnh: rotor dao động qua lại, hệ truyền minh họa dẫn năng lượng về dây cót,
        mức trữ cót dâng lên. Đây chỉ là <strong>minh họa nguyên lý</strong> — hình dạng cụ thể
        của hệ truyền là thiết kế của từng bộ máy.
      </p>
      <div class="rounded-lg border border-brass/30 bg-brass/5 dark:bg-dark-brass/10 p-4 text-sm text-ink-soft dark:text-dark-text-soft">
        <strong class="text-brass dark:text-dark-brass">💡</strong> Nói cách khác: rotor
        <strong>biến chuyển động của bạn thành năng lượng</strong> cho đồng hồ.
      </div>
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 3: KHẢ NĂNG LÊN DÂY THỰC TẾ PHỤ THUỘC GÌ
       ==================================================================== -->
  <div class="scene mt-24 rounded-2xl border border-cream-dark dark:border-dark-border bg-cream-dark/30 dark:bg-dark-border/30 p-8 sm:p-12">
    <div class="mx-auto max-w-3xl">
      <h3 class="mb-4 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
        Khả năng lên dây thực tế phụ thuộc gì?
      </h3>
      <p class="mb-8 text-center text-ink-soft dark:text-dark-text-soft">
        Mức năng lượng được tích khi đeo phụ thuộc <strong>cùng lúc mấy yếu tố</strong> —
        nên không có lời hứa chung cho mọi chiếc.
      </p>

      <div class="grid gap-4 sm:grid-cols-2">
        {factors.map((factor, i) => (
          <div
            class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-5"
            data-anim="factor-card"
            data-index={i}
          >
            <div class="flex items-start gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-steel font-mono text-sm font-semibold text-steel dark:border-steel" style="font-variant-numeric: lining-nums;" aria-hidden="true">{i + 1}</span>
              <div>
                <h4 class="font-serif text-base text-navy dark:text-dark-text">{factor.title}</h4>
                <p class="mt-1 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">{factor.text}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-6 text-center text-sm text-ink-soft dark:text-dark-text-soft">
        Vì vậy, nếu chiếc của bạn dừng sớm dù được đeo đều, hãy đối chiếu
        <strong>tài liệu của mẫu</strong> trước khi tự suy ra nguyên nhân.
      </p>
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 4: KHI CẤT ĐỒNG HỒ LÂU NGÀY
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      Khi cất đồng hồ lâu ngày
    </h3>
    <p class="mx-auto mb-8 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft">
      Không đeo thì rotor không quay, dây cót dần nhả và đồng hồ dừng khi hết trữ cót —
      đó là <strong>hành vi bình thường</strong>, không phải hỏng.
    </p>

    <div class="mx-auto max-w-2xl space-y-3">
      <div class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4" data-anim="store-card" data-index="0">
        <p class="text-sm leading-relaxed text-ink dark:text-dark-text">
          Đeo lại hoặc lên tay theo <strong>hướng dẫn của mẫu</strong> sẽ khởi động lại nó —
          cách lên tay an toàn nằm ở bài <a class="font-medium text-steel underline-offset-2 hover:underline dark:text-steel" href="/huong-dan/len-day-dong-ho">lên dây đồng hồ cơ</a>.
        </p>
      </div>
      <div class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4" data-anim="store-card" data-index="1">
        <p class="text-sm leading-relaxed text-ink dark:text-dark-text">
          Một số người cân nhắc <strong>hộp xoay</strong> để quay đồng hồ khi cất: bài
          <a class="font-medium text-steel underline-offset-2 hover:underline dark:text-steel" href="/huong-dan/hop-xoay-dong-ho">hộp xoay đồng hồ</a>
          là khung câu hỏi trung tính để tự xác định thiết bị này có phù hợp với chiếc của bạn
          không — bài đó không khuyến nghị mua hay tránh.
        </p>
      </div>
      <div class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4" data-anim="store-card" data-index="2">
        <p class="text-sm leading-relaxed text-ink dark:text-dark-text">
          Cấu trúc và hướng dẫn lực là <strong>thiết kế của từng bộ máy</strong> — cách chắc chắn
          nhất để biết chiếc của bạn hoạt động ra sao vẫn là tài liệu của hãng.
        </p>
      </div>
    </div>
  </div>

  <!-- Chú thích cuối -->
  <div class="infographic-note">
    <strong class="text-brass dark:text-dark-brass">💡 Tóm tắt:</strong>
    <strong>Chuyển động tay</strong> → <strong>rotor quay tự do</strong> (trọng lượng riêng đưa nó
    về vị trí dọc) → <strong>hệ truyền cụ thể của calibre</strong> nhân vòng quay →
    <strong>dây cót trong thùng cót</strong> tích năng lượng. Cách chắc chắn nhất để biết chiếc
    của bạn hoạt động ra sao vẫn là tài liệu của hãng.
  </div>
</section>

<style>
  .svg-container svg {
    width: 100%;
    height: auto;
  }

  /*
    Mobile: nhãn mô tả trên đầu SVG (svg-label) quá nhỏ khi co lại — ẩn đi.
    Các nhãn phản hồi tương tác (aw-inline-label) tăng cỡ để đọc được trên 375px.
  */
  @media (max-width: 767px) {
    .svg-label {
      display: none;
    }
    .aw-inline-label {
      font-size: 19px;
    }
  }

  .scene [data-anim] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    will-change: opacity, transform;
  }

  .scene [data-anim].reveal-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .scene [data-anim] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initInfographic() {
    const root = document.querySelector('[data-infographic="automatic-winding"]');
    if (!root) return;

    const revealTargets = root.querySelectorAll('[data-anim]');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );

    revealTargets.forEach((el) => observer.observe(el));

    setTimeout(() => {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
    }, 3000);
  }

  initInfographic();
</script>
