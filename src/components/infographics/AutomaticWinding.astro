---
// =============================================================================
// INFOGRAPHIC: LÊN DÂY TỰ ĐỘNG (Automatic Winding)
// =============================================================================
// Hoạt ảnh: cảnh 2 dùng MechanismAnimation (rotor dao động qua lại, ly hợp
// 1 chiều — bánh răng sáng khi truyền lực/mờ khi trượt tự do, thanh trữ cót
// dâng lên, nút mô phỏng cử động cổ tay). Các cảnh khác giữ CSS reveal.
//
// 4 cảnh:
//   1. Mở đầu — vì sao chỉ cần đeo là chạy
//   2. Rotor + ly hợp 1 chiều — HOẠT ẢNH TƯƠNG TÁC
//   3. Ly hợp một chiều — sơ đồ (giữ nguyên)
//   4. So sánh cơ vs automatic + khi nào cần watch winder
// =============================================================================

import MechanismAnimation from './MechanismAnimation.astro';

// So sánh cơ vs automatic
const comparisons = [
  {
    feature: 'Cách lên cót',
    manual: 'Vặn tay mỗi ngày',
    automatic: 'Tự lên khi đeo',
  },
  {
    feature: 'Nếu bỏ trong ngăn kéo',
    manual: 'Dừng sau ~40h',
    automatic: 'Dừng sau ~40h (như nhau)',
  },
  {
    feature: 'Khi đeo lại sau khi dừng',
    manual: 'Vặn tay 20-40 vòng',
    automatic: 'Vặn tay 20-30 vòng để khởi động',
  },
  {
    feature: 'Cần bảo dưỡng',
    manual: '4-5 năm/lần',
    automatic: '4-5 năm/lần (như nhau)',
  },
];
---

<section class="infographic my-12" data-infographic="automatic-winding">
  <!-- ====================================================================
       CẢNH 1: MỞ ĐẦU
       ==================================================================== -->
  <div class="scene scene-intro infographic-intro">
    <p class="mb-3 text-sm uppercase tracking-widest text-brass-light">Infographic động</p>
    <h2 class="font-serif text-3xl sm:text-5xl">Chỉ cần đeo — đồng hồ tự chạy</h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream/80">
      Bí mật của đồng hồ automatic: một quả nặng xoay theo chuyển động cổ tay,
      biến mọi cử động của bạn thành năng lượng. Cuộn xuống để hiểu.
    </p>
    <div class="mt-8 intro-arrow text-brass-light">↓</div>
  </div>

  <!-- ====================================================================
       CẢNH 2: ROTOR + LY HỢP MỘT CHIỀU — HOẠT ẢNH TƯƠNG TÁC
       ==================================================================== -->
  <div class="scene mt-24 grid items-center gap-8 md:grid-cols-2">
    <div class="svg-container" data-svg="rotor">
      <MechanismAnimation label="Rotor dao động + ly hợp một chiều (bấm 'Mô phỏng cổ tay')" data-mech-step-id="auto-winding">
        <svg viewBox="0 0 400 392" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-md" id="auto-winding-svg" aria-hidden="true" focusable="false">
          <text style="fill:var(--ig-stroke)" x="200" y="20" text-anchor="middle" font-size="11" font-weight="bold" class="svg-label">
            Rotor dao động qua lại — ly hợp chỉ truyền lực một chiều
          </text>

          <!-- ====== Movement (nền tròn) ====== -->
          <circle style="fill:var(--ig-bg);stroke:var(--ig-edge)" cx="200" cy="160" r="100" stroke-width="2" class=""/>
          <circle cx="170" cy="140" r="15" fill="none" stroke="#B8893C" stroke-width="1.5" opacity="0.4"/>
          <circle cx="230" cy="180" r="12" fill="none" stroke="#B8893C" stroke-width="1.5" opacity="0.4"/>

          <!-- ====== Rotor (bán nguyệt, dao động qua lại) ====== -->
          <g id="aw-rotor" data-part="rotor" data-name-vi="Rotor (quả nặng)" data-name-en="Rotor (oscillating weight)">
            <path style="fill:var(--ig-steel);stroke:var(--ig-edge)" d="M 200 160 L 200 70 A 90 90 0 0 1 290 160 Z" stroke-width="2"/>
          </g>
          <!-- Trục rotor -->
          <circle style="fill:var(--ig-edge)" cx="200" cy="160" r="6"/>

          <!-- ====== Ly hợp + bánh răng truyền lực (bên dưới movement) ====== -->
          <g transform="translate(200, 300)">
            <!-- Ly hợp (hộp) -->
            <rect id="aw-clutch" x="-45" y="-18" width="90" height="36" rx="6" fill="#B8893C" stroke="#9B6E2C" stroke-width="2" data-part="clutch" data-name-vi="Ly hợp một chiều" data-name-en="One-way clutch"/>
            <text x="0" y="4" text-anchor="middle" font-size="10" fill="#FAF7F2" font-weight="bold" class="aw-inline-label">Ly hợp</text>
            <!-- Bánh răng truyền lực (sáng khi truyền, mờ khi trượt tự do) -->
            <g id="aw-gear" transform="translate(75, 0)" data-part="transmission-gear" data-name-vi="Bánh răng truyền lực" data-name-en="Drive gear">
              <circle r="16" fill="none" stroke="#4FB286" stroke-width="3" id="aw-gear-circle"/>
              {Array.from({ length: 8 }).map((_, i) => {
                const a = (i * 360) / 8;
                return <g transform={`rotate(${a})`}><rect x="-1.5" y="-20" width="3" height="6" fill="#4FB286"/></g>;
              })}
              <circle r="3" fill="#4FB286"/>
            </g>
          </g>

          <!-- ====== Thanh trữ cót (dưới cùng) ====== -->
          <text style="fill:var(--ig-stroke)" x="200" y="345" text-anchor="middle" font-size="10" font-weight="bold" class="aw-inline-label">Trữ cót</text>
          <rect style="stroke:var(--ig-stroke)" x="100" y="350" width="200" height="14" rx="3" fill="none" stroke-width="1.5" class="dark:stroke-dark-text"/>
          <rect id="aw-reserve-bar" x="102" y="352" width="0" height="10" rx="2" fill="#B8893C"/>
          <text style="fill:var(--ig-stroke)" id="aw-reserve-label" x="200" y="378" text-anchor="middle" font-size="10" class="aw-inline-label">0%</text>

          <!-- ====== Trạng thái ly hợp (text động) ====== -->
          <text id="aw-clutch-status" x="200" y="275" text-anchor="middle" font-size="10" fill="#2D7A55" font-weight="bold" class="aw-inline-label">Truyền lực</text>
        </svg>

        <!-- Nút mô phỏng cử động cổ tay (bên ngoài SVG, trong MechanismAnimation) -->
        <div class="mt-3 text-center">
          <button type="button" id="aw-wrist-btn" class="btn-navy-pill min-h-11">
            🤚 Mô phỏng cử động cổ tay
          </button>
        </div>

        <script is:inline define:vars={{}} slot="script">
          // Trạng thái rotor: dao động qua lại, mỗi nửa chu kỳ là một chiều
          let awReserve = 0; // 0 → 100%
          let awRotorAngle = 0;
          let awPrevDirection = 0; // -1 hoặc +1
          let awKicks = []; // các "cú đạp" từ nút mô phỏng cổ tay

          (window.__mechSteps = window.__mechSteps || {})['auto-winding'] = function(delta, elapsed) {
            const svg = document.getElementById('auto-winding-svg');
            if (!svg) return;
            const rotor = svg.querySelector('#aw-rotor');
            const gear = svg.querySelector('#aw-gear');
            const gearCircle = svg.querySelector('#aw-gear-circle');
            const reserveBar = svg.querySelector('#aw-reserve-bar');
            const reserveLabel = svg.querySelector('#aw-reserve-label');
            const clutchStatus = svg.querySelector('#aw-clutch-status');
            if (!rotor || !gear) return;

            // Dao động rotor: qua lại ±110° (gần nửa vòng), chu kỳ ~2.5 giây
            const swingPeriod = 2500;
            const phase = (elapsed % swingPeriod) / swingPeriod;
            const angle = Math.sin(phase * Math.PI * 2) * 110;
            rotor.setAttribute('transform', `rotate(${angle} 200 160)`);

            // Xác định chiều quay hiện tại (đạo hàm của sin = cos)
            const direction = Math.sign(Math.cos(phase * Math.PI * 2)); // +1 hoặc -1

            // Ly hợp: chỉ truyền lực khi direction > 0 (giả sử chiều CW = truyền)
            // Khi direction <= 0: trượt tự do (bánh răng mờ, không quay)
            const isDriving = direction > 0;

            if (isDriving) {
              // Bánh răng sáng + quay
              gearCircle.setAttribute('stroke', '#4FB286');
              gear.setAttribute('opacity', '1');
              const gearRot = elapsed * 0.3; // quay chậm
              gear.setAttribute('transform', `translate(275, 300) rotate(${gearRot})`);
              clutchStatus.textContent = '⚡ Truyền lực';
              clutchStatus.setAttribute('fill', '#2D7A55');
            } else {
              // Bánh răng mờ (trượt tự do)
              gearCircle.setAttribute('stroke', '#A0AEC0');
              gear.setAttribute('opacity', '0.35');
              clutchStatus.textContent = 'Trượt tự do';
              clutchStatus.setAttribute('fill', '#9B6E2C');
            }

            // Trữ cót dâng lên khi truyền lực (chậm dần khi gần đầy)
            if (isDriving && awReserve < 100) {
              awReserve += delta * 0.002; // ~0.2%/giây
              if (awReserve > 100) awReserve = 100;
            }

            // Xử lý các "cú đạp" từ nút — thêm lực đột ngột
            awKicks = awKicks.filter((k) => elapsed - k < 400);
            if (awKicks.length > 0 && awReserve < 100) {
              awReserve += 0.05 * awKicks.length;
              if (awReserve > 100) awReserve = 100;
            }

            // Cập nhật thanh trữ cót
            const barW = (awReserve / 100) * 196;
            reserveBar.setAttribute('width', String(barW));
            reserveLabel.textContent = Math.round(awReserve) + '%';
          };

          // Nút "Đặt lại" của MechanismAnimation — hồi phục trạng thái riêng:
          // thanh trữ cót về 0%, xóa các cú đạp đang chờ.
          (window.__mechResets = window.__mechResets || {})['auto-winding'] = function() {
            awReserve = 0;
            awKicks = [];
          };

          // Nút mô phỏng cử động cổ tay
          document.addEventListener('DOMContentLoaded', function() {
            const btn = document.getElementById('aw-wrist-btn');
            if (!btn) return;
            btn.addEventListener('click', function() {
              const t = performance.now();
              awKicks.push(t);
              // Reset trữ cót nếu đã đầy → cho người đọc chơi lại
              if (awReserve >= 100) awReserve = 0;
            });
          });
        </script>
      </MechanismAnimation>
    </div>
    <div class="space-y-4">
      <h3 class="font-serif text-2xl text-navy dark:text-dark-text">Rotor — trái tim của automatic</h3>
      <p class="text-ink-soft dark:text-dark-text-soft">
        <strong>Rotor</strong> (còn gọi "oscillating weight") là một quả nặng hình bán nguyệt,
        gắn trên trục có thể <strong>quay tự do 360°</strong>.
      </p>
      <p class="text-ink-soft dark:text-dark-text-soft">
        Vì rotor <strong>nặng và gắn lệch tâm</strong>, nên khi bạn cử động tay,
        <strong>trọng lực</strong> làm nó xoay. Chuyển động quay này được truyền qua
        <strong>ly hợp một chiều</strong> để cuộn dây cót.
      </p>
      <p class="text-sm text-ink-soft dark:text-dark-text-soft">
        Trong hoạt ảnh: rotor dao động qua lại. Khi quay chiều <strong>truyền lực</strong>, bánh răng sáng lên và thanh trữ cót dâng. Khi quay chiều <strong>kia</strong>, bánh răng mờ đi — ly hợp trượt tự do, không truyền lực. Bấm nút để mô phỏng một cú đung đưa cổ tay.
      </p>
      <div class="rounded-lg border border-brass/30 bg-brass/5 dark:bg-dark-brass/10 p-4 text-sm text-ink-soft dark:text-dark-text-soft">
        <strong class="text-brass dark:text-dark-brass">💡</strong> Nói cách khác: rotor <strong>biến chuyển động của bạn
        thành năng lượng</strong> cho đồng hồ.
      </div>
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 3: LY HỢP MỘT CHIỀU
       ==================================================================== -->
  <div class="scene mt-24 rounded-2xl border border-cream-dark dark:border-dark-border bg-cream-dark/30 dark:bg-dark-border/30 p-8 sm:p-12">
    <div class="mx-auto max-w-3xl text-center">
      <h3 class="mb-4 font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
        Ly hợp một chiều — cải tạo mọi chuyển động thành năng lượng
      </h3>
      <p class="mb-8 text-ink-soft dark:text-dark-text-soft">
        Rotor quay <strong>cả hai chiều</strong>, nhưng dây cót chỉ cuộn theo <strong>một chiều</strong>.
        <strong>Ly hợp một chiều</strong> (clutch) "dịch" chuyển động hai chiều thành chiều cuộn đúng.
      </p>

      <div class="svg-container mb-6">
        <svg viewBox="0 0 500 180" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-2xl" aria-hidden="true" focusable="false">
          <!-- Rotor quay 2 chiều -->
          <g data-anim="clutch-input" opacity="0">
            <circle style="stroke:var(--ig-steel)" cx="80" cy="90" r="35" fill="none" stroke-width="2.5"/>
            <path style="stroke:var(--ig-steel)" d="M 80 90 L 80 55" stroke-width="2"/>
            <text style="fill:var(--ig-stroke)" x="80" y="145" text-anchor="middle" font-size="10" font-weight="bold" class="svg-label">Rotor</text>
            <text x="80" y="50" text-anchor="middle" font-size="14" fill="#2E86AB">↻ ↺</text>
            <text x="80" y="35" text-anchor="middle" font-size="9" fill="#2E86AB" class="svg-label">quay 2 chiều</text>
          </g>

          <!-- Mũi tên tới ly hợp -->
          <g data-anim="clutch-arrow1" opacity="0">
            <line x1="125" y1="90" x2="190" y2="90" stroke="#B8893C" stroke-width="2" stroke-dasharray="4 2"/>
            <polygon points="195,90 187,85 187,95" fill="#B8893C"/>
          </g>

          <!-- Ly hợp một chiều -->
          <g data-anim="clutch" opacity="0">
            <rect x="200" y="65" width="100" height="50" rx="6" fill="#B8893C" stroke="#9B6E2C" stroke-width="2"/>
            <text x="250" y="95" text-anchor="middle" font-size="11" fill="#FAF7F2" font-weight="bold" class="svg-label">Ly hợp</text>
            <text style="fill:var(--ig-stroke)" x="250" y="135" text-anchor="middle" font-size="10" font-weight="bold" class="svg-label">1 chiều</text>
          </g>

          <!-- Mũi tên tới thùng cót -->
          <g data-anim="clutch-arrow2" opacity="0">
            <line x1="310" y1="90" x2="375" y2="90" stroke="#B8893C" stroke-width="2" stroke-dasharray="4 2"/>
            <polygon points="380,90 372,85 372,95" fill="#B8893C"/>
          </g>

          <!-- Thùng cót -->
          <g data-anim="barrel-output" opacity="0">
            <circle cx="420" cy="90" r="35" fill="none" stroke="#B8893C" stroke-width="2.5"/>
            <path d="M 420 60 a 30 30 0 1 1 -0.1 0 m 0 5 a 25 25 0 1 0 0.1 0"
                  fill="none" stroke="#B8893C" stroke-width="2.5"/>
            <circle cx="420" cy="90" r="3" fill="#B8893C"/>
            <text style="fill:var(--ig-stroke)" x="420" y="145" text-anchor="middle" font-size="10" font-weight="bold" class="svg-label">Thùng cót</text>
            <text x="420" y="50" text-anchor="middle" font-size="14" fill="#2D7A55">↻</text>
            <text x="420" y="35" text-anchor="middle" font-size="9" fill="#2D7A55" class="svg-label">cuộn 1 chiều</text>
          </g>
        </svg>
      </div>

      <p class="text-sm text-ink-soft dark:text-dark-text-soft">
        Dù rotor quay chiều nào, cơ chế ly hợp luôn <strong>"dịch"</strong> chuyển động thành chiều cuộn cót đúng.
        Có 2 kiểu phổ biến: <strong>kiểu bánh răng</strong> (đơn giản) và <strong>kiểu bi/đòn bẩy</strong> (mượt hơn).
      </p>
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 4: SO SÁNH CƠ vs AUTOMATIC
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      Cơ (manual) vs Automatic — khác biệt thực tế
    </h3>
    <p class="mx-auto mb-12 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft">
      Nhiều người nhầm tưởng automatic "không bao giờ dừng" — không phải.
    </p>

    <div class="overflow-hidden rounded-lg border border-cream-dark dark:border-dark-border" data-anim="comparison-table">
      <table class="w-full text-sm">
        <thead class="bg-navy text-cream">
          <tr>
            <th class="px-4 py-3 text-left">Đặc điểm</th>
            <th class="px-4 py-3 text-left">Cơ (manual)</th>
            <th class="px-4 py-3 text-left">Automatic</th>
          </tr>
        </thead>
        <tbody>
          {comparisons.map((row, i) => (
            <tr class={i % 2 === 0 ? 'bg-white' : 'bg-cream-dark/30 dark:bg-dark-border/30'}>
              <td class="px-4 py-3 font-medium text-navy dark:text-dark-text">{row.feature}</td>
              <td class="px-4 py-3 text-ink-soft dark:text-dark-text-soft">{row.manual}</td>
              <td class="px-4 py-3 text-ink-soft dark:text-dark-text-soft">{row.automatic}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-8 rounded-lg border-l-4 border-brass bg-brass/5 dark:bg-dark-brass/10 p-5">
      <p class="text-sm text-ink-soft dark:text-dark-text-soft">
        <strong class="text-brass dark:text-dark-brass">💡 Watch winder:</strong> Nếu bạn có <strong>nhiều đồng hồ automatic</strong>
        và muốn chúng luôn chạy, cần <strong>hộp quay đồng hồ</strong> (watch winder) — mô phỏng chuyển động cổ tay.
        Nếu chỉ có 1 chiếc, chỉ cần đeo đủ 8 giờ/ngày.
      </p>
    </div>
  </div>

  <!-- Chú thích cuối -->
  <div class="infographic-note">
    <strong class="text-brass dark:text-dark-brass">💡 Tóm tắt:</strong>
    <strong>Rotor</strong> (quay theo chuyển động) → <strong>Ly hợp 1 chiều</strong> (dịch chuyển động) →
    <strong>Thùng cót</strong> (tích năng lượng). Chỉ cần đeo — và đồng hồ tự "sạc".
  </div>
</section>

<style>
  .svg-container svg {
    width: 100%;
    height: auto;
  }

  /*
    Mobile: nhãn mô tả trên đầu SVG (svg-label) quá nhỏ khi co lại — ẩn đi.
    Các nhãn phản hồi tương tác (aw-inline-label: Ly hợp, Trữ cót, %, trạng
    thái truyền lực) tăng cỡ để đạt tối thiểu ~12px trên 375px.
  */
  @media (max-width: 767px) {
    .svg-label {
      display: none;
    }
    .aw-inline-label {
      font-size: 19px;
    }
  }

  .scene [data-anim] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    will-change: opacity, transform;
  }

  .scene [data-anim].reveal-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .scene [data-anim] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initInfographic() {
    const root = document.querySelector('[data-infographic="automatic-winding"]');
    if (!root) return;

    const revealTargets = root.querySelectorAll('[data-anim]');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );

    revealTargets.forEach((el) => observer.observe(el));

    setTimeout(() => {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
    }, 3000);
  }

  initInfographic();
</script>
