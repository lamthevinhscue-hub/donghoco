---
// =============================================================================
// ESCAPEMENT — SVG bộ thoát Swiss lever với animation nhịp tíc-tắc
// =============================================================================
// Mô phỏng chu kỳ: bánh lắc dao động → pallet fork nhả → escape wheel tiến 1 răng → khóa lại
// Dùng MechanismAnimation wrapper cho điều khiển play/pause/tốc độ.
//
// Chu kỳ 1 nhịp (beat):
//   1. Bánh lắc dao động qua một bên → đẩy pallet fork
//   2. Pallet fork nhả escape wheel → escape wheel tiến 1 răng (và phát tiếng "tíc")
//   3. Bánh lắc dao động qua bên kia → đẩy pallet fork bên kia
//   4. Pallet fork nhả escape wheel → tiến 1 răng nữa (phát tiếng "tắc")
//
// Tuân thủ KẾ HOẠCH HOÀN THIỆN Bước 1.2.
// =============================================================================

import MechanismAnimation from './MechanismAnimation.astro';
---

<MechanismAnimation label="Bộ thoát Swiss lever (Escapement)" data-mech-step-id="escapement">
  <svg viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-2xl" id="escapement-svg" role="img" aria-label="Sơ đồ hoạt ảnh bộ thoát Swiss lever: bánh thoát, ngựa, bánh lắc và dây tóc">
    <!-- ====== CHẤT LIỆU: 4 chuyển sắc + bóng đổ (điểm dừng bằng biến CSS — tự đổi theo .dark) ====== -->
    <defs>
      <!-- Thép chải: sáng mép trên → tối mép dưới -->
      <linearGradient id="escSteel" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" style="stop-color:var(--g-steel-hi)" />
        <stop offset="0.5" style="stop-color:var(--ig-steel)" />
        <stop offset="1" style="stop-color:var(--g-steel-dk)" />
      </linearGradient>
      <!-- Đồng thau: ấm, một dải phản chiếu hẹp ở ~1/3 chiều dài -->
      <linearGradient id="escBrass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" style="stop-color:var(--g-brass-dk)" />
        <stop offset="0.3" style="stop-color:var(--g-brass-hi)" />
        <stop offset="0.42" style="stop-color:var(--ig-alloy)" />
        <stop offset="1" style="stop-color:var(--g-brass-dk)" />
      </linearGradient>
      <!-- Rubi chân kính: toả tròn, tâm lệch trên-trái, sáng tâm đậm rìa -->
      <radialGradient id="escRuby" cx="0.35" cy="0.3" r="0.9">
        <stop offset="0" style="stop-color:var(--g-ruby-hi)" />
        <stop offset="0.55" style="stop-color:var(--ig-rubi)" />
        <stop offset="1" style="stop-color:var(--g-ruby-dk)" />
      </radialGradient>
      <!-- Bánh lắc Glucydur: hợp kim đỏ sáng, chuyển sắc nhẹ hơn thép -->
      <linearGradient id="escBalance" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" style="stop-color:var(--g-bal-hi)" />
        <stop offset="1" style="stop-color:var(--g-bal-dk)" />
      </linearGradient>
      <!-- Bóng đổ rất nhẹ, tách ba bộ phận khỏi nền (bản nhạt hơn cho chế tối) -->
      <filter id="escShadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="2" dy="3" stdDeviation="2.5" flood-color="#1F2D3D" flood-opacity="0.22" />
      </filter>
      <filter id="escShadowDim" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="1" dy="2" stdDeviation="1.5" flood-color="#000000" flood-opacity="0.14" />
      </filter>
    </defs>

    <!-- ====== BACKGROUND: các nhãn vùng ====== -->
    <text style="fill:var(--ig-stroke)" x="300" y="30" text-anchor="middle" font-size="13" font-weight="bold" class="svg-label">
      Chu kỳ: bánh lắc dao động → ngựa nhả → bánh thoát tiến 1 răng → khóa (tíc-tắc)
    </text>

    <!-- ====== ESCAPE WHEEL (bánh thoát) - bên trái, 15 răng ====== -->
    <g id="escape-wheel-group" transform="translate(180, 220)" class="esc-shadow">
      <g id="escape-wheel" data-part="escape-wheel" data-name-vi="Bánh thoát" data-name-en="Escape wheel">
        <!-- Vẽ 15 răng hình mỏ neo -->
        <g style="fill:url(#escSteel);stroke:var(--ig-edge)" stroke-width="1">
          {Array.from({ length: 15 }).map((_, i) => {
            const angle = (i * 360) / 15;
            return (
              <g transform={`rotate(${angle})`}>
                <path d="M 0 -55 L 5 -45 L 8 -38 L -8 -38 L -5 -45 Z" />
              </g>
            );
          })}
        </g>
        <!-- Vòng tròn thân -->
        <circle style="fill:url(#escSteel);stroke:var(--ig-edge)" r="38" stroke-width="2"/>
        <!-- Trục giữa -->
        <circle style="fill:var(--ig-edge)" r="5"/>
        <!-- Các chấm trang trí -->
        {Array.from({ length: 5 }).map((_, i) => {
          const a = (i * 360) / 5;
          return <circle style="fill:var(--ig-edge)" cx={Math.cos((a * Math.PI) / 180) * 22} cy={Math.sin((a * Math.PI) / 180) * 22} r="3"/>;
        })}
      </g>
    </g>

    <!-- ====== PALLET FORK (ngựa) - giữa, 2 chân kính ====== -->
    <g id="pallet-fork-group" transform="translate(310, 220)" class="esc-shadow">
      <g id="pallet-fork" data-part="pallet-fork" data-name-vi="Ngựa (pallet fork)" data-name-en="Pallet fork">
        <!-- Thân ngựa (hình chữ Y ngược) -->
        <path d="M 0 0 L -20 -30 L -25 -38 M 0 0 L 20 -30 L 25 -38 M 0 0 L 0 35"
              fill="none" style="stroke:url(#escBrass)" stroke-width="2" stroke-linecap="round"/>
        <!-- Đá trên (entry pallet) -->
        <g transform="rotate(-15 -24 -39)">
          <rect x="-28" y="-42" width="8" height="6" rx="1" style="fill:url(#escRuby)" />
          <ellipse cx="-25.8" cy="-40.4" rx="1.4" ry="1" fill="#FFFFFF" opacity="0.75" />
        </g>
        <!-- Đá dưới (exit pallet) -->
        <g transform="rotate(15 24 -39)">
          <rect x="20" y="-42" width="8" height="6" rx="1" style="fill:url(#escRuby)" />
          <ellipse cx="22.4" cy="-40.4" rx="1.4" ry="1" fill="#FFFFFF" opacity="0.75" />
        </g>
        <!-- Trục -->
        <circle cx="0" cy="35" r="5" fill="#9B6E2C"/>
        <!-- Mỏ ngựa (horns) -->
        <path d="M -8 -2 L -14 5 M 8 -2 L 14 5" fill="none" style="stroke:url(#escBrass)" stroke-width="1" stroke-linecap="round"/>
      </g>
    </g>

    <!-- ====== BALANCE WHEEL (bánh lắc) - bên phải ====== -->
    <g id="balance-group" transform="translate(450, 150)" class="esc-shadow">
      <g id="balance-wheel" data-part="balance-wheel" data-name-vi="Bánh lắc" data-name-en="Balance wheel">
        <!-- Vòng ngoài -->
        <circle style="stroke:url(#escBalance)" r="45" fill="none" stroke-width="2"/>
        <!-- 3 chân (spokes) -->
        <line style="stroke:url(#escBalance)" x1="0" y1="-45" x2="0" y2="45" stroke-width="1"/>
        <line style="stroke:url(#escBalance)" x1="-39" y1="-22.5" x2="39" y2="22.5" stroke-width="1"/>
        <line style="stroke:url(#escBalance)" x1="-39" y1="22.5" x2="39" y2="-22.5" stroke-width="1"/>
        <!-- Trục -->
        <circle style="fill:var(--ig-rubi)" r="6"/>
        <!-- Trọng lượng cố định (timing screws) -->
        <circle style="fill:var(--ig-edge)" cx="0" cy="-45" r="4"/>
        <circle style="fill:var(--ig-edge)" cx="0" cy="45" r="4"/>
        <circle style="fill:var(--ig-edge)" cx="-45" cy="0" r="4"/>
        <circle style="fill:var(--ig-edge)" cx="45" cy="0" r="4"/>
      </g>
      <!-- Dây tóc (hairspring) - xoắn ốc mờ -->
      <g id="hairspring" opacity="0.5" data-part="hairspring" data-name-vi="Dây tóc" data-name-en="Hairspring">
        <path d="M 0 0
                 m -8 0 a 8 8 0 1 1 16 0
                 a 12 12 0 1 1 -24 0
                 a 16 16 0 1 1 32 0
                 a 20 20 0 1 1 -40 0"
              fill="none" stroke="#3182CE" stroke-width="1"/>
      </g>
    </g>

    <!-- ====== MŨI TÊN CHỈ SỰ TRUYỀN LỰC ====== -->
    <g id="power-arrows" opacity="0.6">
      <!-- Escape wheel → pallet fork -->
      <text x="245" y="180" font-size="20" fill="#B8893C">→</text>
      <!-- Pallet fork → balance wheel -->
      <text x="370" y="180" font-size="20" fill="#B8893C">→</text>
    </g>

    <!-- ====== CHÚ THÍCH KHI HOVER (tooltip động — desktop) ====== -->
    <g id="tooltip" opacity="0" style="pointer-events: none;">
      <rect id="tooltip-bg" x="0" y="0" width="160" height="42" rx="6" fill="#1F2D3D" opacity="0.95"/>
      <text id="tooltip-vi" x="80" y="18" text-anchor="middle" font-size="13" fill="#FAF7F2" font-weight="bold"></text>
      <text id="tooltip-en" x="80" y="34" text-anchor="middle" font-size="10" fill="#B8893C"></text>
    </g>

    <!-- ====== TRẠNG THÁI (đang "tíc" hay "tắc") ====== -->
    <text id="beat-indicator" x="300" y="380" text-anchor="middle" font-size="14" fill="#B8893C" font-weight="bold">
      ●
    </text>
  </svg>

  <script is:inline define:vars={{}} slot="script">
    // =============================================================================
    // Đăng ký hàm animate cho escapement
    // =============================================================================
    (window.__mechSteps = window.__mechSteps || {})['escapement'] = function(delta, elapsed) {
      const svg = document.getElementById('escapement-svg');
      if (!svg) return;

      const escapeWheel = svg.querySelector('#escape-wheel-group');
      const palletFork = svg.querySelector('#pallet-fork-group');
      const balanceWheel = svg.querySelector('#balance-group');
      const beatIndicator = svg.querySelector('#beat-indicator');

      if (!escapeWheel || !palletFork || !balanceWheel) return;

      // Chu kỳ: 1 beat = 6000ms ở speed 1x (chậm để nhìn rõ)
      // Dao động của bánh lắc: qua lại trong 1 beat
      const beatPeriod = 6000;
      const phase = (elapsed % beatPeriod) / beatPeriod; // 0 → 1
      const beatNum = Math.floor(elapsed / beatPeriod);

      // Bánh lắc dao động: -35° đến +35° (hình sin)
      const balanceAngle = Math.sin(phase * Math.PI * 2) * 35;
      balanceWheel.setAttribute('transform', `translate(450, 150) rotate(${balanceAngle})`);

      // Pallet fork: KHÔNG đung đưa — nằm yên ở chốt chặn, búng sang vị trí đối
      // xứng trong FLIP_WINDOW (10% chu kỳ) rồi lại giữ. easeInOutCubic mạnh tạo
      // cú "tíc" dứt khoát của đòn bẩy thật.
      const FLIP_START = 0.1;
      const FLIP_WINDOW = 0.1;
      const flipT = phase < FLIP_START ? 0 : phase < FLIP_START + FLIP_WINDOW ? (phase - FLIP_START) / FLIP_WINDOW : 1;
      const snapT = flipT < 0.5 ? 4 * flipT * flipT * flipT : 1 - Math.pow(-2 * flipT + 2, 3) / 2;
      const palletAngle = -10 + 20 * snapT;
      palletFork.setAttribute('transform', `translate(310, 220) rotate(${palletAngle})`);

      // Escape wheel: bị khoá phần lớn chu kỳ, nhả đúng lúc ngựa búng — xoay 24°
      // với easeOut (tăng tốc rất nhanh, chậm dần khi vào vị trí khoá kế tiếp).
      const releaseT = 1 - Math.pow(1 - flipT, 3);
      const escapeAngle = -(beatNum * 24 + 24 * releaseT);
      escapeWheel.setAttribute('transform', `translate(180, 220) rotate(${escapeAngle})`);

      // Chỉ báo tíc-tắc
      if (beatIndicator) {
        beatIndicator.textContent = beatNum % 2 === 0 ? '● TÍC' : '● TẮC';
        beatIndicator.setAttribute('fill', beatNum % 2 === 0 ? '#3182CE' : '#9B2C2C');
      }
    };

    // =============================================================================
    // HOVER TOOLTIP — rê chuột vào bộ phận để hiện tên
    // =============================================================================
    document.addEventListener('DOMContentLoaded', () => {
      const svg = document.getElementById('escapement-svg');
      if (!svg) return;
      const tooltip = svg.querySelector('#tooltip');
      const tooltipBg = svg.querySelector('#tooltip-bg');
      const tooltipVi = svg.querySelector('#tooltip-vi');
      const tooltipEn = svg.querySelector('#tooltip-en');
      if (!tooltip || !tooltipBg || !tooltipVi || !tooltipEn) return;

      const parts = svg.querySelectorAll('[data-part]');
      parts.forEach((part) => {
        part.style.cursor = 'pointer';
        const highlight = () => {
          part.style.filter = 'drop-shadow(0 0 6px #B8893C)';
          const vi = part.getAttribute('data-name-vi') || '';
          const en = part.getAttribute('data-name-en') || '';
          tooltipVi.textContent = vi;
          tooltipEn.textContent = en;
          tooltipBg.setAttribute('width', Math.max(vi.length, en.length) * 7.5 + 20);
          tooltip.setAttribute('opacity', '1');
        };
        const unhighlight = () => {
          part.style.filter = '';
          tooltip.setAttribute('opacity', '0');
        };
        part.addEventListener('mouseenter', highlight);
        part.addEventListener('mouseleave', unhighlight);
        // Thiết bị cảm ứng: chỉ highlight — tên bộ phận đã có legend mobile
        part.addEventListener('touchstart', (e) => {
          e.preventDefault();
          part.style.filter = 'drop-shadow(0 0 6px #B8893C)';
          setTimeout(() => { part.style.filter = ''; }, 2000);
        });
      // Bàn phím + cảm ứng (WCAG 1.4.13): bộ phận nhận focus được, chú thích
      // mở khi focus vào và đóng khi rời focus — không phụ thuộc rê chuột.
      part.setAttribute('tabindex', '0');
      part.setAttribute('role', 'img'); // g SVG: đọc aria-label rồi dừng — bộ phận không phải nút bấm
      part.setAttribute('aria-label', part.getAttribute('data-name-vi') || part.getAttribute('data-name-en') || '');
      part.addEventListener('focusin', highlight);
      part.addEventListener('focusout', unhighlight);

      });

      // Tooltip theo chuột
      svg.addEventListener('mousemove', (e) => {
        const rect = svg.getBoundingClientRect();
        const viewBox = svg.viewBox.baseVal;
        const scaleX = viewBox.width / rect.width;
        const scaleY = viewBox.height / rect.height;
        const x = (e.clientX - rect.left) * scaleX;
        const y = (e.clientY - rect.top) * scaleY;
        // Đặt tooltip cạnh chuột
        tooltip.setAttribute('transform', `translate(${Math.min(x, viewBox.width - 170)}, ${Math.max(y - 45, 0)})`);
      });
    });

  // Escape đóng chú thích mà không rời focus (WCAG 1.4.13) — self-contained,
  // query trực tiếp theo id, không phụ thuộc closure vòng lặp phía trên.
  (() => {
    const svgEl = document.getElementById('escapement-svg');
    const tipEl = document.getElementById('tooltip');
    if (!svgEl || !tipEl) return;
    svgEl.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') tipEl.setAttribute('opacity', '0');
    });
  })();
</script>
</MechanismAnimation>

<style>
  /*
    Điểm dừng chuyển sắc cho <defs> phía trên — dẫn xuất từ token --ig-* nên
    tự đổi theo .dark (chuyển sắc không bao giờ hỏng ở chế tối).
    Bóng đổ: bản đủ đậm cho chế sáng, bản nhạt hơn cho chế tối để không bẩn.
  */
  #escapement-svg {
    --g-steel-hi: #94A0B2;
    --g-steel-dk: #333D4B;
    --g-brass-hi: #EBD8AF;
    --g-brass-dk: #8A6A35;
    --g-ruby-hi: #C85858;
    --g-ruby-dk: #741F1F;
    --g-bal-hi: #C05353;
    --g-bal-dk: #6B1D1D;
  }
  :global(.dark) #escapement-svg {
    --g-steel-hi: #A6B1BD;
    --g-steel-dk: #717D89;
    --g-brass-hi: #E6D0A5;
    --g-brass-dk: #B08F55;
    --g-ruby-hi: #F0AFAF;
    --g-ruby-dk: #9C3A3A;
    --g-bal-hi: #E59696;
    --g-bal-dk: #A85A5A;
  }
  #escapement-svg .esc-shadow {
    filter: url(#escShadow);
  }
  :global(.dark) #escapement-svg .esc-shadow {
    filter: url(#escShadowDim);
  }

  /*
    Mobile: nhãn mô tả chu kỳ trong SVG bị thu nhỏ tới ~7px khi viewBox 600
    co về 320-375px — ẩn đi (tên bộ phận đã có trong legend chip và phần
    chữ của bài). Chỉ báo tíc/tắc là feedback của hoạt ảnh nên tăng cỡ
    thay vì ẩn, để người dùng vẫn đọc được trạng thái.
  */
  @media (max-width: 767px) {
    .svg-label {
      display: none;
    }
    #beat-indicator {
      font-size: 30px;
    }
  }
</style>

