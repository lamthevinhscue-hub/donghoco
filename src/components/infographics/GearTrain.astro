---
// =============================================================================
// INFOGRAPHIC: CHUỖI TRUYỀN ĐỘNG (Gear Train / Power Flow)
// =============================================================================
// Hoạt ảnh: cảnh 2 dùng MechanismAnimation (5 bánh răng quay với tỷ lệ tốc độ
// đúng, ngược chiều kề nhau, tooltip khi chạm/rê). Các cảnh khác giữ nguyên
// CSS reveal + Intersection Observer.
//
// 4 cảnh:
//   1. Mở đầu — dòng chảy năng lượng
//   2. Chuỗi 5 bánh răng truyền động — HOẠT ẢNH TƯƠNG TÁC
//   3. Bánh lắc & tần số — vì sao "tích tắc"
//   4. Tóm tắt — dòng chảy tới kim đồng hồ
// =============================================================================

import MechanismAnimation from './MechanismAnimation.astro';

// 4 trạm trên dòng chảy năng lượng
const stations = [
  {
    num: '①',
    name: 'Dây cót',
    nameEn: 'Mainspring',
    role: 'Nguồn năng lượng',
    detail: 'Dải thép cuộn trong thùng cót. Lên dây = tích năng lượng. Nhả = giải phóng.',
    color: '#B8893C',
    icon: '🌀',
  },
  {
    num: '②',
    name: 'Bộ bánh răng',
    nameEn: 'Gear Train',
    role: 'Truyền + giảm tốc',
    detail: 'Chuỗi bánh răng lớn→nhỏ, truyền năng lượng tới bộ thoát và lái các kim.',
    color: '#4FB286',
    icon: '⚙️',
  },
  {
    num: '③',
    name: 'Bộ thoát',
    nameEn: 'Escapement',
    role: 'Chia năng lượng thành nhịp',
    detail: 'Ngăn dây cót nhả hết một lần. Chia năng lượng thành các "nhịp" nhỏ, từng chút một.',
    color: '#2E86AB',
    icon: '⏱️',
  },
  {
    num: '④',
    name: 'Bánh lắc',
    nameEn: 'Balance Wheel',
    role: 'Gác nhịp',
    detail: 'Dao động qua lại như con lắc. Mỗi nhịp, bộ thoát nhả đúng một chút năng lượng.',
    color: '#9B2C2C',
    icon: '🎡',
  },
];
---

<section class="infographic my-12" data-infographic="gear-train">
  <!-- ====================================================================
       CẢNH 1: MỞ ĐẦU
       ==================================================================== -->
  <div class="scene scene-intro infographic-intro">
    <p class="mb-3 text-sm uppercase tracking-widest text-brass-light">Infographic động</p>
    <h2 class="font-serif text-3xl sm:text-5xl">Năng lượng chảy thế nào trong đồng hồ cơ?</h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream/80">
      Từ cổ tay bạn tới kim đồng hồ — có một dòng chảy qua <strong class="text-brass-light">4 trạm</strong>.
      Hiểu dòng chảy này là chìa khóa hiểu mọi cơ chế phức tạp hơn.
    </p>
    <div class="mt-8 intro-arrow text-brass-light">↓</div>
  </div>

  <!-- ====================================================================
       CẢNH 2: 4 TRẠM TRÊN DÒNG CHẢY — SVG sơ đồ
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      4 trạm trên dòng chảy năng lượng
    </h3>
    <p class="mx-auto mb-12 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft">
      Hãy xem mỗi trạm là một điểm dừng — năng lượng đi qua lần lượt.
    </p>

    <div class="svg-container mb-12">
      <!-- ====== HOẠT ẢNH TƯƠNG TÁC: 5 bánh răng quay với tỷ lệ tốc độ đúng ====== -->
      <MechanismAnimation label="Chuỗi truyền động (5 bánh răng quay với tốc độ khác nhau)" data-mech-step-id="gear-train">
        <svg viewBox="0 0 800 320" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-4xl" id="gear-train-svg">
          <text style="fill:var(--ig-stroke)" x="400" y="26" text-anchor="middle" font-size="13" font-weight="bold" class="svg-label">
            Thùng cót (chậm) → bánh răng → bánh thoát (nhanh) — ngược chiều kề nhau
          </text>

          <!-- ====== 1. THÙNG CÓT (lớn nhất, chậm nhất, chiều CW) ====== -->
          <g id="gt-barrel" transform="translate(110, 170)" data-part="barrel" data-name-vi="Thùng cót (Barrel)" data-name-en="Mainspring Barrel">
            <circle style="fill:var(--ig-bg)" r="62" stroke="#B8893C" stroke-width="3" class=""/>
            <!-- Răng ngoài thùng cót -->
            {Array.from({ length: 24 }).map((_, i) => {
              const a = (i * 360) / 24;
              return (
                <g transform={`rotate(${a})`}>
                  <rect x="-2" y="-68" width="4" height="8" fill="#B8893C"/>
                </g>
              );
            })}
            <!-- Dây cót xoắn bên trong -->
            <path d="M 110 170 m -45 0 a 45 45 0 1 1 90 0 a 38 38 0 1 1 -76 0 a 28 28 0 1 1 56 0"
                  fill="none" stroke="#B8893C" stroke-width="3" opacity="0.7" transform="translate(-110,-170)"/>
            <circle r="8" fill="#B8893C"/>
            <text style="fill:var(--ig-stroke)" y="90" text-anchor="middle" font-size="12" font-weight="bold" class="svg-label">Thùng cót</text>
          </g>

          <!-- ====== 2. BÁNH RĂNG TRUNG GIAN (vừa, nhanh hơn, CCW) ====== -->
          <g id="gt-center" transform="translate(290, 170)" data-part="center-wheel" data-name-vi="Bánh răng trung gian (Center wheel)" data-name-en="Center wheel">
            <circle style="fill:var(--ig-bg)" r="48" stroke="#4FB286" stroke-width="3" class=""/>
            {Array.from({ length: 16 }).map((_, i) => {
              const a = (i * 360) / 16;
              return (
                <g transform={`rotate(${a})`}>
                  <path d="M 0 -48 L 4 -56 L -4 -56 Z" fill="#4FB286"/>
                </g>
              );
            })}
            <circle r="14" fill="none" stroke="#4FB286" stroke-width="2"/>
            <circle r="5" fill="#4FB286"/>
            <text style="fill:var(--ig-stroke)" y="76" text-anchor="middle" font-size="12" font-weight="bold" class="svg-label">Bánh răng trung gian</text>
          </g>

          <!-- ====== 3. BÁNH RĂNG THỨ BA (nhỏ hơn, nhanh hơn nữa, CW) ====== -->
          <g id="gt-third" transform="translate(440, 170)" data-part="third-wheel" data-name-vi="Bánh răng thứ ba (Third wheel)" data-name-en="Third wheel">
            <circle style="fill:var(--ig-bg)" r="38" stroke="#4FB286" stroke-width="3" class=""/>
            {Array.from({ length: 14 }).map((_, i) => {
              const a = (i * 360) / 14;
              return (
                <g transform={`rotate(${a})`}>
                  <path d="M 0 -38 L 3 -45 L -3 -45 Z" fill="#4FB286"/>
                </g>
              );
            })}
            <circle r="12" fill="none" stroke="#4FB286" stroke-width="2"/>
            <circle r="4" fill="#4FB286"/>
            <text style="fill:var(--ig-stroke)" y="64" text-anchor="middle" font-size="12" font-weight="bold" class="svg-label">Bánh răng ba</text>
          </g>

          <!-- ====== 4. BÁNH THOÁT (nhỏ nhất, nhanh nhất, CCW) ====== -->
          <g id="gt-escape" transform="translate(560, 170)" data-part="escape-wheel-gt" data-name-vi="Bánh thoát (Escape wheel)" data-name-en="Escape wheel">
            <circle style="fill:var(--ig-bg)" r="30" stroke="#2E86AB" stroke-width="3" class=""/>
            {Array.from({ length: 15 }).map((_, i) => {
              const a = (i * 360) / 15;
              return (
                <g transform={`rotate(${a})`}>
                  <path d="M 0 -30 L 3 -37 L -3 -37 Z" fill="#2E86AB"/>
                </g>
              );
            })}
            <circle r="8" fill="none" stroke="#2E86AB" stroke-width="2"/>
            <circle r="4" fill="#2E86AB"/>
            <text style="fill:var(--ig-stroke)" y="54" text-anchor="middle" font-size="12" font-weight="bold" class="svg-label">Bánh thoát</text>
          </g>

          <!-- ====== 5. BÁNH LẮC (dao động, không quay tròn) ====== -->
          <g id="gt-balance" transform="translate(690, 170)" data-part="balance-gt" data-name-vi="Bánh lắc (Balance wheel)" data-name-en="Balance wheel">
            <circle style="stroke:var(--ig-rubi)" r="34" fill="none" stroke-width="4"/>
            <line style="stroke:var(--ig-rubi)" x1="0" y1="-34" x2="0" y2="34" stroke-width="2.5"/>
            <line style="stroke:var(--ig-rubi)" x1="-29" y1="-17" x2="29" y2="17" stroke-width="2.5"/>
            <line style="stroke:var(--ig-rubi)" x1="-29" y1="17" x2="29" y2="-17" stroke-width="2.5"/>
            <circle style="fill:var(--ig-rubi)" r="5"/>
            <circle style="fill:var(--ig-edge)" cx="0" cy="-34" r="3"/>
            <circle style="fill:var(--ig-edge)" cx="0" cy="34" r="3"/>
            <text style="fill:var(--ig-stroke)" y="58" text-anchor="middle" font-size="12" font-weight="bold" class="svg-label">Bánh lắc</text>
          </g>

          <!-- Mũi tên dòng chảy (giữa các bánh) -->
          <g opacity="0.5">
            <text x="195" y="155" font-size="14" fill="#B8893C">→</text>
            <text x="360" y="155" font-size="14" fill="#B8893C">→</text>
            <text x="495" y="155" font-size="14" fill="#B8893C">→</text>
            <text x="620" y="155" font-size="14" fill="#B8893C">→</text>
          </g>

          <!-- Tooltip khi rê chuột (desktop). Trên mobile, tên bộ phận nằm trong
               legend chip bên dưới SVG — không hiện tooltip chữ bé khi chạm. -->
          <g id="gt-tooltip" opacity="0" style="pointer-events: none;">
            <rect id="gt-tooltip-bg" x="0" y="0" width="160" height="38" rx="4" fill="#1F2D3D" opacity="0.95"/>
            <text id="gt-tooltip-vi" x="80" y="16" text-anchor="middle" font-size="13" fill="#FAF7F2" font-weight="bold"></text>
            <text id="gt-tooltip-en" x="80" y="31" text-anchor="middle" font-size="10" fill="#B8893C"></text>
          </g>
        </svg>

        <script is:inline define:vars={{}} slot="script">
          // Đăng ký hàm animate cho gear-train
          (window.__mechSteps = window.__mechSteps || {})['gear-train'] = function(delta, elapsed) {
            const svg = document.getElementById('gear-train-svg');
            if (!svg) return;
            const barrel = svg.querySelector('#gt-barrel');
            const center = svg.querySelector('#gt-center');
            const third = svg.querySelector('#gt-third');
            const escape = svg.querySelector('#gt-escape');
            const balance = svg.querySelector('#gt-balance');
            if (!barrel || !center || !escape) return;

            // Tỷ lệ tốc độ: thùng cót chậm nhất (1x), mỗi bánh kế nhanh hơn
            // (thực tế tỷ lệ theo số răng). Đơn vị: độ/giây mô phỏng.
            // barrel: 1x (CW), center: ~3x (CCW), third: ~8x (CW), escape: ~24x (CCW)
            const baseSpeed = 18; // độ/giây cho barrel
            const barrelAngle = elapsed * baseSpeed * 0.001;
            const centerAngle = -elapsed * baseSpeed * 0.001 * 3;     // ngược chiều
            const thirdAngle = elapsed * baseSpeed * 0.001 * 8;
            const escapeAngle = -elapsed * baseSpeed * 0.001 * 24;    // ngược chiều, nhanh nhất

            barrel.setAttribute('transform', `translate(110, 170) rotate(${barrelAngle})`);
            center.setAttribute('transform', `translate(290, 170) rotate(${centerAngle})`);
            third.setAttribute('transform', `translate(440, 170) rotate(${thirdAngle})`);
            escape.setAttribute('transform', `translate(560, 170) rotate(${escapeAngle})`);

            // Bánh lắc: dao động qua lại (không quay tròn)
            // chu kỳ dao động ~ 0.5 giây mô phỏng = 1 nhịp
            const phase = (elapsed % 1000) / 1000;
            const swingAngle = Math.sin(phase * Math.PI * 2) * 28;
            balance.setAttribute('transform', `translate(690, 170) rotate(${swingAngle})`);
          };
        </script>
      </MechanismAnimation>
    </div>

    <!-- Mô tả từng trạm -->
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {stations.map((station, i) => (
        <div
          class="rounded-lg border-t-4 bg-white dark:bg-dark-surface p-5 shadow-sm"
          style={`border-top-color: ${station.color};`}
          data-anim="station-card"
          data-index={i}
        >
          <div class="mb-2 flex items-center gap-2">
            <span class="text-2xl">{station.icon}</span>
            <span class="text-xl font-bold" style={`color: ${station.color};`}>{station.num}</span>
          </div>
          <h3 class="font-serif text-lg text-navy dark:text-dark-text">{station.name}</h3>
          <p class="text-xs uppercase tracking-wide text-ink-soft/90 dark:text-dark-text-soft/70">{station.nameEn}</p>
          <p class="mt-2 text-xs font-medium" style={`color: ${station.color};`}>{station.role}</p>
          <p class="mt-2 text-sm text-ink-soft dark:text-dark-text-soft">{station.detail}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 3: BÁNH LẮC & TẦN SỐ
       ==================================================================== -->
  <div class="scene mt-24 rounded-2xl border border-cream-dark dark:border-dark-border bg-cream-dark/30 dark:bg-dark-border/30 p-8 sm:p-12">
    <div class="mx-auto max-w-3xl text-center">
      <h3 class="mb-4 font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
        Vì sao đồng hồ "tích tắc"?
      </h3>
      <p class="mb-8 text-ink-soft dark:text-dark-text-soft">
        Bánh lắc dao động qua lại — mỗi lần qua lại, bộ thoát nhả đúng <strong>1 nhịp năng lượng</strong>,
        phát ra tiếng "tích" hoặc "tắc". <strong>Tốc độ dao động</strong> quyết định độ chính xác.
      </p>

      <div class="svg-container mb-6">
        <svg viewBox="0 0 400 135" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-lg">
          <!-- Bánh lắc ở giữa dao động -->
          <g data-anim="balance-oscillate" opacity="0">
            <!-- Quỹ đạo dao động -->
            <path style="stroke:var(--ig-rubi)" d="M 130 90 A 70 70 0 0 1 270 90" fill="none" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.4"/>
            <!-- Bánh lắc (vẽ 2 vị trí mờ) -->
            <circle style="stroke:var(--ig-rubi)" cx="150" cy="90" r="18" fill="none" stroke-width="2" opacity="0.3"/>
            <circle style="stroke:var(--ig-rubi)" cx="250" cy="90" r="18" fill="none" stroke-width="2" opacity="0.3"/>
            <!-- Bánh lắc vị trí giữa -->
            <circle style="fill:var(--ig-bg);stroke:var(--ig-rubi)" cx="200" cy="90" r="18" stroke-width="2.5"/>
            <line style="stroke:var(--ig-rubi)" x1="200" y1="72" x2="200" y2="108" stroke-width="2"/>
            <line style="stroke:var(--ig-rubi)" x1="182" y1="78" x2="218" y2="102" stroke-width="2"/>
            <line style="stroke:var(--ig-rubi)" x1="182" y1="102" x2="218" y2="78" stroke-width="2"/>
            <circle style="fill:var(--ig-rubi)" cx="200" cy="90" r="3"/>
            <!-- Mũi tên 2 chiều -->
            <text style="fill:var(--ig-rubi)" x="160" y="50" font-size="20">←</text>
            <text style="fill:var(--ig-rubi)" x="230" y="50" font-size="20">→</text>
          </g>
          <text style="fill:var(--ig-stroke)" x="200" y="125" text-anchor="middle" font-size="10" class="gt-caption">Dao động qua lại liên tục</text>
        </svg>
      </div>

      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="rounded-lg bg-white dark:bg-dark-surface p-3" data-anim="freq-card">
          <p class="text-sm font-bold text-navy dark:text-dark-text">18.000 vph</p>
          <p class="text-xs text-ink-soft dark:text-dark-text-soft">Cổ điển</p>
        </div>
        <div class="rounded-lg bg-white dark:bg-dark-surface p-3" data-anim="freq-card">
          <p class="text-sm font-bold text-navy dark:text-dark-text">21.600 vph</p>
          <p class="text-xs text-ink-soft dark:text-dark-text-soft">Tầm trung</p>
        </div>
        <div class="rounded-lg bg-brass/10 dark:bg-dark-brass/10 p-3 ring-1 ring-brass" data-anim="freq-card">
          <p class="text-sm font-bold text-brass dark:text-dark-brass">28.800 vph</p>
          <p class="text-xs text-ink-soft dark:text-dark-text-soft">Cao cấp (tiêu chuẩn)</p>
        </div>
        <div class="rounded-lg bg-white dark:bg-dark-surface p-3" data-anim="freq-card">
          <p class="text-sm font-bold text-navy dark:text-dark-text">36.000 vph</p>
          <p class="text-xs text-ink-soft dark:text-dark-text-soft">Rất cao (Zenith)</p>
        </div>
      </div>
      <p class="mt-4 text-xs text-ink-soft/90 dark:text-dark-text-soft/70">
        vph = số lần dao động mỗi giờ. Càng cao → kim giây càng mượt, đồng hồ càng chính xác.
      </p>
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 4: TÓM TẮT DÒNG CHẢY TỚI KIM
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      Dòng chảy tới kim đồng hồ
    </h3>
    <p class="mx-auto mb-12 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft">
      Nhớ dòng chảy này — nó là nền của mọi cơ chế phức tạp hơn (chronograph, tourbillon...).
    </p>

    <div class="mx-auto max-w-3xl" data-anim="flow-summary">
      <div class="flex flex-wrap items-center justify-center gap-2 rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-6 text-center text-sm font-medium">
        <span class="rounded-full bg-brass/15 px-3 py-2 text-brass dark:text-dark-brass">Dây cót</span>
        <span class="text-2xl text-ink-soft/40">→</span>
        <span class="rounded-full bg-[#4FB286]/15 px-3 py-2 text-[#2D7A55]">Bánh răng</span>
        <span class="text-2xl text-ink-soft/40">→</span>
        <span class="rounded-full bg-[#2E86AB]/15 px-3 py-2 text-[#1F6E8C]">Bộ thoát</span>
        <span class="text-2xl text-ink-soft/40">→</span>
        <span class="rounded-full bg-[#9B2C2C]/15 px-3 py-2 text-[#9B2C2C]">Bánh lắc</span>
        <span class="text-2xl text-ink-soft/40">→</span>
        <span class="rounded-full bg-navy px-3 py-2 text-cream">Kim đồng hồ</span>
      </div>
    </div>
  </div>

  <!-- Chú thích cuối -->
  <div class="infographic-note">
    <strong class="text-brass dark:text-dark-brass">💡 Tóm tắt:</strong>
    <strong>Dây cót</strong> (năng lượng) → <strong>Bánh răng</strong> (truyền + giảm tốc) →
    <strong>Bộ thoát</strong> (chia nhịp) → <strong>Bánh lắc</strong> (gác nhịp) → <strong>Kim</strong>.
    Hiểu dòng chảy này = hiểu được mọi cơ chế phức tạp hơn.
  </div>
</section>

<style>
  .svg-container svg {
    width: 100%;
    height: auto;
  }

  /*
    Mobile: nhãn chữ trong SVG (class svg-label) bị thu nhỏ tới ~4-5px khi
    viewBox 800 co về màn hình 320-375px — ẩn đi, thông tin tên bộ phận đã
    có trong legend chip (MechanismAnimation) và 4 thẻ "Mô tả từng trạm".
    Chữ chú thích còn lại (gt-caption) tăng cỡ để đạt tối thiểu 12px thực tế
    kể cả ở 320px — cảnh này nằm trong khung p-8 nên tỉ lệ co chỉ ~0.54
    (đo trên trình duyệt: 23px * 0.54 = 12.4px).
  */
  @media (max-width: 767px) {
    .svg-label {
      display: none;
    }
    .gt-caption {
      font-size: 23px;
    }
  }

  .scene [data-anim] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    will-change: opacity, transform;
  }

  .scene [data-anim="station-card"],
  .scene [data-anim="freq-card"] {
    transform: translateY(30px);
  }

  .scene [data-anim].reveal-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .scene [data-anim] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initInfographic() {
    const root = document.querySelector('[data-infographic="gear-train"]');
    if (!root) return;

    const revealTargets = root.querySelectorAll('[data-anim]');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );

    revealTargets.forEach((el) => observer.observe(el));

    setTimeout(() => {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
    }, 3000);
  }

  // ====== Tooltip cho 5 bánh răng khi rê chuột (desktop) ======
  // Thiết bị cảm ứng: chỉ highlight — tên bộ phận đã có trong legend mobile.
  function setupGearTooltips() {
    const svg = document.getElementById('gear-train-svg');
    if (!svg) return;
    const parts = svg.querySelectorAll('[data-part]');
    const tooltip = svg.querySelector('#gt-tooltip');
    const tooltipVi = svg.querySelector('#gt-tooltip-vi');
    const tooltipEn = svg.querySelector('#gt-tooltip-en');
    const tooltipBg = svg.querySelector('#gt-tooltip-bg');
    if (!tooltip || !tooltipVi) return;

    parts.forEach((part) => {
      const highlight = () => {
        part.style.filter = 'drop-shadow(0 0 6px #B8893C)';
        tooltipVi.textContent = part.getAttribute('data-name-vi') || '';
        tooltipEn.textContent = part.getAttribute('data-name-en') || '';
        tooltipBg.setAttribute('width', Math.max(tooltipVi.textContent.length, tooltipEn.textContent.length) * 7.5 + 20);
        tooltip.setAttribute('opacity', '1');
      };
      const unhighlight = () => {
        part.style.filter = '';
        tooltip.setAttribute('opacity', '0');
      };
      part.addEventListener('mouseenter', highlight);
      part.addEventListener('mouseleave', unhighlight);
      part.addEventListener('touchstart', (e) => {
        e.preventDefault();
        part.style.filter = 'drop-shadow(0 0 6px #B8893C)';
        setTimeout(() => { part.style.filter = ''; }, 2000);
      });
    });

    // Tooltip theo chuột
    svg.addEventListener('mousemove', (e) => {
      const rect = svg.getBoundingClientRect();
      const vb = svg.viewBox.baseVal;
      const x = (e.clientX - rect.left) * (vb.width / rect.width);
      const y = (e.clientY - rect.top) * (vb.height / rect.height);
      tooltip.setAttribute('transform', `translate(${Math.min(x, vb.width - 170)}, ${Math.max(y - 40, 0)})`);
    });
  }

  initInfographic();
  setupGearTooltips();
</script>
