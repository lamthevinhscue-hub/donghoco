---
// =============================================================================
// LUME — Dạ quang: nạp sáng → tắt đèn → sáng giảm dần
// =============================================================================
// Người đọc bấm "chiếu sáng" để nạp, rồi "tắt đèn" chuyển nền tối.
// Độ sáng dạ quang giảm dần theo thời gian thật. Ba vật liệu so sánh.
// Dùng MechanismAnimation wrapper.
// =============================================================================

import MechanismAnimation from './MechanismAnimation.astro';

// Ba vật liệu dạ quang
const materials = [
  {
    id: 'radium',
    name: 'Radium (cũ, đã bỏ)',
    en: 'Radium',
    desc: 'Phóng xạ, tự phát sáng liên tục — đã được bỏ vì vấn đề an toàn.',
    type: 'self',
    color: '#A0AEC0',
    initialGlow: 0.4,
    decay: 0, // không giảm (tự phát)
  },
  {
    id: 'tritium',
    name: 'Tritium (cũ)',
    en: 'Tritium',
    desc: 'Phóng xạ yếu hơn nhiều, tự phát sáng yếu nhưng bền. Nay ít dùng.',
    type: 'self',
    color: '#9B6E2C',
    initialGlow: 0.25,
    decay: 0,
  },
  {
    id: 'lumineva',
    name: 'Super-LumiNova (hiện đại)',
    en: 'Super-LumiNova',
    desc: 'Không phóng xạ. Phải nạp sáng, sáng mạnh lúc đầu rồi giảm dần.',
    type: 'charge',
    color: '#4FB286',
    initialGlow: 1.0,
    decay: 0.0008, // giảm dần
  },
];
---

<MechanismAnimation label="Dạ quang — nạp sáng rồi tắt đèn, xem độ sáng giảm dần" data-mech-step-id="lume">
  <svg viewBox="0 0 500 380" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-lg" id="lume-svg">
    <!-- Nền (đổi sáng/tối) -->
    <rect style="fill:var(--ig-bg)" id="lume-bg" x="0" y="0" width="500" height="300" class=""/>

    <text style="fill:var(--ig-stroke)" x="250" y="22" text-anchor="middle" font-size="12" font-weight="bold" id="lume-title" class="">
      Mặt số dạ quang — bấm "Chiếu sáng" để nạp năng lượng
    </text>

    <!-- ====== MẶT SỐ ĐỒNG HỒ ====== -->
    <circle style="stroke:var(--ig-stroke)" cx="250" cy="150" r="100" fill="none" stroke-width="2" id="lume-dial-ring" class="dark:stroke-dark-text"/>

    <!-- Cọc số dạ quang (12 vị trí) -->
    <g id="lume-markers">
      {Array.from({ length: 12 }).map((_, i) => {
        const a = (i * 30 - 90) * Math.PI / 180;
        const x = 250 + 85 * Math.cos(a);
        const y = 150 + 85 * Math.sin(a);
        return <rect class="lume-marker" x={x - 3} y={y - 6} width="6" height="12" rx="1" fill={materials[2].color} data-index={i} />;
      })}
    </g>

    <!-- Kim dạ quang -->
    <g id="lume-hands">
      <rect class="lume-hand" id="lume-hour-hand" x="248" y="100" width="4" height="55" rx="2" fill={materials[2].color} />
      <rect class="lume-hand" id="lume-min-hand" x="248.5" y="75" width="3" height="80" rx="1.5" fill={materials[2].color} />
      <circle cx="250" cy="150" r="5" fill={materials[2].color} />
    </g>

    <!-- Thanh độ sáng dạ quang -->
    <text style="fill:var(--ig-stroke)" x="250" y="275" text-anchor="middle" font-size="10" font-weight="bold" id="lume-intensity-label" class="">Độ sáng dạ quang</text>
    <rect style="stroke:var(--ig-stroke)" x="150" y="282" width="200" height="12" rx="3" fill="none" stroke-width="1" id="lume-bar-bg" class="dark:stroke-dark-text"/>
    <rect id="lume-bar-fill" x="152" y="284" width="196" height="8" rx="2" fill={materials[2].color}/>

    <!-- Vùng chọn vật liệu (dưới) -->
    <foreignObject x="50" y="310" width="400" height="60">
      <div xmlns="http://www.w3.org/1999/xhtml" style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center;">
        {materials.map((m, i) => (
          <button data-mat={m.id} class="lume-mat-btn" style={`padding:4px 10px;font-size:11px;border-radius:9999px;border:1px solid #B8893C;background:${i === 2 ? '#B8893C' : 'transparent'};color:${i === 2 ? '#FAF7F2' : '#1F2D3D'};cursor:pointer;touch-action:none;`}>{m.name}</button>
        ))}
      </div>
    </foreignObject>
  </svg>

  <!-- Nút điều khiển -->
  <div class="mt-3 flex flex-wrap items-center justify-center gap-3">
    <button type="button" id="lume-charge-btn" class="rounded-full bg-brass px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brass-light">
      ☀ Chiếu sáng (nạp năng lượng)
    </button>
    <button type="button" id="lume-dark-btn" class="rounded-full border border-navy px-4 py-2 text-sm font-medium text-navy transition-colors hover:bg-navy hover:text-cream dark:border-dark-text dark:text-dark-text">
      🌙 Tắt đèn
    </button>
    <span id="lume-status" class="text-xs text-ink-soft dark:text-dark-text-soft">Đang ở chế độ sáng</span>
  </div>

  <script is:inline define:vars={{}} slot="script">
    (function() {
      const svg = document.getElementById('lume-svg');
      if (!svg) return;
      const bg = svg.querySelector('#lume-bg');
      const title = svg.querySelector('#lume-title');
      const barFill = svg.querySelector('#lume-bar-fill');
      const intensityLabel = svg.querySelector('#lume-intensity-label');
      const status = document.getElementById('lume-status');
      const chargeBtn = document.getElementById('lume-charge-btn');
      const darkBtn = document.getElementById('lume-dark-btn');
      const matBtns = svg.querySelectorAll('.lume-mat-btn');
      if (!chargeBtn) return;

      let isDark = false;
      let glowLevel = 0; // 0 → 1
      let currentMat = 'lumineva'; // radium | tritium | lumineva
      let lastTs = 0;
      let rafId = null;

      const materials = {
        radium: { glow: 0.4, decay: 0, color: '#A0AEC0', type: 'self' },
        tritium: { glow: 0.25, decay: 0, color: '#9B6E2C', type: 'self' },
        lumineva: { glow: 1.0, decay: 0.0008, color: '#4FB286', type: 'charge' },
      };

      function updateGlow() {
        const m = materials[currentMat];
        const markers = svg.querySelectorAll('.lume-marker');
        const hands = svg.querySelectorAll('.lume-hand');
        const opacity = isDark ? glowLevel : Math.max(glowLevel, 0.15); // ở sáng, dạ quang luôn hơi thấy
        markers.forEach((mk) => { mk.setAttribute('opacity', String(opacity)); mk.setAttribute('fill', m.color); });
        hands.forEach((h) => { h.setAttribute('opacity', String(opacity)); h.setAttribute('fill', m.color); });
        barFill.setAttribute('fill', m.color);
        barFill.setAttribute('width', String(glowLevel * 196));
        intensityLabel.setAttribute('fill', m.color);
      }

      function render(ts) {
        if (!isDark) { if (rafId) cancelAnimationFrame(rafId); rafId = null; return; }
        if (!lastTs) lastTs = ts;
        const dt = ts - lastTs;
        lastTs = ts;

        // Giảm độ sáng theo thời gian (chỉ loại charge)
        const m = materials[currentMat];
        if (m.type === 'charge' && glowLevel > 0) {
          glowLevel -= m.decay * dt;
          if (glowLevel < 0) glowLevel = 0;
        }
        updateGlow();

        if (isDark && glowLevel > 0) {
          rafId = requestAnimationFrame(render);
        } else if (glowLevel <= 0) {
          status.textContent = 'Hết dạ quang — cần nạp lại bằng ánh sáng';
        }
      }

      // Nút chiếu sáng
      chargeBtn.addEventListener('click', function() {
        const m = materials[currentMat];
        if (m.type === 'charge') {
          glowLevel = m.glow;
          status.textContent = 'Đã nạp đầy — độ sáng sẽ giảm dần trong bóng tối';
        } else {
          glowLevel = m.glow;
          status.textContent = 'Loại này tự phát sáng — không cần nạp';
        }
        updateGlow();
      });

      // Nút tắt đèn
      darkBtn.addEventListener('click', function() {
        isDark = !isDark;
        if (isDark) {
          bg.setAttribute('fill', '#0a0f15');
          title.setAttribute('fill', '#FAF7F2');
          title.setAttribute('class', '');
          darkBtn.textContent = '☀ Bật đèn';
          status.textContent = 'Đang ở bóng tối — xem dạ quang phát sáng';
          lastTs = 0;
          rafId = requestAnimationFrame(render);
        } else {
          bg.setAttribute('fill', '#FAF7F2');
          title.setAttribute('fill', '#1F2D3D');
          darkBtn.textContent = '🌙 Tắt đèn';
          status.textContent = 'Đang ở chế độ sáng';
          if (rafId) cancelAnimationFrame(rafId);
          rafId = null;
        }
        updateGlow();
      });

      // Chọn vật liệu
      matBtns.forEach((btn) => {
        btn.addEventListener('click', function() {
          currentMat = btn.getAttribute('data-mat');
          matBtns.forEach((b) => {
            b.style.background = 'transparent';
            b.style.color = '#1F2D3D';
          });
          btn.style.background = '#B8893C';
          btn.style.color = '#FAF7F2';
          const m = materials[currentMat];
          glowLevel = m.glow;
          updateGlow();
        });
      });

      // Đăng ký hàm step rỗng
      (window.__mechSteps = window.__mechSteps || {})['lume'] = function() {};

      updateGlow();
    })();
  </script>
</MechanismAnimation>
