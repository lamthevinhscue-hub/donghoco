---
// =============================================================================
// INFOGRAPHIC: TRỮ CÓT (Power Reserve)
// =============================================================================
// Chuẩn nội dung duy nhất: các bài Markdown do
// scripts/check-automatic-energy-cluster.mjs quản lý (đầu tiên là
// src/content/coChe/vi/tru-cot.md). Mọi câu hiển thị phải chỉ ra được căn cứ
// trong bài; không có căn cứ thì không hiển thị.
//
// 4 cảnh:
//   1. Mở đầu — trữ cót là gì (định nghĩa theo bài)
//   2. Thùng cót + dây cót — HOẠT ẢNH MINH HỌA NGUYÊN LÝ (nhịp nhả trong hình
//      là ẩn dụ, không phản ánh thời lượng của một mẫu; không gắn mức giờ)
//   3. Không có mức chuẩn chung — thông số của từng calibre
//   4. Đồng hồ dừng thì sao? — dừng vì hết cót không phải hỏng
//
// Nội dung vượt căn cứ bài viết đã được rút khỏi bản trước (danh sách cụm
// xem biên bản gói P0.2 trong docs/nghiem-thu/).
// =============================================================================

import MechanismAnimation from './MechanismAnimation.astro';

// Ba ý "không có mức chuẩn chung" — đúng như bài viết.
const facts = [
  {
    title: 'Thông số của từng calibre',
    text: 'Thời lượng chạy sau khi lên đầy là thông số do hãng công bố cho từng calibre — không có mức chuẩn chung cho mọi đồng hồ cơ.',
  },
  {
    title: 'Cấu tạo là quyết định của hãng',
    text: 'Số thùng cót, cách ghép chúng, vật liệu và kích thước dây cót, thời lượng chạy, độ ổn định lực — là quyết định riêng của từng nhà sản xuất.',
  },
  {
    title: 'Con số của chiếc bạn nằm ở tài liệu mẫu',
    text: 'Con số cụ thể nằm trong thông số mẫu trên trang chính thức của hãng hoặc trong tài liệu kèm đồng hồ.',
  },
];
---

<section class="infographic my-12" data-infographic="power-reserve">
  <!-- ====================================================================
       CẢNH 1: MỞ ĐẦU
       ==================================================================== -->
  <div class="scene scene-intro infographic-intro">
    <p class="mb-3 text-sm uppercase tracking-widest text-brass-light">Infographic động</p>
    <h2 class="font-serif text-3xl sm:text-5xl">Đồng hồ cơ chạy được bao lâu?</h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream/80">
      Khi đặt đồng hồ xuống, dây cót dần nhả — đến lúc hết thì đồng hồ dừng.
      <strong class="text-brass-light">Trữ cót</strong> cho biết bao lâu thì đồng hồ dừng
      nếu không được tiếp năng lượng. Cuộn xuống để hiểu.
    </p>
    <div class="mt-8 intro-arrow text-brass-light">↓</div>
  </div>

  <!-- ====================================================================
       CẢNH 2: THÙNG CÓT + DÂY CÓT — HOẠT ẢNH MINH HỌA NGUYÊN LÝ
       ==================================================================== -->
  <div class="scene mt-24 grid items-center gap-8 md:grid-cols-2">
    <div class="svg-container" data-svg="barrel">
      <MechanismAnimation label="Minh họa nguyên lý: dây cót nhả dần — mức trữ cót tụt xuống" data-mech-step-id="power-reserve">
        <svg viewBox="0 0 400 360" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-md" id="power-reserve-svg" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="prBrass" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" style="stop-color:var(--obs-brass-deep)" />
              <stop offset="0.3" style="stop-color:var(--obs-brass-soft)" />
              <stop offset="0.42" style="stop-color:var(--obs-brass)" />
              <stop offset="1" style="stop-color:var(--obs-brass-deep)" />
            </linearGradient>
          </defs>
          <!-- ====== THANH TRỮ CÓT (trên cùng — mức định tính) ====== -->
          <text style="fill:var(--ig-stroke)" x="200" y="20" text-anchor="middle" font-size="11" font-weight="bold" class="">Mức trữ cót (minh họa)</text>
          <rect style="stroke:var(--ig-stroke)" x="60" y="28" width="280" height="18" rx="3" fill="none" stroke-width="1.5" class="dark:stroke-dark-text"/>
          <rect id="pr-bar-fill" x="62" y="30" width="276" height="14" rx="2" style="fill:var(--obs-brass)"/>
          <text style="fill:var(--ig-stroke)" id="pr-bar-label" x="200" y="62" text-anchor="middle" font-size="12" font-weight="bold" class="">100%</text>

          <!-- ====== THÙNG CÓT (giữa) ====== -->
          <g transform="translate(200, 170)">
            <circle style="fill:var(--ig-bg);stroke:var(--obs-brass-deep)" r="78" stroke-width="2" class=""/>
            {Array.from({ length: 20 }).map((_, i) => {
              const a = (i * 360) / 20;
              return <g transform={`rotate(${a})`}><rect x="-2" y="-84" width="4" height="8" style="fill:var(--obs-brass)"/></g>;
            })}
            <g id="pr-mainspring" data-part="mainspring" data-name-vi="Dây cót (Mainspring)" data-name-en="Mainspring"></g>
            <circle style="fill:var(--ig-edge)" r="8"/>
          </g>
          <text style="fill:var(--ig-stroke)" x="200" y="270" text-anchor="middle" font-size="10" font-weight="bold" class="">Thùng cót + dây cót</text>

          <!-- ====== BÁNH LẮC (dưới — dao động minh họa) ====== -->
          <g transform="translate(200, 320)">
            <path style="stroke:var(--ig-rubi)" id="pr-arc" d="M -50 0 A 50 50 0 0 1 50 0" fill="none" stroke-width="0.5" stroke-dasharray="3 3" opacity="0.3"/>
            <g id="pr-balance" data-part="balance-pr" data-name-vi="Bánh lắc (Balance wheel)" data-name-en="Balance wheel">
              <circle style="stroke:var(--ig-rubi)" r="22" fill="none" stroke-width="2"/>
              <line style="stroke:var(--ig-rubi)" x1="0" y1="-22" x2="0" y2="22" stroke-width="1"/>
              <line style="stroke:var(--ig-rubi)" x1="-19" y1="-11" x2="19" y2="11" stroke-width="1"/>
              <circle style="fill:var(--ig-rubi)" r="4"/>
            </g>
          </g>
          <text style="fill:var(--ig-stroke)" id="pr-amplitude-note" x="200" y="354" text-anchor="middle" font-size="10" opacity="0" class=""></text>
        </svg>

        <script is:inline define:vars={{}} slot="script">
          // Sinh dây cót xoắn ốc tĩnh lần đầu (rồi cập nhật động)
          (function initMainspring() {
            const g = document.querySelector('#power-reserve-svg #pr-mainspring');
            if (!g || g.children.length > 0) return;
            const svgNS = 'http://www.w3.org/2000/svg';
            for (let i = 0; i < 5; i++) {
              const r = 70 - i * 12;
              const c = document.createElementNS(svgNS, 'circle');
              c.setAttribute('r', String(r));
              c.setAttribute('fill', 'none');
              c.style.stroke = 'var(--obs-brass)';
              c.setAttribute('stroke-width', '4');
              c.setAttribute('opacity', '0.7');
              c.setAttribute('stroke-dasharray', String(r * 2.5) + ' ' + String(r * 3.8));
              c.setAttribute('class', 'pr-coil');
              c.dataset.baseRadius = String(r);
              g.appendChild(c);
            }
          })();

          // Minh họa nguyên lý: dây cót nhả dần (nhịp trong hình là ẩn dụ)
          (window.__mechSteps = window.__mechSteps || {})['power-reserve'] = function(delta, elapsed) {
            const svg = document.getElementById('power-reserve-svg');
            if (!svg) return;
            const barFill = svg.querySelector('#pr-bar-fill');
            const barLabel = svg.querySelector('#pr-bar-label');
            const coils = svg.querySelectorAll('.pr-coil');
            const balance = svg.querySelector('#pr-balance');
            if (!barFill || !balance) return;

            // Chu kỳ nhả minh họa — KHÔNG tương ứng thời lượng của một mẫu
            const cycle = 20000;
            const phase = (elapsed % cycle) / cycle;
            const reserve = 1 - phase;

            const barW = Math.max(0, 276 * reserve);
            barFill.setAttribute('width', String(barW));
            barLabel.textContent = 'mức còn lại: ' + Math.round(reserve * 100) + '% (minh họa)';

            coils.forEach((coil) => {
              const base = parseFloat(coil.dataset.baseRadius);
              const expand = (1 - reserve) * 10;
              coil.setAttribute('r', String(base + expand));
            });

            // Bánh lắc dao động đều — chỉ minh họa nhịp
            const swingAngle = Math.sin((elapsed / 1000) * Math.PI * 2) * 20;
            balance.setAttribute('transform', `rotate(${swingAngle})`);
          };
        </script>
      </MechanismAnimation>
    </div>
    <div class="space-y-4">
      <h3 class="font-serif text-2xl text-navy dark:text-dark-text">Dây cót — "pin cơ học"</h3>
      <p class="text-ink-soft dark:text-dark-text-soft">
        Dây cót (mainspring) là một dải thép dài cuộn quanh trục trong <strong>thùng cót</strong>
        (barrel). Khi lên dây (vặn núm, hoặc đeo với automatic): dây cót bị cuộn chặt →
        <strong>tích trữ năng lượng</strong>. Khi nhả: dây cót từ từ mở ra →
        <strong>giải phóng năng lượng</strong> chạy đồng hồ.
      </p>
      <p class="text-ink-soft dark:text-dark-text-soft">
        Hãy nghĩ nó như một <strong>"pin cơ học"</strong>: bạn "sạc" bằng cách lên dây,
        và nó từ từ "xả" trong nhiều giờ.
      </p>
      <div class="rounded-lg border border-brass/30 bg-brass/5 dark:bg-dark-brass/10 p-4 text-sm text-ink-soft dark:text-dark-text-soft">
        <strong class="text-brass dark:text-dark-brass">💡 Trữ cót (power reserve)</strong> =
        thời gian đồng hồ chạy được sau khi dây cót được lên đầy.
      </div>
      <p class="text-sm text-ink-soft dark:text-dark-text-soft">
        Trong hoạt ảnh bên: dây cót giãn ra khi nhả, mức trữ cót tụt xuống. Nhịp nhả trong hình
        là <strong>ẩn dụ minh họa</strong> — không phản ánh thời lượng của một mẫu cụ thể.
      </p>
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 3: KHÔNG CÓ MỨC CHUẨN CHUNG
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      Không có mức chuẩn chung
    </h3>
    <p class="mx-auto mb-12 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft">
      Trữ cót là <strong>thông số của từng calibre</strong> — không xếp mức cho "đồng hồ nói chung".
    </p>

    <div class="space-y-4">
      {facts.map((fact, i) => (
        <div
          class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4 sm:p-5"
          data-anim="level"
          data-index={i}
        >
          <div class="flex items-start gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-steel font-mono text-sm font-semibold text-steel dark:border-steel" style="font-variant-numeric: lining-nums;" aria-hidden="true">{i + 1}</span>
            <div>
              <h4 class="font-serif text-base text-navy dark:text-dark-text">{fact.title}</h4>
              <p class="mt-1 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">{fact.text}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 4: ĐỒNG HỒ DỪNG THÌ SAO?
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      Đồng hồ dừng thì sao?
    </h3>
    <p class="mx-auto mb-8 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft">
      <strong>Dừng vì hết cót không phải là hỏng.</strong> Đeo lại (với automatic, chuyển động
      tay làm rotor quay lên dây) hoặc lên tay theo hướng dẫn của mẫu sẽ khởi động lại nó.
    </p>

    <div class="mx-auto max-w-2xl space-y-3">
      <div class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4" data-anim="app-card" data-index="0">
        <p class="text-sm leading-relaxed text-ink dark:text-dark-text">
          Thao tác lên tay an toàn → bài <a class="font-medium text-steel underline-offset-2 hover:underline dark:text-steel" href="/huong-dan/len-day-dong-ho">lên dây đồng hồ cơ</a>.
        </p>
      </div>
      <div class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4" data-anim="app-card" data-index="1">
        <p class="text-sm leading-relaxed text-ink dark:text-dark-text">
          Chỉnh lại giờ và lịch sau khi dừng → bài <a class="font-medium text-steel underline-offset-2 hover:underline dark:text-steel" href="/huong-dan/chinh-lich-an-toan">chỉnh lịch an toàn</a>.
        </p>
      </div>
      <div class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4" data-anim="app-card" data-index="2">
        <p class="text-sm leading-relaxed text-ink dark:text-dark-text">
          Đồng hồ automatic có cần lên tay không? <strong>Tùy mẫu</strong> — nguồn quyết định
          là tài liệu của đúng chiếc, không theo con số chung nào.
        </p>
      </div>
    </div>
  </div>

  <!-- Chú thích cuối -->
  <div class="infographic-note">
    <strong class="text-brass dark:text-dark-brass">💡 Tóm tắt:</strong>
    Trữ cót = thời gian đồng hồ chạy được khi dây cót được lên đầy — <strong>thông số do hãng
    công bố cho từng calibre</strong>. Dừng vì hết cót không phải là hỏng; con số của chiếc bạn
    nằm trong tài liệu của đúng mẫu.
  </div>
</section>

<style>
  /* Ảnh SVG responsive */
  .svg-container svg {
    width: 100%;
    height: auto;
  }

  /* Hoạt ảnh reveal (CSS transition + Intersection Observer trong script) */
  .scene [data-anim] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    will-change: opacity, transform;
  }

  .scene [data-anim="level"] {
    transform: translateX(-30px);
  }

  .scene [data-anim].reveal-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .scene [data-anim] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initInfographic() {
    const root = document.querySelector('[data-infographic="power-reserve"]');
    if (!root) return;

    const revealTargets = root.querySelectorAll('[data-anim]');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );

    revealTargets.forEach((el) => observer.observe(el));

    // Fallback an toàn: ép hiện sau 3s
    setTimeout(() => {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
    }, 3000);
  }

  initInfographic();
</script>
