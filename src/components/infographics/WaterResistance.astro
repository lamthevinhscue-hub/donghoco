---
// =============================================================================
// INFOGRAPHIC: CHỐNG NƯỚC (Water Resistance)
// =============================================================================
// Chuẩn nội dung duy nhất: các bài Markdown do
// scripts/check-daily-care-cluster.mjs quản lý (đầu tiên là
// src/content/coChe/vi/chong-nuoc.md và src/content/huongDan/vi/muc-chong-nuoc.md).
// Mọi câu hiển thị phải chỉ ra được căn cứ trong bài; không có căn cứ trong
// bài thì không hiển thị.
//
// Cấu trúc 5 cảnh:
//   1. Mở đầu — con số khắc trên vỏ có ý nghĩa kèm điều kiện công bố
//   2. Điểm niêm phong + minh họa áp suất ĐỊNH TÍNH (không mét, không ATM)
//   3. Gioăng — bộ phận bị mòn; kiểm tra áp suất cần thiết bị chuyên môn
//   4. Hai hãng, hai cách công bố (Omega / Seiko) — không bảng quy đổi chung
//   5. Đã công bố vs chưa công bố — không suy quy tắc
//
// Nội dung vượt căn cứ bài viết đã được rút khỏi bản trước (danh sách cụm
// xem biên bản gói P0.2 trong docs/nghiem-thu/).
// =============================================================================

import MechanismAnimation from './MechanismAnimation.astro';

// Năm điểm niêm phong — đúng danh sách của bài viết.
const seals = [
  { n: '①', name: 'Kính (crystal)', text: 'gioăng viền kính.' },
  { n: '②', name: 'Núm vặn (crown)', text: 'điểm thao tác nhiều nhất; núm ren phải vặn kín sau mỗi lần chỉnh (nguyên tắc Omega: "always screw it in after handling it").' },
  { n: '③', name: 'Nắp lưng (caseback)', text: 'gioăng viền nắp.' },
  { n: '④', name: 'Nút bấm (pushers)', text: 'Omega: "Avoid operating the chronograph pushers under water" — ngoại lệ do hãng công bố cho một số mẫu.' },
  { n: '⑤', name: 'Van helium', text: 'trên một số mẫu lặn sâu.' },
];

// Hai hãng, hai cách công bố — đúng như bài viết.
const disclosures = [
  {
    brand: 'OMEGA',
    text: 'Sản phẩm "water resistant to the depth defined by the model specifications, provided that the components ensuring the water resistance are intact" — mức theo thông số mẫu, điều kiện là các bộ phận niêm phong còn nguyên vẹn.',
  },
  {
    brand: 'SEIKO',
    text: 'Bảng theo ký hiệu BAR khắc trên vỏ, cho đồng hồ Seiko: 3BAR — tia nước văng, mưa; 5BAR — thêm bơi, du thuyền, tắm vòi sen; 10/15/20BAR — thêm tắm, lặn nông; Diver\'s 200m — thêm lặn bình khí; Professional 1000m — thêm lặn bão hòa. Seiko yêu cầu đọc ký hiệu trên vỏ đúng chiếc đồng hồ của bạn.',
  },
];

// Đã công bố — trích theo bài viết.
const announced = [
  'Rửa nước sạch sau nước biển (Omega, Seiko); lau khô bằng vải mềm.',
  'Không rửa khi núm đang kéo ra; tránh rửa trực tiếp dưới vòi nước chảy (Seiko).',
  'Núm vặn ren luôn vặn kín sau thao tác (Omega).',
  'Không bấm nút chronograph dưới nước, trừ ngoại lệ hãng công bố (Omega — một số Seamaster 300M/600M).',
  'Nhiệt độ vận hành tối ưu 0–60°C (Omega).',
];

// Minh họa áp suất định tính — bốn mức, không đơn vị đo.
const pressureLevels = ['chưa có nước (minh họa)', 'áp suất thấp (minh họa)', 'áp suất vừa (minh họa)', 'áp suất cao (minh họa)'];
---

<section class="infographic my-12" data-infographic="water-resistance">
  <!-- ====================================================================
       CẢNH 1: MỞ ĐẦU
       ==================================================================== -->
  <div class="scene scene-intro infographic-intro">
    <p class="mb-3 text-sm uppercase tracking-widest text-brass-light">Infographic động</p>
    <h2 class="font-serif text-3xl sm:text-5xl">Con số khắc trên vỏ — đọc thế nào cho đúng?</h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream/80">
      "100m" trên vỏ đồng hồ <strong class="text-brass-light">không</strong> tự động có nghĩa
      bạn bơi được 100m. Con số đó chỉ có ý nghĩa <strong class="text-brass-light">kèm điều kiện
      công bố của từng hãng</strong> — và khả năng chống nước thay đổi theo thời gian sử dụng.
    </p>
    <div class="mt-8 intro-arrow text-brass-light">↓</div>
  </div>

  <!-- ====================================================================
       CẢNH 2: ĐIỂM NIÊM PHONG + MINH HỌA ÁP SUẤT ĐỊNH TÍNH
       ==================================================================== -->
  <div class="scene mt-24 grid items-center gap-8 md:grid-cols-2">
    <div class="svg-container" data-svg="case">
      <MechanismAnimation label="Minh họa nguyên lý: áp suất tăng — gioăng bị ép; điểm hở là đường vào của nước" data-mech-step-id="water-resistance">
        <svg viewBox="0 0 400 380" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-md" id="water-resistance-svg" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="wrSteel" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color:var(--obs-steel-soft)" />
              <stop offset="0.55" style="stop-color:var(--obs-steel)" />
              <stop offset="1" style="stop-color:var(--obs-steel-deep)" />
            </linearGradient>
            <linearGradient id="wrSapphire" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" style="stop-color:var(--obs-ivory)" stop-opacity="0.5" />
              <stop offset="0.5" style="stop-color:var(--obs-ivory)" stop-opacity="0.1" />
              <stop offset="1" style="stop-color:var(--obs-ivory)" stop-opacity="0.3" />
            </linearGradient>
          </defs>
          <text style="fill:var(--ig-stroke)" x="200" y="18" text-anchor="middle" font-size="11" font-weight="bold" class="svg-label">
            Minh họa: áp suất tăng → điểm niêm phong chịu ép lớn hơn
          </text>

          <!-- ====== NƯỚC (dâng theo mức minh họa) ====== -->
          <rect id="wr-water" x="0" y="380" width="400" height="0" style="fill:var(--obs-steel)" opacity="0.15"/>

          <!-- ====== VỎ ĐỒNG HỒ (cắt mặt bên) ====== -->
          <path fill="url(#wrSteel)" style="stroke:var(--obs-steel-deep)" d="M 80 80 L 80 240 L 320 240 L 320 80 Z" stroke-width="2"/>
          <rect style="fill:var(--ig-bg)" x="100" y="100" width="200" height="120" class=""/>
          <circle cx="200" cy="160" r="30" style="fill:var(--obs-brass)" opacity="0.25"/>
          <text style="fill:var(--ig-steel)" x="200" y="165" text-anchor="middle" font-size="10" class="svg-label ">Máy</text>

          <!-- Kính -->
          <rect x="100" y="80" width="200" height="20" fill="url(#wrSapphire)" opacity="0.55" style="stroke:var(--obs-steel)" stroke-width="1"/>
          <rect id="wr-gasket-crystal" x="100" y="78" width="200" height="6" style="fill:var(--obs-brass-soft)" rx="2"/>

          <!-- Núm vặn -->
          <rect fill="url(#wrSteel)" style="stroke:var(--obs-steel-deep)" id="wr-crown" x="320" y="150" width="30" height="20" rx="4" stroke-width="1"/>
          <ellipse id="wr-gasket-crown" cx="320" cy="160" rx="3" ry="8" style="fill:var(--obs-brass-soft)"/>

          <!-- Nắp lưng -->
          <rect fill="url(#wrSteel)" style="stroke:var(--obs-steel-deep)" x="100" y="220" width="200" height="20" stroke-width="1"/>
          <rect id="wr-gasket-caseback" x="100" y="218" width="200" height="6" style="fill:var(--obs-brass-soft)" rx="2"/>

          <!-- Nước vào qua điểm hở (minh họa khi núm mở) -->
          <path id="wr-flood" d="" style="fill:var(--obs-steel)" opacity="0" />

          <!-- ====== THANH ÁP SUẤT MINH HỌA (dưới) ====== -->
          <text style="fill:var(--ig-stroke)" x="200" y="300" text-anchor="middle" font-size="10" font-weight="bold" class="wr-label">Áp suất (minh họa)</text>
          <rect style="stroke:var(--ig-stroke)" x="60" y="310" width="280" height="20" rx="4" fill="none" stroke-width="1.5" class="dark:stroke-dark-text"/>
          <rect id="wr-depth-fill" x="62" y="312" width="0" height="16" rx="2" style="fill:var(--obs-steel)"/>
          <text style="fill:var(--ig-stroke)" id="wr-depth-label" x="200" y="350" text-anchor="middle" font-size="12" font-weight="bold" class="wr-label">chưa có nước (minh họa)</text>
          <text id="wr-pressure-label" x="200" y="368" text-anchor="middle" font-size="10" style="fill:var(--obs-steel)" class="wr-label dark:fill-dark-text-soft"></text>
        </svg>

        <!-- Thanh mức áp suất minh họa — HTML ngoài SVG (vùng chạm 44px), KHÔNG đơn vị mét/ATM -->
        <div class="mt-4">
          <input
            type="range"
            id="wr-depth-slider"
            min="0"
            max="3"
            value="0"
            step="1"
            class="wr-depth-slider w-full cursor-pointer appearance-none bg-transparent"
            aria-label="Mức áp suất minh họa tăng dần — chỉ minh họa nguyên lý, không phải độ sâu sử dụng thực tế"
          />
        </div>

        <!-- Nút minh họa: điểm hở là đường vào của nước (vùng bấm 44px) -->
        <div class="mt-3 text-center">
          <button
            type="button"
            id="wr-pull-crown-btn"
            class="min-h-11 rounded-full bg-ruby px-4 py-2 text-sm font-medium text-cream transition-colors hover:bg-brass"
          >
            Minh họa: núm vặn mở khi tiếp xúc nước
          </button>
          <p class="mx-auto mt-2 max-w-md text-xs text-ink-soft dark:text-dark-text-soft">
            Minh họa nguyên lý — không phải phép thử, không phản ánh mức chống nước của một mẫu đồng hồ.
          </p>
        </div>

        <script is:inline define:vars={{}} slot="script">
          (function() {
            const svg = document.getElementById('water-resistance-svg');
            if (!svg) return;
            const slider = document.getElementById('wr-depth-slider');
            const depthFill = svg.querySelector('#wr-depth-fill');
            const depthLabel = svg.querySelector('#wr-depth-label');
            const pressureLabel = svg.querySelector('#wr-pressure-label');
            const water = svg.querySelector('#wr-water');
            const gCrystal = svg.querySelector('#wr-gasket-crystal');
            const gCrown = svg.querySelector('#wr-gasket-crown');
            const gCaseback = svg.querySelector('#wr-gasket-caseback');
            const flood = svg.querySelector('#wr-flood');
            const pullBtn = document.getElementById('wr-pull-crown-btn');
            if (!slider) return;

            const labels = ['chưa có nước (minh họa)', 'áp suất thấp (minh họa)', 'áp suất vừa (minh họa)', 'áp suất cao (minh họa)'];

            function render() {
              const level = parseInt(slider.value, 10); // 0..3 — mức minh họa, không đơn vị

              depthFill.setAttribute('width', String((level / 3) * 276));
              depthLabel.textContent = labels[level];
              pressureLabel.textContent = '';

              const waterH = Math.min(280, level * 90);
              water.setAttribute('y', String(380 - waterH));
              water.setAttribute('height', String(waterH));

              // Gioăng chịu ép theo mức minh họa
              const compression = Math.min(0.6, level / 5);
              const gH = 6 * (1 - compression);
              gCrystal.setAttribute('height', String(gH));
              gCrystal.setAttribute('y', String(78 + (6 - gH) / 2));
              gCaseback.setAttribute('height', String(gH));
              gCaseback.setAttribute('y', String(218 + (6 - gH) / 2));
              gCrown.setAttribute('ry', String(8 * (1 - compression)));
            }

            slider.addEventListener('input', render);

            // Minh họa: điểm hở (núm mở) là đường vào của nước
            pullBtn.addEventListener('click', function() {
              const level = parseInt(slider.value, 10);
              if (level > 0) {
                flood.setAttribute('opacity', '0.6');
                flood.setAttribute('d', 'M 100 100 L 100 240 L 300 240 L 300 100 Z');
                flood.style.fill = 'var(--obs-steel)';
                setTimeout(function() { flood.setAttribute('opacity', '0'); }, 3000);
              } else {
                flood.setAttribute('opacity', '0.3');
                flood.setAttribute('d', 'M 280 150 L 260 145 L 270 155 Z');
                flood.style.fill = 'var(--obs-brass-soft)';
                setTimeout(function() { flood.setAttribute('opacity', '0'); }, 1500);
              }
            });

            (window.__mechSteps = window.__mechSteps || {})['water-resistance'] = function() {};

            (window.__mechResets = window.__mechResets || {})['water-resistance'] = function() {
              slider.value = '0';
              flood.setAttribute('opacity', '0');
              render();
            };

            render();
          })();
        </script>
      </MechanismAnimation>
    </div>
    <div class="space-y-4">
      <h3 class="font-serif text-2xl text-navy dark:text-dark-text">Các điểm niêm phong</h3>
      <p class="text-ink-soft dark:text-dark-text-soft">
        Theo Omega, khả năng chống nước được bảo đảm bởi các <strong>gioăng</strong> đặt giữa
        <strong>núm vặn, nút bấm, kính và vỏ</strong>; một số mẫu có thêm <strong>van helium</strong>.
        Mỗi điểm hở đều là đường vào của nước.
      </p>
      <p class="text-sm text-ink-soft dark:text-dark-text-soft">
        Kéo thanh mức bên cạnh để xem <strong>minh họa nguyên lý</strong>: áp suất tăng, điểm niêm phong
        chịu ép lớn hơn. Đây là minh họa — không phải phép thử, và không quy đổi ra độ sâu sử dụng thực tế.
      </p>
      <p class="text-sm text-ink-soft dark:text-dark-text-soft">
        Xem hướng dẫn chi tiết trong bài <a href="/huong-dan/muc-chong-nuoc" class="text-brass underline">mức chống nước</a>.
      </p>
      <ul class="space-y-3 text-sm">
        {seals.map((s) => (
          <li class="flex gap-3">
            <span class="text-brass dark:text-dark-brass font-bold">{s.n}</span>
            <span><strong>{s.name}</strong> — {s.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 3: GIOĂNG — BỘ PHẬN BỊ MÒN; KIỂM TRA CẦN CHUYÊN MÔN
       ==================================================================== -->
  <div class="scene mt-24 rounded-2xl border border-cream-dark dark:border-dark-border bg-cream-dark/30 dark:bg-dark-border/30 p-8 sm:p-12">
    <div class="mx-auto max-w-3xl">
      <h3 class="mb-6 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
        Gioăng — bộ phận bị mòn
      </h3>
      <div class="space-y-4 text-ink-soft dark:text-dark-text-soft">
        <p class="text-sm leading-relaxed sm:text-base">
          Gioăng là vòng đệm bị <strong>ép chặt</strong> giữa các bộ phận. Omega ghi rõ: gioăng
          "<strong>deteriorate over time</strong>" do nhiệt độ, môi trường, hóa chất và
          "<strong>must be regularly replaced</strong>" — khả năng chống nước của một chiếc đồng hồ
          không đứng yên theo thời gian.
        </p>
        <p class="text-sm leading-relaxed sm:text-base">
          Seiko đồng quan điểm: "A watch's water resistance is <strong>not permanently guaranteed</strong>" —
          ảnh hưởng bởi <strong>lão hóa gioăng</strong> và <strong>biến dạng vỏ do va chạm</strong>.
        </p>
        <p class="text-sm leading-relaxed sm:text-base">
          Việc kiểm tra chống nước cần <strong>thiết bị chuyên dụng</strong> — nhờ thợ hoặc trung tâm
          bảo trì chính hãng. Khuyến nghị kiểm tra hằng năm và chu kỳ full service là khuyến nghị
          <strong>của Omega, cho sản phẩm Omega</strong>; các hãng khác có khuyến nghị riêng — tra manual.
        </p>
      </div>
      <div class="svg-container mt-8" data-svg="pressure">
        <svg viewBox="0 0 500 200" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-2xl" aria-hidden="true" focusable="false">
          <circle style="fill:var(--ig-steel);stroke:var(--ig-edge)" cx="250" cy="100" r="50" stroke-width="3"/>
          <circle style="fill:var(--ig-bg)" cx="250" cy="100" r="35"/>
          <circle cx="250" cy="100" r="35" fill="none" style="stroke:var(--obs-brass-soft)" stroke-width="3" data-anim="seal-ring"/>
          <g data-anim="pressure-arrows" opacity="0">
            <line x1="250" y1="20" x2="250" y2="45" style="stroke:var(--obs-steel)" stroke-width="2"/>
            <polygon points="250,50 245,42 255,42" style="fill:var(--obs-steel)"/>
            <line x1="250" y1="180" x2="250" y2="155" style="stroke:var(--obs-steel)" stroke-width="2"/>
            <polygon points="250,150 245,158 255,158" style="fill:var(--obs-steel)"/>
            <line x1="170" y1="100" x2="195" y2="100" style="stroke:var(--obs-steel)" stroke-width="2"/>
            <polygon points="200,100 192,95 192,105" style="fill:var(--obs-steel)"/>
            <line x1="330" y1="100" x2="305" y2="100" style="stroke:var(--obs-steel)" stroke-width="2"/>
            <polygon points="300,100 308,95 308,105" style="fill:var(--obs-steel)"/>
            <text x="250" y="14" text-anchor="middle" font-size="10" style="fill:var(--obs-steel)" class="wr-atm-label">áp suất thử (minh họa)</text>
          </g>
          <circle cx="250" cy="100" r="35" fill="none" style="stroke:var(--obs-steel)" stroke-width="2" opacity="0" data-anim="water-test"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 4: HAI HÃNG, HAI CÁCH CÔNG BỐ
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      Hai hãng, hai cách công bố
    </h3>
    <p class="mx-auto mb-12 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft">
      Không có bảng quy đổi giữa các hãng — <strong>manual của đúng mẫu luôn là chuẩn</strong>.
    </p>

    <div class="grid gap-6 md:grid-cols-2">
      {disclosures.map((d, i) => (
        <div
          class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-6"
          data-anim="level"
          data-index={i}
        >
          <h3 class="mb-2 font-serif text-lg text-navy dark:text-dark-text">{d.brand}</h3>
          <p class="text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">{d.text}</p>
        </div>
      ))}
    </div>

    <div class="mt-8 rounded-lg border-l-4 border-brass bg-brass/5 dark:bg-dark-brass/10 p-5">
      <p class="text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
        Đồng hồ lặn của từng hãng công bố theo chuẩn lặn riêng và bảng dùng được riêng — với đồng hồ
        lặn, tra thông số và manual của <strong>đúng mẫu</strong>, kể cả tên chuẩn khắc trên vỏ.
      </p>
    </div>
  </div>

  <!-- ====================================================================
       CẢNH 5: ĐÃ CÔNG BỐ VS CHƯA CÔNG BỐ
       ==================================================================== -->
  <div class="scene mt-24">
    <h3 class="mb-3 text-center font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      Đã công bố — và những gì chưa
    </h3>
    <p class="mx-auto mb-12 max-w-2xl text-center text-ink-soft dark:text-dark-text-soft">
      Chỉ những gì các nguồn đã nêu mới thành hướng dẫn; phần còn lại không suy ra quy tắc.
    </p>

    <div class="mx-auto max-w-3xl space-y-3">
      {announced.map((item, i) => (
        <div
          class="rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-4"
          data-anim="myth"
          data-index={i}
        >
          <p class="flex items-start gap-2 text-sm leading-relaxed text-ink dark:text-dark-text">
            <span class="text-lg text-green-600">✓</span>
            <span>{item}</span>
          </p>
        </div>
      ))}
      <div class="rounded-lg border-l-4 border-ruby bg-ruby/5 p-5" data-anim="myth" data-index="5">
        <p class="text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
          <strong class="text-ruby">Chưa có công bố cụ thể trong các nguồn đã trích:</strong> tác động của
          xà phòng/dầu gội/nước clo lên từng mức chống nước; giới hạn sauna. Với những trường hợp này,
          không suy ra quy tắc — tra manual của mẫu hoặc hỏi dịch vụ có chuyên môn.
        </p>
      </div>
    </div>
  </div>

  <!-- Chú thích cuối -->
  <div class="infographic-note">
    <strong class="text-brass dark:text-dark-brass">💡 Tóm tắt:</strong>
    Con số khắc trên vỏ có ý nghĩa <strong>kèm điều kiện công bố của từng hãng</strong> — không tự
    động là "độ sâu sử dụng được". Khả năng chống nước thay đổi theo thời gian do gioăng mòn.
    Trước khi tiếp xúc nước, kiểm tra chỉ số và hướng dẫn chính thức của <strong>đúng mẫu</strong>.
  </div>
</section>

<style>
  /* Ảnh SVG responsive */
  .svg-container svg {
    width: 100%;
    height: auto;
  }

  /*
    Mobile: nhãn mô tả (svg-label, wr-atm-label) quá nhỏ khi SVG co lại — ẩn đi.
    Chỉ số phản hồi tương tác (wr-label) tăng cỡ để đọc được ở 320 và 375px.
  */
  @media (max-width: 767px) {
    .svg-label,
    .wr-atm-label {
      display: none;
    }
    .wr-label {
      font-size: 19px;
    }
  }

  /*
    Thanh mức áp suất minh họa (HTML ngoài SVG): vùng chạm 44px.
  */
  .wr-depth-slider {
    height: 2.75rem;
  }
  .wr-depth-slider::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 9999px;
    background: rgb(var(--c-line));
  }
  .wr-depth-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    margin-top: -8px;
    border-radius: 50%;
    background: var(--obs-steel);
    cursor: pointer;
    border: 2px solid rgb(var(--c-surface-raised));
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
  }
  .wr-depth-slider::-moz-range-track {
    height: 6px;
    border-radius: 9999px;
    background: rgb(var(--c-line));
  }
  .wr-depth-slider::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--obs-steel);
    cursor: pointer;
    border: 2px solid rgb(var(--c-surface-raised));
  }

  /* Hoạt ảnh reveal */
  .scene [data-anim] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    will-change: opacity, transform;
  }

  .scene [data-anim="level"] {
    transform: translateX(-30px);
  }

  .scene [data-anim="myth"] {
    transform: translateY(30px);
  }

  .scene [data-anim].reveal-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .scene [data-anim] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initInfographic() {
    const root = document.querySelector('[data-infographic="water-resistance"]');
    if (!root) return;

    const revealTargets = root.querySelectorAll('[data-anim]');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.15,
        rootMargin: '0px 0px -10% 0px',
      }
    );

    revealTargets.forEach((el) => observer.observe(el));

    // FALLBACK: sau 3 giây ép hiện tất cả — nội dung không bao giờ kẹt ẩn
    setTimeout(() => {
      revealTargets.forEach((el) => el.classList.add('reveal-visible'));
    }, 3000);
  }

  initInfographic();
</script>
