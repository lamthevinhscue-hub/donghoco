---
// =============================================================================
// GMT (Múi giờ thứ hai) — INTERACTIVE
// =============================================================================
// Minh họa NGUYÊN LÝ HIỂN THỊ của GMT có vành 24 giờ xoay:
//   - Kim GMT phụ (24 giờ - 1 vòng/ngày) → giờ nhà trên thang 24 giờ
//   - Vành 24 giờ xoay (ở một số mẫu) → đọc thêm một múi giờ thay thế
//   - Minh họa: giờ địa phương + giờ nhà + múi giờ thay thế (qua vành đã xoay)
// KHÔNG phải mô phỏng thao tác chính xác cho mọi calibre — thao tác thật theo
// tài liệu của nhà sản xuất.
//
// Lịch sử chuẩn theo hồ sơ nguồn cụm GMT: GMT-Master ra mắt 1955; trở thành
// đồng hồ chính thức của hãng hàng không Pan Am; GMT-Master II giới thiệu bộ
// máy mới năm 1982 cho phép chỉnh kim giờ độc lập.
// Tuân thủ KẾ HOẠCH HOÀN THIỆN Bước 1.3.
// =============================================================================

import MechanismAnimation from '../MechanismAnimation.astro';

// Danh sách múi giờ chính cho bezel
const cities = [
  { name: 'LDN', offset: 0 },
  { name: 'PAR', offset: 1 },
  { name: 'CAI', offset: 2 },
  { name: 'JED', offset: 3 },
  { name: 'DXB', offset: 4 },
  { name: 'KHI', offset: 5 },
  { name: 'DAC', offset: 6 },
  { name: 'BKK', offset: 7 },
  { name: 'HKG', offset: 8 },
  { name: 'TYO', offset: 9 },
  { name: 'SYD', offset: 10 },
  { name: 'NOU', offset: 11 },
  { name: 'AKL', offset: 12 },
  { name: 'HNL', offset: -10 },
  { name: 'ANC', offset: -9 },
  { name: 'LAX', offset: -8 },
  { name: 'DEN', offset: -7 },
  { name: 'CHI', offset: -6 },
  { name: 'NYC', offset: -5 },
  { name: 'RIO', offset: -3 },
  { name: 'SGN', offset: 7 },
];
---

<MechanismAnimation label="GMT — Hiển thị múi giờ thứ hai (24h hand)" data-mech-step-id="gmt">
  <svg viewBox="0 0 600 460" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-2xl" id="gmt-svg" aria-hidden="true" focusable="false">
    <!-- ====== VẬT LIỆU (token --obs-*/--ig-* — tự đổi theo .dark) ====== -->
    <defs>
      <!-- Mặt số: radial rất nhẹ tạo chiều sâu — đọc giờ vẫn là ưu tiên, không kim loại hóa kim -->
      <radialGradient id="gmtDial" cx="0.5" cy="0.42" r="0.8">
        <stop offset="0" style="stop-color:var(--ig-bg)" />
        <stop offset="1" style="stop-color:var(--ig-bg-soft)" />
      </radialGradient>
      <!-- Thép: vạch giờ, khung -->
      <linearGradient id="gmtSteel" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color:var(--obs-steel-soft)" />
        <stop offset="0.55" style="stop-color:var(--obs-steel)" />
        <stop offset="1" style="stop-color:var(--obs-steel-deep)" />
      </linearGradient>
      <!-- Rubi: kim giây (màu đỏ nghĩa đã có) -->
      <radialGradient id="gmtRuby" cx="0.35" cy="0.3" r="0.9">
        <stop offset="0" style="stop-color:var(--obs-ruby-soft)" />
        <stop offset="0.55" style="stop-color:var(--obs-ruby)" />
        <stop offset="1" style="stop-color:var(--obs-ruby-deep)" />
      </radialGradient>
    </defs>

    <text style="fill:var(--ig-text)" x="300" y="24" text-anchor="middle" font-size="13" font-weight="bold">
      Giờ địa phương • Giờ nhà (kim 24 giờ) • Múi giờ thay thế (đọc qua vành 24 giờ xoay)
    </text>
    <text style="fill:var(--ig-text);opacity:0.7" x="300" y="42" text-anchor="middle" font-size="9.5">
      Minh họa nguyên lý hiển thị trên một mẫu GMT có vành xoay — không phải mô phỏng thao tác của mọi calibre
    </text>

    <!-- ====== ĐỒNG HỒ GMT (mặt chính) ====== -->
    <g id="gmt-watch" transform="translate(300, 230)">
      <!-- Vòng bezel 24 giờ (xoay được) — graphite, viền brass là bao chính -->
      <g id="bezel-group" data-part="bezel" data-name-vi="Vòng bezel 24 giờ" data-name-en="24h rotating bezel" transform="rotate(0)">
        <circle r="155" style="fill:var(--obs-graphite);stroke:var(--obs-brass)" stroke-width="2"/>
        <!-- Vạch 24 giờ trên bezel — chi tiết 1 / vạch phụ 0.5 -->
        <g style="stroke:var(--obs-brass)" stroke-width="1">
          {Array.from({ length: 24 }).map((_, i) => {
            const a = (i * 360) / 24;
            const rad = (a * Math.PI) / 180;
            const r1 = 145, r2 = 155;
            const isMajor = i % 6 === 0;
            return <line x1={Math.cos(rad) * r1} y1={Math.sin(rad) * r1} x2={Math.cos(rad) * r2} y2={Math.sin(rad) * r2} stroke-width={isMajor ? 1 : 0.5}/>;
          })}
        </g>
        <!-- Số 24h (đỏ cho ban đêm, xanh cho ban ngày — màu nghĩa giữ nguyên) -->
        {Array.from({ length: 24 }).map((_, i) => {
          const a = (i * 360) / 24;
          const rad = (a * Math.PI) / 180;
          const isNight = i >= 18 || i < 6;
          const fill = isNight ? 'var(--ig-rubi)' : 'var(--obs-steel-soft)';
          const num = i === 0 ? '24' : String(i);
          return <text x={Math.cos(rad) * 135} y={Math.sin(rad) * 135 + 4} text-anchor="middle" font-size="11" style={`fill:${fill}`} font-weight={i % 6 === 0 ? 'bold' : 'normal'}>{num}</text>;
        })}
      </g>

      <!-- Mặt đồng hồ chính — radial nhẹ, nét bao 2px -->
      <circle r="125" fill="url(#gmtDial)" style="stroke:var(--obs-steel-deep)" stroke-width="2" data-part="dial" data-name-vi="Mặt đồng hồ" data-name-en="Watch dial"/>
      <!-- Vạch 12 giờ — chi tiết 1 / vạch phụ 0.5 -->
      <g style="stroke:var(--ig-text)" stroke-width="1">
        {Array.from({ length: 60 }).map((_, i) => {
          const a = (i * 360) / 60 - 90;
          const rad = (a * Math.PI) / 180;
          const isMajor = i % 5 === 0;
          const r1 = isMajor ? 110 : 115;
          return <line x1={Math.cos(rad) * r1} y1={Math.sin(rad) * r1} x2={Math.cos(rad) * 122} y2={Math.sin(rad) * 122} stroke-width={isMajor ? 1 : 0.5}/>;
        })}
      </g>
      <!-- Số 12 giờ -->
      {[12, 3, 6, 9].map((n, i) => {
        const a = (i * 90) - 90;
        const rad = (a * Math.PI) / 180;
        return <text x={Math.cos(rad) * 95} y={Math.sin(rad) * 95 + 6} text-anchor="middle" font-size="18" style="fill:var(--ig-text)" font-weight="bold" font-family="Be Vietnam Pro, sans-serif">{n}</text>;
      })}

      <!-- ====== KIM (giữ phẳng tối ưu để đọc giờ — không kim loại hóa) ====== -->
      <!-- Kim giờ (12h, ngắn, dày) -->
      <g id="hour-hand" data-part="hour-hand" data-name-vi="Kim giờ (giờ địa phương)" data-name-en="Hour hand (local time)">
        <line x1="0" y1="10" x2="0" y2="-60" style="stroke:var(--ig-text)" stroke-width="5" stroke-linecap="round"/>
      </g>
      <!-- Kim phút (dài, mỏng hơn) -->
      <g id="minute-hand" data-part="minute-hand" data-name-vi="Kim phút" data-name-en="Minute hand">
        <line x1="0" y1="15" x2="0" y2="-90" style="stroke:var(--ig-text)" stroke-width="3" stroke-linecap="round"/>
      </g>
      <!-- Kim giây (mỏng nhất, đỏ rubi) -->
      <g id="second-hand">
        <line x1="0" y1="20" x2="0" y2="-105" stroke="url(#gmtRuby)" stroke-width="1.5" stroke-linecap="round"/>
        <circle cx="0" cy="-95" r="3" fill="url(#gmtRuby)"/>
      </g>
      <!-- KIM GMT (24h) — điểm nhấn brass VỪA ĐỦ, phẳng không gradient kim loại -->
      <g id="gmt-hand" data-part="gmt-hand" data-name-vi="Kim GMT (giờ nhà, 24h)" data-name-en="GMT hand (home time, 24h)">
        <line x1="0" y1="15" x2="0" y2="-110" style="stroke:var(--obs-brass)" stroke-width="3" stroke-linecap="round"/>
        <polygon points="0,-115 -5,-105 5,-105" style="fill:var(--obs-brass)"/>
        <circle cx="0" cy="-50" r="6" style="fill:var(--obs-brass)"/>
        <text x="0" y="-47" text-anchor="middle" font-size="7" style="fill:var(--obs-graphite)" font-weight="bold">24</text>
      </g>

      <!-- Tâm -->
      <circle r="6" style="fill:var(--ig-text)"/>
      <circle r="2.5" style="fill:var(--obs-brass)"/>
    </g>

    <!-- ====== MŨI TÊN CHỈ HƯỚNG TRỜI (ngày/đêm) ====== -->
    <g transform="translate(300, 230)">
      <!-- Nửa trên (ban ngày) - xanh nhạt -->
      <path d="M -125 0 A 125 125 0 0 1 125 0" style="fill:var(--obs-steel)" opacity="0.05"/>
      <!-- Nửa dưới (ban đêm) - đỏ nhạt -->
      <path d="M -125 0 A 125 125 0 0 0 125 0" style="fill:var(--obs-ruby)" opacity="0.05"/>
    </g>

    <!-- ====== HIỂN THỊ 3 THỜI GIAN ====== -->
    <g id="time-readout" transform="translate(0, 410)">
      <!-- Giờ địa phương -->
      <g transform="translate(80, 0)">
        <rect x="-65" y="0" width="130" height="44" rx="6" style="fill:var(--obs-graphite)"/>
        <text x="0" y="15" text-anchor="middle" font-size="8" style="fill:var(--obs-brass-soft)">GIỜ ĐỊA PHƯƠNG</text>
        <text id="local-time" x="0" y="35" text-anchor="middle" font-size="14" style="fill:var(--obs-ivory)" font-weight="bold">10:30</text>
      </g>
      <!-- Giờ nhà (kim 24h) -->
      <g transform="translate(300, 0)">
        <rect x="-65" y="0" width="130" height="44" rx="6" style="fill:var(--obs-graphite)"/>
        <text x="0" y="15" text-anchor="middle" font-size="8" style="fill:var(--obs-brass-soft)">GIỜ NHÀ (KIM 24H)</text>
        <text id="home-time" x="0" y="35" text-anchor="middle" font-size="14" style="fill:var(--obs-brass-soft)" font-weight="bold">15:30</text>
      </g>
      <!-- Giờ thứ 3 (bezel) -->
      <g transform="translate(520, 0)">
        <rect x="-65" y="0" width="130" height="44" rx="6" style="fill:var(--obs-graphite)"/>
        <text x="0" y="15" text-anchor="middle" font-size="8" style="fill:var(--obs-brass-soft)">MÚI THAY THẾ (VÀNH)</text>
        <text id="third-time" x="0" y="35" text-anchor="middle" font-size="14" style="fill:var(--obs-steel-soft)" font-weight="bold">--:--</text>
      </g>
    </g>

    <!-- ====== CHÚ THÍCH KHI HOVER ====== -->
    <g id="tooltip" opacity="0" style="pointer-events: none;">
      <rect id="tooltip-bg" x="0" y="0" width="200" height="40" rx="6" style="fill:var(--obs-graphite)" opacity="0.95"/>
      <text id="tooltip-vi" x="100" y="17" text-anchor="middle" font-size="11" style="fill:var(--obs-ivory)" font-weight="bold"></text>
      <text id="tooltip-en" x="100" y="32" text-anchor="middle" font-size="9" style="fill:var(--obs-brass-soft)"></text>
    </g>
  </svg>

  <!-- Bộ chọn múi giờ nhà + múi giờ thứ 3 -->
  <div class="mt-4 space-y-3 text-xs">
    <div class="flex flex-wrap items-center gap-2">
      <label for="home-tz" class="text-ink-soft/90 dark:text-dark-text-soft/70">Múi giờ nhà (kim 24h):</label>
      <select id="home-tz" class="rounded border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface px-2 py-1 text-navy dark:text-dark-text">
        {cities.map((c) => <option value={c.offset}>{c.name} (UTC{c.offset >= 0 ? '+' : ''}{c.offset})</option>)}
      </select>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <label for="third-tz" class="text-ink-soft/90 dark:text-dark-text-soft/70">Múi giờ thay thế (vành xoay theo chênh lệch):</label>
      <select id="third-tz" class="rounded border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface px-2 py-1 text-navy dark:text-dark-text">
        {cities.map((c) => <option value={c.offset}>{c.name} (UTC{c.offset >= 0 ? '+' : ''}{c.offset})</option>)}
      </select>
    </div>
  </div>

  <script is:inline slot="script">
    // =============================================================================
    // Hoạt ảnh GMT — mô phỏng thời gian trôi (1 phút thực = 1 giờ mô phỏng)
    // =============================================================================
    let __homeOffset = 7;   // SGN mặc định
    let __thirdOffset = 0;  // LDN mặc định

    (window.__mechSteps = window.__mechSteps || {})['gmt'] = function(delta, elapsed) {
      const svg = document.getElementById('gmt-svg');
      if (!svg) return;

      const hourHand = svg.querySelector('#hour-hand');
      const minuteHand = svg.querySelector('#minute-hand');
      const secondHand = svg.querySelector('#second-hand');
      const gmtHand = svg.querySelector('#gmt-hand');
      const bezel = svg.querySelector('#bezel-group');
      const localTime = svg.querySelector('#local-time');
      const homeTime = svg.querySelector('#home-time');
      const thirdTime = svg.querySelector('#third-time');
      if (!hourHand || !minuteHand || !gmtHand) return;

      // 1 giờ mô phỏng = 3 giây (để nhìn thấy kim phút chạy)
      const hourMs = 3000;
      const totalHours = elapsed / hourMs;

      // Giờ địa phương: 10:00 ban đầu
      const localStart = 10;
      const localH = localStart + totalHours;
      const localH12 = ((localH % 24) + 24) % 24;
      const localMinutes = (localH - Math.floor(localH)) * 60;

      // Kim giờ: 360°/12h
      const hourAngle = (localH12 % 12) * 30 + localMinutes * 0.5;
      hourHand.setAttribute('transform', `rotate(${hourAngle})`);
      // Kim phút: 360°/60min
      const minuteAngle = localMinutes * 6;
      minuteHand.setAttribute('transform', `rotate(${minuteAngle})`);
      // Kim giây: quay nhanh cho đẹp
      const secondAngle = (elapsed / 50) % 360;
      secondHand.setAttribute('transform', `rotate(${secondAngle})`);

      // Kim GMT: theo giờ nhà (offset khác)
      // Kim 24h quay 360°/24h = 15°/giờ. Vị trí 0h = trên cùng (-90° SVG)
      const homeH = localH + (__homeOffset - 7); // giả định local = UTC+7 (SGN)
      const homeAngle = homeH * 15; // 0h = 0° (trên cùng, do đã -90 trong SVG transform gốc? thực ra dùng rotate)
      gmtHand.setAttribute('transform', `rotate(${homeAngle})`);

      // Bezel xoay theo offset thứ 3: 1 múi giờ = 15°
      // Bezel cần xoay sao cho số giờ đúng ở vị trí kim GMT
      const thirdOffsetDiff = __thirdOffset - __homeOffset;
      const bezelAngle = thirdOffsetDiff * 15;
      bezel.setAttribute('transform', `rotate(${bezelAngle})`);

      // Cập nhật text
      const fmt = (h) => {
        const hh = Math.floor(((h % 24) + 24) % 24);
        const mm = Math.floor((h - Math.floor(h)) * 60);
        return String(hh).padStart(2, '0') + ':' + String(mm).padStart(2, '0');
      };
      if (localTime) localTime.textContent = fmt(localH);
      if (homeTime) homeTime.textContent = fmt(homeH);
      if (thirdTime) thirdTime.textContent = fmt(localH + (__thirdOffset - 7));
    };

    // Xử lý dropdown chọn múi giờ
    document.addEventListener('DOMContentLoaded', () => {
      const homeSelect = document.getElementById('home-tz');
      const thirdSelect = document.getElementById('third-tz');
      if (homeSelect) homeSelect.addEventListener('change', (e) => { __homeOffset = parseInt(e.target.value, 10); });
      if (thirdSelect) thirdSelect.addEventListener('change', (e) => { __thirdOffset = parseInt(e.target.value, 10); });

      // Tooltip hover
      const svg = document.getElementById('gmt-svg');
      if (!svg) return;
      const tooltip = svg.querySelector('#tooltip');
      const tooltipBg = svg.querySelector('#tooltip-bg');
      const tooltipVi = svg.querySelector('#tooltip-vi');
      const tooltipEn = svg.querySelector('#tooltip-en');
      if (!tooltip || !tooltipBg || !tooltipVi || !tooltipEn) return;
      const parts = svg.querySelectorAll('[data-part]');
      parts.forEach((part) => {
        part.style.cursor = 'pointer';
        const highlight = () => {
          part.style.filter = 'drop-shadow(0 0 6px #B8893C)';
          const vi = part.getAttribute('data-name-vi') || '';
          const en = part.getAttribute('data-name-en') || '';
          tooltipVi.textContent = vi;
          tooltipEn.textContent = en;
          tooltipBg.setAttribute('width', Math.max(vi.length, en.length) * 7 + 30);
          tooltip.setAttribute('opacity', '1');
        };
        const unhighlight = () => { part.style.filter = ''; tooltip.setAttribute('opacity', '0'); };
        part.addEventListener('mouseenter', highlight);
        part.addEventListener('mouseleave', unhighlight);
        part.addEventListener('touchstart', (e) => { e.preventDefault(); highlight(); setTimeout(unhighlight, 2000); });
      });
      svg.addEventListener('mousemove', (e) => {
        const rect = svg.getBoundingClientRect();
        const vb = svg.viewBox.baseVal;
        const x = (e.clientX - rect.left) * (vb.width / rect.width);
        const y = (e.clientY - rect.top) * (vb.height / rect.height);
        tooltip.setAttribute('transform', `translate(${Math.min(x, vb.width - 210)}, ${Math.max(y - 45, 0)})`);
      });
    });
  </script>
</MechanismAnimation>

<!-- Phần giải thích -->
<div class="mt-10 space-y-6" data-explanation>
  <div data-anim="explain-card" class="rounded-lg border-l-4 border-[#3182CE] bg-white dark:bg-dark-surface p-5">
    <h2 class="mb-2 font-serif text-lg text-navy dark:text-dark-text">① Hiện tượng — bạn nhìn thấy gì?</h2>
    <p class="text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
      Một chiếc đồng hồ GMT có thêm <strong>một kim phụ phân biệt bằng thiết kế/màu riêng</strong> —
      kim này <strong>đi hết 1 vòng trong 24 giờ</strong> (thay vì 12 giờ như kim giờ thường). Thang 24 giờ
      cho phép đọc kim này theo giờ tuyệt đối trong ngày. GMT hiển thị <strong>múi giờ thứ hai</strong>;
      ở những mẫu có <strong>vành 24 giờ xoay</strong>, vành còn cho phép đọc thêm một <strong>múi giờ thay thế</strong>.
    </p>
  </div>

  <div data-anim="explain-card" class="rounded-lg border-l-4 border-[#B8893C] bg-white dark:bg-dark-surface p-5">
    <h2 class="mb-2 font-serif text-lg text-navy dark:text-dark-text">② Nguyên lý — các cách đọc trên mặt số</h2>
    <ul class="space-y-2 text-sm text-ink-soft dark:text-dark-text-soft">
      <li class="flex gap-2"><span class="text-brass dark:text-dark-brass font-bold">a)</span>
        <span><strong>Kim giờ + phút</strong> thông thường → giờ địa phương (nơi bạn đang đứng).</span>
      </li>
      <li class="flex gap-2"><span class="text-brass dark:text-dark-brass font-bold">b)</span>
        <span><strong>Kim GMT 24 giờ</strong> chỉ giờ nhà (nơi bạn sinh sống): kim hoàn thành một vòng trong 24 giờ; quan hệ giữa kim GMT và các kim còn lại là <strong>đặc tính của từng calibre</strong> — trong infographic này chỉ minh họa quan hệ hiển thị.</span>
      </li>
      <li class="flex gap-2"><span class="text-brass dark:text-dark-brass font-bold">c)</span>
        <span><strong>Vành 24 giờ xoay (chỉ ở một số mẫu)</strong>: xoay vành theo <strong>chênh lệch múi giờ</strong> cần theo dõi, rồi đọc kim GMT trên thang vành đã xoay — đó là múi giờ thay thế. Khi vành đang dùng cho múi này, giờ nhà không còn đọc trực tiếp theo vành (Rolex mô tả cho GMT-Master II).</span>
      </li>
    </ul>
    <p class="mt-3 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
      Thử chọn múi giờ nhà và múi giờ thay thế ở trên — bạn sẽ thấy vành minh họa xoay theo chênh lệch. Đây là minh họa nguyên lý, không phải hướng dẫn thao tác của mẫu cụ thể.
    </p>
  </div>

  <div data-anim="explain-card" class="rounded-lg border-l-4 border-[#9B2C2C] bg-white dark:bg-dark-surface p-5">
    <h2 class="mb-2 font-serif text-lg text-navy dark:text-dark-text">③ Lịch sử — sinh ra cho người xuyên múi giờ</h2>
    <p class="text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
      Rolex ghi <strong>GMT-Master</strong> ra mắt năm <strong>1955</strong> — thiết kế cho người đi khắp các múi giờ —
      và dòng này sau đó trở thành <strong>đồng hồ chính thức của hãng hàng không Pan American World Airways (Pan Am)</strong>.
    </p>
    <p class="mt-2 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
      Năm <strong>1982</strong>, Rolex giới thiệu bộ máy cho phép chỉnh kim giờ độc lập với các kim còn lại —
