---
// =============================================================================
// HAIRSPRING & BALANCE WHEEL — Dây tóc & bánh lắc (trái tim dao động)
// =============================================================================
// Mô phỏng dao động của hệ bánh lắc + dây tóc:
//   - Bánh lắc dao động điều hòa (xoay qua lại) — hình sin
//   - Dây tóc (hairspring) co/giãn theo dao động —Spirométrica
//   - So sánh 3 tần số: 18.000 (chậm, êm), 28.800 (chuẩn), 36.000 (Hi-Beat, mượt)
//
// Tuân thủ KẾ HOẠCH HOÀN THIỆN Bước 1.3.
// =============================================================================

import MechanismAnimation from '../MechanismAnimation.astro';
---

<MechanismAnimation label="Dây tóc & bánh lắc — Trái tim dao động" data-mech-step-id="hairspring">
  <svg viewBox="0 0 600 420" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-2xl" id="hairspring-svg" aria-hidden="true" focusable="false">
    <!-- ====== VẬT LIỆU (token --obs-*/--ig-* — tự đổi theo .dark) ====== -->
    <defs>
      <!-- Glucydur bánh lắc: hợp kim đỏ SÁNG hơn nền/panel xung quanh -->
      <linearGradient id="hsBalance" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" style="stop-color:var(--obs-ruby-soft)" />
        <stop offset="0.55" style="stop-color:var(--obs-ruby)" />
        <stop offset="1" style="stop-color:var(--obs-ruby-deep)" />
      </linearGradient>
      <!-- Thép: cầu máy, vít cố định, tần số -->
      <linearGradient id="hsSteel" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color:var(--obs-steel-soft)" />
        <stop offset="0.55" style="stop-color:var(--obs-steel)" />
        <stop offset="1" style="stop-color:var(--obs-steel-deep)" />
      </linearGradient>
      <!-- Đồng thau: dấu chỉ vị trí + con trỏ dao động ký -->
      <linearGradient id="hsBrass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" style="stop-color:var(--obs-brass-deep)" />
        <stop offset="0.3" style="stop-color:var(--obs-brass-soft)" />
        <stop offset="0.42" style="stop-color:var(--obs-brass)" />
        <stop offset="1" style="stop-color:var(--obs-brass-deep)" />
      </linearGradient>
    </defs>

    <text style="fill:var(--ig-text)" x="300" y="28" text-anchor="middle" font-size="13" font-weight="bold">
      Bánh lắc dao động qua lại → dây tóc co giãn → tạo nhịp thời gian
    </text>

    <!-- ====== BÁNH LẮC (balance wheel) - trung tâm, dao động — Glucydur SÁNG ====== -->
    <g id="balance-group" transform="translate(300, 200) rotate(0)">
      <g id="balance-wheel" data-part="balance-wheel" data-name-vi="Bánh lắc" data-name-en="Balance wheel">
        <!-- Vành ngoài: nét bao chính, sáng hơn panel nền -->
        <circle r="70" fill="none" stroke="url(#hsBalance)" stroke-width="2"/>
        <circle r="70" fill="none" style="stroke:var(--obs-ruby-soft)" stroke-width="0.5" opacity="0.4" transform="scale(1.05)"/>
        <!-- 2 chân ngang (cross spokes) — chi tiết 1px -->
        <line x1="-70" y1="0" x2="70" y2="0" stroke="url(#hsBalance)" stroke-width="1"/>
        <line x1="0" y1="-70" x2="0" y2="70" stroke="url(#hsBalance)" stroke-width="1"/>
        <!-- Trục -->
        <circle r="8" fill="url(#hsBalance)"/>
        <circle r="3" style="fill:var(--obs-steel-deep)"/>
        <!-- Trọng lượng cố định (timing screws) — 4 cái, thép -->
        <circle cx="0" cy="-70" r="6" fill="url(#hsSteel)" style="stroke:var(--obs-steel-deep)" stroke-width="1"/>
        <circle cx="0" cy="70" r="6" fill="url(#hsSteel)" style="stroke:var(--obs-steel-deep)" stroke-width="1"/>
        <circle cx="-70" cy="0" r="6" fill="url(#hsSteel)" style="stroke:var(--obs-steel-deep)" stroke-width="1"/>
        <circle cx="70" cy="0" r="6" fill="url(#hsSteel)" style="stroke:var(--obs-steel-deep)" stroke-width="1"/>
        <!-- Vết brass chỉ vị trí (để nhìn rõ sự quay) -->
        <circle cx="0" cy="-58" r="4" fill="url(#hsBrass)"/>
      </g>
    </g>

    <!-- ====== DÂY TÓC (hairspring) - vòng trong bánh lắc, phồng/xẹp — thép mảnh ====== -->
    <g id="hairspring-group" transform="translate(300, 200)">
      <g id="hairspring" data-part="hairspring" data-name-vi="Dây tóc (hairspring)" data-name-en="Hairspring / Balance spring">
        <!-- Vòng xoắn ốc - nét mảnh 1px rõ trên cả nền sáng/tối -->
        <g id="hairspring-coils" fill="none" style="stroke:var(--obs-steel-deep)" stroke-width="1">
          <path d="M 0 0
                   m -15 0 a 15 15 0 1 1 30 0
                   a 22 22 0 1 1 -44 0
                   a 30 30 0 1 1 60 0
                   a 38 38 0 1 1 -76 0
                   a 46 46 0 1 1 92 0"
                transform="scale(1)"/>
        </g>
        <!-- Điểm cố định ngoài (stud) -->
        <rect x="46" y="-3" width="8" height="6" style="fill:var(--obs-steel-deep)"/>
        <!-- Điểm nối trong (collet) -->
        <circle r="8" style="fill:var(--obs-steel)" opacity="0.4"/>
      </g>
    </g>

    <!-- ====== CHỈ SỐ DAO ĐỘNG (vạch đo + kim) ====== -->
    <g id="oscilloscope" transform="translate(80, 320)">
      <rect x="-5" y="-50" width="490" height="80" rx="6" style="fill:var(--obs-graphite)" opacity="0.9"/>
      <text x="0" y="-32" font-size="9" style="fill:var(--obs-brass-soft)" font-weight="bold">DAO ĐỘNG (oscilloscope)</text>
      <!-- Đường giữa — vạch tham chiếu 0.5px -->
      <line x1="0" y1="0" x2="480" y2="0" style="stroke:var(--obs-steel-deep)" stroke-width="0.5" stroke-dasharray="3 3"/>
      <!-- Đường sóng sin động (path sẽ được JS cập nhật) — đường dữ liệu chính -->
      <path id="wave-path" d="M 0 0" fill="none" stroke="url(#hsBrass)" stroke-width="2"/>
      <!-- Con trỏ hiện tại -->
      <circle id="wave-dot" cx="0" cy="0" r="4" fill="url(#hsBrass)"/>
    </g>

    <!-- ====== TẦN SỐ DISPLAY ====== -->
    <g id="freq-display" transform="translate(420, 50)">
      <rect x="0" y="0" width="160" height="60" rx="6" style="fill:var(--obs-graphite)"/>
      <text x="80" y="22" text-anchor="middle" font-size="9" style="fill:var(--obs-brass-soft)">TẦN SỐ ĐANG MÔ PHỎNG</text>
      <text id="freq-value" x="80" y="42" text-anchor="middle" font-size="16" style="fill:var(--obs-ivory)" font-weight="bold">28.800 vph</text>
      <text id="freq-hz" x="80" y="54" text-anchor="middle" font-size="10" style="fill:var(--obs-brass-soft)">4 Hz</text>
    </g>

    <!-- ====== CHÚ THÍCH KHI HOVER ====== -->
    <g id="tooltip" opacity="0" style="pointer-events: none;">
      <rect id="tooltip-bg" x="0" y="0" width="180" height="40" rx="6" style="fill:var(--obs-graphite)" opacity="0.95"/>
      <text id="tooltip-vi" x="90" y="17" text-anchor="middle" font-size="11" style="fill:var(--obs-ivory)" font-weight="bold"></text>
      <text id="tooltip-en" x="90" y="32" text-anchor="middle" font-size="9" style="fill:var(--obs-brass-soft)"></text>
    </g>
  </svg>

  <!-- Bộ chọn tần số để so sánh -->
  <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-xs">
    <span class="text-ink-soft/90 dark:text-dark-text-soft/70">Chọn tần số để so sánh:</span>
    <button type="button" class="freq-btn rounded-full border border-cream-dark dark:border-dark-border px-3 py-1 text-navy dark:text-dark-text hover:bg-brass dark:hover:bg-dark-brass hover:text-white" data-freq="18000">18.000 (cũ, chậm)</button>
    <button type="button" class="freq-btn rounded-full border border-navy bg-navy px-3 py-1 text-cream" data-freq="28800">28.800 (chuẩn)</button>
    <button type="button" class="freq-btn rounded-full border border-cream-dark dark:border-dark-border px-3 py-1 text-navy dark:text-dark-text hover:bg-brass dark:hover:bg-dark-brass hover:text-white" data-freq="36000">36.000 (Hi-Beat)</button>
  </div>

  <script is:inline slot="script">
    // =============================================================================
    // Hoạt ảnh dây tóc & bánh lắc — dao động điều hòa
    // =============================================================================
    let __currentFreq = 28800; // vph mặc định

    (window.__mechSteps = window.__mechSteps || {})['hairspring'] = function(delta, elapsed) {
      const svg = document.getElementById('hairspring-svg');
      if (!svg) return;

      const balance = svg.querySelector('#balance-group');
      const coils = svg.querySelector('#hairspring-coils');
      const wavePath = svg.querySelector('#wave-path');
      const waveDot = svg.querySelector('#wave-dot');
      if (!balance || !coils) return;

      // Tần số → chu kỳ (ms mỗi dao động). Chu kỳ thực = 1/f.
      // Nhưng để nhìn rõ, ta làm chậm: 1 Hz thực = 6 giây ở đây (factor 6x chậm)
      const vph = __currentFreq;
      const hz = vph / 3600; // 18k=5Hz, 28.8k=8Hz, 36k=10Hz
      const periodMs = (1 / hz) * 1000 * 6; // chậm 6x

      // Góc dao động: hình sin, biên độ ±35°
      const phase = (elapsed % periodMs) / periodMs;
      const angle = Math.sin(phase * Math.PI * 2) * 35;
      balance.setAttribute('transform', `translate(300, 200) rotate(${angle})`);

      // Dây tóc: phồng ra khi bánh lắc ra xa, cụp vào khi về giữa
      // Scale 1.0 ở giữa, 1.12 ở biên
      const breathScale = 1 + Math.abs(Math.sin(phase * Math.PI * 2)) * 0.12;
      coils.setAttribute('transform', `scale(${breathScale})`);

      // Vẽ sóng dao động (cuộn liên tục)
      if (wavePath) {
        const samples = 80;
        const W = 480;
        let d = `M 0 0`;
        for (let i = 0; i <= samples; i++) {
          const x = (i / samples) * W;
          const t = elapsed - (samples - i) * (periodMs / samples);
          const p2 = (t % periodMs) / periodMs;
          const y = Math.sin(p2 * Math.PI * 2) * 28;
          d += ` L ${x.toFixed(1)} ${y.toFixed(1)}`;
        }
        wavePath.setAttribute('d', d);
        if (waveDot) {
          const curY = Math.sin(phase * Math.PI * 2) * 28;
          waveDot.setAttribute('cy', curY);
          waveDot.setAttribute('cx', W);
        }
      }
    };

    // Nút chọn tần số
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.freq-btn');
      const freqValue = document.getElementById('freq-value');
      const freqHz = document.getElementById('freq-hz');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          __currentFreq = parseInt(btn.dataset.freq, 10);
          buttons.forEach((b) => {
            b.classList.remove('bg-navy', 'text-cream', 'border-navy', 'dark:text-dark-text');
            b.classList.add('border-cream-dark', 'text-navy', 'dark:text-dark-text');
          });
          btn.classList.add('bg-navy', 'text-cream', 'border-navy');
          btn.classList.remove('border-cream-dark', 'text-navy', 'dark:text-dark-text');
          if (freqValue) freqValue.textContent = __currentFreq.toLocaleString('en-US') + ' vph';
          if (freqHz) freqHz.textContent = (__currentFreq / 3600).toFixed(2) + ' Hz';
        });
      });

      // Tooltip hover
      const svg = document.getElementById('hairspring-svg');
      if (!svg) return;
      const tooltip = svg.querySelector('#tooltip');
      const tooltipBg = svg.querySelector('#tooltip-bg');
      const tooltipVi = svg.querySelector('#tooltip-vi');
      const tooltipEn = svg.querySelector('#tooltip-en');
      if (!tooltip || !tooltipBg || !tooltipVi || !tooltipEn) return;
      const parts = svg.querySelectorAll('[data-part]');
      parts.forEach((part) => {
        part.style.cursor = 'pointer';
        const highlight = () => {
          part.style.filter = 'drop-shadow(0 0 6px #B8893C)';
          const vi = part.getAttribute('data-name-vi') || '';
          const en = part.getAttribute('data-name-en') || '';
          tooltipVi.textContent = vi;
          tooltipEn.textContent = en;
          tooltipBg.setAttribute('width', Math.max(vi.length, en.length) * 7 + 20);
          tooltip.setAttribute('opacity', '1');
        };
        const unhighlight = () => { part.style.filter = ''; tooltip.setAttribute('opacity', '0'); };
        part.addEventListener('mouseenter', highlight);
        part.addEventListener('mouseleave', unhighlight);
        part.addEventListener('touchstart', (e) => { e.preventDefault(); highlight(); setTimeout(unhighlight, 2000); });
      });
      svg.addEventListener('mousemove', (e) => {
        const rect = svg.getBoundingClientRect();
        const vb = svg.viewBox.baseVal;
        const x = (e.clientX - rect.left) * (vb.width / rect.width);
        const y = (e.clientY - rect.top) * (vb.height / rect.height);
        tooltip.setAttribute('transform', `translate(${Math.min(x, vb.width - 190)}, ${Math.max(y - 45, 0)})`);
      });
    });
  </script>
</MechanismAnimation>

<!-- Phần giải thích -->
<div class="mt-10 space-y-6" data-explanation>
  <div data-anim="explain-card" class="rounded-lg border-l-4 border-[#9B2C2C] bg-white dark:bg-dark-surface p-5">
    <h2 class="mb-2 font-serif text-lg text-navy dark:text-dark-text">① Hiện tượng — bạn nhìn thấy gì?</h2>
    <p class="text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
      Nhìn vào mặt sau của một chiếc đồng hồ cơ lộ máy, bạn thấy một <strong>bánh xe đỏ dao động qua lại</strong> —
      xoay trái rồi xoay phải, không ngừng nghỉ, hàng chục ngàn lần mỗi giờ. Đó là <strong>bánh lắc</strong> (balance wheel),
      và cuộn dây xanh cuộn quanh nó là <strong>dây tóc</strong> (hairspring). Cặp đôi này chính là <strong>"trái tim đập"</strong> của đồng hồ.
    </p>
  </div>

  <div data-anim="explain-card" class="rounded-lg border-l-4 border-[#3182CE] bg-white dark:bg-dark-surface p-5">
    <h2 class="mb-2 font-serif text-lg text-navy dark:text-dark-text">② Nguyên lý — hệ dao động điều hòa</h2>
    <p class="text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
      Bánh lắc + dây tóc tạo thành một <strong>hệ dao động điều hòa</strong> — cùng nguyên lý với con lắc đồng hồ quả quýt:
    </p>
    <ul class="mt-3 space-y-2 text-sm text-ink-soft dark:text-dark-text-soft">
      <li class="flex gap-2"><span class="text-brass dark:text-dark-brass font-bold">a)</span>
        <span>Bộ thoát <strong>đẩy nhẹ</strong> bánh lắc ra khỏi vị trí cân bằng (như đẩy trẻ trên xích đu).</span>
      </li>
      <li class="flex gap-2"><span class="text-brass dark:text-dark-brass font-bold">b)</span>
        <span>Bánh lắc quay đi → <strong>dây tóc bị vặn</strong> → tích năng lượng đàn hồi.</span>
      </li>
      <li class="flex gap-2"><span class="text-brass dark:text-dark-brass font-bold">c)</span>
        <span>Dây tóc <strong>giật lại</strong> về vị trí cân bằng → kéo bánh lắc quay ngược → quá biên bên kia.</span>
      </li>
      <li class="flex gap-2"><span class="text-brass dark:text-dark-brass font-bold">d)</span>
        <span>Quá trình lặp lại <strong>vô tận</strong> — và <strong>chu kỳ dao động không đổi</strong> (tính bằng vật lý của dây tóc).</span>
      </li>
    </ul>
    <p class="mt-3 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
      Vì chu kỳ cố định, mỗi dao động = một đơn vị thời gian đều nhau. <strong>Đồng hồ cơ đo thời gian bằng dao động.</strong>
    </p>
  </div>

  <div data-anim="explain-card" class="rounded-lg border-l-4 border-[#B8893C] bg-white dark:bg-dark-surface p-5">
    <h2 class="mb-2 font-serif text-lg text-navy dark:text-dark-text">③ Tần số (VPH) — chậm hay nhanh thì tốt hơn?</h2>
    <p class="text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
      <strong>VPH</strong> (vibrations per hour) đếm số dao động. Thử bấm các nút phía trên để so sánh:
    </p>
    <div class="mt-3 grid gap-2 text-xs sm:grid-cols-3">
      <div class="rounded border border-cream-dark dark:border-dark-border p-2">
        <strong class="text-navy dark:text-dark-text">18.000 vph (2.5 Hz)</strong>
        <p class="mt-1 text-ink-soft dark:text-dark-text-soft">Cũ, êm, "đậm chất vintage". Chịu va đập kém hơn.</p>
      </div>
      <div class="rounded border border-navy bg-navy/5 p-2">
        <strong class="text-navy dark:text-dark-text">28.800 vph (4 Hz)</strong>
        <p class="mt-1 text-ink-soft dark:text-dark-text-soft">Chuẩn hiện đại (Rolex, Omega). Cân bằng giữa độ chính xác và độ bền.</p>
      </div>
      <div class="rounded border border-cream-dark dark:border-dark-border p-2">
        <strong class="text-navy dark:text-dark-text">36.000 vph (5 Hz)</strong>
        <p class="mt-1 text-ink-soft dark:text-dark-text-soft">"Hi-Beat" (Grand Seiko, Zenith El Primero). Kim mượt hơn, chính xác hơn — nhưng hao dầu, mài mòn nhanh hơn.</p>
      </div>
    </div>
    <p class="mt-3 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
      <strong>Dây tóc Breguet overcoil</strong> (đầu cuộn nâng cao) và <strong>dây tóc silicon</strong> (2001+) là 2 cải tiến lớn:
      giảm sai số nhiệt, không nhiễm từ. Xem [mốc 2001 trong timeline](/lich-su).
    </p>
  </div>
</div>
