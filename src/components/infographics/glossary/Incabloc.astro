---
// =============================================================================
// INFOGRAPHIC TỪ ĐIỂN: INCABLOC (Hệ thống chống sốc)
// SVG lò xo lyre + trục bánh lắc. Minh họa cách hấp thụ sốc.
// Chất liệu: gradient --obs-* (khung đồng thau, bánh lắc thép, chân kính rubi).
// =============================================================================
const points = [
  { num: '①', title: 'Trục bánh lắc cực mỏng', detail: 'Chỉ ~0,1mm — mỏng hơn sợi tóc, dễ gãy khi va đập.' },
  { num: '②', title: 'Lò xo Incabloc (lyre-shaped)', detail: 'Gắn ở 2 đầu trục, hấp thụ năng lượng sốc.' },
  { num: '③', title: 'Sau sốc → đẩy về chỗ cũ', detail: 'Lò xo đẩy trục về vị trí ban đầu, không hỏng.' },
];
---

<section class="my-8" data-infographic="glossary-incabloc">
  <div class="my-6 rounded-lg border border-cream-dark dark:border-dark-border bg-cream-dark/20 dark:bg-dark-border/20 p-6">
    <svg viewBox="0 0 320 200" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-md" aria-hidden="true" focusable="false">
      <defs>
        <!-- Đồng thau: hai khung gá Incabloc -->
        <linearGradient id="inc-brass" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color:var(--obs-brass-soft)" />
          <stop offset="0.45" style="stop-color:var(--obs-brass)" />
          <stop offset="1" style="stop-color:var(--obs-brass-deep)" />
        </linearGradient>
        <!-- Thép: đĩa bánh lắc -->
        <linearGradient id="inc-steel" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color:var(--ig-steel-soft)" />
          <stop offset="0.5" style="stop-color:var(--ig-steel)" />
          <stop offset="1" style="stop-color:var(--ig-edge)" />
        </linearGradient>
        <!-- Chân kính rubi: bijou nằm giữa khung gá -->
        <radialGradient id="inc-ruby" cx="0.35" cy="0.3" r="0.9">
          <stop offset="0" style="stop-color:var(--obs-ruby-soft)" />
          <stop offset="0.55" style="stop-color:var(--obs-ruby)" />
          <stop offset="1" style="stop-color:var(--obs-ruby-deep)" />
        </radialGradient>
      </defs>
      <text x="160" y="25" text-anchor="middle" font-size="11" style="fill:var(--ig-text)" font-weight="bold" data-anim="title">
        Incabloc bảo vệ trục bánh lắc
      </text>
      <!-- Khung Incabloc trên -->
      <g data-anim="top-jewel">
        <path d="M 130 55 Q 160 40 190 55 L 190 75 L 130 75 Z" fill="url(#inc-brass)" opacity="0.45" style="stroke:var(--obs-brass-deep)" stroke-width="1"/>
        <path d="M 135 58 Q 160 48 185 58" fill="none" style="stroke:var(--obs-brass-deep)" stroke-width="2"/>
        <circle cx="160" cy="68" r="6" fill="url(#inc-ruby)" style="stroke:var(--obs-brass-deep)" stroke-width="1.5"/>
      </g>
      <!-- Trục bánh lắc (cực mỏng) -->
      <g data-anim="pivot">
        <line x1="160" y1="75" x2="160" y2="125" style="stroke:var(--obs-ruby)" stroke-width="2"/>
        <text x="180" y="105" font-size="9" style="fill:var(--ig-rubi)" font-weight="bold">Trục ~0,1mm</text>
      </g>
      <!-- Bánh lắc -->
      <g data-anim="balance">
        <circle cx="160" cy="130" r="22" fill="url(#inc-steel)" style="stroke:var(--ig-edge)" stroke-width="2"/>
        <line x1="138" y1="130" x2="182" y2="130" style="stroke:var(--ig-edge)" stroke-width="1.5"/>
        <circle cx="160" cy="130" r="3" style="fill:var(--obs-ruby)"/>
      </g>
      <!-- Khung Incabloc dưới -->
      <g data-anim="bottom-jewel">
        <path d="M 130 145 L 190 145 L 190 165 Q 160 180 130 165 Z" fill="url(#inc-brass)" opacity="0.45" style="stroke:var(--obs-brass-deep)" stroke-width="1"/>
        <path d="M 135 162 Q 160 172 185 162" fill="none" style="stroke:var(--obs-brass-deep)" stroke-width="2"/>
        <circle cx="160" cy="152" r="6" fill="url(#inc-ruby)" style="stroke:var(--obs-brass-deep)" stroke-width="1.5"/>
      </g>
      <!-- Mũi tên chỉ lực sốc -->
      <g data-anim="shock-arrow">
        <line x1="60" y1="100" x2="120" y2="100" style="stroke:var(--ig-steel)" stroke-width="2.5"/>
        <polygon points="125,100 115,94 115,106" style="fill:var(--ig-steel)"/>
        <text x="50" y="95" text-anchor="middle" font-size="9" style="fill:var(--ig-steel)" font-weight="bold">Sốc</text>
        <text x="225" y="100" font-size="9" style="fill:var(--ig-label)" font-weight="bold">→ hấp thụ</text>
      </g>
      <text x="160" y="195" text-anchor="middle" font-size="9" style="fill:var(--ig-label)" data-anim="caption">
        Lò xo lyre dạng chữ thập đặc trưng
      </text>
    </svg>
  </div>

  <!-- 3 điểm chính -->
  <div class="grid gap-4 sm:grid-cols-3">
    {points.map((point, i) => (
      <div class="rounded-lg border-l-4 border-brass bg-white dark:bg-dark-surface p-4" data-anim="point-card" data-index={i}>
        <p class="mb-1 text-lg font-bold text-brass dark:text-dark-brass">{point.num}</p>
        <p class="font-serif text-sm font-semibold text-navy dark:text-dark-text">{point.title}</p>
        <p class="mt-1 text-xs text-ink-soft dark:text-dark-text-soft">{point.detail}</p>
      </div>
    ))}
  </div>

  <div class="mt-4 rounded-lg bg-brass/5 dark:bg-dark-brass/10 p-3 text-center text-xs text-ink-soft dark:text-dark-text-soft" data-anim="note">
    <strong class="text-brass dark:text-dark-brass">Nhận biết:</strong> Mặt sau lộ máy có cấu trúc <strong>hình chữ thập</strong> với lò xo
    hình lyre = Incabloc (hoặc Kif/Etachoc tương tự).
  </div>
</section>
