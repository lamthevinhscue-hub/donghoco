---
// =============================================================================
// INFOGRAPHIC TỪ ĐIỂN: MINUTE REPEATER (Cơ chế điểm chuông)
// SVG chuông + búa gõ. Minh họa quy ước gõ giờ-phút.
// Chất liệu: gradient --obs-* (ống chuông thép / đồng thau, búa đậm nét).
// =============================================================================
const beatRules = [
  { sound: 'Ting', count: '3 tiếng', meaning: 'Giờ (vd: 3 giờ)', color: 'var(--ig-steel)' },
  { sound: 'Ding-dong', count: '2 tổ', meaning: 'Mỗi tổ = 15 phút (vd: 2 tổ = 30 phút)', color: 'var(--obs-brass)' },
  { sound: 'Ting', count: '7 tiếng', meaning: 'Phút lẻ (vd: 7 phút)', color: 'var(--ig-rubi)' },
];
---

<section class="my-8" data-infographic="glossary-minute-repeater">
  <div class="my-6 rounded-lg border border-cream-dark dark:border-dark-border bg-cream-dark/20 dark:bg-dark-border/20 p-6">
    <svg viewBox="0 0 300 240" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-xs" aria-hidden="true" focusable="false">
      <defs>
        <!-- Thép: ống chuông trầm -->
        <linearGradient id="mrp-steel" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color:var(--ig-steel-soft)" />
          <stop offset="0.5" style="stop-color:var(--ig-steel)" />
          <stop offset="1" style="stop-color:var(--ig-edge)" />
        </linearGradient>
        <!-- Đồng thau: ống chuông bổng -->
        <linearGradient id="mrp-brass" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color:var(--obs-brass-soft)" />
          <stop offset="0.5" style="stop-color:var(--obs-brass)" />
          <stop offset="1" style="stop-color:var(--obs-brass-deep)" />
        </linearGradient>
      </defs>
      <!-- 2 chuông (gongs) - ống thép uốn -->
      <g data-anim="gong-bass">
        <path d="M 70 130 Q 70 80 120 80 Q 170 80 170 110" fill="none" stroke="url(#mrp-steel)" stroke-width="6" stroke-linecap="round"/>
        <path d="M 70 130 Q 70 80 120 80 Q 170 80 170 110" fill="none" style="stroke:var(--obs-ivory)" stroke-width="1.2" opacity="0.35"/>
        <text x="90" y="155" font-size="9" style="fill:var(--ig-text)" font-weight="bold">Chuông trầm</text>
      </g>
      <g data-anim="gong-treble">
        <path d="M 230 130 Q 230 80 180 80" fill="none" stroke="url(#mrp-brass)" stroke-width="5" stroke-linecap="round"/>
        <path d="M 230 130 Q 230 80 180 80" fill="none" style="stroke:var(--obs-ivory)" stroke-width="1" opacity="0.35"/>
        <text x="195" y="155" font-size="9" style="fill:var(--ig-text)" font-weight="bold">Chuông cao</text>
      </g>
      <!-- 2 búa (hammers) -->
      <g data-anim="hammers">
        <circle cx="75" cy="135" r="8" style="fill:var(--ig-edge)"/>
        <line x1="75" y1="135" x2="100" y2="165" style="stroke:var(--ig-edge)" stroke-width="3"/>
        <circle cx="225" cy="135" r="7" style="fill:var(--obs-brass-deep)"/>
        <line x1="225" y1="135" x2="205" y2="165" style="stroke:var(--obs-brass-deep)" stroke-width="2.5"/>
      </g>
      <!-- Movement nền -->
      <rect x="110" y="160" width="80" height="50" rx="6" style="fill:var(--ig-bg);stroke:var(--ig-edge)" stroke-width="1.5" data-anim="movement-box"/>
      <text x="150" y="190" text-anchor="middle" font-size="9" style="fill:var(--ig-label)" data-anim="movement-box">Máy</text>
      <!-- Chú thích -->
      <text x="150" y="230" text-anchor="middle" font-size="10" style="fill:var(--ig-text)" data-anim="caption">
        Bấm cần gạt → búa gõ chuông báo giờ
      </text>
      <text x="150" y="30" text-anchor="middle" font-size="11" style="fill:var(--ig-text)" font-weight="bold" data-anim="caption">
        2 chuông + 2 búa
      </text>
    </svg>
  </div>

  <!-- Quy ước gõ: ví dụ 3:37 -->
  <div class="rounded-lg border-l-4 border-brass bg-white dark:bg-dark-surface p-5">
    <p class="mb-3 text-sm font-medium text-navy dark:text-dark-text">Ví dụ: 3 giờ 37 phút</p>
    <div class="space-y-3">
      {beatRules.map((rule, i) => (
        <div class="flex items-center gap-3" data-anim="rule-row" data-index={i}>
          <span class="w-2 h-8 rounded shrink-0" style={`background-color: ${rule.color};`}></span>
          <div class="flex-1">
            <p class="text-sm font-medium" style={`color: ${rule.color};`}>{rule.sound}</p>
            <p class="text-xs text-ink-soft dark:text-dark-text-soft">{rule.count} → {rule.meaning}</p>
          </div>
        </div>
      ))}
    </div>
    <p class="mt-4 rounded bg-brass/10 dark:bg-dark-brass/10 p-2 text-center text-xs text-ink-soft dark:text-dark-text-soft">
      = <strong class="text-brass dark:text-dark-brass">3 tiếng trầm</strong> + <strong class="text-brass dark:text-dark-brass">2 tổ</strong> + <strong class="text-brass dark:text-dark-brass">7 tiếng cao</strong> = 3:37
    </p>
  </div>
</section>
