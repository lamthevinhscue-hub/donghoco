---
// =============================================================================
// INFOGRAPHIC TỪ ĐIỂN: PERPETUAL CALENDAR (Lịch vạn niên)
// SVG bánh cam 4 năm + loại lịch so sánh.
// =============================================================================
const calendarTypes = [
  { name: 'Lịch đơn giản', desc: 'Phải chỉnh cuối tháng ngắn (5 lần/năm)', tone: 'bad' },
  { name: 'Annual Calendar', desc: 'Tự đúng cả năm, chỉ sai tháng Hai (1 lần/năm)', tone: 'ok' },
  { name: 'Perpetual Calendar', desc: 'Đúng mãi đến năm 2100 (1 lần/400 năm!)', tone: 'great' },
];
const toneColors = {
  bad: { bg: '#9B2C2C', text: '#9B2C2C' },
  ok: { bg: '#B8893C', text: '#9B6E2C' },
  great: { bg: '#2D7A55', text: '#2D7A55' },
};
---

<section class="my-8" data-infographic="glossary-perpetual-calendar">
  <div class="my-6 rounded-lg border border-cream-dark bg-cream-dark/20 p-6">
    <svg viewBox="0 0 320 200" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-md">
      <!-- Bánh cam (snail cam) hình ốc - 4 năm -->
      <text x="160" y="25" text-anchor="middle" font-size="11" fill="#1F2D3D" font-weight="bold" data-anim="title" opacity="0">
        Bánh cam ghi nhớ chu kỳ 4 năm
      </text>
      <!-- 4 vòng tròn = 4 năm, kích thước tăng dần -->
      <g data-anim="year-cam" opacity="0">
        <circle cx="80" cy="110" r="30" fill="none" stroke="#4FB286" stroke-width="2.5"/>
        <text x="80" y="115" text-anchor="middle" font-size="10" fill="#1F2D3D">Năm 1</text>
        <text x="80" y="128" text-anchor="middle" font-size="8" fill="#4A5568">28 ngày</text>

        <circle cx="140" cy="110" r="30" fill="none" stroke="#4FB286" stroke-width="2.5"/>
        <text x="140" y="115" text-anchor="middle" font-size="10" fill="#1F2D3D">Năm 2</text>
        <text x="140" y="128" text-anchor="middle" font-size="8" fill="#4A5568">28 ngày</text>

        <circle cx="200" cy="110" r="30" fill="none" stroke="#4FB286" stroke-width="2.5"/>
        <text x="200" y="115" text-anchor="middle" font-size="10" fill="#1F2D3D">Năm 3</text>
        <text x="200" y="128" text-anchor="middle" font-size="8" fill="#4A5568">28 ngày</text>

        <circle cx="260" cy="110" r="30" fill="#B8893C" stroke="#9B6E2C" stroke-width="2.5"/>
        <text x="260" y="113" text-anchor="middle" font-size="10" fill="#FAF7F2" font-weight="bold">Năm 4</text>
        <text x="260" y="126" text-anchor="middle" font-size="8" fill="#FAF7F2">NHUẬN</text>
        <text x="260" y="138" text-anchor="middle" font-size="8" fill="#FAF7F2">29 ngày</text>
      </g>
      <!-- Kim chỉ -->
      <g data-anim="indicator" opacity="0">
        <line x1="80" y1="50" x2="80" y2="75" stroke="#9B2C2C" stroke-width="2"/>
        <polygon points="80,80 75,72 85,72" fill="#9B2C2C"/>
        <text x="80" y="45" text-anchor="middle" font-size="9" fill="#9B2C2C" font-weight="bold">Kim chỉ năm</text>
      </g>
      <text x="160" y="180" text-anchor="middle" font-size="9" fill="#4A5568" data-anim="caption" opacity="0">
        Sau năm 4 → quay lại năm 1. Chu kỳ lặp lại.
      </text>
    </svg>
  </div>

  <!-- So sánh các loại lịch -->
  <div class="space-y-3">
    {calendarTypes.map((cal, i) => {
      const color = toneColors[cal.tone];
      return (
        <div class="flex items-start gap-3 rounded-lg border-l-4 bg-white p-3" style={`border-left-color: ${color.bg};`} data-anim="cal-row" data-index={i}>
          <span class="mt-0.5 shrink-0 text-sm font-bold" style={`color: ${color.text};`}>{i + 1}.</span>
          <div>
            <p class="text-sm font-medium" style={`color: ${color.text};`}>{cal.name}</p>
            <p class="text-xs text-ink-soft">{cal.desc}</p>
          </div>
        </div>
      );
    })}
  </div>

  <div class="mt-4 rounded-lg bg-brass/5 p-3 text-center text-xs text-ink-soft" data-anim="note">
    <strong class="text-brass">⚠ Lưu ý năm 2100:</strong> Năm chia hết 100 <em>không</em> là nhuận (trừ khi chia hết 400).
    Năm 2100 perpetual calendar sẽ sai → cần chỉnh.
  </div>
</section>

<style>
  [data-infographic] [data-anim] {
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  [data-infographic] [data-anim].reveal-visible {
    opacity: 1;
    transform: translate(0, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-infographic] [data-anim] { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  function init() {
    const root = document.querySelector('[data-infographic="glossary-perpetual-calendar"]');
    if (!root) return;
    const targets = root.querySelectorAll('[data-anim]');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      targets.forEach((el) => el.classList.add('reveal-visible'));
      return;
    }
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('reveal-visible'); obs.unobserve(e.target); }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
    targets.forEach((el) => obs.observe(el));
    setTimeout(() => targets.forEach((el) => el.classList.add('reveal-visible')), 3000);
  }
  init();
</script>
