---
// =============================================================================
// INFOGRAPHIC TỪ ĐIỂN: ROTOR (Quả nặng xoay của automatic)
// SVG rotor bán nguyệt + 2 kiểu bố trí (center vs micro-rotor).
// Chất liệu: rotor thép gradient 3 nấc, nền movement trắng ngà chuyển sắc.
// =============================================================================
const layouts = [
  {
    name: 'Center rotor',
    nameVi: 'Rotor giữa (phổ biến)',
    detail: 'Rotor lớn ở giữa movement, dễ thấy qua mặt sau lộ máy.',
    pros: 'Hiệu quả cao, dễ thiết kế',
    tone: 'common',
  },
  {
    name: 'Micro-rotor',
    nameVi: 'Micro-rotor (mỏng)',
    detail: 'Rotor nhỏ ở viền, cùng cao với movement → đồng hồ siêu mỏng.',
    pros: 'Movement mỏng, đẹp — nhưng khó thiết kế',
    tone: 'rare',
  },
];
const materials = [
  { name: 'Vàng / Platinum', note: 'Nặng → quay hiệu quả', tone: 'high' },
  { name: 'Thép', note: 'Nhẹ hơn, rẻ hơn', tone: 'mid' },
  { name: 'Tungsten / Bronze', note: 'Siêu nặng, hiệu quả cao', tone: 'high' },
];
const toneColors = { common: 'var(--ig-steel)', rare: 'var(--ig-rubi)', high: 'var(--ig-steel-soft)', mid: 'var(--obs-brass)' };
---

<section class="my-8" data-infographic="glossary-rotor">
  <div class="my-6 rounded-lg border border-cream-dark dark:border-dark-border bg-cream-dark/20 dark:bg-dark-border/20 p-6">
    <svg viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-xs" aria-hidden="true" focusable="false">
      <defs>
        <!-- Thép rotor: bán nguyệt bắt sáng trên, đậm dần xuống dưới -->
        <linearGradient id="rot-steel" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color:var(--ig-steel-soft)" />
          <stop offset="0.5" style="stop-color:var(--ig-steel)" />
          <stop offset="1" style="stop-color:var(--ig-edge)" />
        </linearGradient>
        <!-- Nền movement: mặt số trắng ngà, rìa nổi một nấc -->
        <radialGradient id="rot-movement" cx="0.42" cy="0.38" r="0.95">
          <stop offset="0" style="stop-color:var(--ig-bg)" />
          <stop offset="0.78" style="stop-color:var(--ig-bg)" />
          <stop offset="1" style="stop-color:var(--ig-bg-soft)" />
        </radialGradient>
      </defs>
      <text x="160" y="25" text-anchor="middle" font-size="11" style="fill:var(--ig-text)" font-weight="bold" data-anim="title">
        Rotor — quả nặng bán nguyệt
      </text>
      <!-- Movement nền -->
      <circle cx="160" cy="115" r="75" fill="url(#rot-movement)" style="stroke:var(--ig-edge)" stroke-width="1.5" data-anim="movement-bg"/>
      <!-- Chi tiết movement -->
      <g data-anim="movement-details">
        <circle cx="140" cy="100" r="12" fill="none" style="stroke:var(--obs-brass)" stroke-width="1" opacity="0.4"/>
        <circle cx="180" cy="130" r="10" fill="none" style="stroke:var(--obs-brass)" stroke-width="1" opacity="0.4"/>
        <circle cx="160" cy="115" r="6" style="fill:var(--obs-brass)" opacity="0.4"/>
      </g>
      <!-- Rotor bán nguyệt (vị trí trên) -->
      <g data-anim="rotor">
        <path d="M 160 115 L 160 50 A 65 65 0 0 1 225 115 Z" fill="url(#rot-steel)" style="stroke:var(--ig-edge)" stroke-width="2"/>
        <path d="M 166 108 L 166 58 A 59 59 0 0 1 218 108" fill="none" style="stroke:var(--obs-ivory)" stroke-width="1" opacity="0.35"/>
        <text x="195" y="80" font-size="9" style="fill:var(--ig-bg)" font-weight="bold">Rotor</text>
      </g>
      <!-- Trục rotor -->
      <circle cx="160" cy="115" r="5" style="fill:var(--ig-edge)" data-anim="pivot"/>
      <!-- Mũi tên cong chỉ xoay -->
      <g data-anim="rotation">
        <path d="M 225 115 A 65 65 0 0 1 95 115" fill="none" style="stroke:var(--obs-brass)" stroke-width="1.5" stroke-dasharray="4 3"/>
        <polygon points="95,115 103,109 103,121" style="fill:var(--obs-brass)"/>
        <text x="160" y="200" text-anchor="middle" font-size="9" style="fill:var(--ig-label)">
          Quay tự do 360° theo trọng lực
        </text>
      </g>
    </svg>
  </div>

  <!-- 2 kiểu bố trí -->
  <div class="grid gap-4 sm:grid-cols-2">
    {layouts.map((layout, i) => (
      <div class="rounded-lg border-l-4 bg-white dark:bg-dark-surface p-4" style={`border-left-color: ${toneColors[layout.tone]};`} data-anim="layout-card" data-index={i}>
        <p class="font-serif text-base" style={`color: ${toneColors[layout.tone]};`}>{layout.name}</p>
        <p class="text-xs font-medium text-navy dark:text-dark-text">{layout.nameVi}</p>
        <p class="mt-2 text-xs text-ink-soft dark:text-dark-text-soft">{layout.detail}</p>
        <p class="mt-2 text-xs">
          <span class="font-medium" style={`color: ${toneColors[layout.tone]};`}>→ {layout.pros}</span>
        </p>
      </div>
    ))}
  </div>

  <!-- Vật liệu -->
  <div class="mt-6">
    <p class="mb-3 text-center text-sm font-medium text-navy dark:text-dark-text">Vật liệu rotor (cần nặng để quay hiệu quả):</p>
    <div class="flex flex-wrap justify-center gap-3">
      {materials.map((mat, i) => (
        <div class="rounded-full border px-4 py-2 text-xs" style={`border-color: ${toneColors[mat.tone]}; color: ${toneColors[mat.tone]};`} data-anim="mat-chip" data-index={i}>
          <strong>{mat.name}</strong> — {mat.note}
        </div>
      ))}
    </div>
  </div>
</section>
