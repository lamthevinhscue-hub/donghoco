---
// =============================================================================
// INFOGRAPHIC TỪ ĐIỂN: ROTOR (Quả nặng xoay của automatic)
// SVG rotor bán nguyệt + 2 kiểu bố trí (center vs micro-rotor).
// =============================================================================
const layouts = [
  {
    name: 'Center rotor',
    nameVi: 'Rotor giữa (phổ biến)',
    detail: 'Rotor lớn ở giữa movement, dễ thấy qua mặt sau lộ máy.',
    pros: 'Hiệu quả cao, dễ thiết kế',
    tone: 'common',
  },
  {
    name: 'Micro-rotor',
    nameVi: 'Micro-rotor (mỏng)',
    detail: 'Rotor nhỏ ở viền, cùng cao với movement → đồng hồ siêu mỏng.',
    pros: 'Movement mỏng, đẹp — nhưng khó thiết kế',
    tone: 'rare',
  },
];
const materials = [
  { name: 'Vàng / Platinum', note: 'Nặng → quay hiệu quả', tone: 'high' },
  { name: 'Thép', note: 'Nhẹ hơn, rẻ hơn', tone: 'mid' },
  { name: 'Tungsten / Bronze', note: 'Siêu nặng, hiệu quả cao', tone: 'high' },
];
const toneColors = { common: '#2E86AB', rare: '#9B2C2C', high: '#2D7A55', mid: '#B8893C' };
---

<section class="my-8" data-infographic="glossary-rotor">
  <div class="my-6 rounded-lg border border-cream-dark bg-cream-dark/20 p-6">
    <svg viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-xs">
      <text x="160" y="25" text-anchor="middle" font-size="11" fill="#1F2D3D" font-weight="bold" data-anim="title" opacity="0">
        Rotor — quả nặng bán nguyệt
      </text>
      <!-- Movement nền -->
      <circle cx="160" cy="115" r="75" fill="#FAF7F2" stroke="#2D3748" stroke-width="1.5" data-anim="movement-bg" opacity="0"/>
      <!-- Chi tiết movement -->
      <g data-anim="movement-details" opacity="0">
        <circle cx="140" cy="100" r="12" fill="none" stroke="#B8893C" stroke-width="1" opacity="0.4"/>
        <circle cx="180" cy="130" r="10" fill="none" stroke="#B8893C" stroke-width="1" opacity="0.4"/>
        <circle cx="160" cy="115" r="6" fill="#B8893C" opacity="0.4"/>
      </g>
      <!-- Rotor bán nguyệt (vị trí trên) -->
      <g data-anim="rotor" opacity="0">
        <path d="M 160 115 L 160 50 A 65 65 0 0 1 225 115 Z" fill="#4A5568" stroke="#2D3748" stroke-width="2"/>
        <text x="195" y="80" font-size="9" fill="#FAF7F2" font-weight="bold">Rotor</text>
      </g>
      <!-- Trục rotor -->
      <circle cx="160" cy="115" r="5" fill="#2D3748" data-anim="pivot" opacity="0"/>
      <!-- Mũi tên cong chỉ xoay -->
      <g data-anim="rotation" opacity="0">
        <path d="M 225 115 A 65 65 0 0 1 95 115" fill="none" stroke="#B8893C" stroke-width="1.5" stroke-dasharray="4 3"/>
        <polygon points="95,115 103,109 103,121" fill="#B8893C"/>
        <text x="160" y="200" text-anchor="middle" font-size="9" fill="#4A5568">
          Quay tự do 360° theo trọng lực
        </text>
      </g>
    </svg>
  </div>

  <!-- 2 kiểu bố trí -->
  <div class="grid gap-4 sm:grid-cols-2">
    {layouts.map((layout, i) => (
      <div class="rounded-lg border-l-4 bg-white p-4" style={`border-left-color: ${toneColors[layout.tone]};`} data-anim="layout-card" data-index={i}>
        <h4 class="font-serif text-base" style={`color: ${toneColors[layout.tone]};`}>{layout.name}</h4>
        <p class="text-xs font-medium text-navy">{layout.nameVi}</p>
        <p class="mt-2 text-xs text-ink-soft">{layout.detail}</p>
        <p class="mt-2 text-xs">
          <span class="font-medium" style={`color: ${toneColors[layout.tone]};`}>→ {layout.pros}</span>
        </p>
      </div>
    ))}
  </div>

  <!-- Vật liệu -->
  <div class="mt-6">
    <p class="mb-3 text-center text-sm font-medium text-navy">Vật liệu rotor (cần nặng để quay hiệu quả):</p>
    <div class="flex flex-wrap justify-center gap-3">
      {materials.map((mat, i) => (
        <div class="rounded-full border px-4 py-2 text-xs" style={`border-color: ${toneColors[mat.tone]}; color: ${toneColors[mat.tone]};`} data-anim="mat-chip" data-index={i}>
          <strong>{mat.name}</strong> — {mat.note}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  [data-infographic] [data-anim] {
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  [data-infographic] [data-anim].reveal-visible {
    opacity: 1;
    transform: translate(0, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-infographic] [data-anim] { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  function init() {
    const root = document.querySelector('[data-infographic="glossary-rotor"]');
    if (!root) return;
    const targets = root.querySelectorAll('[data-anim]');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      targets.forEach((el) => el.classList.add('reveal-visible'));
      return;
    }
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('reveal-visible'); obs.unobserve(e.target); }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
    targets.forEach((el) => obs.observe(el));
    setTimeout(() => targets.forEach((el) => el.classList.add('reveal-visible')), 3000);
  }
  init();
</script>
