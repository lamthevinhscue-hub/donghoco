---
// =============================================================================
// INFOGRAPHIC TỪ ĐIỂN: VPH (Tần số dao động)
// SVG bánh lắc dao động + thang tần số. Quy đổi Hz ↔ vph.
// =============================================================================
const freqLevels = [
  { vph: '18.000', hz: '2,5 Hz', label: 'Cổ điển', note: 'Kim giây giật rõ', tone: 'low' },
  { vph: '21.600', hz: '3 Hz', label: 'Tầm trung', note: 'Phổ biến tầm trung', tone: 'mid' },
  { vph: '28.800', hz: '4 Hz', label: 'Cao cấp', note: 'Tiêu chuẩn cao cấp', tone: 'high' },
  { vph: '36.000', hz: '5 Hz', label: 'Rất cao', note: 'Zenith El Primero', tone: 'top' },
];
const toneColors = {
  low: '#9B2C2C', mid: '#B8893C', high: '#2D7A55', top: '#15435C',
};
---

<section class="my-8" data-infographic="glossary-vph">
  <div class="my-6 rounded-lg border border-cream-dark bg-cream-dark/20 p-6">
    <svg viewBox="0 0 360 150" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-lg">
      <text x="180" y="25" text-anchor="middle" font-size="11" fill="#1F2D3D" font-weight="bold" data-anim="title" opacity="0">
        Bánh lắc dao động qua lại liên tục
      </text>
      <!-- Quỹ đạo dao động -->
      <path d="M 100 90 A 80 80 0 0 1 260 90" fill="none" stroke="#9B2C2C" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.4" data-anim="arc" opacity="0"/>
      <!-- Bánh lắc 3 vị trí -->
      <g data-anim="balance-positions" opacity="0">
        <circle cx="120" cy="90" r="20" fill="none" stroke="#9B2C2C" stroke-width="2" opacity="0.3"/>
        <circle cx="240" cy="90" r="20" fill="none" stroke="#9B2C2C" stroke-width="2" opacity="0.3"/>
        <circle cx="180" cy="90" r="20" fill="#FAF7F2" stroke="#9B2C2C" stroke-width="2.5"/>
        <line x1="180" y1="70" x2="180" y2="110" stroke="#9B2C2C" stroke-width="2"/>
        <line x1="160" y1="76" x2="200" y2="104" stroke="#9B2C2C" stroke-width="2"/>
        <line x1="160" y1="104" x2="200" y2="76" stroke="#9B2C2C" stroke-width="2"/>
        <circle cx="180" cy="90" r="3" fill="#9B2C2C"/>
      </g>
      <!-- Mũi tên 2 chiều -->
      <g data-anim="arrows" opacity="0">
        <text x="130" y="135" font-size="20" fill="#9B2C2C">←</text>
        <text x="215" y="135" font-size="20" fill="#9B2C2C">→</text>
        <text x="180" y="145" text-anchor="middle" font-size="9" fill="#4A5568">Mỗi qua-lại = 2 dao động</text>
      </g>
    </svg>
  </div>

  <!-- Thang tần số -->
  <div class="space-y-2">
    <p class="mb-3 text-center text-sm text-ink-soft">Các mức tần số phổ biến:</p>
    {freqLevels.map((freq, i) => (
      <div class="flex items-center gap-3 rounded-lg border border-cream-dark bg-white p-3" data-anim="freq-row" data-index={i}>
        <span class="w-3 h-3 rounded-full shrink-0" style={`background-color: ${toneColors[freq.tone]};`}></span>
        <div class="flex flex-1 flex-wrap items-baseline gap-x-3 gap-y-0.5">
          <span class="font-serif text-lg font-bold" style={`color: ${toneColors[freq.tone]};`}>{freq.vph} vph</span>
          <span class="text-xs text-ink-soft/70">({freq.hz})</span>
          <span class="text-sm font-medium text-navy">{freq.label}</span>
          <span class="text-xs text-ink-soft">— {freq.note}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="mt-4 rounded-lg bg-brass/5 p-3 text-center text-xs text-ink-soft" data-anim="formula">
    <strong class="text-brass">Công thức quy đổi:</strong> 1 Hz = 7.200 vph
    (vì 1 Hz = 2 dao động, 1 giờ = 3.600 giây → 2 × 3.600 = 7.200)
  </div>
</section>

<style>
  [data-infographic] [data-anim] {
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  [data-infographic] [data-anim].reveal-visible {
    opacity: 1;
    transform: translate(0, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-infographic] [data-anim] { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  function init() {
    const root = document.querySelector('[data-infographic="glossary-vph"]');
    if (!root) return;
    const targets = root.querySelectorAll('[data-anim]');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      targets.forEach((el) => el.classList.add('reveal-visible'));
      return;
    }
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('reveal-visible'); obs.unobserve(e.target); }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
    targets.forEach((el) => obs.observe(el));
    setTimeout(() => targets.forEach((el) => el.classList.add('reveal-visible')), 3000);
  }
  init();
</script>
