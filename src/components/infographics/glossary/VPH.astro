---
// =============================================================================
// INFOGRAPHIC TỪ ĐIỂN: VPH (Tần số dao động)
// SVG bánh lắc dao động + thang tần số. Quy đổi Hz ↔ vph.
// Chất liệu: bánh lắc rubi trên nền mặt số gradient, mực độ tần số 4 nấc token.
// =============================================================================
const freqLevels = [
  { vph: '18.000', hz: '2,5 Hz', label: 'Cổ điển', note: 'Kim giây giật rõ', tone: 'low' },
  { vph: '21.600', hz: '3 Hz', label: 'Tầm trung', note: 'Phổ biến tầm trung', tone: 'mid' },
  { vph: '28.800', hz: '4 Hz', label: 'Cao cấp', note: 'Tiêu chuẩn cao cấp', tone: 'high' },
  { vph: '36.000', hz: '5 Hz', label: 'Rất cao', note: 'Zenith El Primero', tone: 'top' },
];
const toneColors = {
  low: 'var(--ig-rubi)', mid: 'var(--obs-brass)', high: 'var(--ig-steel)', top: 'var(--ig-stroke)',
};
---

<section class="my-8" data-infographic="glossary-vph">
  <div class="my-6 rounded-lg border border-cream-dark dark:border-dark-border bg-cream-dark/20 dark:bg-dark-border/20 p-6">
    <svg viewBox="0 0 360 150" xmlns="http://www.w3.org/2000/svg" class="mx-auto w-full max-w-lg" aria-hidden="true" focusable="false">
      <defs>
        <!-- Mặt bánh lắc: trắng ngà, rìa nổi một nấc -->
        <radialGradient id="vph-balance" cx="0.4" cy="0.35" r="0.95">
          <stop offset="0" style="stop-color:var(--ig-bg)" />
          <stop offset="0.78" style="stop-color:var(--ig-bg)" />
          <stop offset="1" style="stop-color:var(--ig-bg-soft)" />
        </radialGradient>
      </defs>
      <text x="180" y="25" text-anchor="middle" font-size="11" style="fill:var(--ig-text)" font-weight="bold" data-anim="title">
        Bánh lắc dao động qua lại liên tục
      </text>
      <!-- Quỹ đạo dao động -->
      <path d="M 100 90 A 80 80 0 0 1 260 90" fill="none" style="stroke:var(--ig-rubi)" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.4" data-anim="arc"/>
      <!-- Bánh lắc 3 vị trí -->
      <g data-anim="balance-positions">
        <circle cx="120" cy="90" r="20" fill="none" style="stroke:var(--ig-rubi)" stroke-width="2" opacity="0.3"/>
        <circle cx="240" cy="90" r="20" fill="none" style="stroke:var(--ig-rubi)" stroke-width="2" opacity="0.3"/>
        <circle cx="180" cy="90" r="20" fill="url(#vph-balance)" style="stroke:var(--ig-rubi)" stroke-width="2.5"/>
        <line x1="180" y1="70" x2="180" y2="110" style="stroke:var(--ig-rubi)" stroke-width="2"/>
        <line x1="160" y1="76" x2="200" y2="104" style="stroke:var(--ig-rubi)" stroke-width="2"/>
        <line x1="160" y1="104" x2="200" y2="76" style="stroke:var(--ig-rubi)" stroke-width="2"/>
        <circle cx="180" cy="90" r="3" style="fill:var(--ig-rubi)"/>
      </g>
      <!-- Mũi tên 2 chiều -->
      <g data-anim="arrows">
        <text x="130" y="135" font-size="20" style="fill:var(--ig-rubi)">←</text>
        <text x="215" y="135" font-size="20" style="fill:var(--ig-rubi)">→</text>
        <text x="180" y="145" text-anchor="middle" font-size="9" style="fill:var(--ig-label)">Mỗi qua-lại = 2 dao động</text>
      </g>
    </svg>
  </div>

  <!-- Thang tần số -->
  <div class="space-y-2">
    <p class="mb-3 text-center text-sm text-ink-soft dark:text-dark-text-soft">Các mức tần số phổ biến:</p>
    {freqLevels.map((freq, i) => (
      <div class="flex items-center gap-3 rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface p-3" data-anim="freq-row" data-index={i}>
        <span class="w-3 h-3 rounded-full shrink-0" style={`background-color: ${toneColors[freq.tone]};`}></span>
        <div class="flex flex-1 flex-wrap items-baseline gap-x-3 gap-y-0.5">
          <span class="font-serif text-lg font-bold" style={`color: ${toneColors[freq.tone]};`}>{freq.vph} vph</span>
          <span class="text-xs text-ink-soft/90 dark:text-dark-text-soft/70">({freq.hz})</span>
          <span class="text-sm font-medium text-navy dark:text-dark-text">{freq.label}</span>
          <span class="text-xs text-ink-soft dark:text-dark-text-soft">— {freq.note}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="mt-4 rounded-lg bg-brass/5 dark:bg-dark-brass/10 p-3 text-center text-xs text-ink-soft dark:text-dark-text-soft" data-anim="formula">
    <strong class="text-brass dark:text-dark-brass">Công thức quy đổi:</strong> 1 Hz = 7.200 vph
    (vì 1 Hz = 2 dao động, 1 giờ = 3.600 giây → 2 × 3.600 = 7.200)
  </div>
</section>
