---
// =============================================================================
// GmtReader — Thành phần tương tác: đọc và chỉnh đồng hồ GMT
// =============================================================================
// Ba múi giờ cùng lúc: giờ địa phương (kim giờ), giờ nhà (kim GMT), và giờ
// thứ ba (vành 24 giờ). Người đọc chỉnh kim giờ và kim GMT từng nấc, xoay
// vành 24 giờ. Dùng cho /huong-dan/doc-va-chinh-gmt.
// =============================================================================

interface Props {
  'data-mech-step-id'?: string;
}
const { 'data-mech-step-id': _mechStepId } = Astro.props;
---

<section
  class="interactive-tool my-8 rounded-lg border border-cream-dark bg-cream-dark/20 p-4 sm:p-6 dark:border-dark-border dark:bg-dark-border/20"
  data-tool="gmt-reader"
>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <span class="text-sm font-medium text-navy dark:text-dark-text">Dụng cụ tương tác — đồng hồ GMT</span>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="gmt-hour-up rounded-full border border-navy px-3 py-1.5 text-xs font-medium text-navy transition-colors hover:bg-navy hover:text-cream dark:border-dark-text dark:text-dark-text">
        Kim giờ +1h
      </button>
      <button type="button" class="gmt-gmt-up rounded-full border border-brass px-3 py-1.5 text-xs font-medium text-brass transition-colors hover:bg-brass hover:text-white">
        Kim GMT +1h
      </button>
      <button type="button" class="gmt-bezel-ccw rounded-full border border-cream-dark bg-white px-3 py-1.5 text-xs font-medium text-ink-soft transition-colors hover:border-brass hover:text-brass dark:border-dark-border dark:bg-dark-surface dark:text-dark-text-soft">
        ⟲ Vành 24h
      </button>
      <button type="button" class="gmt-bezel-cw rounded-full border border-cream-dark bg-white px-3 py-1.5 text-xs font-medium text-ink-soft transition-colors hover:border-brass hover:text-brass dark:border-dark-border dark:bg-dark-surface dark:text-dark-text-soft">
        Vành 24h ⟳
      </button>
    </div>
  </div>

  <div class="gmt-stage flex flex-col items-center gap-4 rounded-lg border border-cream-dark bg-white p-4 dark:border-dark-border dark:bg-dark-surface sm:flex-row sm:justify-center">
    <svg
      class="gmt-svg"
      viewBox="0 0 300 300"
      width="280"
      height="280"
      style="touch-action: none;"
      role="img"
      aria-label="Mô phỏng đồng hồ GMT: bấm nút để chỉnh kim"
    >
      <!-- Vành 24 giờ (xoay được) -->
      <g class="gmt-bezel-ring" style="cursor: grab; transform-origin: 150px 150px;">
        <circle cx="150" cy="150" r="140" fill="#1F2D3D" stroke="#0f1620" stroke-width="2" />
        <g class="gmt-bezel-marks"></g>
        <text x="150" y="22" text-anchor="middle" fill="#FAF7F2" font-family="Be Vietnam Pro, sans-serif" font-size="13" font-weight="700">24</text>
        <text x="150" y="288" text-anchor="middle" fill="#FAF7F2" font-family="Be Vietnam Pro, sans-serif" font-size="13" font-weight="700">12</text>
        <text x="282" y="155" text-anchor="middle" fill="#FAF7F2" font-family="Be Vietnam Pro, sans-serif" font-size="13" font-weight="700">06</text>
        <text x="18" y="155" text-anchor="middle" fill="#FAF7F2" font-family="Be Vietnam Pro, sans-serif" font-size="13" font-weight="700">18</text>
      </g>
      <!-- Mặt số 12 giờ -->
      <circle cx="150" cy="150" r="112" fill="#FAF7F2" stroke="#1F2D3D" stroke-width="2" />
      <g class="hour-marks"></g>
      <!-- Kim giờ (local) -->
      <g class="hour-hand" style="transform-origin: 150px 150px;">
        <line x1="150" y1="160" x2="150" y2="85" stroke="#1F2D3D" stroke-width="5" stroke-linecap="round" />
      </g>
      <!-- Kim phút (cố định chỉ 12 cho rõ) -->
      <line x1="150" y1="160" x2="150" y2="55" stroke="#1F2D3D" stroke-width="3" stroke-linecap="round" />
      <!-- Kim GMT (màu brass, ngắn hơn, một vòng/24h) -->
      <g class="gmt-hand" style="transform-origin: 150px 150px;">
        <polygon points="146,150 154,150 152,70 150,60 148,70" fill="#B8893C" />
      </g>
      <circle cx="150" cy="150" r="6" fill="#1F2D3D" />
      <polygon points="150,2 145,14 155,14" fill="#B8893C" />
    </svg>

    <!-- Bảng 3 múi giờ -->
    <div class="gmt-readout w-full max-w-xs space-y-3 sm:w-60">
      <div class="rounded-lg border border-cream-dark bg-cream/40 p-3 dark:border-dark-border dark:bg-dark-border/30">
        <p class="text-xs uppercase tracking-wider text-ink-soft/90 dark:text-dark-text-soft/70">Giờ địa phương (kim giờ)</p>
        <p class="gmt-local font-serif text-2xl text-navy dark:text-dark-text">12:00</p>
      </div>
      <div class="rounded-lg border-l-4 border-brass bg-brass/5 p-3">
        <p class="text-xs uppercase tracking-wider text-ink-soft/90 dark:text-dark-text-soft/70">Giờ nhà (kim GMT)</p>
        <p class="gmt-home font-serif text-2xl text-navy dark:text-dark-text">12:00</p>
      </div>
      <div class="rounded-lg border border-cream-dark bg-cream/40 p-3 dark:border-dark-border dark:bg-dark-border/30">
        <p class="text-xs uppercase tracking-wider text-ink-soft/90 dark:text-dark-text-soft/70">Múi giờ thứ ba (theo vành 24h)</p>
        <p class="gmt-third font-serif text-2xl text-navy dark:text-dark-text">12:00</p>
      </div>
      <p class="text-xs leading-relaxed text-ink-soft dark:text-dark-text-soft">
        Bấm nút để chỉnh kim. Kim giờ quay một vòng/12h, kim GMT một vòng/24h.
      </p>
    </div>
  </div>
</section>

<style>
  .gmt-svg .gmt-bezel-ring:active { cursor: grabbing; }
  .gmt-svg { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
</style>

<script>
  // Vạch giờ 1-12 trên mặt số + vạch 24h trên vành
  (function () {
    const svgNS = 'http://www.w3.org/2000/svg';
    const hourMarks = document.querySelector('.gmt-svg .hour-marks');
    if (hourMarks && hourMarks.children.length === 0) {
      for (let i = 0; i < 12; i++) {
        const angle = (i * 30 - 90) * Math.PI / 180;
        const x = 150 + 100 * Math.cos(angle);
        const y = 150 + 100 * Math.sin(angle);
        const t = document.createElementNS(svgNS, 'text');
        t.setAttribute('x', String(x));
        t.setAttribute('y', String(y + 5));
        t.setAttribute('text-anchor', 'middle');
        t.setAttribute('fill', '#1F2D3D');
        t.setAttribute('font-family', 'Be Vietnam Pro, sans-serif');
        t.setAttribute('font-size', '14');
        t.setAttribute('font-weight', '600');
        t.textContent = i === 0 ? '12' : String(i);
        hourMarks.appendChild(t);
      }
    }
    // Vạch phụ 24h trên vành
    const bezelMarks = document.querySelector('.gmt-svg .gmt-bezel-marks');
    if (bezelMarks && bezelMarks.children.length === 0) {
      for (let i = 0; i < 24; i++) {
        const angle = (i * 15 - 90) * Math.PI / 180;
        const isMajor = i % 6 === 0;
        const x1 = 150 + 140 * Math.cos(angle);
        const y1 = 150 + 140 * Math.sin(angle);
        const x2 = 150 + (isMajor ? 124 : 130) * Math.cos(angle);
        const y2 = 150 + (isMajor ? 124 : 130) * Math.sin(angle);
        const line = document.createElementNS(svgNS, 'line');
        line.setAttribute('x1', String(x1));
        line.setAttribute('y1', String(y1));
        line.setAttribute('x2', String(x2));
        line.setAttribute('y2', String(y2));
        line.setAttribute('stroke', '#FAF7F2');
        line.setAttribute('stroke-width', isMajor ? '2' : '1');
        line.setAttribute('opacity', isMajor ? '1' : '0.4');
        bezelMarks.appendChild(line);
      }
    }
  })();

  (function () {
    const svg = document.querySelector('[data-tool="gmt-reader"] .gmt-svg') as SVGSVGElement | null;
    if (!svg) return;
    const hourHand = svg.querySelector('.hour-hand') as SVGGElement | null;
    const gmtHand = svg.querySelector('.gmt-hand') as SVGGElement | null;
    const bezelRing = svg.querySelector('.gmt-bezel-ring') as SVGGElement | null;
    const localEl = document.querySelector('.gmt-local') as HTMLElement | null;
    const homeEl = document.querySelector('.gmt-home') as HTMLElement | null;
    const thirdEl = document.querySelector('.gmt-third') as HTMLElement | null;
    const hourUp = document.querySelector('.gmt-hour-up') as HTMLButtonElement | null;
    const gmtUp = document.querySelector('.gmt-gmt-up') as HTMLButtonElement | null;
    const bezelCcw = document.querySelector('.gmt-bezel-ccw') as HTMLButtonElement | null;
    const bezelCw = document.querySelector('.gmt-bezel-cw') as HTMLButtonElement | null;
    if (!hourHand || !gmtHand || !bezelRing) return;

    let localHour = 12; // 1-12 (giờ địa phương)
    let gmtHour24 = 12; // 0-23 (giờ nhà trên thang 24h)
    let bezelAngle = 0; // độ xoay vành

    function pad(n: number) { return n < 10 ? '0' + n : '' + n; }

    function render() {
      // Kim giờ: 12h = 0°, mỗi giờ = 30° (một vòng/12h)
      const hourAngle = ((localHour % 12) * 30);
      hourHand.style.transform = `rotate(${hourAngle}deg)`;
      // Kim GMT: một vòng/24h, mỗi giờ = 15°. 0h/24h ở đỉnh.
      const gmtAngle = (gmtHour24 % 24) * 15;
      gmtHand.style.transform = `rotate(${gmtAngle}deg)`;
      bezelRing.style.transform = `rotate(${bezelAngle}deg)`;

      // Giờ địa phương
      if (localEl) localEl.textContent = `${pad(localHour % 12 === 0 ? 12 : localHour % 12)}:00`;
      // Giờ nhà = gmtHour24
      const h24 = gmtHour24 % 24;
      if (homeEl) homeEl.textContent = `${pad(h24)}:00`;
      // Múi giờ thứ ba: đọc trên vành 24h tại mốc đỉnh cố định.
      // Vành xoay angle° → số giờ tại đỉnh thay đổi. Mỗi giờ = 15°.
      // Giờ tại đỉnh = (24 - bezelAngle/15) mod 24... nhưng trực giác hơn:
      // mốc đỉnh cố định chỉ vào vạch (24 - bezelAngle/15) trên vành.
      let third = (24 - bezelAngle / 15) % 24;
      if (third < 0) third += 24;
      if (thirdEl) thirdEl.textContent = `${pad(Math.floor(thickThird(third)))}:00`;
    }
    // Làm tròn giờ thứ ba về số nguyên gần nhất (mỗi nấc vành = 1h)
    function thickThird(v: number) { return Math.round(v); }

    hourUp?.addEventListener('click', () => {
      localHour = (localHour % 12) + 1; // 1..12
      render();
    });
    gmtUp?.addEventListener('click', () => {
      gmtHour24 = (gmtHour24 + 1) % 24;
      render();
    });
    // Vành 24h xoay mỗi nấc = 15° (1 giờ)
    bezelCw?.addEventListener('click', () => { bezelAngle = (bezelAngle + 15) % 360; render(); });
    bezelCcw?.addEventListener('click', () => { bezelAngle = (bezelAngle - 15 + 360) % 360; render(); });

    // Kéo vành bằng ngón tay/chuột
    let dragging = false;
    let lastAngle = 0;
    function getPoint(e: PointerEvent) {
      const rect = svg.getBoundingClientRect();
      return { x: ((e.clientX - rect.left) / rect.width) * 300, y: ((e.clientY - rect.top) / rect.height) * 300 };
    }
    function angleFromCenter(p: { x: number; y: number }) {
      const dx = p.x - 150, dy = p.y - 150;
      let d = Math.atan2(dx, -dy) * 180 / Math.PI;
      if (d < 0) d += 360;
      return d;
    }
    function onDown(e: PointerEvent) {
      const t = e.target as Element;
      if (!bezelRing.contains(t) && t !== bezelRing) return;
      dragging = true;
      (e.target as Element).setPointerCapture?.(e.pointerId);
      lastAngle = angleFromCenter(getPoint(e));
      e.preventDefault();
    }
    function onMove(e: PointerEvent) {
      if (!dragging) return;
      const cur = angleFromCenter(getPoint(e));
      let delta = cur - lastAngle;
      if (delta > 180) delta -= 360;
      if (delta < -180) delta += 360;
      bezelAngle = (bezelAngle + delta + 360) % 360;
      lastAngle = cur;
      render();
    }
    function onUp(e: PointerEvent) { dragging = false; (e.target as Element).releasePointerCapture?.(e.pointerId); }
    bezelRing.addEventListener('pointerdown', onDown);
    svg.addEventListener('pointermove', onMove);
    svg.addEventListener('pointerup', onUp);
    svg.addEventListener('pointercancel', onUp);

    render();
  })();
</script>
