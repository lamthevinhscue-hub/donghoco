---
// =============================================================================
// TachymeterTool — Thành phần tương tác: đo tốc độ bằng thang tachymeter
// =============================================================================
// Người đọc nhập quãng đường, bấm bắt đầu khi vật qua vạch xuất phát, dừng khi
// qua hết quãng đường, đọc tốc độ trung bình. Dùng cho /huong-dan/dung-tachymeter.
// =============================================================================

interface Props {
  'data-mech-step-id'?: string;
}
const { 'data-mech-step-id': _mechStepId } = Astro.props;
---

<section
  class="interactive-tool my-8 rounded-lg border border-cream-dark bg-cream-dark/20 p-4 sm:p-6 dark:border-dark-border dark:bg-dark-border/20"
  data-tool="tachymeter"
>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <span class="text-sm font-medium text-navy dark:text-dark-text">Dụng cụ tương tác — thang tachymeter</span>
  </div>

  <div class="tacho-stage flex flex-col items-center gap-4 rounded-lg border border-cream-dark bg-white p-4 dark:border-dark-border dark:bg-dark-surface lg:flex-row lg:justify-center">
    <!-- SVG đồng hồ chronograph với thang tachymeter -->
    <svg
      class="tacho-svg"
      viewBox="0 0 300 300"
      width="260"
      height="260"
      role="img"
      aria-label="Mô phỏng thang tachymeter"
      focusable="false">
      <!-- Thang tachymeter (vòng ngoài cùng) -->
      <circle style="fill:var(--ig-bg);stroke:var(--ig-stroke)" cx="150" cy="150" r="142" stroke-width="1.5" />
      <g class="tacho-scale"></g>
      <!-- Mặt số -->
      <circle style="fill:var(--ig-stroke)" cx="150" cy="150" r="110" />
      <g class="tacho-hour-marks"></g>
      <!-- Kim giây chronograph (đỏ) -->
      <g class="tacho-sec-hand" style="transform-origin: 150px 150px;">
        <line x1="150" y1="165" x2="150" y2="40" stroke="#B8893C" stroke-width="2.5" stroke-linecap="round" />
      </g>
      <circle style="fill:var(--ig-bg)" cx="150" cy="150" r="5" />
    </svg>

    <!-- Bảng điều khiển -->
    <div class="tacho-controls w-full max-w-xs space-y-4 lg:w-72">
      <!-- Nhập quãng đường -->
      <div>
        <label for="tacho-distance" class="block text-xs font-medium uppercase tracking-wider text-ink-soft/90 dark:text-dark-text-soft/70">
          Quãng đường (1 đơn vị)
        </label>
        <div class="mt-1 flex items-center gap-2">
          <input
            id="tacho-distance"
            type="number"
            min="0.1"
            step="0.1"
            value="1"
            class="tacho-distance w-24 rounded border border-cream-dark bg-white px-2 py-1.5 text-sm dark:border-dark-border dark:bg-dark-surface dark:text-dark-text"
          />
          <span class="text-sm text-ink-soft dark:text-dark-text-soft">km (hoặc dặm)</span>
        </div>
      </div>

      <!-- Bộ đếm thời gian -->
      <div class="rounded-lg border border-cream-dark bg-cream/40 p-3 text-center dark:border-dark-border dark:bg-dark-border/30">
        <p class="text-xs uppercase tracking-wider text-ink-soft/90 dark:text-dark-text-soft/70">Thời gian trôi qua</p>
        <p class="tacho-elapsed font-serif text-3xl text-navy dark:text-dark-text">0.0 giây</p>
      </div>

      <!-- Nút bấm -->
      <div class="flex gap-2">
        <button type="button" class="tacho-start flex-1 rounded-full bg-navy px-4 py-2 text-sm font-medium text-cream transition-colors hover:bg-brass">
          Bắt đầu
        </button>
        <button type="button" class="tacho-stop flex-1 rounded-full border border-navy px-4 py-2 text-sm font-medium text-navy transition-colors hover:bg-navy hover:text-cream dark:border-dark-text dark:text-dark-text">
          Dừng
        </button>
        <button type="button" class="tacho-reset rounded-full border border-cream-dark px-3 py-2 text-sm text-ink-soft transition-colors hover:border-brass hover:text-brass dark:border-dark-border dark:text-dark-text-soft" aria-label="Đặt lại">
          ↺
        </button>
      </div>

      <!-- Kết quả -->
      <div class="tacho-result hidden rounded-lg border-l-4 border-brass bg-brass/5 p-3">
        <p class="text-xs uppercase tracking-wider text-ink-soft/90 dark:text-dark-text-soft/70">Tốc độ trung bình</p>
        <p class="tacho-speed font-serif text-3xl text-navy dark:text-dark-text">—</p>
        <p class="tacho-note text-xs text-ink-soft dark:text-dark-text-soft"></p>
      </div>

      <p class="text-xs leading-relaxed text-ink-soft dark:text-dark-text-soft">
        Bấm <strong>Bắt đầu</strong> khi vật qua vạch, <strong>Dừng</strong> khi đi hết quãng đường. Tốc độ = kim giây chỉ số trên thang.
      </p>
    </div>
  </div>
</section>

<script>
  // Vạch thang tachymeter (không chia đều) + vạch giờ
  (function () {
    const svgNS = 'http://www.w3.org/2000/svg';
    const scale = document.querySelector('.tacho-svg .tacho-scale');
    if (scale && scale.children.length === 0) {
      // Thang tachymeter: số = 3600/thời_giây. Vị trí góc = (thời_giây/60)*360 từ đỉnh.
      // Sinh các số từ 60 (tại 60s) đến ~400 (tại 9s). Mỗi số ứng với một góc.
      const speeds = [400, 300, 240, 200, 180, 160, 140, 120, 100, 90, 80, 75, 70, 65, 60];
      speeds.forEach((sp) => {
        const sec = 3600 / sp; // thời gian giây ứng với tốc độ này
        if (sec > 60 || sec < 7) return;
        const angle = (sec / 60) * 360 - 90; // -90 để 0 = đỉnh
        const rad = angle * Math.PI / 180;
        const r = 142;
        const r2 = 132;
        const x1 = 150 + r * Math.cos(rad);
        const y1 = 150 + r * Math.sin(rad);
        const x2 = 150 + r2 * Math.cos(rad);
        const y2 = 150 + r2 * Math.sin(rad);
        const line = document.createElementNS(svgNS, 'line');
        line.setAttribute('x1', String(x1));
        line.setAttribute('y1', String(y1));
        line.setAttribute('x2', String(x2));
        line.setAttribute('y2', String(y2));
        line.setAttribute('stroke', '#1F2D3D');
        line.setAttribute('stroke-width', '1');
        scale.appendChild(line);
        const tx = 150 + 122 * Math.cos(rad);
        const ty = 150 + 122 * Math.sin(rad) + 3;
        const t = document.createElementNS(svgNS, 'text');
        t.setAttribute('x', String(tx));
        t.setAttribute('y', String(ty));
        t.setAttribute('text-anchor', 'middle');
        t.setAttribute('fill', '#1F2D3D');
        t.setAttribute('font-family', 'Be Vietnam Pro, sans-serif');
        t.setAttribute('font-size', '9');
        t.setAttribute('font-weight', '600');
        t.textContent = String(sp);
        scale.appendChild(t);
      });
    }
    // Vạch giờ 12h trên mặt tối
    const hm = document.querySelector('.tacho-svg .tacho-hour-marks');
    if (hm && hm.children.length === 0) {
      for (let i = 0; i < 12; i++) {
        const angle = (i * 30 - 90) * Math.PI / 180;
        const x = 150 + 95 * Math.cos(angle);
        const y = 150 + 95 * Math.sin(angle);
        const t = document.createElementNS(svgNS, 'text');
        t.setAttribute('x', String(x));
        t.setAttribute('y', String(y + 4));
        t.setAttribute('text-anchor', 'middle');
        t.setAttribute('fill', '#FAF7F2');
        t.setAttribute('font-family', 'Be Vietnam Pro, sans-serif');
        t.setAttribute('font-size', '13');
        t.setAttribute('font-weight', '600');
        t.textContent = i === 0 ? '12' : String(i);
        hm.appendChild(t);
      }
    }
  })();

  (function () {
    const secHand = document.querySelector('[data-tool="tachymeter"] .tacho-sec-hand') as SVGGElement | null;
    const elapsedEl = document.querySelector('.tacho-elapsed') as HTMLElement | null;
    const startBtn = document.querySelector('.tacho-start') as HTMLButtonElement | null;
    const stopBtn = document.querySelector('.tacho-stop') as HTMLButtonElement | null;
    const resetBtn = document.querySelector('.tacho-reset') as HTMLButtonElement | null;
    const distInput = document.querySelector('.tacho-distance') as HTMLInputElement | null;
    const resultBox = document.querySelector('.tacho-result') as HTMLElement | null;
    const speedEl = document.querySelector('.tacho-speed') as HTMLElement | null;
    const noteEl = document.querySelector('.tacho-note') as HTMLElement | null;
    if (!secHand || !startBtn || !stopBtn) return;

    let running = false;
    let startTime = 0;
    let rafId: number | null = null;

    function render(sec: number) {
      // Kim giây quay: 60 giây = 1 vòng (360°)
      const angle = (sec / 60) * 360;
      secHand.style.transform = `rotate(${angle}deg)`;
      if (elapsedEl) elapsedEl.textContent = `${sec.toFixed(1)} giây`;
    }

    function loop(ts: number) {
      if (!running) return;
      const sec = (ts - startTime) / 1000;
      if (sec <= 60) {
        render(sec);
      } else {
        // Quá 60 giây: dừng, thang chỉ đo tới 60s
        stop();
        if (noteEl) noteEl.textContent = 'Quá 60 giây — thang tachymeter không đo được (quá chậm).';
      }
      if (running) rafId = requestAnimationFrame(loop);
    }

    function start() {
      running = true;
      startTime = performance.now();
      startBtn.textContent = 'Đang chạy...';
      startBtn.disabled = true;
      if (resultBox) resultBox.classList.add('hidden');
      rafId = requestAnimationFrame(loop);
    }
    function stop() {
      running = false;
      startBtn.textContent = 'Bắt đầu';
      startBtn.disabled = false;
      if (rafId) cancelAnimationFrame(rafId);
      // Tính kết quả
      const sec = (performance.now() - startTime) / 1000;
      const dist = distInput ? parseFloat(distInput.value) || 1 : 1;
      if (sec > 0 && sec <= 60 && resultBox && speedEl && noteEl) {
        // Tốc độ = 3600/sec × (quãng đường) — nhưng thang tachymeter mặc định quãng = 1 đơn vị.
        // Nếu quãng đường = d, tốc độ thực = (3600/sec) nhân tỉ lệ.
        const baseSpeed = 3600 / sec; // tốc độ trên thang (ứng quãng 1)
        const realSpeed = baseSpeed * dist;
        const unit = distInput ? 'km/h' : 'km/h';
        speedEl.textContent = `${Math.round(realSpeed)} ${unit}`;
        noteEl.textContent = `Thang cơ sở chỉ ${Math.round(baseSpeed)} (quãng = 1); quãng ${dist} → ${Math.round(realSpeed)}.`;
        resultBox.classList.remove('hidden');
      }
    }
    function reset() {
      running = false;
      startBtn.textContent = 'Bắt đầu';
      startBtn.disabled = false;
      if (rafId) cancelAnimationFrame(rafId);
      render(0);
      if (resultBox) resultBox.classList.add('hidden');
    }

    startBtn.addEventListener('click', start);
    stopBtn.addEventListener('click', stop);
    resetBtn?.addEventListener('click', reset);

    render(0);
  })();
</script>
