---
// =============================================================================
// TERM ARTICLE — template trang TỪ ĐIỂN dùng chung vi/en
// =============================================================================
// Wrappers: vi = /tu-dien/[slug], en = /en/glossary/[slug].
// Bản tiếng Anh: ẩn infographic (nhãn chưa dịch), schema DefinedTerm trỏ về
// tập thuật ngữ tiếng Anh đang tồn tại.
// =============================================================================

import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Tourbillon from '../../components/infographics/glossary/Tourbillon.astro';
import MinuteRepeater from '../../components/infographics/glossary/MinuteRepeater.astro';
import PerpetualCalendar from '../../components/infographics/glossary/PerpetualCalendar.astro';
import VPH from '../../components/infographics/glossary/VPH.astro';
import Incabloc from '../../components/infographics/glossary/Incabloc.astro';
import Rotor from '../../components/infographics/glossary/Rotor.astro';
import Chronograph from '../../components/infographics/glossary/Chronograph.astro';
import Hairspring from '../../components/infographics/glossary/Hairspring.astro';
import GMT from '../../components/infographics/glossary/GMT.astro';
import { getEntriesByLang, getSlug } from '../../lib/content';
import { render } from 'astro:content';
import { getCategoryLabel } from '../../i18n/ui';
import { collectionHref } from '../../i18n/contentRoutes';
import type { Lang } from '../../i18n/ui';
import type { RelatedItem } from '../../components/RelatedArticles.astro';

interface Props {
  slug: string;
  lang: Lang;
}

const { slug, lang } = Astro.props;
const entries = await getEntriesByLang('tuDien', lang);
const entry = entries.find((e) => getSlug(e) === slug);
if (!entry) {
  return Astro.redirect('/404');
}

const { Content, headings } = await render(entry);
const { data } = entry;
const meta = (data as any).term_en
  ? `EN: ${(data as any).term_en}`
  : getCategoryLabel((data as any).category, lang);

// Map slug vi -> component infographic. Bản EN ẩn (nhãn chưa dịch hoàn toàn).
const infographics: Record<string, any> = {
  tourbillon: Tourbillon,
  'minute-repeater': MinuteRepeater,
  'perpetual-calendar': PerpetualCalendar,
  vph: VPH,
  incabloc: Incabloc,
  rotor: Rotor,
  chronograph: Chronograph,
  gmt: GMT,
  'day-toc-banh-lac': Hairspring,
};
const Infographic =
  lang === 'vi' && (data as any).has_infographic ? infographics[slug] : null;

// ====== Gợi ý "Đọc tiếp" (tối đa 3) ======
const coCheEntries = await getEntriesByLang('coChe', lang);
const matchingMechanism = coCheEntries.find((e) => getSlug(e) === slug);
const sameCategory = entries
  .filter((e) => getSlug(e) !== slug && (e.data as any).category === (data as any).category)
  .sort((a, b) => (a.data as any).title.localeCompare((b.data as any).title));

const related: RelatedItem[] = [];

if (matchingMechanism) {
  const md = matchingMechanism.data as any;
  related.push({
    href: collectionHref('coChe', getSlug(matchingMechanism), lang),
    title: md.title,
    excerpt: md.excerpt,
    meta: md.term_en ? `EN: ${md.term_en}` : getCategoryLabel(md.category, lang),
  });
}

for (const e of sameCategory) {
  if (related.length >= 3) break;
  const ed = e.data as any;
  related.push({
    href: collectionHref('tuDien', getSlug(e), lang),
    title: ed.title,
    excerpt: ed.excerpt,
    meta: ed.term_en ? `EN: ${ed.term_en}` : getCategoryLabel(ed.category, lang),
  });
}

// Schema DefinedTerm — tập thuật ngữ theo ngôn ngữ trang
const siteUrl = Astro.site ?? new URL('https://www.kienthucdonghoco.vn');
const termSetHref = new URL(
  lang === 'vi' ? '/tu-dien' : '/en/glossary/',
  siteUrl
).href;
const termSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: data.title,
  description: data.excerpt,
  url: new URL(Astro.url.pathname, siteUrl).href,
  inDefinedTermSet: termSetHref,
};

const backHref = lang === 'vi' ? '/tu-dien' : '/en/glossary';
---

<ArticleLayout
  headings={headings}
  title={data.title}
  excerpt={data.excerpt}
  date={data.date}
  updated={data.updated}
  backHref={backHref}
  meta={meta}
  relatedArticles={related}
  sources={data.sources}
  schemaOverride={termSchema}
>
  {Infographic && (
    <div class="mb-8 rounded-lg border border-brass/30 bg-brass/5 p-3 text-center text-xs font-medium text-brass">
      ✅ Infographic minh họa {(data as any).interactive ? 'tương tác (Play/Pause/Speed/Step)' : ''}
    </div>
  )}
  {Infographic && <Infographic />}

  {Infographic && <div class="mt-12 border-t border-cream-dark pt-10"></div>}
  <Content />
</ArticleLayout>
