---
// =============================================================================
// ARTICLE LAYOUT (Bộ khung cho bài viết chi tiết)
// =============================================================================
// Dùng cho trang chi tiết của: mẫu iconic, thương hiệu, cơ chế, hướng dẫn...
// Hiển thị tiêu đề lớn, thông tin phụ, ảnh bìa, rồi đến nội dung Markdown.
// =============================================================================

import BaseLayout from './BaseLayout.astro';
import WatchImage from '../components/WatchImage.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import RelatedArticles, { type RelatedItem } from '../components/RelatedArticles.astro';
import SourceList from '../components/SourceList.astro';
import { getLangFromUrl, t, localizedPath } from '../i18n/ui';

interface Props {
  title: string;
  excerpt?: string;
  date?: string;
  cover_image?: string;
  /** Đường dẫn về trang danh sách (không tính tiền tố ngôn ngữ) */
  backHref?: string;
  /** Thông tin phụ hiển thị ngay dưới tiêu đề */
  meta?: string;
  /** Các bài gợi ý cho khối "Đọc tiếp" (tối đa 3, tự tính ở trang slug) */
  relatedArticles?: RelatedItem[];
  /** Link dẫn sang công cụ so sánh với mẫu hiện tại đã chọn (chỉ /mau-iconic) */
  compareHref?: string;
  /** Nguồn tham khảo — hiện cuối bài qua SourceList.astro */
  sources?: { label: string; url: string }[];
}

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);

const { title, excerpt, date, cover_image, backHref, meta, relatedArticles = [], compareHref, sources = [] } = Astro.props;

// Breadcrumb + Article schema cho SEO
// Ánh xạ đường dẫn danh sách → nhãn dịch (tránh hiển thị slug thô như "co che")
const sectionLabels: Record<string, string> = {
  '/thuong-hieu': tr.nav_brands,
  '/mau-iconic': tr.nav_iconic,
  '/co-che': tr.nav_mechanisms,
  '/tu-dien': tr.nav_glossary,
  '/huong-dan': tr.nav_guides,
};
const breadcrumbData = backHref ? [
  { name: tr.siteName, path: '/' },
  { name: sectionLabels[backHref] ?? backHref, path: backHref },
  { name: title, path: Astro.url.pathname },
] : undefined;

const articleData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  datePublished: date,
  inLanguage: 'vi-VN',
};

// Định dạng ngày thân thiện với tiếng Việt
const formattedDate = date
  ? new Date(date).toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<BaseLayout title={title} description={excerpt} cover_image={cover_image} breadcrumb={breadcrumbData} articleSchema={articleData} datePublished={date}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    {breadcrumbData && <Breadcrumb items={breadcrumbData} />}

    <header class="mb-8">
      <h1 class="font-serif text-4xl leading-tight text-navy dark:text-dark-text sm:text-5xl">{title}</h1>

      {(meta || formattedDate) && (
        <p class="mt-4 text-sm uppercase tracking-wider text-ink-soft/70 dark:text-dark-text-soft/70">
          {[meta, formattedDate].filter(Boolean).join(' • ')}
        </p>
      )}

      {excerpt && <p class="mt-4 text-lg italic leading-relaxed text-ink-soft dark:text-dark-text-soft">{excerpt}</p>}
    </header>

    {cover_image && (
      <div class="mb-10">
        <WatchImage src={cover_image} alt={title} ratio="16/9" eager />
      </div>
    )}

    <!-- Slot "spec" — bảng thông số kỹ thuật (dùng cho trang chi tiết mẫu iconic).
         Đặt giữa phần tóm tắt/ảnh bìa và nội dung bài. Nếu trang không truyền
         slot này thì không hiện gì. -->
    <slot name="spec" />

    <!-- Nội dung Markdown được chèn vào đây -->
    <div class="prose-content text-ink dark:text-dark-text">
      <slot />
    </div>

    <!-- Khối nguồn tham khảo — đặt ngay sau nội dung, trước khối "Đọc tiếp" -->
    <SourceList sources={sources} />

    <!-- Khối "Đọc tiếp" — gợi ý bài liên quan (chỉ 4 collection, không cho thương hiệu) -->
    {relatedArticles.length > 0 && (
      <RelatedArticles items={relatedArticles} />
    )}

    <!-- Link "Đặt cạnh mẫu khác" — dẫn sang /so-sanh với mẫu hiện tại đã chọn -->
    {compareHref && (
      <a href={compareHref} class="mt-10 inline-flex items-center gap-2 rounded-lg border border-brass/40 bg-brass/5 px-4 py-2.5 text-sm font-medium text-brass transition-colors hover:bg-brass/10 dark:border-dark-brass/40 dark:bg-dark-brass/5 dark:text-dark-brass dark:hover:bg-dark-brass/10">
        ⚖ Đặt cạnh mẫu khác →
      </a>
    )}

    <!-- Nút "Quay lại danh sách" — chuyển từ đầu bài xuống cuối, đặt dưới khối Đọc tiếp -->
    {backHref && (
      <a href={localizedPath(backHref, lang)} class="mt-12 inline-block text-sm text-ink-soft transition-colors hover:text-brass dark:text-dark-text-soft dark:hover:text-dark-brass">
        {tr.back_to_list}
      </a>
    )}
  </article>
</BaseLayout>
