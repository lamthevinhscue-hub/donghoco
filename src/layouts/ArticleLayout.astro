---
// =============================================================================
// ARTICLE LAYOUT (Bộ khung cho bài viết chi tiết)
// =============================================================================
// Dùng cho trang chi tiết của: mẫu iconic, thương hiệu, cơ chế, hướng dẫn...
// Hiển thị tiêu đề lớn, thông tin phụ, ảnh bìa, rồi đến nội dung Markdown.
// =============================================================================

import BaseLayout from './BaseLayout.astro';
import WatchImage from '../components/WatchImage.astro';
import RelatedArticles, { type RelatedItem } from '../components/RelatedArticles.astro';
import { getLangFromUrl, t, localizedPath } from '../i18n/ui';

interface Props {
  title: string;
  excerpt?: string;
  date?: string;
  cover_image?: string;
  /** Đường dẫn về trang danh sách (không tính tiền tố ngôn ngữ) */
  backHref?: string;
  /** Thông tin phụ hiển thị ngay dưới tiêu đề */
  meta?: string;
  /** Các bài gợi ý cho khối "Đọc tiếp" (tối đa 3, tự tính ở trang slug) */
  relatedArticles?: RelatedItem[];
}

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);

const { title, excerpt, date, cover_image, backHref, meta, relatedArticles = [] } = Astro.props;

// Breadcrumb + Article schema cho SEO
const breadcrumbData = backHref ? [
  { name: 'Đồng Hồ Cơ', path: '/' },
  { name: backHref.replace('/', '').replace(/-/g, ' '), path: backHref },
  { name: title, path: Astro.url.pathname },
] : undefined;

const articleData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  datePublished: date,
  inLanguage: 'vi-VN',
};

// Định dạng ngày thân thiện với tiếng Việt
const formattedDate = date
  ? new Date(date).toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<BaseLayout title={title} description={excerpt} cover_image={cover_image} breadcrumb={breadcrumbData} articleSchema={articleData}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-8">
      <h1 class="font-serif text-4xl leading-tight text-navy sm:text-5xl dark:text-dark-text">{title}</h1>

      {(meta || formattedDate) && (
        <p class="mt-4 text-sm uppercase tracking-wider text-ink-soft/70 dark:text-dark-text-soft/70">
          {[meta, formattedDate].filter(Boolean).join(' • ')}
        </p>
      )}

      {excerpt && <p class="mt-4 text-lg italic leading-relaxed text-ink-soft dark:text-dark-text-soft">{excerpt}</p>}
    </header>

    {cover_image && (
      <div class="mb-10">
        <WatchImage src={cover_image} alt={title} ratio="16/9" eager />
      </div>
    )}

    <!-- Nội dung Markdown được chèn vào đây -->
    <div class="prose-content text-ink dark:text-dark-text">
      <slot />
    </div>

    <!-- Khối "Đọc tiếp" — gợi ý bài liên quan (chỉ 4 collection, không cho thương hiệu) -->
    {relatedArticles.length > 0 && (
      <RelatedArticles items={relatedArticles} />
    )}

    <!-- Nút "Quay lại danh sách" — chuyển từ đầu bài xuống cuối, đặt dưới khối Đọc tiếp -->
    {backHref && (
      <a href={localizedPath(backHref, lang)} class="mt-12 inline-block text-sm text-ink-soft transition-colors hover:text-brass dark:text-dark-text-soft dark:hover:text-dark-brass">
        {tr.back_to_list}
      </a>
    )}
  </article>
</BaseLayout>
