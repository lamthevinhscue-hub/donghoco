---
// =============================================================================
// BASE LAYOUT (Bộ khung chung của mọi trang)
// =============================================================================
// Mọi trang trên website đều được bao bọc bởi bộ khung này. Nó chứa:
//   - Phần <head>: thông tin kỹ thuật, font chữ, tiêu đề trang
//   - Thanh menu (Header)
//   - Nội dung riêng của từng trang (nằm ở <slot />)
//   - Chân trang (Footer)
// =============================================================================

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, t, SITE_AUTHOR, SITE_PUBLISHER, getOgImage } from '../i18n/ui';
import Analytics from '@vercel/analytics/astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  cover_image?: string;
  breadcrumb?: { name: string; path: string }[];
  articleSchema?: object;
  /** Ngày xuất bản (từ frontmatter `date`) — bổ sung vào WebSite schema */
  datePublished?: string;
}

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);

const {
  title,
  description = tr.siteTagline,
  cover_image,
  breadcrumb,
  articleSchema,
  datePublished,
} = Astro.props;

// Tiêu đề đầy đủ hiển thị trên tab trình duyệt
const fullTitle = title ? `${title} — ${tr.siteName}` : `${tr.siteName} — ${tr.siteTagline}`;

// Meta description: Google cắt hiện thị ~160 ký tự — excerpt dài hơn sẽ bị cụt lởn.
// Cắt tại ranh giới câu (ưu tiên) hoặc từ, CHỈ áp cho thẻ meta/OG — nội dung hiển
// thị trên trang giữ nguyên excerpt gốc.
function truncateMeta(text: string, max = 165): string {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const lastSentence = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '), cut.lastIndexOf('? '));
  const lastSpace = cut.lastIndexOf(' ');
  const at = lastSentence > 80 ? lastSentence + 1 : lastSpace;
  return cut.slice(0, at).trimEnd() + '…';
}
const metaDescription = description ? truncateMeta(description) : undefined;

// URL đầy đủ (canonical + OG url)
const siteUrl = Astro.site ?? new URL('https://www.kienthucdonghoco.vn');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// OG image: ưu tiên cover_image > ảnh theo khu vực > ảnh mặc định
const ogImage = getOgImage(Astro.url.pathname, cover_image);
const ogImageUrl = new URL(ogImage, siteUrl).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Dark mode: áp dụng trước khi render để tránh flash -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />

    <!-- Ngôn ngữ nội dung -->
    <meta name="language" content={lang} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph (Facebook, Zalo, LinkedIn...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={tr.siteName} />
    <meta property="og:title" content={title ?? tr.siteName} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={ogImage.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
    <meta property="og:image:alt" content={tr.og_image_alt} />
    <meta property="og:locale" content="vi_VN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? tr.siteName} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={tr.og_image_alt} />

    <!-- Structured Data: WebSite schema (cho mọi trang) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: tr.siteName,
      url: siteUrl.href,
      description: tr.siteTagline,
      inLanguage: 'vi-VN',
      author: SITE_AUTHOR,
      publisher: SITE_PUBLISHER,
      copyrightHolder: SITE_PUBLISHER,
      copyrightYear: 2024,
      ...(datePublished ? { datePublished } : {}),
    })} />

    <!-- Structured Data: BreadcrumbList (nếu có breadcrumb) -->
    {breadcrumb && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumb.map((item: any, i: number) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: item.name,
          item: new URL(item.path, siteUrl).href,
        })),
      })} />
    )}

    <!-- Structured Data: Article (nếu là bài viết) -->
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}

    <!-- Tải font từ Google Fonts: Newsreader (tiêu đề, 500-700) + Be Vietnam Pro (nội dung/UI, 400-700).
         Chỉ tải các weight thực dùng; display=swap để chữ hiện ngay bằng font dự phòng. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-cream text-ink dark:bg-dark-bg dark:text-dark-text">
    <!-- Skip link — người dùng bàn phím nhảy thẳng tới nội dung chính (ẩn cho chuột/mắt) -->
    <a href="#main-content" class="skip-link">
      {tr.skip_to_content}
    </a>
    <Header />
    <main id="main-content" tabindex="-1" class="min-w-0 flex-1">
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
    <Analytics />
    <script>
      // Bảng rộng: bọc trong vùng cuộn ngang riêng + gắn bóng mờ mép phải và
      // dòng chú thích "kéo ngang" ngay dưới bảng để người dùng mobile biết
      // cuộn. Bảng không tràn thì không thêm gì — tránh tín hiệu sai.
      // Phát hiện theo MÉP PHẢI VIEWPORT (bảng deterministic tràn theo cách
      // scrollWidth == clientWidth nên không so được trên chính bảng).
      // Wrapper (dù tạo ở BUILD bởi rehype hay tạo động ở đây) luôn là vùng
      // region có tên, nhận focus và cuộn được bằng bàn phím (WCAG 2.1.1).
      function ensureWrapAttrs(wrap) {
        if (!wrap.hasAttribute('tabindex')) wrap.setAttribute('tabindex', '0');
        if (!wrap.hasAttribute('role')) wrap.setAttribute('role', 'region');
        if (!wrap.hasAttribute('aria-label')) {
          wrap.setAttribute('aria-label', 'Bảng dữ liệu — dùng phím mũi tên trái và phải để xem thêm cột');
        }
      }

      function markOverflowTables() {
        // Bù thuộc tính cho wrapper sinh tại build (rehype) nếu thiếu
        document.querySelectorAll('main .table-scroll-wrap').forEach(ensureWrapAttrs);
        document.querySelectorAll('main table').forEach((table) => {
          if (table.closest('.table-scroll-wrap')) return; // đã bọc
          const rect = table.getBoundingClientRect();
          const overflowing =
            rect.right > document.documentElement.clientWidth + 4 ||
            table.scrollWidth - table.clientWidth > 4;
          if (!overflowing) return;
          const wrap = document.createElement('div');
          wrap.className = 'table-scroll-wrap overflow-x-auto';
          ensureWrapAttrs(wrap);
          table.parentNode.insertBefore(wrap, table);
          wrap.appendChild(table);
          table.classList.add('table-can-scroll');
          const hint = document.createElement('p');
          hint.className = 'table-scroll-hint';
          hint.setAttribute('aria-hidden', 'true');
          hint.textContent = '← Kéo ngang để xem hết bảng →';
          wrap.insertAdjacentElement('afterend', hint);
        });
      }
      markOverflowTables();
      // Font hiển thị (display=swap) có thể đổi độ rộng chữ sau khi tải — kiểm lại một lần
      window.addEventListener('load', markOverflowTables);

      // ====== Cuộn bảng bằng bàn phím (WCAG 2.1.1) ======
      // Chỉ chặn bốn phím điều hướng này — Tab và mọi phím khác giữ hành vi
      // mặc định của trình duyệt (đi qua link/nút trong bảng như thường).
      document.addEventListener('keydown', (e) => {
        const wrap = e.target instanceof Element ? e.target.closest('.table-scroll-wrap') : null;
        if (!wrap) return;
        const keys = ['ArrowRight', 'ArrowLeft', 'Home', 'End'];
        if (!keys.includes(e.key)) return;
        e.preventDefault();
        const step = Math.max(80, wrap.clientWidth * 0.5);
        if (e.key === 'ArrowRight') wrap.scrollLeft += step;
        else if (e.key === 'ArrowLeft') wrap.scrollLeft -= step;
        else if (e.key === 'Home') wrap.scrollLeft = 0;
        else if (e.key === 'End') wrap.scrollLeft = wrap.scrollWidth;
      });
    </script>
  </body>
</html>
