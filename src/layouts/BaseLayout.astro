---
// =============================================================================
// BASE LAYOUT (Bộ khung chung của mọi trang)
// =============================================================================
// Mọi trang trên website đều được bao bọc bởi bộ khung này. Nó chứa:
//   - Phần <head>: thông tin kỹ thuật, font chữ, tiêu đề trang
//   - Thanh menu (Header)
//   - Nội dung riêng của từng trang (nằm ở <slot />)
//   - Chân trang (Footer)
// =============================================================================

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, t } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;        // Tiêu đề trang (hiện trên tab trình duyệt)
  description?: string;  // Mô tả ngắn (dùng cho SEO & chia sẻ mạng xã hội)
  cover_image?: string;  // Ảnh bìa (dùng cho Open Graph + Twitter Card)
}

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);

const {
  title,
  description = tr.siteTagline,
  cover_image,
} = Astro.props;

// Tiêu đề đầy đủ hiển thị trên tab trình duyệt
const fullTitle = title ? `${title} — ${tr.siteName}` : `${tr.siteName} — ${tr.siteTagline}`;

// URL đầy đủ (canonical + OG url)
const siteUrl = Astro.site ?? new URL('https://donghoco1.vercel.app');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// OG image: ưu tiên cover_image của trang, fallback ảnh mặc định
const ogImage = cover_image ?? '/og-default.jpg';
const ogImageUrl = new URL(ogImage, siteUrl).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Ngôn ngữ nội dung -->
    <meta name="language" content={lang} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph (Facebook, Zalo, LinkedIn...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={tr.siteName} />
    <meta property="og:title" content={title ?? tr.siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="vi_VN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? tr.siteName} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Tải font từ Google Fonts: Playfair Display (tiêu đề) + Inter (nội dung) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
