---
// =============================================================================
// BRAND LAYOUT — Template trang thương hiệu thế hệ mới (5 khối)
// =============================================================================
// Mỗi trang thương hiệu trở thành "hồ sơ sưu tầm" hoàn chỉnh:
//   1. Hồ sơ nhanh (quick profile) — quốc gia, năm, phân khúc, tập đoàn, calibre
//   2. Dòng chảy lịch sử (mini-timeline dọc)
//   3. Các dòng đồng hồ (collections)
//   4. Đối chiếu cùng phân khúc (segment comparison table)
//   5. Mẫu iconic liên quan (tự kéo từ mauIconic)
//
// Tuân thủ KẾ HOẠCH HOÀN THIỆN Bước 2.1.
// =============================================================================

import BaseLayout from './BaseLayout.astro';
import MiniTimeline from '../components/MiniTimeline.astro';
import WatchImage from '../components/WatchImage.astro';
import { getLangFromUrl, t, localizedPath } from '../i18n/ui';

interface IconicModel {
  title: string;
  slug: string;
  excerpt: string;
  category?: string;
  year?: number;
  cover_image?: string;
}

interface Props {
  title: string;
  excerpt?: string;
  meta?: string;
  data: any; // Toàn bộ frontmatter thương hiệu
  iconicModels?: IconicModel[]; // Khối 5: mẫu iconic liên quan
}

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);
const { title, excerpt, meta, data, iconicModels = [] } = Astro.props;

// Nhãn dịch phân khúc
const tierLabels: Record<string, string> = {
  'haute horlogerie': 'Haute Horlogerie (đỉnh cao chế tác)',
  'ultra luxury': 'Ultra Luxury (siêu sang)',
  'high-end luxury': 'High-End Luxury (sang trọng cao cấp)',
  'mid-range luxury': 'Mid-Range Luxury (sang trọng tầm trung)',
  'entry-level luxury': 'Entry-Level Luxury (nhập môn sang trọng)',
  consumer: 'Consumer (phổ thông)',
  microbrand: 'Microbrand (indie nhỏ)',
};
const tierLabel = tierLabels[data.tier] || data.tier;
---

<BaseLayout title={title} description={excerpt}>
  <article class="mx-auto max-w-4xl px-4 py-8 sm:py-12">
    <!-- Quay lại -->
    <a href={localizedPath('/thuong-hieu', lang)} class="mb-6 inline-block text-sm text-ink-soft transition-colors hover:text-brass">
      {tr.back_to_list}
    </a>

    <!-- ====== HEADER ====== -->
    <header class="mb-10">
      <h1 class="font-serif text-4xl leading-tight text-navy sm:text-5xl">{title}</h1>
      {meta && (
        <p class="mt-3 text-sm uppercase tracking-wider text-ink-soft/70">{meta}</p>
      )}
      {excerpt && <p class="mt-4 text-lg italic leading-relaxed text-ink-soft">{excerpt}</p>}
    </header>

    <!-- ====== KHỐI 1: HỒ SƠ NHANH (Quick Profile) ====== -->
    <section class="mb-12" data-block="quick-profile">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Quốc gia -->
        <div class="rounded-lg border border-cream-dark bg-white p-4">
          <p class="text-xs uppercase tracking-wider text-ink-soft/60">Quốc gia</p>
          <p class="mt-1 font-serif text-lg text-navy">{data.country}</p>
        </div>
        <!-- Năm thành lập -->
        {data.founded && (
          <div class="rounded-lg border border-cream-dark bg-white p-4">
            <p class="text-xs uppercase tracking-wider text-ink-soft/60">Thành lập</p>
            <p class="mt-1 font-serif text-lg text-navy">{data.founded} <span class="text-sm text-ink-soft">({new Date().getFullYear() - data.founded} năm)</span></p>
          </div>
        )}
        <!-- Tập đoàn mẹ -->
        {data.parent_company && (
          <div class="rounded-lg border border-cream-dark bg-white p-4">
            <p class="text-xs uppercase tracking-wider text-ink-soft/60">Tập đoàn mẹ</p>
            <p class="mt-1 font-serif text-lg text-navy">{data.parent_company}</p>
          </div>
        )}
        <!-- Phân khúc -->
        <div class="rounded-lg border-l-4 border-brass bg-brass/5 p-4">
          <p class="text-xs uppercase tracking-wider text-ink-soft/60">Phân khúc</p>
          <p class="mt-1 font-serif text-base font-medium text-navy">{tierLabel}</p>
        </div>
        <!-- Calibre tiêu biểu -->
        {data.signature_calibres && data.signature_calibres.length > 0 && (
          <div class="rounded-lg border border-cream-dark bg-white p-4 sm:col-span-2">
            <p class="text-xs uppercase tracking-wider text-ink-soft/60">Bộ máy in-house tiêu biểu</p>
            <div class="mt-2 flex flex-wrap gap-2">
              {data.signature_calibres.map((c: string) => (
                <span class="rounded-full bg-navy/10 px-3 py-1 text-xs font-medium text-navy">Calibre {c}</span>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- ====== SLOT: Nội dung Markdown gốc (giữ phần giới thiệu tổng quan) ====== -->
    <section class="mb-12 prose-content text-ink">
      <slot />
    </section>

    <!-- ====== KHỐI 2: DÒNG CHẢY LỊCH SỬ (Mini Timeline) ====== -->
    {data.lineHistory && data.lineHistory.length > 0 && (
      <section class="mb-12" data-block="line-history">
        <h2 class="mb-6 flex items-center gap-3 font-serif text-2xl text-navy">
          <span class="text-brass">⑵</span> Dòng chảy lịch sử
        </h2>
        <p class="mb-6 text-sm leading-relaxed text-ink-soft">
          Từ ngày thành lập đến hôm nay — các cột mốc định hình nên <strong>{title}</strong> của chúng ta ngày nay.
        </p>
        <MiniTimeline milestones={data.lineHistory} />
      </section>
    )}

    <!-- ====== KHỐI 3: CÁC DÒNG ĐỒNG HỒ (Collections) ====== -->
    {data.collections && data.collections.length > 0 && (
      <section class="mb-12" data-block="collections">
        <h2 class="mb-6 flex items-center gap-3 font-serif text-2xl text-navy">
          <span class="text-brass">⑶</span> Các dòng đồng hồ
        </h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {data.collections.map((col: any) => (
            <div class="rounded-lg border border-cream-dark bg-white p-5 transition-shadow hover:shadow-md">
              <div class="mb-2 flex items-baseline justify-between gap-2">
                <h3 class="font-serif text-lg text-navy">{col.name}</h3>
                {col.year && <span class="shrink-0 text-xs font-medium text-brass">{col.year}</span>}
              </div>
              <p class="text-sm leading-relaxed text-ink-soft">{col.identity}</p>
              <p class="mt-2 text-xs italic text-ink-soft/70">📍 {col.positioning}</p>
              {col.iconic_ref && (
                <p class="mt-2 text-xs font-medium text-navy">★ Mẫu tiêu biểu: {col.iconic_ref}</p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ====== KHỐI 4: ĐỐI CHIẾU CÙNG PHÂN KHÚC (Segment Comparison) ====== -->
    {data.segmentComparison && data.segmentComparison.length > 0 && (
      <section class="mb-12" data-block="segment-comparison">
        <h2 class="mb-2 flex items-center gap-3 font-serif text-2xl text-navy">
          <span class="text-brass">⑷</span> Đối chiếu cùng phân khúc
        </h2>
        <p class="mb-6 text-sm leading-relaxed text-ink-soft">
          So sánh khách quan với các thương hiệu cùng hạng — để bạn chọn đúng cho nhu cầu của mình.
        </p>

        <!-- Bảng so sánh -->
        <div class="overflow-x-auto rounded-lg border border-cream-dark">
          <table class="w-full min-w-[640px] text-left text-sm">
            <thead class="bg-navy text-cream">
              <tr>
                <th class="px-4 py-3 font-medium">Tiêu chí</th>
                {data.segmentComparison.map((c: any) => (
                  <th class="px-4 py-3 font-medium">
                    {c.slug
                      ? <a href={`/thuong-hieu/${c.slug}`} class="underline-offset-2 hover:underline">{c.brand}</a>
                      : c.brand}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-cream-dark bg-white">
              <tr>
                <td class="px-4 py-3 font-medium text-ink-soft">Thế mạnh chế tác</td>
                {data.segmentComparison.map((c: any) => <td class="px-4 py-3 text-ink">{c.strength}</td>)}
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink-soft">Bộ máy</td>
                {data.segmentComparison.map((c: any) => <td class="px-4 py-3 text-ink">{c.movement}</td>)}
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink-soft">Giá trị giữ giá</td>
                {data.segmentComparison.map((c: any) => <td class="px-4 py-3 text-ink">{c.value_retention}</td>)}
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink-soft">Triết lý</td>
                {data.segmentComparison.map((c: any) => <td class="px-4 py-3 text-ink">{c.philosophy}</td>)}
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Nhận định nhà sưu tầm -->
        {data.collectorNote && (
          <div class="mt-6 rounded-lg border-l-4 border-brass bg-brass/5 p-5">
            <h4 class="mb-2 flex items-center gap-2 text-sm font-bold text-navy">
              🎩 Góc nhìn nhà sưu tầm — chọn khi nào?
            </h4>
            <p class="text-sm leading-relaxed text-ink-soft">{data.collectorNote}</p>
          </div>
        )}
      </section>
    )}

    <!-- ====== KHỐI 5: MẪU ICONIC LIÊN QUAN ====== -->
    {iconicModels.length > 0 && (
      <section class="mb-12" data-block="iconic-models">
        <h2 class="mb-6 flex items-center gap-3 font-serif text-2xl text-navy">
          <span class="text-brass">⑸</span> Mẫu iconic của {title}
        </h2>
        <div class="grid gap-5 sm:grid-cols-2">
          {iconicModels.map((model) => (
            <a
              href={`/mau-iconic/${model.slug}`}
              class="group flex gap-4 rounded-lg border border-cream-dark bg-white p-4 transition-all hover:border-brass hover:shadow-md"
            >
              <!-- Ảnh / placeholder -->
              <div class="h-20 w-20 shrink-0 overflow-hidden rounded-lg bg-cream-dark/30">
                {model.cover_image
                  ? <img src={model.cover_image} alt={model.title} class="h-full w-full object-cover" loading="lazy" />
                  : <WatchImage alt={model.title} class="h-full w-full" />}
              </div>
              <!-- Nội dung -->
              <div class="min-w-0 flex-1">
                <h3 class="font-serif text-base leading-tight text-navy group-hover:text-brass">
                  {model.title}
                </h3>
                {model.category && (
                  <span class="mt-1 inline-block rounded-full bg-navy/10 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-navy">
                    {model.category}
                  </span>
                )}
                <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-ink-soft">{model.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {iconicModels.length === 0 && (
      <section class="mb-12 rounded-lg border border-dashed border-cream-dark bg-cream-dark/10 p-6 text-center text-sm text-ink-soft/60">
        📝 Chưa có mẫu iconic nào của {title} trên website. Sẽ được bổ sung sau.
      </section>
    )}
  </article>
</BaseLayout>
