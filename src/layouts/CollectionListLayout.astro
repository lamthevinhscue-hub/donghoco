---
// =============================================================================
// COLLECTION LIST LAYOUT (Bộ khung trang danh sách)
// =============================================================================
// Dùng chung cho các trang liệt kê: /thuong-hieu, /mau-iconic, /co-che...
// Chỉ cần truyền vào tiêu đề, mô tả, danh sách bài, và cấu hình thẻ.
// =============================================================================

import BaseLayout from './BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import { getCollectionRoute, getSlug, type ContentCollectionName } from '../lib/content';
import { getLangFromUrl, t, localizedPath } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  collection: ContentCollectionName;
  title: string;
  description: string;
  entries: CollectionEntry<ContentCollectionName>[];
  /** Hàm trích xuất thông tin phụ (meta) cho mỗi thẻ — có thể bỏ qua */
  getMeta?: (entry: CollectionEntry<ContentCollectionName>) => string | undefined;
  /** Hàc trích xuất nhãn (badge) cho mỗi thẻ */
  getBadge?: (entry: CollectionEntry<ContentCollectionName>) => string | undefined;
}

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const { collection, title, description, entries, getMeta, getBadge } = Astro.props;
const route = getCollectionRoute(collection);
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <SectionHeading title={title} subtitle={description} />

    {entries.length === 0 ? (
      <p class="py-12 text-center text-ink-soft">
        {lang === 'vi'
          ? 'Chưa có bài viết nào trong mục này. Hãy quay lại sau!'
          : 'No articles yet. Please check back later!'}
      </p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {entries.map((entry) => (
          <Card
            href={`${route}/${getSlug(entry)}`}
            title={entry.data.title}
            excerpt={entry.data.excerpt}
            meta={getMeta?.(entry)}
            badge={getBadge?.(entry)}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
