---
// Trang: 404 (không tìm thấy trang)
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, localizedPath } from '../i18n/ui';

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const isVi = lang === 'vi';
---

<BaseLayout title="404">
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center">
    <p class="font-serif text-7xl text-brass">404</p>
    <h1 class="mt-4 font-serif text-3xl text-navy">
      {isVi ? 'Không tìm thấy trang' : 'Page not found'}
    </h1>
    <p class="mt-3 text-ink-soft">
      {isVi
        ? 'Trang bạn tìm có thể đã bị di chuyển hoặc không tồn tại.'
        : 'The page you are looking for may have moved or does not exist.'}
    </p>
    <a
      href={localizedPath('/', lang)}
      class="mt-8 rounded-lg bg-navy px-6 py-3 font-medium text-cream transition-colors hover:bg-brass"
    >
      {isVi ? '← Về trang chủ' : '← Back home'}
    </a>
  </section>
</BaseLayout>
