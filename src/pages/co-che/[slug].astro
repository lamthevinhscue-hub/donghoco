---
// Trang chi tiết: CƠ CHẾ HOẠT ĐỘNG (tiếng Việt — /co-che/[slug])
// Thân trang nằm ở template dùng chung src/components/templates/MechanismArticle.astro
// (wrapper tiếng Anh: /en/mechanisms/[slug]). Route này chỉ sinh bản tiếng Việt.
import MechanismArticle from '../../components/templates/MechanismArticle.astro';
import { getEntriesByLang, getSlug } from '../../lib/content';
import type { Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  const lang: Lang = 'vi';
  const entries = await getEntriesByLang('coChe', lang);
  return entries.map((entry) => ({
    params: { slug: getSlug(entry) },
    props: { slug: getSlug(entry), lang },
  }));
}

const { slug, lang } = Astro.props as { slug: string; lang: Lang };
---

<MechanismArticle slug={slug} lang={lang} />
