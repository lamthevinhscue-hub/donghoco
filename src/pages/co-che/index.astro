---
// Trang danh sách: CƠ CHẾ HOẠT ĐỘNG (Trụ cột 3 - infographic)
import CollectionListLayout from '../../layouts/CollectionListLayout.astro';
import { getEntriesByLang } from '../../lib/content';
import { getLangFromUrl } from '../../i18n/ui';

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const entries = await getEntriesByLang('coChe', lang);
---

<CollectionListLayout
  collection="coChe"
  title={lang === 'vi' ? 'Cơ chế hoạt động' : 'How it works'}
  description={lang === 'vi'
    ? 'Hiểu sâu về cách đồng hồ cơ đập, lên dây và đo thời gian. Infographic động sẽ được thêm dần ở giai đoạn 2.'
    : 'Go deep into how mechanical watches tick, wind and keep time. Interactive infographics coming in phase 2.'}
  entries={entries}
  getMeta={(e) => e.data.category}
  getBadge={(e) => (e.data.has_infographic ? (lang === 'vi' ? 'Có infographic' : 'Infographic') : undefined)}
/>
