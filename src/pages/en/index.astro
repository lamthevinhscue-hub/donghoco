---
// Trang /en/ — thông báo tiếng Anh đang chuẩn bị, dẫn về tiếng Việt
// Trang này tồn tại để: nếu ai vào /en/ (qua link cũ, nút cũ) sẽ thấy thông báo
// thay vì trang lỗi trắng.
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="English — Coming Soon">
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center">
    <div class="mb-3 h-1 w-12 rounded bg-brass"></div>
    <h1 class="font-serif text-3xl text-navy sm:text-4xl">English — Coming Soon</h1>
    <p class="mt-4 text-ink-soft">
      The English version of this website is being prepared. Vietnamese content is
      currently the main language.
    </p>
    <p class="mt-2 text-sm text-ink-soft/70">
      Phiên bản tiếng Anh đang được chuẩn bị. Tạm thời nội dung chính bằng tiếng Việt.
    </p>
    <a
      href="/"
      class="mt-8 rounded-lg bg-navy px-6 py-3 font-medium text-cream transition-colors hover:bg-brass"
    >
      ← Về trang chủ / Back to home
    </a>
  </section>
</BaseLayout>
