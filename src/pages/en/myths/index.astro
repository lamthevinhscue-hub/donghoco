---
// Series hub: "Mechanical Watch Myths" (package U1, English)
// Lists only huongDan articles carrying the `hieu-dung` tag.
// With no tagged articles yet, an honest empty state is shown.
// Route thẻ bài EN: /en/guides/<slug>/ (không dùng getCollectionRoute — nó
// trả cố định route VI /huong-dan).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import Card from '../../../components/Card.astro';
import { getEntriesByLang, getSlug, isEntryOf } from '../../../lib/content';
import { t } from '../../../i18n/ui';

const tr = t('en');
const entries = (await getEntriesByLang('huongDan', 'en'))
  .filter(isEntryOf('huongDan'))
  .filter((entry) => entry.data.tags?.includes('hieu-dung'));
---

<BaseLayout title={tr.hieudung_hub_title} description={tr.hieudung_hub_description}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <SectionHeading title={tr.hieudung_hub_title} level={1} subtitle={tr.hieudung_hub_description} />

    {entries.length === 0 ? (
      <p class="py-12 text-center text-ink-soft dark:text-dark-text-soft">
        {tr.hieudung_empty}
      </p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {entries.map((entry) => (
          <Card
            href={`/en/guides/${getSlug(entry)}/`}
            title={entry.data.title}
            excerpt={entry.data.excerpt}
            image={entry.data.cover_image}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
