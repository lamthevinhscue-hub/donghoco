---
// Trang chi tiết: HƯỚNG DẪN THỰC HÀNH (tiếng Việt — /huong-dan/[slug])
// Thân trang nằm ở template dùng chung src/components/templates/GuideArticle.astro
// (wrapper tiếng Anh: /en/guides/[slug]). Route này chỉ sinh bản tiếng Việt.
import GuideArticle from '../../components/templates/GuideArticle.astro';
import { getEntriesByLang, getSlug } from '../../lib/content';
import type { Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  const lang: Lang = 'vi';
  const entries = await getEntriesByLang('huongDan', lang);
  return entries.map((entry) => ({
    params: { slug: getSlug(entry) },
    props: { slug: getSlug(entry), lang },
  }));
}

const { slug, lang } = Astro.props as { slug: string; lang: Lang };
---

<GuideArticle slug={slug} lang={lang} />
