---
// =============================================================================
// TRANG CHỦ — "Hồ sơ calibre của người thợ đồng hồ"
// =============================================================================
// Cấu trúc (nhẹ dần từ giá trị cốt lõi ra thông tin phụ):
//   1. Hero: value proposition + 2 CTA + chỉ dấu thư viện (số đếm động, 1 dòng)
//   2. Calibre Map: sơ đồ dòng năng lượng qua 5 khâu — mỗi khâu là link thật
//   3. Chọn lộ trình: người mới / đi sâu bộ máy
//   4. Hồ sơ được biên tập chọn: danh sách slug cố định, không slice ngẫu nhiên
//   5. Dải mốc lịch sử + tường thương hiệu (giữ từ bản cũ)
//   6. Khối độ tin cậy: "Thà thiếu còn hơn sai"
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CalibreMap from '../components/CalibreMap.astro';
import { getEntriesByLang, getCollectionRoute, getSlug } from '../lib/content';
import { getLangFromUrl, t, localizedPath } from '../i18n/ui';
import timelineData from '../data/timeline.json';

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);
const isVi = lang === 'vi';

// Số đếm chỉ dấu thư viện (đếm động từ collection — phục vụ định vị, không phô trương)
const allBrands = await getEntriesByLang('thuongHieu', lang);
const allIconics = await getEntriesByLang('mauIconic', lang);
const allMechanisms = await getEntriesByLang('coChe', lang);
const allGlossary = await getEntriesByLang('tuDien', lang);
const heroCounts = tr.hero_counts
  .replace('{brands}', String(allBrands.length))
  .replace('{iconics}', String(allIconics.length))
  .replace('{mechanisms}', String(allMechanisms.length))
  .replace('{glossary}', String(allGlossary.length));

// ====== Hồ sơ nổi bật: chọn tay theo slug, giữ đúng thứ tự biên tập ======
// Không dùng slice(0, 3) — nếu sau này đổi danh sách, chỉ sửa mảng này.
const FEATURED_SLUGS = ['rolex-submariner', 'omega-speedmaster', 'cartier-tank'] as const;
const featured = FEATURED_SLUGS.map((slug) => {
  const entry = allIconics.find((e) => getSlug(e) === slug);
  if (!entry) {
    // Cảnh báo lúc build — dễ thấy khi bảo trì, không âm thầm lấy bài khác thay
    console.warn(`[trang chủ] Slug nổi bật "${slug}" không tồn tại trong mauIconic — đã bỏ khỏi danh sách.`);
  }
  return entry;
}).filter((e): e is NonNullable<typeof e> => Boolean(e));
const [featuredLead, ...featuredRest] = featured;

// ====== Hai lộ trình đọc — mọi link đều tới trang đang tồn tại ======
// Nhãn bước lấy từ i18n (tr.path_*_step_N) — không hard-code trong trang.
const pathNew = {
  title: tr.path_new_title,
  desc: tr.path_new_desc,
  cta: tr.path_new_cta,
  ctaHref: '/huong-dan/chon-dong-ho-dau-tien',
  steps: [
    { href: '/huong-dan/chon-dong-ho-dau-tien', label: tr.path_new_step_1 },
    { href: '/co-che/chuyen-dong-co', label: tr.path_new_step_2 },
    { href: '/tu-dien', label: tr.path_new_step_3 },
  ],
};
const pathDeep = {
  title: tr.path_deep_title,
  desc: tr.path_deep_desc,
  cta: tr.path_deep_cta,
  ctaHref: '/co-che/tru-cot',
  steps: [
    { href: '/co-che/tru-cot', label: tr.path_deep_step_1 },
    { href: '/co-che/chuyen-dong-co', label: tr.path_deep_step_2 },
    { href: '/co-che/bo-thoat', label: tr.path_deep_step_3 },
    { href: '/co-che/day-toc-banh-lac', label: tr.path_deep_step_4 },
  ],
};

// ====== Dải mốc lịch sử: chọn ~6 mốc trải đều (giữ nguyên logic bản cũ) ======
const totalMilestones = timelineData.length;
const pickIndices = totalMilestones > 6
  ? [0, Math.floor(totalMilestones / 5), Math.floor(2 * totalMilestones / 5),
     Math.floor(3 * totalMilestones / 5), Math.floor(4 * totalMilestones / 5),
     totalMilestones - 1]
  : timelineData.map((_, i) => i);
const timelineHighlights = pickIndices
  .filter((idx, i, arr) => arr.indexOf(idx) === i)
  .map((idx) => timelineData[idx])
  .filter(Boolean);
---

<BaseLayout>
  <!-- ===== 1. HERO — value proposition + CTA, không trang trí lớn chắn đường ===== -->
  <section class="border-b border-line bg-surface-tech/50 dark:bg-dark-surface/30">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <div class="max-w-3xl">
        <h1 class="font-serif text-3xl leading-tight text-navy dark:text-dark-text sm:text-5xl">
          {tr.hero_title}
        </h1>
        <p class="mt-5 text-base leading-relaxed text-ink-soft dark:text-dark-text-soft sm:text-lg">
          {tr.hero_lead}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={localizedPath('/huong-dan/chon-dong-ho-dau-tien', lang)}
            class="inline-flex min-h-11 items-center rounded-lg bg-navy px-5 py-2.5 text-sm font-semibold text-cream transition-colors hover:bg-steel dark:bg-steel dark:text-cream dark:hover:bg-steel/80"
          >
            {tr.cta_start}
          </a>
          <a
            href={localizedPath('/co-che/chuyen-dong-co', lang)}
            class="inline-flex min-h-11 items-center rounded-lg border-2 border-navy px-5 py-2 text-sm font-semibold text-navy transition-colors hover:border-brass hover:text-brass dark:border-steel dark:text-dark-text dark:hover:border-dark-brass dark:hover:text-dark-brass"
          >
            {tr.cta_mechanism}
          </a>
          <a
            href={localizedPath('/tu-dien', lang)}
            class="ml-1 inline-flex min-h-11 items-center px-2 text-sm font-medium text-steel underline-offset-4 transition-colors hover:text-brass hover:underline dark:text-steel dark:hover:text-dark-brass"
          >
            {tr.cta_glossary} →
          </a>
        </div>
        <!-- Chỉ dấu thư viện: một dòng chữ thay cho khối số liệu lớn -->
        <p class="mt-8 text-base leading-relaxed text-ink-soft/90 dark:text-dark-text-soft/70">
          {heroCounts}
        </p>
      </div>
    </div>
  </section>

  <!-- ===== 2. CALIBRE MAP ===== -->
  <CalibreMap />

  <!-- ===== 3. CHỌN LỘ TRÌNH — hai hướng, mỗi bước là link thật ===== -->
  <section class="mx-auto max-w-6xl px-4 pb-14" aria-labelledby="paths-title">
    <h2 id="paths-title" class="font-serif text-2xl text-navy dark:text-dark-text sm:text-3xl">
      {tr.paths_title}
    </h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {[pathNew, pathDeep].map((path) => (
        <div class="rounded-xl border border-line bg-surface-raised p-6 dark:border-dark-border dark:bg-dark-surface">
          <h3 class="font-serif text-xl text-navy dark:text-dark-text">{path.title}</h3>
          <p class="mt-2 text-base leading-relaxed text-ink-soft dark:text-dark-text-soft">{path.desc}</p>
          <ol class="mt-5 space-y-2">
            {path.steps.map((step, i) => (
              <li>
                <a
                  href={localizedPath(step.href, lang)}
                  class="group flex min-h-11 items-center gap-3 rounded-lg px-2 py-1.5 transition-colors hover:bg-brass/10 dark:hover:bg-dark-brass/15"
                >
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-steel font-mono text-xs font-semibold text-steel dark:border-steel" style="font-variant-numeric: lining-nums;">{i + 1}</span>
                  <span class="text-base font-medium text-ink group-hover:text-brass dark:text-dark-text dark:group-hover:text-dark-brass">{step.label}</span>
                  <span class="ml-auto text-alloy transition-transform group-hover:translate-x-1 dark:text-dark-brass" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
          <a
            href={localizedPath(path.ctaHref, lang)}
            class="mt-4 inline-flex min-h-11 items-center rounded-lg bg-navy px-4 py-2 text-sm font-semibold text-cream transition-colors hover:bg-steel dark:bg-steel dark:hover:bg-steel/80"
          >
            {path.cta}
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== 4. HỒ SƠ ĐƯỢC BIÊN TẬP CHỌN — slug cố định, đúng thứ tự ===== -->
  {featured.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 pb-14" aria-labelledby="featured-title">
      <SectionHeading title={tr.featured_title} subtitle={tr.featured_desc} />
      <div class="grid gap-6 lg:grid-cols-3">
        {featuredLead && (
          <article class="flex flex-col rounded-xl border-2 border-brass/40 bg-surface-raised p-7 dark:border-dark-brass/40 dark:bg-dark-surface lg:col-span-2">
            {featuredLead.data.year && (
              <span class="font-mono text-sm font-semibold text-ruby" style="font-variant-numeric: lining-nums;">{featuredLead.data.year}</span>
            )}
            <h3 class="mt-1 font-serif text-2xl leading-tight text-navy dark:text-dark-text sm:text-3xl">
              <a href={`${getCollectionRoute('mauIconic')}/${getSlug(featuredLead)}`} class="transition-colors hover:text-brass dark:hover:text-dark-brass">
                {featuredLead.data.title}
              </a>
            </h3>
            <p class="mt-1 text-xs uppercase tracking-wider text-ink-soft/90 dark:text-dark-text-soft/70">{featuredLead.data.brand}</p>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-soft dark:text-dark-text-soft">{featuredLead.data.excerpt}</p>
            <a
              href={`${getCollectionRoute('mauIconic')}/${getSlug(featuredLead)}`}
              class="mt-auto inline-flex min-h-11 items-center self-start pt-4 text-sm font-semibold text-steel transition-colors hover:text-brass dark:hover:text-dark-brass"
            >
              {tr.read_more} →
            </a>
          </article>
        )}
        {featuredRest.map((entry) => (
          <article class="flex flex-col rounded-xl border border-line bg-surface-raised p-6 dark:border-dark-border dark:bg-dark-surface">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-serif text-lg leading-tight text-navy dark:text-dark-text">
                <a href={`${getCollectionRoute('mauIconic')}/${getSlug(entry)}`} class="transition-colors hover:text-brass dark:hover:text-dark-brass">
                  {entry.data.title}
                </a>
              </h3>
              {entry.data.year && (
                <span class="shrink-0 font-mono text-xs font-semibold text-ruby" style="font-variant-numeric: lining-nums;">{entry.data.year}</span>
              )}
            </div>
            <p class="mt-1 text-xs uppercase tracking-wider text-ink-soft/90 dark:text-dark-text-soft/70">{entry.data.brand}</p>
            <p class="mt-3 line-clamp-3 text-base leading-relaxed text-ink-soft dark:text-dark-text-soft">{entry.data.excerpt}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- ===== 5. DẢI MỐC LỊCH SỬ (giữ từ bản cũ) ===== -->
  {timelineHighlights.length > 0 && (
    <section class="border-y border-line bg-surface-tech/50 py-14 dark:border-dark-border dark:bg-dark-surface/30">
      <div class="mx-auto max-w-6xl px-4">
        <SectionHeading
          title={isVi ? 'Dòng chảy lịch sử' : 'Timeline highlights'}
          subtitle={isVi ? 'Những khoảnh khắc định hình ngành đồng hồ cơ.' : 'Moments that shaped mechanical watchmaking.'}
        />
      </div>
      <div class="timeline-strip mx-auto max-w-6xl px-4">
        <div class="timeline-track flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4">
          {timelineHighlights.map((m) => (
            <a
              href={localizedPath('/lich-su', lang)}
              class="group flex w-64 shrink-0 snap-start flex-col rounded-xl border border-line bg-surface-raised p-5 transition-all hover:border-brass hover:shadow-lg dark:border-dark-border dark:bg-dark-surface dark:hover:border-dark-brass"
            >
              <span class="font-mono text-2xl font-semibold text-brass dark:text-dark-brass" style="font-variant-numeric: lining-nums;">
                {m.year}
              </span>
              <p class="mt-2 line-clamp-2 text-base font-medium text-navy dark:text-dark-text">{m.title}</p>
              <p class="mt-1 line-clamp-3 text-base leading-relaxed text-ink-soft dark:text-dark-text-soft">{m.description}</p>
              <span class="mt-3 text-xs font-medium text-brass dark:text-dark-brass">{isVi ? 'Xem dòng lịch sử →' : 'View timeline →'}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== 6. TƯỜNG THƯƠNG HIỆU (giữ từ bản cũ — nằm cuối, không che lối vào chính) ===== -->
  {allBrands.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-14">
      <SectionHeading
        title={tr.pillar_brands}
        subtitle={tr.pillar_brands_desc}
      />
      <a
        href={localizedPath('/thuong-hieu', lang)}
        class="group block rounded-xl border border-line bg-surface-raised p-6 transition-all hover:border-brass hover:shadow-lg dark:border-dark-border dark:bg-dark-surface dark:hover:border-dark-brass sm:p-8"
      >
        <div class="brand-wall flex flex-wrap gap-x-4 gap-y-2">
          {allBrands.map((entry, i) => (
            <span class="font-serif text-lg text-navy transition-colors group-hover:text-brass dark:text-dark-text dark:group-hover:text-dark-brass sm:text-xl">
              {entry.data.title}{i < allBrands.length - 1 && <span class="text-brass/40 dark:text-dark-brass/40">·</span>}
            </span>
          ))}
        </div>
        <div class="mt-6 flex items-center gap-2 text-sm font-medium text-brass dark:text-dark-brass">
          <span>{isVi ? `Xem tất cả ${allBrands.length} thương hiệu` : `View all ${allBrands.length} brands`}</span>
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </div>
      </a>
    </section>
  )}

  <!-- ===== 7. KHỐI ĐỘ TIN CẬY — không tự nhận điều không có ===== -->
  <section class="border-t border-line dark:border-dark-border">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-2 border-steel text-steel dark:border-steel" aria-hidden="true">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h2 class="font-serif text-xl text-navy dark:text-dark-text">{tr.trust_title}</h2>
          <p class="mt-2 max-w-3xl text-base leading-relaxed text-ink-soft dark:text-dark-text-soft">{tr.trust_body}</p>
          <a href={localizedPath('/ve-chung-toi', lang)} class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-steel underline-offset-4 transition-colors hover:text-brass hover:underline dark:hover:text-dark-brass">
            {tr.trust_link} →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /*
    Dải mốc lịch sử: ẩn thanh cuộn ngang cho gọn, vẫn cuộn được bằng vuốt.
    -webkit-scrollbar: Safari/Chrome; scrollbar-width: Firefox.
  */
  .timeline-track {
    scrollbar-width: thin;
    scrollbar-color: #8A6A35 transparent;
  }
  .timeline-track::-webkit-scrollbar {
    height: 6px;
  }
  .timeline-track::-webkit-scrollbar-track {
    background: transparent;
  }
  .timeline-track::-webkit-scrollbar-thumb {
    background: #8A6A35;
    border-radius: 3px;
  }
  :global(.dark) .timeline-track {
    scrollbar-color: #D0B27B transparent;
  }
  :global(.dark) .timeline-track::-webkit-scrollbar-thumb {
    background: #D0B27B;
  }
</style>
