---
// =============================================================================
// TRANG /lich-su — TIMELINE "300 NĂM ĐỒNG HỒ CƠ ĐEO TAY"
// =============================================================================
// Tính năng "chữ ký số 1" của website — timeline tương tác đầu tiên bằng tiếng Việt
// về lịch sử đồng hồ cơ đeo tay.
//
// Thiết kế:
// - Desktop: cuộn NGANG như dây cót đang nhả đều
// - Mobile: cuộn DỌC (responsive)
// - 3 lớp màu phân loại mốc (máy móc / thương hiệu / văn hóa), bật-tắt được
// - Thẻ hiện dần khi cuộn tới (Intersection Observer)
//
// Dữ liệu 28 mốc lịch sử lấy từ src/data/timeline.json (KHÔNG tự bịa).
// Tuân thủ KẾ HOẠCH HOÀN THIỆN Bước 1.1.
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import WatchImage from '../components/WatchImage.astro';
import timelineData from '../data/timeline.json';

const isVi = true; // trang này chỉ tiếng Việt (en đã ẩn tạm thời)

// Cấu hình 3 lớp phân loại
const layers = [
  {
    id: 'mechanism',
    label: '🔧 Máy móc & cơ chế',
    labelShort: 'Máy móc',
    color: '#2E86AB',        // xanh dương
    bgColor: '#2E86AB',
  },
  {
    id: 'brand',
    label: '🏛 Thương hiệu & mẫu',
    labelShort: 'Thương hiệu',
    color: '#B8893C',        // vàng đồng
    bgColor: '#B8893C',
  },
  {
    id: 'culture',
    label: '🌍 Bối cảnh & văn hóa',
    labelShort: 'Văn hóa',
    color: '#9B2C2C',        // đỏ trầm
    bgColor: '#9B2C2C',
  },
];

const milestones = timelineData as Array<{
  year: string;
  type: string;
  title: string;
  description: string;
  slug: string;
  internalLink: string | null;
}>;
---

<BaseLayout
  title="Lịch sử đồng hồ cơ đeo tay — 300 năm"
  description="Timeline tương tác đầu tiên bằng tiếng Việt về lịch sử đồng hồ cơ đeo tay — từ Peter Henlein (1510) đến kỷ nguyên silicon."
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <!-- Tiêu đề -->
    <div class="mb-3 h-1 w-12 rounded bg-brass"></div>
    <h1 class="font-serif text-3xl text-navy sm:text-5xl">
      300 năm đồng hồ cơ đeo tay
    </h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink-soft">
      Dòng chảy thời gian trên cổ tay con người — từ cỗ máy bỏ túi Nuremberg đến
      kỷ nguyên silicon. <strong>28 mốc</strong> định hình toàn bộ ngành đồng hồ,
      được kể như một nhà sưu tầm đang dẫn bạn đi dọc hành lang lịch sử.
    </p>

    <!-- Thanh điều khiển 3 lớp -->
    <div class="sticky top-16 z-40 mt-8 flex flex-wrap items-center gap-2 rounded-lg border border-cream-dark bg-cream/95 p-3 backdrop-blur">
      <span class="mr-2 text-xs font-medium uppercase tracking-wider text-ink-soft/60">Lọc theo lớp:</span>
      {layers.map((layer) => (
        <button
          type="button"
          data-layer-toggle={layer.id}
          class="layer-btn flex items-center gap-2 rounded-full border-2 px-3 py-1.5 text-xs font-medium transition-all"
          style={`border-color: ${layer.color}; color: ${layer.color};`}
          aria-pressed="true"
        >
          <span class="h-2.5 w-2.5 rounded-full" style={`background-color: ${layer.color};`}></span>
          <span class="hidden sm:inline">{layer.label}</span>
          <span class="sm:hidden">{layer.labelShort}</span>
        </button>
      ))}
      <span class="ml-auto text-xs text-ink-soft/50" id="milestone-count">{milestones.length} mốc</span>
    </div>

    <!-- Hướng dẫn cuộn (desktop) -->
    <p class="mt-6 hidden text-center text-sm text-ink-soft/60 md:block">
      ← Cuộn ngang để xem dòng thời gian →
    </p>
  </section>

  <!-- Timeline -->
  <section class="timeline-track px-4 pb-20" id="timeline">
    <!-- Đường nối (chạy dọc trên mobile, ngang trên desktop) -->
    <div class="timeline-line"></div>

    <div class="timeline-items">
      {milestones.map((m, i) => {
        const layer = layers.find((l) => l.id === m.type) ?? layers[0];
        const imageSrc = `/images/timeline/${m.slug}.jpg`;
        return (
          <article
            class="milestone-card"
            data-anim="card"
            data-type={m.type}
            data-index={i}
          >
            <!-- Điểm trên timeline -->
            <div class="milestone-dot" style={`background-color: ${layer.color};`}></div>

            <!-- Năm -->
            <div class="milestone-year" style={`color: ${layer.color};`}>
              {m.year}
            </div>

            <!-- Thẻ nội dung -->
            <div class="milestone-content rounded-lg border-l-4 bg-white p-5 shadow-sm"
                 style={`border-left-color: ${layer.color};`}>
              <h2 class="mb-2 font-serif text-lg text-navy">{m.title}</h2>

              <!-- Ảnh (dùng WatchImage, hiện placeholder nếu chưa có) -->
              <WatchImage src={imageSrc} alt={m.title} ratio="4/3" />

              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{m.description}</p>

              {m.internalLink && (
                <a
                  href={m.internalLink}
                  class="mt-3 inline-block text-xs font-medium transition-colors hover:underline"
                  style={`color: ${layer.color};`}
                >
                  Đọc chi tiết →
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Chú thích cuối -->
  <section class="mx-auto max-w-3xl px-4 pb-20">
    <div class="rounded-lg border border-brass/30 bg-brass/5 p-5 text-sm text-ink-soft">
      <strong class="text-brass">💡 Ghi chú của nhà sưu tầm:</strong>
      300 năm này không phải đường thẳng — mà là chuỗi <em>phát minh → khủng hoảng → phục hưng</em>.
      Khi đọc, hãy để ý cách các mốc <strong>văn hóa</strong> (chiến tranh, khủng hoảng quartz)
      định hình lại toàn bộ <strong>máy móc</strong> và <strong>thương hiệu</strong>.
    </div>
  </section>
</BaseLayout>

<style>
  /* =============================================================================
     LAYOUT TIMELINE
     - Mobile (mặc định): cuộn DỌC, thẻ xếp chồng
     - Desktop (md+): cuộn NGANG, thẻ xếp ngang như dây cót
     ============================================================================= */

  .timeline-track {
    position: relative;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: #B8893C #F0EAE0;
  }
  .timeline-track::-webkit-scrollbar {
    height: 8px;
  }
  .timeline-track::-webkit-scrollbar-track {
    background: #F0EAE0;
    border-radius: 4px;
  }
  .timeline-track::-webkit-scrollbar-thumb {
    background: #B8893C;
    border-radius: 4px;
  }

  /* Container ngang (desktop) / dọc (mobile) */
  .timeline-items {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding: 2rem 0;
    min-width: min-content;
  }

  /* Đường nối: dọc (mobile) */
  .timeline-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 20px;
    width: 3px;
    background: linear-gradient(to bottom, #B8893C, #F0EAE0);
    border-radius: 2px;
  }

  .milestone-card {
    position: relative;
    padding-left: 50px;
    scroll-snap-align: start;
    max-width: 480px;
  }

  /* Điểm trên timeline */
  .milestone-dot {
    position: absolute;
    left: 11px;
    top: 4px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 3px solid #FAF7F2;
    box-shadow: 0 0 0 2px currentColor;
    z-index: 2;
  }

  .milestone-year {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  /* === DESKTOP: chuyển sang cuộn ngang === */
  @media (min-width: 768px) {
    .timeline-track {
      overflow-x: auto;
      overflow-y: hidden;
      padding-bottom: 1rem;
    }
    .timeline-items {
      flex-direction: row;
      align-items: flex-start;
      gap: 2rem;
      padding: 2rem 0 2rem 2rem;
    }
    /* Đường nối ngang */
    .timeline-line {
      top: 11px;
      left: 0;
      right: 0;
      bottom: auto;
      width: auto;
      height: 3px;
      background: linear-gradient(to right, #B8893C, #F0EAE0);
    }
    .milestone-card {
      padding-left: 0;
      padding-top: 40px;
      max-width: 360px;
      min-width: 320px;
    }
    .milestone-dot {
      left: 50%;
      transform: translateX(-50%);
      top: 2px;
    }
    .milestone-year {
      text-align: center;
    }
  }

  /* === Hoạt ảnh reveal === */
  .milestone-card {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .milestone-card.reveal-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Nút lọc */
  .layer-btn {
    background: transparent;
  }
  .layer-btn[aria-pressed="false"] {
    opacity: 0.35;
  }
  .layer-btn[aria-pressed="false"] .h-2\.5 {
    background: transparent !important;
    border: 1.5px solid currentColor;
  }

  /* Ẩn thẻ khi lớp tắt */
  .milestone-card.layer-hidden {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .milestone-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // =============================================================================
  // JAVASCRIPT TIMELINE
  // 1. Bật/tắt 3 lớp phân loại
  // 2. Reveal thẻ khi cuộn tới (Intersection Observer)
  // =============================================================================

  function initTimeline() {
    const track = document.getElementById('timeline');
    if (!track) return;

    const cards = track.querySelectorAll<HTMLElement>('.milestone-card');
    const toggles = document.querySelectorAll<HTMLButtonElement>('[data-layer-toggle]');
    const countEl = document.getElementById('milestone-count');

    // ---- 1. Bật/tắt lớp ----
    const activeLayers = new Set(['mechanism', 'brand', 'culture']);

    function updateVisibility() {
      let visibleCount = 0;
      cards.forEach((card) => {
        const type = card.dataset.type ?? '';
        const visible = activeLayers.has(type);
        card.classList.toggle('layer-hidden', !visible);
        if (visible) visibleCount++;
      });
      if (countEl) countEl.textContent = `${visibleCount} mốc`;
    }

    toggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        const layerId = btn.dataset.layerToggle ?? '';
        if (activeLayers.has(layerId)) {
          // Không cho tắt hết — luôn giữ ít nhất 1 lớp
          if (activeLayers.size > 1) {
            activeLayers.delete(layerId);
            btn.setAttribute('aria-pressed', 'false');
          }
        } else {
          activeLayers.add(layerId);
          btn.setAttribute('aria-pressed', 'true');
        }
        updateVisibility();
      });
    });

    // ---- 2. Reveal khi cuộn tới ----
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      cards.forEach((c) => c.classList.add('reveal-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, root: track }
      );
      cards.forEach((card) => observer.observe(card));

      // Fallback: hiện tất cả sau 3s
      setTimeout(() => {
        cards.forEach((c) => c.classList.add('reveal-visible'));
      }, 3000);
    }
  }

  initTimeline();
</script>
