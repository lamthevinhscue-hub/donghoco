---
// =============================================================================
// TRANG /lich-su — TIMELINE "500 NĂM ĐỒNG HỒ CƠ ĐEO TAY"
// =============================================================================
// Thiết kế:
// - Bố cục dọc so le hai bên (desktop), một cột (mobile)
// - Đường dọc chạy giữa trang, chấm màu theo lớp
// - Thanh điều hướng dính bên phải, scroll spy đánh dấu mốc đang xem
// - 3 lớp màu phân loại mốc, bật-tắt được
// - Thẻ hiện dần khi cuộn tới (Intersection Observer)
//
// Dữ liệu 28 mốc lịch sử lấy từ src/data/timeline.json.
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import WatchImage from '../components/WatchImage.astro';
import timelineData from '../data/timeline.json';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const isVi = true;

// Cấu hình 3 lớp phân loại
const layers = [
  { id: 'mechanism', label: '🔧 Máy móc & cơ chế', labelShort: 'Máy móc', color: '#2E86AB', bgColor: '#2E86AB' },
  { id: 'brand', label: '🏛 Thương hiệu & mẫu', labelShort: 'Thương hiệu', color: '#B8893C', bgColor: '#B8893C' },
  { id: 'culture', label: '🌍 Bối cảnh & văn hóa', labelShort: 'Văn hóa', color: '#9B2C2C', bgColor: '#9B2C2C' },
];

const milestones = timelineData as Array<{
  year: string;
  type: string;
  title: string;
  description: string;
  slug: string;
  internalLink: string | null;
}>;

// Tạo các mốc nhảy theo thập niên cho thanh điều hướng
const decadeMarks: { label: string; index: number }[] = [];
let lastDecade = '';
milestones.forEach((m, i) => {
  const yearNum = parseInt(m.year);
  if (isNaN(yearNum)) return;
  const decade = Math.floor(yearNum / 50) * 50; // nhóm 50 năm
  const label = decade === Math.floor(yearNum / 100) * 100
    ? `${decade}s`
    : `${decade}–${decade + 49}`;
  if (label !== lastDecade) {
    decadeMarks.push({ label, index: i });
    lastDecade = label;
  }
});
---

<BaseLayout
  title="500 năm chế tác đồng hồ cơ"
  description="Dòng chảy thời gian từ cỗ máy bỏ túi Nuremberg đến kỷ nguyên silicon — hành trình đồng hồ cơ đi từ trong túi áo lên cổ tay con người. 28 mốc định hình toàn bộ ngành, được kể như một nhà sưu tầm đang dẫn bạn đi dọc hành lang lịch sử."
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <!-- Tiêu đề -->
    <div class="mb-3 h-1 w-12 rounded bg-brass"></div>
    <h1 class="timeline-heading font-serif text-3xl text-navy dark:text-dark-text sm:text-5xl">
      500 năm chế tác đồng hồ cơ
    </h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink-soft dark:text-dark-text-soft">
      Dòng chảy thời gian từ cỗ máy bỏ túi Nuremberg đến kỷ nguyên silicon —
      hành trình đồng hồ cơ đi từ trong túi áo lên cổ tay con người.
      <strong>28 mốc</strong> định hình toàn bộ ngành, được kể như một nhà sưu tầm
      đang dẫn bạn đi dọc hành lang lịch sử.
    </p>

    <!-- Thanh điều khiển 3 lớp -->
    <div class="sticky top-16 z-40 mt-8 flex flex-wrap items-center gap-2 rounded-lg border border-cream-dark dark:border-dark-border bg-cream/95 p-3 backdrop-blur">
      <span class="mr-2 text-xs font-medium uppercase tracking-wider text-ink-soft/60 dark:text-dark-text-soft/60">Lọc theo lớp:</span>
      <button
        type="button"
        id="toggle-all"
        class="layer-btn-all flex items-center gap-1.5 rounded-full border-2 px-3 py-1.5 text-xs font-medium transition-all"
        aria-pressed="true"
      >
        Tất cả
      </button>
      {layers.map((layer) => (
        <button
          type="button"
          data-layer-toggle={layer.id}
          class="layer-btn flex items-center gap-2 rounded-full border-2 px-3 py-1.5 text-xs font-medium transition-all"
          style={`--layer-color: ${layer.color}; --layer-bg: ${layer.bgColor};`}
          aria-pressed="true"
        >
          <span class="layer-dot h-2.5 w-2.5 rounded-full" style={`background-color: ${layer.color};`}></span>
          <span class="hidden sm:inline">{layer.label}</span>
          <span class="sm:hidden">{layer.labelShort}</span>
        </button>
      ))}
      <span class="ml-auto text-xs font-medium text-ink-soft/60 dark:text-dark-text-soft/60" id="milestone-count">{milestones.length} mốc</span>
    </div>
  </section>

  <!-- Layout chính: timeline + thanh điều hướng dính -->
  <div class="mx-auto max-w-6xl px-4 lg:flex lg:gap-8 lg:px-4">
    <!-- Timeline -->
    <section class="timeline-track pb-20 flex-1 lg:min-w-0" id="timeline">
      <!-- Đường dọc giữa trang -->
      <div class="timeline-line"></div>

      <div class="timeline-items">
        {milestones.map((m, i) => {
          const layer = layers.find((l) => l.id === m.type) ?? layers[0];
          const imageSrc = existsSync(join(process.cwd(), 'public', 'images', 'timeline', `${m.slug}.jpg`))
            ? `/images/timeline/${m.slug}.jpg`
            : `/images/timeline/${m.slug}.svg`;
          return (
            <article
              class="milestone-card"
              data-anim="card"
              data-type={m.type}
              data-index={i}
              id={`milestone-${i}`}
            >
              <!-- Điểm trên timeline -->
              <div class="milestone-dot" style={`background-color: ${layer.color};`}></div>

              <!-- Thẻ nội dung -->
              <div class="milestone-content rounded-lg border-l-4 bg-white dark:bg-dark-surface p-5 shadow-sm"
                   style={`border-left-color: ${layer.color};`}>
                <!-- Năm -->
                <div class="milestone-year" style={`color: ${layer.color};`}>
                  {m.year}
                </div>

                <h2 class="mb-2 font-serif text-lg text-navy dark:text-dark-text">{m.title}</h2>

                <!-- Ảnh -->
                <WatchImage src={imageSrc} alt={m.title} ratio="4/3" />

                <p class="mt-3 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">{m.description}</p>

                {m.internalLink && (
                  <a
                    href={m.internalLink}
                    class="mt-3 inline-block text-xs font-medium transition-colors hover:underline"
                    style={`color: ${layer.color};`}
                  >
                    Đọc chi tiết →
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Thanh điều hướng dính (desktop) -->
    <aside class="hidden lg:block lg:w-44 lg:shrink-0">
      <nav class="timeline-nav sticky top-32" id="timeline-nav" aria-label="Điều hướng dòng thời gian">
        <p class="mb-3 text-xs font-medium uppercase tracking-wider text-ink-soft/50 dark:text-dark-text-soft/50">Điều hướng</p>
        <ul class="space-y-1">
          {decadeMarks.map((dm) => (
            <li>
              <button
                type="button"
                class="timeline-nav-btn block w-full text-left text-xs text-ink-soft transition-colors hover:text-brass dark:text-dark-text-soft dark:hover:text-dark-brass"
                data-jump-to={dm.index}
              >
                {dm.label}
              </button>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  </div>

  <!-- Nút điều hướng (mobile) -->
  <button type="button" id="timeline-nav-toggle" class="fixed bottom-20 right-4 z-40 flex h-11 w-11 items-center justify-center rounded-full bg-navy text-cream shadow-lg lg:hidden dark:bg-dark-surface dark:text-dark-text dark:border dark:border-dark-border" aria-label="Mở điều hướng dòng thời gian">
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>
  <div id="timeline-nav-mobile" class="fixed bottom-20 right-4 z-50 hidden w-48 rounded-lg border border-cream-dark bg-white p-3 shadow-xl lg:hidden dark:border-dark-border dark:bg-dark-surface">
    <p class="mb-2 text-xs font-medium uppercase tracking-wider text-ink-soft/50 dark:text-dark-text-soft/50">Điều hướng</p>
    <ul class="max-h-60 space-y-1 overflow-y-auto">
      {decadeMarks.map((dm) => (
        <li>
          <button
            type="button"
            class="timeline-nav-btn-mobile block w-full text-left text-xs text-ink-soft dark:text-dark-text-soft"
            data-jump-to={dm.index}
          >
            {dm.label}
          </button>
        </li>
      ))}
    </ul>
  </div>

  <!-- Chú thích cuối -->
  <section class="mx-auto max-w-3xl px-4 pb-20">
    <div class="rounded-lg border border-brass/30 bg-brass/5 dark:bg-dark-brass/10 p-5 text-sm text-ink-soft dark:text-dark-text-soft">
      <strong class="text-brass">💡 Ghi chú của nhà sưu tầm:</strong>
      500 năm này không phải đường thẳng — mà là chuỗi <em>phát minh → khủng hoảng → phục hưng</em>.
      Khi đọc, hãy để ý cách các mốc <strong>văn hóa</strong> (chiến tranh, khủng hoảng quartz)
      định hình lại toàn bộ <strong>máy móc</strong> và <strong>thương hiệu</strong>.
    </div>
  </section>
</BaseLayout>

<style>
  /* =============================================================================
     LAYOUT TIMELINE — dọc so le hai bên (desktop), một cột (mobile)
     ============================================================================= */

  .timeline-track {
    position: relative;
    padding: 2rem 0;
  }

  /* Container dọc */
  .timeline-items {
    position: relative;
    z-index: 1;
  }

  /* Đường dọc giữa trang — mobile: bên trái */
  .timeline-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 20px;
    width: 3px;
    background: linear-gradient(to bottom, #B8893C, #F0EAE0);
    border-radius: 2px;
    z-index: 0;
  }

  .milestone-card {
    position: relative;
    padding-left: 50px;
    margin-bottom: 3rem;
    max-width: 100%;
  }

  /* Điểm trên timeline — mobile: bên trái */
  .milestone-dot {
    position: absolute;
    left: 11px;
    top: 4px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 3px solid #FAF7F2;
    box-shadow: 0 0 0 2px currentColor;
    z-index: 2;
  }

  .milestone-year {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  /* === DESKTOP: so le hai bên, đường giữa === */
  @media (min-width: 768px) {
    .timeline-line {
      left: 50%;
      transform: translateX(-50%);
    }

    .timeline-items {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    /* Mốc lẻ: bên trái */
    .milestone-card:nth-child(odd) {
      padding-left: 0;
      padding-right: 3rem;
      text-align: right;
      grid-column: 1;
    }

    /* Mốc chẵn: bên phải */
    .milestone-card:nth-child(even) {
      padding-left: 3rem;
      padding-right: 0;
      grid-column: 2;
    }

    /* Mỗi mốc chiếm đúng một ô, đẩy mốc kế sang hàng mới */
    .milestone-card:nth-child(odd) + .milestone-card:nth-child(even) {
      grid-row: auto;
    }
    /* Mốc lẻ mà không có mốc chẵn theo sau → vẫn ở cột trái */
    .milestone-card:nth-child(odd):last-child {
      grid-column: 1;
    }

    /* Điểm trên timeline — desktop: giữa */
    .milestone-dot {
      left: 50%;
      transform: translateX(-50%);
      top: 2px;
    }

    /* Nội dung bên trái: align phải */
    .milestone-card:nth-child(odd) .milestone-content {
      border-left: none;
      border-right: 4px solid;
      border-right-color: inherit;
    }
    .milestone-card:nth-child(odd) .milestone-content > * {
      /* Tailwind text-right được đặt qua class inline */
    }
  }

  /* === Hoạt ảnh reveal === */
  .milestone-card {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .milestone-card.reveal-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .timeline-heading {
    font-variant-numeric: lining-nums;
  }

  /* Nút lọc lớp */
  .layer-btn {
    background: var(--layer-bg);
    border-color: var(--layer-color);
    color: #FAF7F2;
  }
  .layer-btn[aria-pressed="false"] {
    background: transparent;
    border-color: rgba(31, 45, 61, 0.25);
    color: rgba(31, 45, 61, 0.45);
  }
  .layer-btn[aria-pressed="false"] .layer-dot {
    background: transparent !important;
    border: 1.5px solid rgba(31, 45, 61, 0.35);
    box-sizing: border-box;
  }

  .layer-btn-all {
    background: #1F2D3D;
    border-color: #1F2D3D;
    color: #FAF7F2;
  }
  .layer-btn-all[aria-pressed="false"] {
    background: transparent;
    border-color: rgba(31, 45, 61, 0.25);
    color: rgba(31, 45, 61, 0.45);
  }

  .milestone-card.layer-hidden {
    display: none;
  }

  /* Thanh điều hướng — mốc đang xem được nổi bật */
  .timeline-nav-btn.active,
  .timeline-nav-btn-mobile.active {
    color: #B8893C !important;
    font-weight: 600;
  }
  :global(.dark) .timeline-nav-btn.active,
  :global(.dark) .timeline-nav-btn-mobile.active {
    color: #D4A85A !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .milestone-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initTimeline() {
    const track = document.getElementById('timeline');
    if (!track) return;

    const cards = track.querySelectorAll<HTMLElement>('.milestone-card');
    const toggles = document.querySelectorAll<HTMLButtonElement>('[data-layer-toggle]');
    const toggleAll = document.getElementById('toggle-all') as HTMLButtonElement | null;
    const countEl = document.getElementById('milestone-count');
    const total = cards.length;

    // ---- 1. Bật/tắt lớp ----
    const activeLayers = new Set(['mechanism', 'brand', 'culture']);

    function updateVisibility() {
      let visibleCount = 0;
      cards.forEach((card) => {
        const type = card.dataset.type ?? '';
        const visible = activeLayers.has(type);
        card.classList.toggle('layer-hidden', !visible);
        if (visible) visibleCount++;
      });
      if (countEl) {
        countEl.textContent = visibleCount === total
          ? `${total} mốc`
          : `${visibleCount} / ${total} mốc`;
      }
      const allOn = activeLayers.size === 3;
      toggleAll?.setAttribute('aria-pressed', String(allOn));
    }

    toggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        const layerId = btn.dataset.layerToggle ?? '';
        if (activeLayers.has(layerId)) {
          activeLayers.delete(layerId);
          btn.setAttribute('aria-pressed', 'false');
        } else {
          activeLayers.add(layerId);
          btn.setAttribute('aria-pressed', 'true');
        }
        updateVisibility();
      });
    });

    toggleAll?.addEventListener('click', () => {
      activeLayers.clear();
      activeLayers.add('mechanism', 'brand', 'culture');
      toggles.forEach((btn) => btn.setAttribute('aria-pressed', 'true'));
      updateVisibility();
    });

    // ---- 2. Reveal khi cuộn tới ----
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      cards.forEach((c) => c.classList.add('reveal-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      cards.forEach((card) => observer.observe(card));

      setTimeout(() => {
        cards.forEach((c) => c.classList.add('reveal-visible'));
      }, 3000);
    }

    // ---- 3. Thanh điều hướng: nhảy tới mốc ----
    function jumpToMilestone(index: number) {
      const target = cards[index] as HTMLElement | undefined;
      if (!target || target.classList.contains('layer-hidden')) return;
      target.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-jump-to]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.jumpTo ?? '0');
        jumpToMilestone(idx);
        // Đóng panel mobile nếu đang mở
        document.getElementById('timeline-nav-mobile')?.classList.add('hidden');
      });
    });

    // ---- 4. Scroll spy: đánh dấu mốc đang xem ----
    const navBtns = document.querySelectorAll<HTMLButtonElement>('.timeline-nav-btn, .timeline-nav-btn-mobile');

    const spyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = (entry.target as HTMLElement).dataset.index;
            if (!idx) return;
            // Tìm decade mark gần nhất
            navBtns.forEach((btn) => {
              const jumpIdx = parseInt(btn.dataset.jumpTo ?? '0');
              const nextBtn = btn.nextElementSibling?.querySelector('[data-jump-to]') as HTMLElement | null;
              const nextIdx = nextBtn ? parseInt(nextBtn.dataset.jumpTo ?? '999') : 999;
              if (parseInt(idx) >= jumpIdx && parseInt(idx) < nextIdx) {
                btn.classList.add('active');
              } else {
                btn.classList.remove('active');
              }
            });
          }
        });
      },
      { threshold: 0.5 }
    );
    cards.forEach((card) => spyObserver.observe(card));

    // ---- 5. Nút điều hướng mobile ----
    const navToggle = document.getElementById('timeline-nav-toggle');
    const navMobile = document.getElementById('timeline-nav-mobile');
    navToggle?.addEventListener('click', () => {
      navMobile?.classList.toggle('hidden');
    });
    // Đóng khi bấm ra ngoài
    document.addEventListener('click', (e) => {
      if (navMobile?.classList.contains('hidden')) return;
      if (navToggle?.contains(e.target as Node)) return;
      if (navMobile?.contains(e.target as Node)) return;
      navMobile?.classList.add('hidden');
    });
  }

  initTimeline();
</script>
