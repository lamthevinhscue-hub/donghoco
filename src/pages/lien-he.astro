---
// Trang: LIÊN HỆ
// Form gửi thật qua Formspree. Mã endpoint lấy từ biến môi trường
// PUBLIC_FORMSPREE_ID (xem .env / .env.example). Nếu biến trống, form ẩn
// ô nhập và hiện thông báo tạm ngưng — không để người đọc gõ rồi mất dữ liệu.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, t } from '../i18n/ui';

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);
const isVi = lang === 'vi';

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID ?? '';
const hasEndpoint = formspreeId.trim() !== '';
const formAction = `https://formspree.io/f/${formspreeId}`;
---

<BaseLayout title={tr.nav_contact}>
  <section class="mx-auto max-w-2xl px-4 py-16">
    <div class="mb-3 h-1 w-12 rounded bg-brass"></div>
    <h1 class="font-serif text-4xl text-navy dark:text-dark-text sm:text-5xl">{tr.nav_contact}</h1>
    <p class="mt-4 text-ink-soft dark:text-dark-text-soft">
      {isVi
        ? 'Có câu hỏi, góp ý hoặc ý tưởng chủ đề? Hãy gửi cho tôi — tôi đọc tất cả.'
        : 'Got a question, feedback, or a topic idea? Send it over — I read everything.'}
    </p>

    {hasEndpoint ? (
      <form
        class="mt-10 space-y-5"
        method="POST"
        action={formAction}
        data-form="contact"
        novalidate
        data-sending-text={tr.contact_sending}
        data-success-text={tr.contact_success}
        data-error-text={tr.contact_error}
        data-msg-fill-name={isVi ? 'Vui lòng điền tên của bạn.' : 'Please enter your name.'}
        data-msg-fill-email={isVi ? 'Vui lòng điền địa chỉ email.' : 'Please enter your email address.'}
        data-msg-email-invalid={isVi ? 'Địa chỉ email chưa hợp lệ — kiểm tra lại giúp tôi.' : 'That email address does not look valid — please check again.'}
        data-msg-fill-message={isVi ? 'Vui lòng điền nội dung tin nhắn.' : 'Please write your message.'}
      >
        <!-- Honeypot chống bot: ẩn khỏi người dùng, Formspree loại bỏ lượt gửi có ô này được điền -->
        <div class="hidden" aria-hidden="true">
          <label for="gotcha">Đừng điền ô này</label>
          <input type="text" id="gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>
        <!-- Tiêu đề thư cố định để nhận biết trong hộp mail -->
        <input type="hidden" name="_subject" value={isVi ? 'Liên hệ từ Đồng Hồ Cơ' : 'Contact from Đồng Hồ Cơ'} />

        <div>
          <label for="name" class="mb-1.5 block text-sm font-medium text-navy dark:text-dark-text">
            {tr.contact_name} <span class="sr-only">({isVi ? 'bắt buộc' : 'required'})</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            aria-describedby="name-error"
            maxlength="100"
            class="w-full rounded-lg border border-ink-soft/70 bg-white px-4 py-2.5 text-ink focus:border-brass focus:outline-none focus:ring-1 focus:ring-brass dark:border-dark-border dark:bg-dark-surface dark:text-dark-text"
          />
          <p id="name-error" aria-live="polite" class="mt-1 hidden text-sm text-red-700 dark:text-red-300"></p>
        </div>

        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium text-navy dark:text-dark-text">
            {tr.contact_email} <span class="sr-only">({isVi ? 'bắt buộc' : 'required'})</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            aria-describedby="email-error"
            maxlength="100"
            class="w-full rounded-lg border border-ink-soft/70 bg-white px-4 py-2.5 text-ink focus:border-brass focus:outline-none focus:ring-1 focus:ring-brass dark:border-dark-border dark:bg-dark-surface dark:text-dark-text"
          />
          <p id="email-error" aria-live="polite" class="mt-1 hidden text-sm text-red-700 dark:text-red-300"></p>
        </div>

        <div>
          <label for="message" class="mb-1.5 block text-sm font-medium text-navy dark:text-dark-text">
            {tr.contact_message} <span class="sr-only">({isVi ? 'bắt buộc' : 'required'})</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            aria-describedby="message-error"
            maxlength="2000"
            class="w-full rounded-lg border border-ink-soft/70 bg-white px-4 py-2.5 text-ink focus:border-brass focus:outline-none focus:ring-1 focus:ring-brass dark:border-dark-border dark:bg-dark-surface dark:text-dark-text"
            data-message
          ></textarea>
          <p id="message-error" aria-live="polite" class="mt-1 hidden text-sm text-red-700 dark:text-red-300"></p>
          <p class="mt-1 text-right text-xs text-ink-soft/90 dark:text-dark-text-soft/70">
            <span data-char-count>2000</span> {tr.contact_chars_remaining}
          </p>
        </div>

        <button
          type="submit"
          data-submit-btn
          class="rounded-lg bg-navy px-6 py-3 font-medium text-cream transition-colors hover:bg-brass dark:bg-dark-surface dark:text-dark-text dark:border dark:border-dark-border"
        >
          {tr.contact_button}
        </button>

        <!-- Khối thông báo kết quả — aria-live để trình đọc màn hình đọc được -->
        <p
          id="form-status"
          aria-live="polite"
          role="status"
          class="hidden text-sm"
        >
        </p>
      </form>
    ) : (
      <p class="mt-10 rounded-lg border border-cream-dark bg-cream-dark/20 px-5 py-4 text-sm text-ink-soft dark:border-dark-border dark:bg-dark-surface dark:text-dark-text-soft">
        {tr.contact_disabled_notice}
      </p>
    )}
  </section>
</BaseLayout>

<script>
  // Gửi form bằng fetch để không chuyển trang. Nếu JavaScript tắt, thẻ <form>
  // vẫn gửi được theo cách thường vì đã có action + method thật.
  const form = document.querySelector('[data-form="contact"]') as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('form-status');
    const btn = form.querySelector('[data-submit-btn]') as HTMLButtonElement | null;
    const btnOriginalText = btn ? btn.textContent : '';
    // Nhãn trạng thái lấy từ data attribute (do server render theo ngôn ngữ)
    const sendingText = form.dataset.sendingText ?? 'Sending…';
    const successText = form.dataset.successText ?? 'Sent.';
    const errorText = form.dataset.errorText ?? 'Error.';
    const msg = (key: string) => form.dataset[key] ?? '';

    // ----- Validation cho trình đọc màn hình -----
    // Native bubble của trình duyệt không được mọi trình đọc đọc lên — tự kiểm tra
    // bằng Constraint Validation API (attribute required/type vẫn là nguồn chuẩn),
    // hiển thị text lỗi cụ thể + aria-invalid + đưa focus về field lỗi đầu.
    interface FieldRule {
      el: HTMLInputElement | HTMLTextAreaElement | null;
      emptyMsg: string;
      invalidMsg?: string;
    }
    const fields: FieldRule[] = [
      { el: form.querySelector('#name'), emptyMsg: msg('msgFillName') },
      { el: form.querySelector('#email'), emptyMsg: msg('msgFillEmail'), invalidMsg: msg('msgEmailInvalid') },
      { el: form.querySelector('#message'), emptyMsg: msg('msgFillMessage') },
    ];

    function setFieldError(rule: FieldRule, text: string) {
      if (!rule.el) return;
      const errEl = document.getElementById(rule.el.id + '-error');
      if (text) {
        rule.el.setAttribute('aria-invalid', 'true');
        if (errEl) {
          errEl.textContent = text;
          errEl.classList.remove('hidden');
        }
      } else {
        rule.el.setAttribute('aria-invalid', 'false');
        if (errEl) {
          errEl.textContent = '';
          errEl.classList.add('hidden');
        }
      }
    }

    function validateField(rule: FieldRule): boolean {
      if (!rule.el) return true;
      const v = rule.el.validity;
      if (v.valid) {
        setFieldError(rule, '');
        return true;
      }
      setFieldError(rule, v.valueMissing ? rule.emptyMsg : rule.invalidMsg ?? rule.emptyMsg);
      return false;
    }

    // Gõ lại ở field đang lỗi → xét lại ngay để người dùng thấy đã sửa xong
    fields.forEach((rule) => {
      rule.el?.addEventListener('input', () => {
        if (rule.el?.getAttribute('aria-invalid') === 'true') validateField(rule);
      });
    });

    // Đếm ký tự còn lại cho ô nội dung
    const textarea = form.querySelector('[data-message]') as HTMLTextAreaElement | null;
    const charCount = form.querySelector('[data-char-count]');
    if (textarea && charCount) {
      const max = textarea.getAttribute('maxlength') || '2000';
      const update = () => {
        const remaining = Number(max) - textarea.value.length;
        charCount.textContent = String(remaining);
      };
      textarea.addEventListener('input', update);
      update();
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status || !btn) return;
      // Kiểm tra hợp lệ trước khi gửi — focus chuyển đến field lỗi đầu tiên
      // để trình đọc màn hình đọc label + thông báo lỗi (qua aria-describedby)
      const results = fields.map(validateField);
      if (results.includes(false)) {
        const firstBad = fields[results.indexOf(false)];
        firstBad?.el?.focus();
        return;
      }
      // Tránh gửi nhiều lần liên tiếp
      if (btn.disabled) return;
      btn.disabled = true;
      btn.textContent = sendingText;
      status.className = 'text-sm text-brass dark:text-dark-brass';
      status.textContent = sendingText;

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          // Thành công: xóa form, hiện lời cảm ơn
          form.reset();
          if (textarea && charCount) {
            const max = textarea.getAttribute('maxlength') || '2000';
            charCount.textContent = max;
          }
          status.className = 'text-sm text-green-600 dark:text-green-400';
          status.textContent = successText;
        } else {
          // Lỗi HTTP (4xx/5xx): báo lỗi thật, giữ nguyên nội dung
          status.className = 'text-sm text-red-600 dark:text-red-400';
          status.textContent = errorText;
        }
      } catch (err) {
        // Lỗi mạng (không có kết nối): báo lỗi thật, KHÔNG báo thành công
        status.className = 'text-sm text-red-600 dark:text-red-400';
        status.textContent = errorText;
      } finally {
        btn.disabled = false;
        btn.textContent = btnOriginalText;
      }
    });
  }
</script>
