---
// =============================================================================
// Trang: LỘ TRÌNH HỌC ĐỒNG HỒ CƠ — hub đường đọc cho ba nhóm người đọc
// =============================================================================
// Chỉ TỔ CHỨC LẠI các bài/trang đã tồn tại — không tạo dữ kiện hay bài mới.
// Dữ liệu duy nhất từ src/data/learningPaths.ts (script check-learning-paths
// kiểm trong npm run check). Không JavaScript cần thiết: toàn bộ nội dung và
// mọi liên kết nằm trong HTML tĩnh.
//
// Dấu thị giác: "đường truyền năng lượng" — mỗi lộ trình là một nhánh đọc, mỗi
// bước là một điểm dừng trên đường dẫn (vòng tròn số nối bằng đường kẻ, gợi
// vạch chia trên vành phút). Toàn bộ là HTML/CSS tĩnh: không ảnh, không gradient,
// không animation, không chuyển động tự phát.
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, localizedPath } from '../i18n/ui';
import { learningPaths } from '../data/learningPaths';

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
---

<BaseLayout
  title="Lộ trình học đồng hồ cơ"
  description="Ba lộ trình đọc cho ba cách tiếp cận đồng hồ cơ: bắt đầu chơi, hiểu bộ máy, và tư duy người sưu tầm — mỗi bước dẫn tới một bài viết có nguồn trên trang."
>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <div class="mb-3 h-1 w-12 rounded bg-brass" aria-hidden="true"></div>
    <h1 class="font-serif text-4xl text-navy dark:text-dark-text sm:text-5xl">Lộ trình học đồng hồ cơ</h1>

    <p class="mt-4 text-lg leading-relaxed text-ink-soft dark:text-dark-text-soft">
      Dưới đây là <strong class="text-ink dark:text-dark-text">ba cách đọc khác nhau</strong> về đồng hồ cơ —
      không phải bảng xếp hạng kiến thức, và không có nhánh nào là "bắt buộc học trước".
      Mỗi lộ trình gồm các bước nối nhau, mỗi bước dẫn tới một bài viết có nguồn
      sẵn trên trang. Chọn nhánh gần với nhu cầu của bạn nhất và đi tiếp từ đó.
    </p>

    <!-- Mục lục — ba nhánh, neo tới từng lộ trình -->
    <nav aria-label="Mục lục ba lộ trình" class="mt-10">
      <ol class="grid gap-3 sm:grid-cols-3">
        {learningPaths.map((path) => (
          <li>
            <a
              href={`#${path.id}`}
              class="group flex min-h-11 items-baseline gap-2.5 rounded-lg border border-line bg-surface-raised px-4 py-3 transition-colors hover:border-steel focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steel dark:border-dark-border dark:bg-dark-surface"
            >
              <span class="font-mono text-sm font-semibold text-steel dark:text-steel" aria-hidden="true">{String(path.number).padStart(2, '0')}</span>
              <span class="text-sm font-medium leading-snug text-ink group-hover:text-brass dark:text-dark-text dark:group-hover:text-dark-brass">{path.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    {learningPaths.map((path) => (
      <section id={path.id} class="mt-16 scroll-mt-24" aria-labelledby={`path-${path.id}-title`}>
        <div class="flex items-baseline gap-3">
          <span class="font-mono text-3xl font-semibold text-steel/50 dark:text-steel/40" aria-hidden="true">{String(path.number).padStart(2, '0')}</span>
          <h2 id={`path-${path.id}-title`} class="font-serif text-2xl text-navy dark:text-dark-text">
            {path.title}
          </h2>
        </div>
        <p class="mt-3 leading-relaxed text-ink-soft dark:text-dark-text-soft">{path.description}</p>
        <p class="mt-2 text-sm text-ink-soft dark:text-dark-text-soft">
          <span class="font-medium text-steel dark:text-steel">Phù hợp với:</span>
          {path.audience}
        </p>

        <!-- Đường truyền năng lượng: các điểm dừng nối nhau bằng một đường kẻ -->
        <ol class="lp-steps mt-6">
          {path.steps.map((step, i) => (
            <li class="lp-item relative">
              <span class="lp-line" aria-hidden="true"></span>
              <a
                href={localizedPath(step.href, lang)}
                class="group relative flex gap-3 rounded-lg px-1 py-3 transition-colors hover:bg-brass/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steel dark:hover:bg-dark-brass/15"
              >
                <span
                  class="lp-circle flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-steel bg-cream font-mono text-xs font-semibold text-steel dark:border-steel dark:bg-dark-bg"
                  style="font-variant-numeric: lining-nums;"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <span class="flex flex-col">
                  <span class="text-base font-medium leading-snug text-ink transition-colors group-hover:text-brass dark:text-dark-text dark:group-hover:text-dark-brass">
                    {step.label}
                  </span>
                  <span class="mt-1 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
                    {step.why}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>

        <a
          href={localizedPath(path.steps[0].href, lang)}
          class="mt-4 inline-flex min-h-11 items-center rounded-lg bg-navy px-4 py-2 text-sm font-semibold text-cream transition-colors hover:bg-steel focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steel dark:bg-steel dark:hover:bg-steel/80"
        >
          Bắt đầu lộ trình này
          <span class="ml-1" aria-hidden="true">→</span>
        </a>
      </section>
    ))}

    <!-- Khối kết thúc: điểm hổ trợ khi gặp thuật ngữ lạ -->
    <section
      class="mt-16 rounded-xl border border-line bg-surface-raised p-6 dark:border-dark-border dark:bg-dark-surface"
      aria-labelledby="glossary-tip-title"
    >
      <h2 id="glossary-tip-title" class="font-serif text-lg text-navy dark:text-dark-text">
        Chưa biết tra thuật ngữ nào?
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-soft dark:text-dark-text-soft">
        Gặp một thuật ngữ lạ ở bất kỳ bước nào trên đây — tra nghĩa ngắn gọn trong từ điển
        đồng hồ của trang, hoặc dùng ô tìm kiếm trên thanh menu.
      </p>
      <a
        href={localizedPath('/tu-dien', lang)}
        class="mt-3 inline-flex min-h-11 items-center gap-1 text-sm font-medium text-steel underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steel dark:text-steel"
      >
        Mở từ điển đồng hồ
        <span aria-hidden="true">→</span>
      </a>
    </section>
  </section>
</BaseLayout>

<style>
  /* ===== Đường truyền năng lượng — HTML/CSS thuần, không animation ===== */

  .lp-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Đường kẻ dọc nối các điểm dừng — gợi vạch chia trên vành phút */
  .lp-line {
    position: absolute;
    left: 13px; /* tâm vòng tròn số 28px: 14px trừ 1px nửa đường kẻ */
    top: 0;
    height: 100%;
    width: 1px;
    background: rgb(var(--c-line) / 0.9);
  }

  /* Bước cuối: đường kẻ dừng tại vòng tròn cuối cùng */
  .lp-item:last-child .lp-line {
    height: 26px; /* py-3 (12px) + nửa vòng tròn (14px) */
    bottom: auto;
  }

  /* Vòng tròn số là "điểm dừng": nền cùng màu trang để che đường kẻ phía sau */
  .lp-item .lp-circle {
    position: relative;
    z-index: 10;
  }
</style>
