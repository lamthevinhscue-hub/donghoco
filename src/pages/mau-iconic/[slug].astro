---
// Trang chi tiết: MẪU ICONIC (tiếng Việt — /mau-iconic/[slug])
// Thân trang nằm ở template dùng chung src/components/templates/IconicArticle.astro
// (wrapper tiếng Anh: /en/iconic-watches/[slug]). Route này chỉ sinh bản tiếng Việt.
import IconicArticle from '../../components/templates/IconicArticle.astro';
import { getEntriesByLang, getSlug } from '../../lib/content';
import type { Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  const lang: Lang = 'vi';
  const entries = await getEntriesByLang('mauIconic', lang);
  return entries.map((entry) => ({
    params: { slug: getSlug(entry) },
    props: { slug: getSlug(entry), lang },
  }));
}

const { slug, lang } = Astro.props as { slug: string; lang: Lang };
---

<IconicArticle slug={slug} lang={lang} />
