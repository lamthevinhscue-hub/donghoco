---
// Trang chi tiết: MẪU ICONIC
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getEntriesByLang, getSlug } from '../../lib/content';
import { render } from 'astro:content';
import type { Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  const langs: Lang[] = ['vi', 'en'];
  const paths = [];
  for (const lang of langs) {
    const entries = await getEntriesByLang('mauIconic', lang);
    for (const entry of entries) {
      paths.push({
        params: { slug: getSlug(entry) },
        props: { slug: getSlug(entry), lang },
      });
    }
  }
  return paths;
}

const { slug, lang } = Astro.props as { slug: string; lang: Lang };
const entries = await getEntriesByLang('mauIconic', lang);
const entry = entries.find((e) => getSlug(e) === slug);

if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
const { data } = entry;
const meta = [
  data.brand,
  data.year ? `${data.year}` : null,
  data.references && data.references.length > 0 ? `${data.references.length} ref` : null,
].filter(Boolean).join(' • ');
---

<ArticleLayout
  title={data.title}
  excerpt={data.excerpt}
  date={data.date}
  cover_image={data.cover_image}
  backHref="/mau-iconic"
  meta={meta}
>
  <Content />
</ArticleLayout>
