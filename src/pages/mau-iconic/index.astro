---
// Trang danh sách: MẪU ICONIC (Trụ cột 2) — lọc theo thể loại + thập niên
import CollectionListLayout from '../../layouts/CollectionListLayout.astro';
import { getEntriesByLang, getSlug } from '../../lib/content';
import { getLangFromUrl } from '../../i18n/ui';

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const entries = await getEntriesByLang('mauIconic', lang);

// Nhóm lọc 1: Thể loại (lấy từ category của các bài)
const categories = [...new Set(entries.map((e) => e.data.category).filter(Boolean))] as string[];
const categoryLabels: Record<string, string> = {
  'lặn': 'Lặn',
  'chronograph': 'Chronograph',
  'dress': 'Dress',
  'pilot': 'Phi công',
  'sport-luxury': 'Sport-luxury',
  'chế tác độc lập': 'Chế tác độc lập',
  'siêu mỏng': 'Siêu mỏng',
  'vật liệu': 'Vật liệu',
  'phức tạp cao cấp': 'Phức tạp cao cấp',
};

// Nhóm lọc 2: Thập niên (tính từ year)
function getDecade(year?: number): string | undefined {
  if (!year) return undefined;
  return Math.floor(year / 10) * 10 + 's';
}
const decades = [...new Set(entries.map((e) => getDecade(e.data.year)).filter(Boolean))] as string[];
decades.sort();

// Danh sách hiển thị sắp A–Z theo tiêu đề mẫu (Intl.Collator: ngôn ngữ vi,
// không phân biệt hoa/thường, hỗ trợ số trong tên). Dùng BẢN SAO mảng
// ([...entries]) trước khi sort — categories/decades phía trên vẫn tính từ
// thứ tự gốc để thứ tự nút lọc không đổi; bộ lọc client-side ẩn/hiện theo
// data-f-* nên thứ tự A–Z được giữ nguyên khi lọc.
const collator = new Intl.Collator(lang === 'vi' ? 'vi' : 'en', { sensitivity: 'accent', numeric: true });
const sortedEntries = [...entries].sort((a, b) => collator.compare(a.data.title, b.data.title));
---

<CollectionListLayout
  collection="mauIconic"
  title={lang === 'vi' ? 'Những mẫu iconic' : 'Iconic watches'}
  description={lang === 'vi'
    ? 'Câu chuyện của những chiếc đồng hồ định hình cả một thể loại. Muốn đối chiếu thông số?'
    : 'Stories of the watches that defined entire categories.'}
  descriptionLink={lang === 'vi' ? { href: '/so-sanh', label: 'Mở công cụ so sánh →' } : undefined}
  entries={sortedEntries}
  getMeta={(e) => e.data.brand}
  getFeatureYear={(e) => (e.data.year ? String(e.data.year) : undefined)}
  getCompareSlug={(e) => getSlug(e)}
  filters={[
    {
      key: 'theloai',
      label: 'Thể loại',
      options: categories.map((c) => ({ value: c, label: categoryLabels[c] ?? c })),
      getValue: (e) => e.data.category,
    },
    {
      key: 'decade',
      label: 'Thập niên',
      options: decades.map((d) => ({ value: d, label: d })),
      getValue: (e) => getDecade(e.data.year),
    },
  ]}
/>
