---
// =============================================================================
// TRANG /so-sanh — Công cụ so sánh mẫu iconic
// =============================================================================
// Người dùng chọn 2-3 mẫu iconic, hiển thị bảng đối chiếu:
// năm, thương hiệu, thể loại, bộ máy, trữ cót, chống nước, câu chuyện định danh.
// Dữ liệu lấy từ frontmatter collection mauIconic — không nhập tay.
// Trạng thái lựa chọn lưu trên URL (?m=slug1,slug2,slug3) để chia sẻ.
// =============================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntriesByLang, getSlug } from '../lib/content';

const entries = await getEntriesByLang('mauIconic', 'vi');

const categoryLabels: Record<string, string> = {
  'lặn': 'Lặn',
  'chronograph': 'Chronograph',
  'dress': 'Dress',
  'pilot': 'Phi công',
  'sport-luxury': 'Sport-luxury',
  'chế tác độc lập': 'Chế tác độc lập',
  'siêu mỏng': 'Siêu mỏng',
  'vật liệu': 'Vật liệu',
  'phức tạp cao cấp': 'Phức tạp cao cấp',
};

// Trích dữ liệu cho từng mẫu
const models = entries.map((e) => ({
  slug: getSlug(e),
  title: e.data.title,
  excerpt: e.data.excerpt,
  year: e.data.year,
  brand: e.data.brand,
  category: e.data.category,
  categoryLabel: e.data.category ? (categoryLabels[e.data.category] ?? e.data.category) : '—',
  movement: e.data.movement,
  power_reserve: e.data.power_reserve,
  water_resistance: e.data.water_resistance,
}));
---

<BaseLayout
  title="So sánh mẫu iconic"
  description="Chọn 2-3 mẫu đồng hồ iconic để đối chiếu thông số: năm, thương hiệu, thể loại, bộ máy, trữ cót, chống nước."
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="mb-3 h-1 w-12 rounded bg-brass"></div>
    <h1 class="font-serif text-3xl text-navy dark:text-dark-text sm:text-4xl">So sánh mẫu iconic</h1>
    <p class="mt-3 max-w-2xl text-ink-soft dark:text-dark-text-soft">
      Chọn 2–3 mẫu đồng hồ để đối chiếu thông số và câu chuyện. Dữ liệu lấy trực tiếp từ hồ sơ từng mẫu.
    </p>

    <!-- ====== CHỌN MẪU ====== -->
    <div class="mt-8">
      <label for="model-select" class="mb-2 block text-sm font-medium text-navy dark:text-dark-text">Thêm mẫu để so sánh:</label>
      <div class="flex flex-wrap gap-3">
        <select
          id="model-select"
          class="flex-1 rounded-lg border border-cream-dark dark:border-dark-border bg-white dark:bg-dark-surface px-4 py-2.5 text-sm text-navy dark:text-dark-text focus:border-brass focus:outline-none"
        >
          <option value="">— Chọn một mẫu —</option>
          {models.map((m) => (
            <option value={m.slug}>{m.title}</option>
          ))}
        </select>
        <button
          type="button"
          id="add-model"
          class="shrink-0 rounded-lg bg-navy px-5 py-2.5 text-sm font-medium text-cream transition-colors hover:bg-brass"
        >
          Thêm
        </button>
      </div>
      <p class="mt-2 text-xs text-ink-soft/60 dark:text-dark-text-soft/60">Tối đa 3 mẫu. Bấm tên mẫu trong bảng để bỏ.</p>
    </div>

    <!-- ====== TRẠNG THÁI RỖNG / 1 MẪU ====== -->
    <div id="compare-empty" class="mt-12 rounded-lg border border-dashed border-cream-dark dark:border-dark-border bg-cream-dark/10 dark:bg-dark-surface/50 py-12 text-center">
      <div id="compare-empty-content"></div>
    </div>

    <div id="compare-table-wrap" class="mt-8 hidden overflow-x-auto">
      <table class="w-full min-w-[640px] border-collapse text-sm">
        <thead>
          <tr id="compare-header"></tr>
        </thead>
        <tbody id="compare-body"></tbody>
      </table>
    </div>

    <!-- ====== CHIA SẺ LINK ====== -->
    <div id="share-link-wrap" class="mt-6 hidden">
      <p class="text-xs text-ink-soft/60 dark:text-dark-text-soft/60">
        🔗 Link chia sẻ: <span id="share-link" class="font-mono text-brass"></span>
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ modelsData: models }}>
  // ====== State ======
  let selected = [];
  const MAX = 3;
  const selectEl = document.getElementById('model-select');
  const addBtn = document.getElementById('add-model');
  const emptyEl = document.getElementById('compare-empty');
  const tableWrap = document.getElementById('compare-table-wrap');
  const headerRow = document.getElementById('compare-header');
  const bodyEl = document.getElementById('compare-body');
  const shareWrap = document.getElementById('share-link-wrap');
  const shareLink = document.getElementById('share-link');

  // Đọc selection từ URL ?m=slug1,slug2
  function restoreFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const m = params.get('m');
    if (m) {
      selected = m.split(',').filter((s) => modelsData.find((md) => md.slug === s)).slice(0, MAX);
    }
  }

  function saveToUrl() {
    if (selected.length > 0) {
      const url = new URL(window.location);
      url.searchParams.set('m', selected.join(','));
      window.history.replaceState(null, '', url);
      shareLink.textContent = url.toString();
      shareWrap.classList.remove('hidden');
    } else {
      const url = new URL(window.location);
      url.searchParams.delete('m');
      window.history.replaceState(null, '', url);
      shareWrap.classList.add('hidden');
    }
  }

  function render() {
    // Toggle empty vs table
    const emptyContent = document.getElementById('compare-empty-content');
    if (selected.length < 2) {
      emptyEl.classList.remove('hidden');
      tableWrap.classList.add('hidden');
      if (selected.length === 1) {
        // Đã chọn 1 mẫu — hiện mẫu đó ở cột đầu và mời chọn thêm
        const m = modelsData.find((md) => md.slug === selected[0]);
        if (m) {
          const label = document.createElement('p');
          label.className = 'mb-2 text-xs font-medium uppercase tracking-wider text-brass';
          label.textContent = 'Đã chọn';

          const title = document.createElement('p');
          title.className = 'font-serif text-2xl text-navy dark:text-dark-text';
          title.textContent = m.title;

          const meta = document.createElement('p');
          meta.className = 'mt-1 text-sm text-ink-soft dark:text-dark-text-soft';
          meta.textContent = (m.brand || '') + (m.year ? ' • ' + m.year : '');

          const hintP = document.createElement('p');
          hintP.className = 'mt-4 text-sm text-ink-soft dark:text-dark-text-soft';
          hintP.textContent = 'Thêm ít nhất 1 mẫu nữa để bắt đầu so sánh. ↑';

          emptyContent.replaceChildren(label, title, meta, hintP);
        } else {
          const p = document.createElement('p');
          p.className = 'text-ink-soft dark:text-dark-text-soft';
          p.textContent = 'Đã chọn 1 mẫu. Thêm ít nhất 1 mẫu nữa để so sánh.';
          emptyContent.replaceChildren(p);
        }
      } else {
        const p = document.createElement('p');
        p.className = 'text-ink-soft dark:text-dark-text-soft';
        p.textContent = 'Chưa chọn mẫu nào. Thêm ít nhất 2 mẫu để bắt đầu so sánh.';
        emptyContent.replaceChildren(p);
      }
    } else {
      emptyEl.classList.add('hidden');
      tableWrap.classList.remove('hidden');
    }

    // Header — tạo DOM thay vì ghép innerHTML
    const labelTh = document.createElement('th');
    labelTh.className = 'border-b-2 border-cream-dark dark:border-dark-border p-3 text-left text-xs font-medium uppercase tracking-wider text-ink-soft/60 dark:text-dark-text-soft/60';
    labelTh.textContent = 'Tiêu chí';
    const headerFrag = document.createDocumentFragment();
    headerFrag.appendChild(labelTh);

    selected.forEach((slug) => {
      const m = modelsData.find((md) => md.slug === slug);
      if (!m) return;
      const th = document.createElement('th');
      th.className = 'border-b-2 border-cream-dark dark:border-dark-border p-3 text-left';

      const div = document.createElement('div');
      div.className = 'flex items-start justify-between gap-2';

      const span = document.createElement('span');
      span.className = 'font-serif text-base text-navy dark:text-dark-text';
      span.textContent = m.title;

      const btn = document.createElement('button');
      btn.className = 'shrink-0 text-xs text-ink-soft dark:text-dark-text-soft hover:text-brass dark:hover:text-dark-brass';
      btn.setAttribute('data-remove', slug);
      btn.setAttribute('aria-label', 'Bỏ');
      btn.textContent = '✕';

      div.appendChild(span);
      div.appendChild(btn);
      th.appendChild(div);
      headerFrag.appendChild(th);
    });
    headerRow.replaceChildren(headerFrag);

    // Body rows
    const rows = [
      { label: 'Năm ra mắt', key: 'year', val: (m) => m.year || '—' },
      { label: 'Thương hiệu', key: 'brand', val: (m) => m.brand || '—' },
      { label: 'Thể loại', key: 'category', val: (m) => m.categoryLabel },
      { label: 'Bộ máy', key: 'movement', val: (m) => m.movement || '—' },
      { label: 'Trữ cót', key: 'power_reserve', val: (m) => m.power_reserve || '—' },
      { label: 'Chống nước', key: 'water_resistance', val: (m) => m.water_resistance || '—' },
      { label: 'Câu chuyện định danh', key: 'excerpt', val: (m) => m.excerpt || '—' },
    ];

    bodyEl.replaceChildren();
    rows.forEach((row, ri) => {
      const tr = document.createElement('tr');
      tr.className = ri % 2 === 0 ? 'bg-white' : 'bg-cream-dark/5';

      const labelTd = document.createElement('td');
      labelTd.className = 'border-b border-cream-dark dark:border-dark-border p-3 font-medium text-ink-soft dark:text-dark-text-soft';
      labelTd.textContent = row.label;
      tr.appendChild(labelTd);

      selected.forEach((slug) => {
        const m = modelsData.find((md) => md.slug === slug);
        const td = document.createElement('td');
        td.className = 'border-b border-cream-dark dark:border-dark-border p-3';
        if (!m) { td.textContent = '—'; tr.appendChild(td); return; }
        const val = row.val(m);
        const isExcerpt = row.key === 'excerpt';
        if (isExcerpt) {
          td.className += ' italic text-ink-soft dark:text-dark-text-soft';
          td.textContent = val;
        } else {
          td.className += ' text-navy dark:text-dark-text';
          const strong = document.createElement('strong');
          strong.textContent = val;
          td.appendChild(strong);
        }
        tr.appendChild(td);
      });
      bodyEl.appendChild(tr);
    });

    // Bind remove buttons
    document.querySelectorAll('[data-remove]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-remove');
        selected = selected.filter((s) => s !== slug);
        render();
        saveToUrl();
      });
    });
  }

  // Add model
  addBtn.addEventListener('click', () => {
    const slug = selectEl.value;
    if (!slug) return;
    if (selected.length >= MAX) return;
    if (!selected.includes(slug)) {
      selected.push(slug);
      render();
      saveToUrl();
    }
    selectEl.value = '';
  });

  // Enter key
  selectEl.addEventListener('change', () => {
    if (selectEl.value && selected.length < MAX && !selected.includes(selectEl.value)) {
      selected.push(selectEl.value);
      render();
      saveToUrl();
      selectEl.value = '';
    }
  });

  // Init
  restoreFromUrl();
  render();
</script>
