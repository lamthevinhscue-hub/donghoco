---
// Trang chi tiết: THƯƠNG HIỆU (tiếng Việt — /thuong-hieu/[slug])
// Thân trang nằm ở template dùng chung src/components/templates/BrandArticle.astro
// (wrapper tiếng Anh: /en/brands/[slug]). Route này chỉ sinh bản tiếng Việt.
import BrandArticle from '../../components/templates/BrandArticle.astro';
import { getEntriesByLang, getSlug } from '../../lib/content';
import type { Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  const lang: Lang = 'vi';
  const entries = await getEntriesByLang('thuongHieu', lang);
  return entries.map((entry) => ({
    params: { slug: getSlug(entry) },
    props: { slug: getSlug(entry), lang },
  }));
}

const { slug, lang } = Astro.props as { slug: string; lang: Lang };
---

<BrandArticle slug={slug} lang={lang} />
