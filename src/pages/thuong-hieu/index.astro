---
// =============================================================================
// Trang danh sách: THƯƠNG HIỆU (Trụ cột 1) — nhóm theo hạng + lọc theo hạng
// =============================================================================
// Hiển thị tất cả thương hiệu, ĐƯỢC NHÓM THEO TỪNG HẠNG (từ cao xuống thấp).
// Thanh lọc ở trên chọn theo TỪNG HẠNG RIÊNG (không gộp) — khớp với 6 nhóm
// trên trang chủ. Trạng thái lọc ghi vào hash (#tier=<slug>) để chia sẻ được;
// tải lại trang với hash thì tự kích hoạt đúng hạng (link "và N hãng khác"
// từ trang chủ dẫn về đây). Lọc chạy ở trình duyệt, không tải lại trang.
// =============================================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getEntriesByLang, getSlug } from '../../lib/content';
import { getLangFromUrl, t, TIER_ORDER, getTierLabel, getTierDesc, getTierAccent } from '../../i18n/ui';

const lang = getLangFromUrl(new URL(Astro.url.pathname, Astro.site));
const tr = t(lang);
const isVi = lang === 'vi';

const entries = await getEntriesByLang('thuongHieu', lang);

// Nhãn năm đặc biệt cho một số thương hiệu (ghi chú kèm năm lập)
const foundedLabel: Record<string, string> = {
  'philippe-dufour': '1978 — lập xưởng riêng',
};

// Slug hóa tier cho hash (haute horlogerie -> haute-horlogerie) — ổn định, chia sẻ được
const tierSlug = (tier: string) => tier.replace(/\s+/g, '-');

// Sắp xếp thương hiệu A–Z theo tên hiển thị trong từng nhóm phân khúc.
// Intl.Collator: so sánh theo ngôn ngữ (vi), không phân biệt hoa/thường
// (sensitivity 'accent' vẫn giữ phân biệt dấu tiếng Việt), hỗ trợ số trong tên
// (numeric — VD "Seagull 1963" đứng trước "Seagull 1963M" kiểu tự nhiên).
const collator = new Intl.Collator(lang === 'vi' ? 'vi' : 'en', { sensitivity: 'accent', numeric: true });
const byTitle = (a: { data: { title: string } }, b: { data: { title: string } }) =>
  collator.compare(a.data.title, b.data.title);

// Nhóm thương hiệu theo hạng — mỗi nhóm kèm mã màu nhấn (tier accent).
// items: filter() đã trả về MẢNG MỚI nên sort trên đó không đụng mảng cache
// gốc từ getEntriesByLang — thứ tự nhóm phân khúc vẫn theo TIER_ORDER.
const groups = TIER_ORDER.map((tier) => ({
  tier,
  slug: tierSlug(tier),
  label: getTierLabel(tier, lang),
  desc: getTierDesc(tier, lang),
  accent: getTierAccent(tier),
  items: entries.filter((e) => e.data.tier === tier).sort(byTitle),
})).filter((g) => g.items.length > 0); // bỏ các hạng không có thương hiệu
---

<BaseLayout
  title={isVi ? 'Thư viện thương hiệu' : 'Brand library'}
  description={isVi
    ? 'Toàn bộ thương hiệu đồng hồ cơ, phân hạng từ Haute Horlogerie đến Entry-Level Luxury.'
    : 'All mechanical watch brands, tiered from Haute Horlogerie to Entry-Level Luxury.'}
>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <!-- Tiêu đề trang -->
    <div class="mb-3 h-1 w-12 rounded bg-brass"></div>
    <h1 class="font-serif text-4xl text-navy dark:text-dark-text sm:text-5xl">
      {isVi ? 'Thư viện thương hiệu' : 'Brand library'}
    </h1>
    <p class="mt-3 max-w-2xl text-ink-soft dark:text-dark-text-soft">
      {isVi
        ? 'Tất cả thương hiệu đồng hồ cơ, sắp theo hạng phân cấp — từ đỉnh cao chế tác đến phổ thông.'
        : 'All mechanical watch brands, organized by tier — from the pinnacle of watchmaking to consumer.'}
    </p>

    <!-- Thanh lọc theo từng hạng — vùng bấm 44px, aria-pressed, không gộp hạng -->
    <div class="mt-8 flex flex-wrap gap-2" id="tier-filter">
      <button
        data-tier="all"
        aria-pressed="true"
        class="filter-btn min-h-11 rounded-full border border-navy bg-navy px-4 text-xs font-medium text-cream transition-colors"
      >
        {tr.filter_all} ({entries.length})
      </button>
      {groups.map((g) => (
        <button
          data-tier={g.tier}
          data-accent={g.accent}
          aria-pressed="false"
          class="filter-btn min-h-11 rounded-full border border-cream-dark bg-white px-4 text-xs font-medium text-ink-soft transition-colors hover:border-brass hover:text-brass dark:border-dark-border dark:bg-dark-surface dark:text-dark-text-soft dark:hover:border-dark-brass dark:hover:text-dark-brass"
        >
          {g.label} ({g.items.length})
        </button>
      ))}
    </div>

    <!-- Danh sách nhóm theo hạng -->
    <div class="mt-12 space-y-16">
      {groups.map((group) => (
        <div data-tier-group={group.tier} class="tier-group" data-accent={group.accent}>
          <div class={`mb-6 border-l-4 border-${group.accent} pl-4 dark:border-${group.accent}-light`}>
            <h2 class="font-serif text-2xl text-navy dark:text-dark-text">{group.label}</h2>
            <p class="mt-1 text-sm text-ink-soft dark:text-dark-text-soft">{group.desc}</p>
          </div>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((entry) => {
              const slug = getSlug(entry);
              // Năm thành lập = yếu tố thị giác chính (featureYear).
              // Nhãn đặc biệt (VD "1978 — lập xưởng riêng") vẫn hiện làm badge;
              // nếu chỉ có năm thuần thì không có badge riêng để tránh trùng.
              const specialLabel = foundedLabel[slug];
              const featureYear = entry.data.founded ? String(entry.data.founded) : undefined;
              return (
                <Card
                  href={`/thuong-hieu/${slug}`}
                  title={entry.data.title}
                  excerpt={entry.data.excerpt}
                  meta={entry.data.country}
                  badge={specialLabel}
                  logo={entry.data.logo}
                  tierLabel={group.label}
                  tierAccent={group.accent}
                  featureYear={featureYear}
                />
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- Thông báo khi không có kết quả (khi lọc) -->
    <p id="no-results" class="hidden py-12 text-center text-ink-soft dark:text-dark-text-soft">
      {isVi ? 'Không có thương hiệu nào trong hạng này.' : 'No brands in this tier.'}
    </p>

    <p class="mt-12 border-t border-line pt-4 text-sm italic text-ink-soft/90 dark:border-dark-border dark:text-dark-text-soft/70">
      {tr.brand_groups_note}
    </p>
  </section>
</BaseLayout>

<script>
  // Lọc theo từng hạng — chạy ở trình duyệt, không cần tải lại trang.
  // Nút đang bật dùng màu nhấn riêng của hạng (thay vì navy chung cho mọi hạng).
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const groups = document.querySelectorAll<HTMLElement>('.tier-group');
  const noResults = document.getElementById('no-results');

  // Lập bản đồ tier -> mã màu nhấn (lấy từ data-accent của nhóm tương ứng).
  const tierAccentMap: Record<string, { bg: string; text: string; border: string }> = {};
  groups.forEach((g) => {
    const tier = g.dataset.tierGroup;
    const accent = g.dataset.accent ?? 'brass';
    if (tier && accent) {
      tierAccentMap[tier] = {
        bg: `bg-${accent}`,
        text: 'text-cream',
        border: `border-${accent}`,
      };
    }
  });

  // Danh sách mọi class màu có thể có trên nút (để xóa sạch khi đổi trạng thái).
  // offClasses gồm đủ biến thể dark để trạng thái "chưa chọn" không giữ nền trắng
  // ở chế độ tối; hover brass chỉ trên nút CHƯA chọn — nút đã chọn giữ chữ text-cream.
  const allAccentClasses = Object.values(tierAccentMap).flatMap((c) => [c.bg, c.border]);
  const offClasses = [
    'bg-white', 'text-ink-soft', 'border-cream-dark',
    'dark:bg-dark-surface', 'dark:text-dark-text-soft', 'dark:border-dark-border',
    'hover:border-brass', 'hover:text-brass',
    'dark:hover:border-dark-brass', 'dark:hover:text-dark-brass',
  ];
  const allOnClasses = ['bg-navy', 'text-cream', 'border-navy', ...allAccentClasses];

  function setButtonOff(b: HTMLButtonElement) {
    allOnClasses.forEach((c) => b.classList.remove(c));
    offClasses.forEach((c) => b.classList.add(c));
  }

  function selectTier(selected: string) {
    // Đặt mọi nút về trạng thái tắt (kèm aria-pressed cho trình đọc màn hình)
    buttons.forEach((b) => {
      setButtonOff(b);
      b.setAttribute('aria-pressed', 'false');
    });

    // Bật nút được chọn: "Tất cả" dùng navy; nút hạng dùng màu nhấn riêng.
    const btn = Array.from(buttons).find((b) => b.dataset.tier === selected);
    if (btn) {
      const accent = tierAccentMap[selected];
      if (selected === 'all' || !accent) {
        btn.classList.add('bg-navy', 'text-cream', 'border-navy');
      } else {
        btn.classList.add(accent.bg, accent.text, accent.border);
      }
      btn.setAttribute('aria-pressed', 'true');
    }

    // Hiển thị đúng hạng được chọn — không gộp hạng
    let anyVisible = false;
    groups.forEach((group) => {
      const show = selected === 'all' || group.dataset.tierGroup === selected;
      group.classList.toggle('hidden', !show);
      if (show) anyVisible = true;
    });
    noResults?.classList.toggle('hidden', anyVisible);

    // Ghi trạng thái vào hash để chia sẻ được (không tạo mục lịch sử mới)
    const newHash = `#tier=${selected === 'all' ? 'all' : selected.replace(/\s+/g, '-')}`;
    if (location.hash !== newHash) {
      history.replaceState(null, '', newHash);
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => selectTier(btn.dataset.tier ?? 'all'));
  });

  // Khôi phục lọc từ hash khi tải trang: /thuong-hieu#tier=haute-horlogerie
  // (link "và N hãng khác" từ trang chủ dẫn về đây)
  function applyHash() {
    const m = location.hash.match(/^#tier=([a-z0-9-]+)/i);
    if (!m) return;
    // slug -> tier: đối chiếu data-tier của các nút sau khi thay gạch nối bằng khoảng trắng
    const target = Array.from(buttons).find(
      (b) => b.dataset.tier !== 'all' && b.dataset.tier.replace(/\s+/g, '-') === m[1]
    );
    if (target) selectTier(target.dataset.tier!);
  }
  applyHash();
  // Điều hướng hash nội bộ (không tải lại trang) cũng cập nhật lọc
  window.addEventListener('hashchange', applyHash);
</script>
