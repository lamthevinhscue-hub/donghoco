---
// Trang chi tiết: TỪ ĐIỂN THUẬT NGỮ (tiếng Việt — /tu-dien/[slug])
// Thân trang nằm ở template dùng chung src/components/templates/TermArticle.astro
// (wrapper tiếng Anh: /en/glossary/[slug]). Route này chỉ sinh bản tiếng Việt.
import TermArticle from '../../components/templates/TermArticle.astro';
import { getEntriesByLang, getSlug } from '../../lib/content';
import type { Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  const lang: Lang = 'vi';
  const entries = await getEntriesByLang('tuDien', lang);
  return entries.map((entry) => ({
    params: { slug: getSlug(entry) },
    props: { slug: getSlug(entry), lang },
  }));
}

const { slug, lang } = Astro.props as { slug: string; lang: Lang };
---

<TermArticle slug={slug} lang={lang} />
